---
interface Props {
  activeNav?: string;
}

const { activeNav = 'home' } = Astro.props;
---

<header class="teepul-header">
  <!-- Top Announcement Bar -->
  <div class="announcement-bar">
    <div class="container announcement-content">
      <span>🔥 FREE EXPRESS SHIPPING ACROSS INDIA &bull; CASH ON DELIVERY AVAILABLE</span>
      <div class="announcement-meta">
        <span>⚡ 240 GSM Heavy Cotton Drops</span>
        <a href="/login" class="wp-quick-login">WP Admin Login</a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Navbar -->
  <div class="main-navbar">
    <div class="container nav-flex">
      <!-- Brand Logo -->
      <a href="/" class="brand-logo">
        <span class="brand-name">TEEPUL</span>
        <span class="brand-tag">STREETWEAR &bull; WP ASTRO</span>
      </a>

      <!-- Navigation Links -->
      <nav class="nav-menu">
        <a href="/" class={activeNav === 'home' ? 'nav-link active' : 'nav-link'}>Home</a>
        <a href="/products" class={activeNav === 'shop' ? 'nav-link active' : 'nav-link'}>Shop Drops</a>
        <a href="/products?category=oversized-tees" class="nav-link">240 GSM Tees</a>
        <a href="/products?category=anime-hoodies" class="nav-link">Anime Hoodies</a>
        <a href="/blog" class={activeNav === 'blog' ? 'nav-link active' : 'nav-link'}>WordPress Journal</a>
        <a href="/admin" class="nav-link admin-pill">WP Admin Portal</a>
      </nav>

      <!-- Right Header Actions -->
      <div class="nav-actions">
        <a href="/products" class="icon-btn" title="Search Products">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </a>

        <a href="/login" class="icon-btn" title="WP Account">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
        </a>

        <!-- Cart Button -->
        <button class="cart-trigger trigger-cart-open" aria-label="View Shopping Bag">
          <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
          </svg>
          <span class="cart-count-badge">0</span>
        </button>
      </div>
    </div>
  </div>
</header>

<style>
  .teepul-header {
    width: 100%;
    position: relative;
    z-index: 998;
    background: #000000;
    color: #ffffff;
    font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  .announcement-bar {
    background: #ff3b30;
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    padding: 0.45rem 0;
    text-transform: uppercase;
  }

  .announcement-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .announcement-meta {
    display: flex;
    gap: 1.25rem;
    align-items: center;
  }

  .wp-quick-login {
    color: #ffffff;
    text-decoration: underline;
    font-weight: 700;
  }

  .main-navbar {
    border-bottom: 1px solid rgba(255,255,255,0.12);
    padding: 1.1rem 0;
    background: #0a0a0a;
  }

  .nav-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .brand-logo {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    line-height: 1;
  }

  .brand-name {
    font-size: 1.8rem;
    font-weight: 900;
    letter-spacing: 2px;
    color: #ffffff;
  }

  .brand-tag {
    font-size: 0.65rem;
    font-weight: 700;
    color: #ff3b30;
    letter-spacing: 1px;
    margin-top: 2px;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-link {
    color: #a0a0a0;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    transition: color 0.15s ease;
  }

  .nav-link:hover, .nav-link.active {
    color: #ffffff;
  }

  .admin-pill {
    background: rgba(34, 113, 177, 0.2);
    color: #72aee6 !important;
    border: 1px solid rgba(114, 174, 230, 0.3);
    padding: 0.35rem 0.85rem;
    border-radius: 4px;
    font-size: 0.82rem;
  }

  .admin-pill:hover {
    background: #2271b1;
    color: #ffffff !important;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .icon-btn {
    background: none;
    border: none;
    color: #ffffff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.15s ease;
  }

  .icon-btn:hover {
    opacity: 0.8;
  }

  .cart-trigger {
    background: #ffffff;
    color: #000000;
    border: none;
    padding: 0.55rem 1rem;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    cursor: pointer;
    transition: background 0.15s ease, transform 0.15s ease;
  }

  .cart-trigger:hover {
    background: #ff3b30;
    color: #ffffff;
    transform: scale(1.03);
  }

  .cart-count-badge {
    background: #ff3b30;
    color: #ffffff;
    font-size: 0.75rem;
    padding: 1px 7px;
    border-radius: 10px;
  }

  .cart-trigger:hover .cart-count-badge {
    background: #ffffff;
    color: #000000;
  }

  @media (max-width: 768px) {
    .announcement-meta { display: none; }
    .nav-menu { display: none; }
  }
</style>
