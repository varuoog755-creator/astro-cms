---
---

<section id="curtain-hero-banner" class="relative w-full h-[65vh] sm:h-[78vh] min-h-[460px] max-h-[820px] bg-stone-900 overflow-hidden flex items-center justify-center select-none border-b border-slate-200/80">
  
  <!-- 1. Pure Full-Bleed HD Video (1080p Upscaled & Watermark Removed) -->
  <div class="absolute inset-0 z-0 w-full h-full overflow-hidden">
    <video
      id="hero-bg-video"
      autoplay
      loop
      muted
      playsinline
      poster="/videos/hero_curtain_poster.webp"
      preload="auto"
      class="w-full h-full object-cover object-center"
    >
      <source src="/videos/hero_curtain_video.mp4" type="video/mp4" />
    </video>
  </div>

  <!-- 2. Ultra-Clean Minimalist Floating Actions (No blocking text overlays) -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full h-full flex flex-col justify-between py-5 sm:py-8 pointer-events-none">
    
    <!-- Top Minimalist Quality Pill & Video Control -->
    <div class="flex items-center justify-between pointer-events-auto">
      <div class="inline-flex items-center gap-2 bg-black/40 hover:bg-black/60 backdrop-blur-md border border-white/20 text-white text-[11px] sm:text-xs font-bold px-3.5 py-1.5 rounded-full uppercase tracking-wider shadow-lg transition">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Panipat Factory Direct · 100% HD Drapery</span>
      </div>

      <!-- Play / Pause Video Pill -->
      <button
        type="button"
        id="toggle-video-btn"
        class="bg-black/40 hover:bg-black/60 active:scale-95 backdrop-blur-md text-white font-semibold text-xs px-3.5 py-1.5 rounded-full border border-white/20 shadow-lg transition flex items-center gap-1.5 cursor-pointer"
        title="Play / Pause Video"
      >
        <span id="video-btn-icon">⏸️</span>
        <span id="video-btn-text">Pause</span>
      </button>
    </div>

    <!-- Bottom Ultra-Clean Quick CTA Bar -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pointer-events-auto">
      
      <!-- Clean Floating Shop Button -->
      <div class="flex items-center gap-3">
        <a
          href="/products"
          class="bg-amber-700 hover:bg-amber-800 active:scale-95 text-white font-black text-xs sm:text-sm px-7 py-3.5 rounded-full shadow-2xl hover:shadow-amber-900/50 hover:-translate-y-0.5 transition-all flex items-center gap-2 group backdrop-blur-md"
        >
          <span>🛍️ Shop Curtains</span>
          <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
        </a>
        <a
          href="#bestsellers"
          class="bg-black/40 hover:bg-black/60 active:scale-95 text-white border border-white/30 font-bold text-xs sm:text-sm px-5 py-3.5 rounded-full shadow-lg backdrop-blur-md hover:-translate-y-0.5 transition-all"
        >
          <span>View Bestsellers</span>
        </a>
      </div>

      <!-- Minimal Size Badges -->
      <div class="hidden sm:flex items-center gap-2 bg-black/40 backdrop-blur-md border border-white/20 text-white text-[11px] font-semibold px-4 py-2 rounded-full shadow-lg">
        <span>📏 Available in 5 FT · 7 FT · 9 FT</span>
      </div>

    </div>

  </div>

</section>

<script>
  function initHeroVideo() {
    const video = document.getElementById('hero-bg-video') as HTMLVideoElement;
    const toggleBtn = document.getElementById('toggle-video-btn');
    const icon = document.getElementById('video-btn-icon');
    const text = document.getElementById('video-btn-text');

    if (!video || !toggleBtn) return;

    // Ensure video plays smoothly
    video.play().catch(() => {});

    toggleBtn.addEventListener('click', () => {
      if (video.paused) {
        video.play();
        if (icon) icon.textContent = '⏸️';
        if (text) text.textContent = 'Pause';
      } else {
        video.pause();
        if (icon) icon.textContent = '▶️';
        if (text) text.textContent = 'Play';
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroVideo);
  } else {
    initHeroVideo();
  }
</script>
