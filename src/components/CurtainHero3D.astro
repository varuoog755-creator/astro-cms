---
---

<section id="curtain-3d-hero" class="relative w-full h-[85vh] min-h-[600px] max-h-[900px] bg-slate-950 text-white overflow-hidden flex items-center justify-center select-none">
  
  <!-- 1. 3D WebGL Canvas Layer -->
  <div id="three-canvas-container" class="absolute inset-0 z-0 w-full h-full">
    <canvas id="curtain-webgl-canvas" class="w-full h-full block cursor-grab active:cursor-grabbing"></canvas>
  </div>

  <!-- Fallback Background for Non-WebGL / Pre-load -->
  <div
    id="hero-fallback-bg"
    class="absolute inset-0 z-0 bg-cover bg-center transition-opacity duration-1000 opacity-0 pointer-events-none"
    style="background-image: url('/images/3d/window-view.webp');"
  ></div>

  <!-- Subtle Lighting Vignettes (Leaves center clear for 3D focal point) -->
  <div class="absolute inset-0 z-[1] bg-gradient-to-t from-slate-950/90 via-transparent to-slate-950/50 pointer-events-none"></div>
  <div class="absolute inset-0 z-[1] bg-gradient-to-r from-slate-950/60 via-transparent to-slate-950/60 pointer-events-none"></div>

  <!-- 2. Minimalist Conversion UI (Clean & Non-Intrusive) -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full h-full flex flex-col justify-between py-8 sm:py-12 pointer-events-none">
    
    <!-- Top Header Pill -->
    <div class="flex items-center justify-between pointer-events-auto">
      <div class="inline-flex items-center gap-2 bg-slate-900/80 backdrop-blur-md border border-amber-500/30 text-amber-300 text-[11px] sm:text-xs font-black px-4 py-1.5 rounded-full uppercase tracking-wider shadow-xl">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Teepul 3D Experience · Panipat Mills</span>
      </div>

      <!-- Interactive Curtain Toggle Button -->
      <button
        type="button"
        id="toggle-curtain-btn"
        class="bg-black/60 hover:bg-black/80 active:scale-95 backdrop-blur-md text-white font-bold text-xs px-4 py-2 rounded-full border border-white/20 shadow-lg transition flex items-center gap-2 cursor-pointer"
        title="Click to Open/Close Curtains"
      >
        <span id="curtain-btn-icon">✨</span>
        <span id="curtain-btn-text">Open / Close</span>
      </button>
    </div>

    <!-- Bottom Center Call to Action -->
    <div class="max-w-2xl mx-auto text-center space-y-4 pt-20 pointer-events-auto">
      <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight drop-shadow-2xl">
        Touch &amp; Feel <span class="bg-gradient-to-r from-amber-300 via-amber-100 to-amber-400 bg-clip-text text-transparent">Luxury Fall</span>
      </h1>
      <p class="text-xs sm:text-sm text-slate-200 font-medium max-w-md mx-auto drop-shadow-md">
        150 GSM heavyweight room-darkening fabric with pre-fitted smooth glide eyelets.
      </p>

      <div class="flex items-center justify-center gap-3 pt-2">
        <a
          href="/products"
          class="bg-amber-500 hover:bg-amber-400 active:scale-95 text-slate-950 font-black text-xs sm:text-sm px-8 py-4 rounded-full shadow-2xl hover:shadow-amber-500/30 hover:-translate-y-0.5 transition-all flex items-center gap-2"
        >
          <span>🛍️ Shop Curtains</span>
          <span>&rarr;</span>
        </a>
        <a
          href="#bestsellers"
          class="bg-white/15 hover:bg-white/25 active:scale-95 backdrop-blur-md text-white border border-white/25 font-bold text-xs sm:text-sm px-6 py-4 rounded-full transition-all"
        >
          <span>Explore Catalog</span>
        </a>
      </div>

      <!-- Trust Bar -->
      <div class="flex items-center justify-center gap-6 pt-3 text-[11px] text-slate-300 font-semibold drop-shadow">
        <span>✓ Pack of 2 Panels</span>
        <span>✓ 85%+ Blackout</span>
        <span>✓ 5ft · 7ft · 9ft</span>
      </div>
    </div>

    <!-- Bottom Hint -->
    <div class="text-center text-[11px] text-slate-400 font-semibold pointer-events-auto">
      <span>👆 Drag or Click anywhere on curtains to open &amp; close</span>
    </div>

  </div>

</section>

<!-- 3D Three.js Engine -->
<script>
  import * as THREE from 'three';

  function init3DCurtainHero() {
    const canvas = document.getElementById('curtain-webgl-canvas') as HTMLCanvasElement;
    const container = document.getElementById('three-canvas-container');
    const fallback = document.getElementById('hero-fallback-bg');
    const toggleBtn = document.getElementById('toggle-curtain-btn');
    if (!canvas || !container) return;

    try {
      // 1. Scene & Camera Setup
      const scene = new THREE.Scene();
      scene.fog = new THREE.FogExp2(0x0a0f1d, 0.04);

      const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 50);
      camera.position.set(0, 0, 5.2);

      const renderer = new THREE.WebGLRenderer({
        canvas,
        alpha: true,
        antialias: true,
        powerPreference: 'high-performance'
      });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.15;

      const textureLoader = new THREE.TextureLoader();

      // 2. Textures Loading
      const fabricTex = textureLoader.load('/images/3d/fabric-texture.webp');
      fabricTex.wrapS = THREE.RepeatWrapping;
      fabricTex.wrapT = THREE.RepeatWrapping;
      fabricTex.repeat.set(4, 6);

      const windowTex = textureLoader.load('/images/3d/window-view.webp');
      const floorTex = textureLoader.load('/images/3d/floor-wood.webp');
      floorTex.wrapS = THREE.RepeatWrapping;
      floorTex.wrapT = THREE.RepeatWrapping;
      floorTex.repeat.set(4, 4);

      // 3. Realistic Lighting
      const ambientLight = new THREE.AmbientLight(0xfffaed, 0.9);
      scene.add(ambientLight);

      // Warm Daylight streaming through window
      const sunLight = new THREE.DirectionalLight(0xfff3d6, 3.2);
      sunLight.position.set(2.5, 3.5, -2);
      sunLight.castShadow = true;
      sunLight.shadow.mapSize.set(1024, 1024);
      sunLight.shadow.bias = -0.0003;
      scene.add(sunLight);

      // Front Camera Fill Light
      const fillLight = new THREE.DirectionalLight(0xe2e8f0, 0.8);
      fillLight.position.set(-2, 1.5, 4);
      scene.add(fillLight);

      // 4. Room Environment (Window, Walls, Rod, Floor)
      const roomGroup = new THREE.Group();

      // Golden Brass Rod
      const rodMat = new THREE.MeshStandardMaterial({
        color: 0xcca041,
        roughness: 0.22,
        metalness: 0.88
      });
      const rod = new THREE.Mesh(new THREE.CylinderGeometry(0.038, 0.038, 7.8, 32), rodMat);
      rod.rotation.z = Math.PI / 2;
      rod.position.set(0, 2.5, 0);
      rod.castShadow = true;
      roomGroup.add(rod);

      // Rod Finials
      const finialGeo = new THREE.SphereGeometry(0.09, 24, 24);
      const finialL = new THREE.Mesh(finialGeo, rodMat);
      finialL.position.set(-3.95, 2.5, 0);
      const finialR = new THREE.Mesh(finialGeo, rodMat);
      finialR.position.set(3.95, 2.5, 0);
      roomGroup.add(finialL, finialR);

      // High-Res Window Backdrop
      const winGeo = new THREE.PlaneGeometry(7.2, 5.2);
      const winMat = new THREE.MeshBasicMaterial({ map: windowTex });
      const win = new THREE.Mesh(winGeo, winMat);
      win.position.set(0, 0.1, -0.3);
      roomGroup.add(win);

      // Window Frame & Mullions
      const trimMat = new THREE.MeshStandardMaterial({ color: 0x1e293b, roughness: 0.7 });
      const mullionV = new THREE.Mesh(new THREE.BoxGeometry(0.08, 5.2, 0.06), trimMat);
      mullionV.position.set(0, 0.1, -0.22);
      const mullionH = new THREE.Mesh(new THREE.BoxGeometry(7.2, 0.08, 0.06), trimMat);
      mullionH.position.set(0, 0.1, -0.22);
      roomGroup.add(mullionV, mullionH);

      // Floor
      const floorMat = new THREE.MeshStandardMaterial({ map: floorTex, roughness: 0.5, metalness: 0.1 });
      const floor = new THREE.Mesh(new THREE.PlaneGeometry(12, 8), floorMat);
      floor.rotation.x = -Math.PI / 2;
      floor.position.set(0, -2.5, 1.5);
      floor.receiveShadow = true;
      roomGroup.add(floor);

      scene.add(roomGroup);

      // 5. Parametric High-Density Pleated Curtains
      const eyeletRingGeo = new THREE.TorusGeometry(0.065, 0.012, 16, 24);
      const eyeletRingMat = new THREE.MeshStandardMaterial({ color: 0xe2e8f0, roughness: 0.2, metalness: 0.95 });

      function createCurtainPanel(side: 'left' | 'right') {
        const width = 3.6;
        const height = 5.0;
        const segX = 64;
        const segY = 64;

        const geo = new THREE.PlaneGeometry(width, height, segX, segY);
        const pos = geo.attributes.position;
        const orig = new Float32Array(pos.count * 3);

        // Apply deep S-curve architectural pleats
        for (let i = 0; i < pos.count; i++) {
          const u = (pos.getX(i) + width / 2) / width;
          const pleatZ = Math.sin(u * Math.PI * 16) * 0.18;
          pos.setZ(i, pos.getZ(i) + pleatZ);

          orig[i * 3] = pos.getX(i);
          orig[i * 3 + 1] = pos.getY(i);
          orig[i * 3 + 2] = pos.getZ(i);
        }
        geo.computeVertexNormals();

        // Velvet Terracotta PBR Fabric Material
        const mat = new THREE.MeshStandardMaterial({
          map: fabricTex,
          color: 0x853020,
          roughness: 0.92,
          metalness: 0.02,
          side: THREE.DoubleSide
        });

        const mesh = new THREE.Mesh(geo, mat);
        mesh.position.set(side === 'left' ? -1.8 : 1.8, 0, 0);
        mesh.castShadow = true;
        mesh.receiveShadow = true;

        // Create 8 sliding Eyelet rings
        const rings: THREE.Mesh[] = [];
        const ringCount = 8;
        for (let r = 0; r < ringCount; r++) {
          const ring = new THREE.Mesh(eyeletRingGeo, eyeletRingMat);
          ring.rotation.y = Math.PI / 2;
          ring.position.set(0, 2.5, 0);
          ring.castShadow = true;
          scene.add(ring);
          rings.push(ring);
        }

        return { mesh, geo, orig, side, width, height, rings, ringCount };
      }

      const leftCurtain = createCurtainPanel('left');
      const rightCurtain = createCurtainPanel('right');
      scene.add(leftCurtain.mesh);
      scene.add(rightCurtain.mesh);

      // 6. Interactive State & Animation
      let openProgress = 0.0; // 0 = Closed together, 1 = Fully open
      let targetProgress = 0.78; // Start closed, glide open on load
      let isDragging = false;
      let startMouseX = 0;
      let startProgress = 0;

      // Opening trigger on load with slight delay
      setTimeout(() => {
        targetProgress = 0.82;
      }, 400);

      // Toggle Button Handler
      if (toggleBtn) {
        toggleBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          targetProgress = targetProgress > 0.4 ? 0.05 : 0.85;
        });
      }

      // Drag / Click anywhere to open / close curtains
      canvas.addEventListener('pointerdown', (e) => {
        isDragging = true;
        startMouseX = e.clientX;
        startProgress = openProgress;
      });

      window.addEventListener('pointermove', (e) => {
        if (isDragging) {
          const diffX = Math.abs(e.clientX - startMouseX);
          const factor = diffX / (window.innerWidth * 0.35);
          targetProgress = Math.max(0.05, Math.min(0.92, targetProgress > 0.5 ? 0.85 - factor : 0.05 + factor));
        }
      });

      window.addEventListener('pointerup', () => {
        if (isDragging) {
          isDragging = false;
        }
      });

      canvas.addEventListener('click', () => {
        targetProgress = targetProgress > 0.45 ? 0.08 : 0.84;
      });

      // Mouse Parallax Damping
      const mouse = { x: 0, y: 0, targetX: 0, targetY: 0 };
      window.addEventListener('mousemove', (e) => {
        mouse.targetX = (e.clientX / window.innerWidth) * 2 - 1;
        mouse.targetY = -(e.clientY / window.innerHeight) * 2 + 1;
      }, { passive: true });

      // Resize Handler
      window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
      });

      // 7. 60 FPS Render Loop
      const clock = new THREE.Clock();

      function animate() {
        requestAnimationFrame(animate);

        const delta = clock.getDelta();
        const elapsed = clock.getElapsedTime();

        // Smooth curtain opening interpolation
        openProgress += (targetProgress - openProgress) * 0.045;

        // Camera Parallax
        mouse.x += (mouse.targetX - mouse.x) * 0.05;
        mouse.y += (mouse.targetY - mouse.y) * 0.05;
        camera.position.x = mouse.x * 0.3;
        camera.position.y = mouse.y * 0.15;
        camera.lookAt(0, 0.1, 0);

        // Adjust sunlight intensity as curtains open
        sunLight.intensity = 1.0 + openProgress * 2.4;

        // Update Cloth Physics and Eyelet Rings
        [leftCurtain, rightCurtain].forEach((c) => {
          const pos = c.geo.attributes.position;
          const orig = c.orig;
          const compression = THREE.MathUtils.lerp(1.0, 0.28, openProgress);
          const gatherOffset = c.side === 'left' ? -1.62 * openProgress : 1.62 * openProgress;

          for (let i = 0; i < pos.count; i++) {
            const origX = orig[i * 3];
            const origY = orig[i * 3 + 1];
            const origZ = orig[i * 3 + 2];

            const normY = (origY + 2.5) / 5.0;
            const hangWeight = Math.sin((1 - normY) * Math.PI * 0.5);

            // Realistic breeze flutter
            const breeze = Math.sin(elapsed * 2.0 + origY * 1.3 + origX * 2.0) * 0.04 * hangWeight;
            const ripple = Math.cos(elapsed * 2.8 + origX * 3.5) * 0.02 * hangWeight;

            let targetX = origX * compression;
            if (c.side === 'left') {
              targetX = (origX + c.width / 2) * compression - c.width / 2 + gatherOffset;
            } else {
              targetX = (origX - c.width / 2) * compression + c.width / 2 + gatherOffset;
            }

            pos.setX(i, targetX);
            pos.setY(i, origY);
            pos.setZ(i, origZ + breeze + ripple);
          }

          pos.needsUpdate = true;
          c.geo.computeVertexNormals();

          // Slide Eyelet Rings along Rod
          const baseLeft = c.side === 'left' ? -1.8 + gatherOffset - (c.width * compression * 0.5) : 1.8 + gatherOffset - (c.width * compression * 0.5);
          const stepX = (c.width * compression) / (c.ringCount - 1);

          c.rings.forEach((ring, rIdx) => {
            ring.position.x = baseLeft + rIdx * stepX;
            ring.position.z = Math.sin((rIdx / c.ringCount) * Math.PI * 8) * 0.05;
          });
        });

        renderer.render(scene, camera);
      }

      animate();
    } catch (err) {
      console.warn('WebGL initialization error:', err);
      if (fallback) fallback.style.opacity = '1';
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init3DCurtainHero);
  } else {
    init3DCurtainHero();
  }
</script>
