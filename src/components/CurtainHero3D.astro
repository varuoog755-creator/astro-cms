---
---

<section id="curtain-hero-banner" class="relative w-full h-[78vh] min-h-[560px] max-h-[820px] bg-stone-900 text-slate-900 overflow-hidden flex items-center justify-center select-none border-b border-slate-200/80">
  
  <!-- 1. Background Video Layer (Watermark Cleaned & Ultra Fast Streaming) -->
  <div class="absolute inset-0 z-0 w-full h-full overflow-hidden">
    <video
      id="hero-bg-video"
      autoplay
      loop
      muted
      playsinline
      poster="/videos/hero_curtain_poster.webp"
      preload="auto"
      class="w-full h-full object-cover object-center scale-[1.01] transform transition-transform duration-700"
    >
      <source src="/videos/hero_curtain_video.mp4" type="video/mp4" />
    </video>
  </div>

  <!-- 2. Minimalist Conversion UI Overlay (No heavy dark overlays or milky wash) -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full h-full flex flex-col justify-between py-6 sm:py-10 pointer-events-none">
    
    <!-- Top Minimalist Pill & Interactive Video Controls -->
    <div class="flex items-center justify-between pointer-events-auto">
      <div class="inline-flex items-center gap-2 bg-white/95 backdrop-blur-md border border-slate-200 text-amber-900 text-[11px] sm:text-xs font-black px-3.5 py-1.5 rounded-full uppercase tracking-wider shadow-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Panipat Direct · 150 GSM Drapes</span>
      </div>

      <!-- Play / Pause Video Pill -->
      <button
        type="button"
        id="toggle-video-btn"
        class="bg-white/95 hover:bg-white active:scale-95 backdrop-blur-md text-slate-800 font-bold text-xs px-4 py-2 rounded-full border border-slate-200 shadow-sm transition flex items-center gap-2 cursor-pointer hover:border-amber-400"
        title="Play / Pause Video"
      >
        <span id="video-btn-icon">⏸️</span>
        <span id="video-btn-text">Pause</span>
      </button>
    </div>

    <!-- Center-Left Clean Copy & CTA -->
    <div class="max-w-xl text-left space-y-4 pt-10 sm:pt-14 pointer-events-auto">
      <div class="inline-block bg-white/85 backdrop-blur-md px-3.5 py-1.5 rounded-lg border border-slate-200/80 text-xs font-bold text-amber-900 shadow-xs">
        🏷️ Factory Direct Starting at ₹499/Pair
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-[1.12] drop-shadow-xs">
        Room ka look <span class="text-amber-800 underline decoration-amber-300 decoration-wavy decoration-2">dull lag raha hai?</span>
      </h1>
      
      <p class="text-xs sm:text-base text-slate-700 font-semibold leading-relaxed max-w-lg bg-white/70 backdrop-blur-xs p-2 rounded-lg inline-block">
        Upgrade to Panipat factory-direct luxury curtains. Heavyweight <strong>85%+ room-darkening fabric</strong>, pre-fitted anti-rust grommets, and flawless drape fall.
      </p>

      <!-- Clean Action Buttons -->
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href="/products"
          class="bg-amber-800 hover:bg-amber-900 active:scale-95 text-white font-black text-xs sm:text-sm px-8 py-4 rounded-full shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all flex items-center gap-2 group"
        >
          <span>🛍️ Shop Curtains</span>
          <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
        </a>
        <a
          href="#bestsellers"
          class="bg-white/95 hover:bg-white active:scale-95 text-slate-900 border border-slate-300 font-bold text-xs sm:text-sm px-6 py-4 rounded-full shadow-xs hover:-translate-y-0.5 transition-all"
        >
          <span>Explore Catalog</span>
        </a>
      </div>

      <!-- Trust Badges -->
      <div class="flex flex-wrap items-center gap-4 sm:gap-6 pt-3 text-[11px] text-slate-800 font-bold bg-white/80 backdrop-blur-md p-2.5 rounded-xl border border-slate-200/80 w-fit">
        <span class="flex items-center gap-1.5"><strong class="text-slate-900 font-black">Pack of 2</strong> Included</span>
        <span class="flex items-center gap-1.5"><strong class="text-amber-800 font-black">85%+</strong> Blackout</span>
        <span class="flex items-center gap-1.5"><strong class="text-emerald-700 font-black">★ 4.9</strong> (10k+ Homes)</span>
      </div>
    </div>

    <!-- Bottom Minimalist Prompt -->
    <div class="flex items-center justify-between text-[11px] text-slate-700 font-bold bg-white/80 backdrop-blur-md px-3 py-1.5 rounded-lg border border-slate-200/80 w-fit pointer-events-auto">
      <span>✨ 100% Factory Direct Finish</span>
      <span class="ml-4 hidden sm:inline-block">5ft · 7ft · 9ft Standard Sizes</span>
    </div>

  </div>

</section>

<script>
  function initHeroVideo() {
    const video = document.getElementById('hero-bg-video') as HTMLVideoElement;
    const toggleBtn = document.getElementById('toggle-video-btn');
    const icon = document.getElementById('video-btn-icon');
    const text = document.getElementById('video-btn-text');

    if (!video || !toggleBtn) return;

    // Ensure video plays smoothly
    video.play().catch(() => {
      // Autoplay with sound might be blocked; already muted
    });

    toggleBtn.addEventListener('click', () => {
      if (video.paused) {
        video.play();
        if (icon) icon.textContent = '⏸️';
        if (text) text.textContent = 'Pause';
      } else {
        video.pause();
        if (icon) icon.textContent = '▶️';
        if (text) text.textContent = 'Play';
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroVideo);
  } else {
    initHeroVideo();
  }
</script>
