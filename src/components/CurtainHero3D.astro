<section id="curtain-3d-hero" class="relative w-full h-[82vh] min-h-[580px] max-h-[850px] bg-[#FAF8F5] text-slate-900 overflow-hidden flex items-center justify-center select-none border-b border-slate-200/80">
  
  <!-- 1. 3D WebGL Canvas Layer -->
  <div id="three-canvas-container" class="absolute inset-0 z-0 w-full h-full">
    <canvas id="curtain-webgl-canvas" class="w-full h-full block cursor-grab active:cursor-grabbing"></canvas>
  </div>

  <!-- Fallback Background for Pre-load / Mobile -->
  <div
    id="hero-fallback-bg"
    class="absolute inset-0 z-0 bg-cover bg-center transition-opacity duration-1000 opacity-0 pointer-events-none"
    style="background-image: url('/images/3d/daylight-window.webp');"
  ></div>

  <!-- 2. Minimalist Conversion UI Overlay -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full h-full flex flex-col justify-between py-6 sm:py-10 pointer-events-none">
    
    <!-- Top Minimalist Pill & Interactive Video-Style Controls -->
    <div class="flex items-center justify-between pointer-events-auto">
      <div class="inline-flex items-center gap-2 bg-white/90 backdrop-blur-md border border-slate-200 text-amber-900 text-[11px] sm:text-xs font-black px-3.5 py-1.5 rounded-full uppercase tracking-wider shadow-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Panipat Direct · 150 GSM Drapes</span>
      </div>

      <!-- Play / Replay Animation Pill -->
      <button
        type="button"
        id="toggle-curtain-btn"
        class="bg-white/90 hover:bg-white active:scale-95 backdrop-blur-md text-slate-800 font-bold text-xs px-4 py-2 rounded-full border border-slate-200 shadow-sm transition flex items-center gap-2 cursor-pointer hover:border-amber-400"
        title="Click to Open or Close Curtains"
      >
        <span id="curtain-btn-icon">✨</span>
        <span id="curtain-btn-text">Open / Close</span>
      </button>
    </div>

    <!-- Center-Left Clean Copy & CTA -->
    <div class="max-w-xl text-left space-y-4 pt-12 sm:pt-16 pointer-events-auto">
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-[1.12]">
        Room ka look <span class="text-amber-800 underline decoration-amber-300 decoration-wavy decoration-2">dull lag raha hai?</span>
      </h1>
      
      <p class="text-xs sm:text-base text-slate-600 font-medium leading-relaxed max-w-lg">
        Upgrade to Panipat factory-direct luxury curtains. Heavyweight <strong>85%+ room-darkening fabric</strong>, pre-fitted anti-rust grommets, and flawless drape fall.
      </p>

      <!-- Clean Action Buttons -->
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href="/products"
          class="bg-amber-800 hover:bg-amber-900 active:scale-95 text-white font-black text-xs sm:text-sm px-8 py-4 rounded-full shadow-lg hover:shadow-xl hover:-translate-y-0.5 transition-all flex items-center gap-2 group"
        >
          <span>🛍️ Shop Curtains</span>
          <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
        </a>
        <a
          href="#bestsellers"
          class="bg-white hover:bg-slate-50 active:scale-95 text-slate-900 border border-slate-300 font-bold text-xs sm:text-sm px-6 py-4 rounded-full shadow-xs hover:-translate-y-0.5 transition-all"
        >
          <span>Explore Catalog</span>
        </a>
      </div>

      <!-- Trust Badges -->
      <div class="flex flex-wrap items-center gap-4 sm:gap-6 pt-3 text-[11px] text-slate-600 font-semibold border-t border-slate-200/70">
        <span class="flex items-center gap-1.5"><strong class="text-slate-900 font-black">Pack of 2</strong> Included</span>
        <span class="flex items-center gap-1.5"><strong class="text-amber-800 font-black">85%+</strong> Blackout</span>
        <span class="flex items-center gap-1.5"><strong class="text-emerald-700 font-black">★ 4.9</strong> (10k+ Homes)</span>
      </div>
    </div>

    <!-- Bottom Minimalist Prompt -->
    <div class="flex items-center justify-between text-[11px] text-slate-500 font-semibold pointer-events-auto">
      <span>👆 Click or Drag anywhere to open &amp; close</span>
      <span class="hidden sm:inline-block">5ft · 7ft · 9ft Standard Sizes</span>
    </div>

  </div>

</section>

<!-- 3D Three.js Client Engine -->
<script>
  import * as THREE from 'three';

  function init3DCurtainHero() {
    const canvas = document.getElementById('curtain-webgl-canvas') as HTMLCanvasElement;
    const container = document.getElementById('three-canvas-container');
    const fallback = document.getElementById('hero-fallback-bg');
    const toggleBtn = document.getElementById('toggle-curtain-btn');
    if (!canvas || !container) return;

    try {
      // 1. Scene & Camera Setup (Bright Daylight Interior)
      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0xfaf8f5);

      const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 50);
      camera.position.set(0.6, 0.1, 5.2);

      const renderer = new THREE.WebGLRenderer({
        canvas,
        alpha: false,
        antialias: true,
        powerPreference: 'high-performance'
      });
      renderer.setSize(window.innerWidth, window.innerHeight);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.05;

      const textureLoader = new THREE.TextureLoader();

      // 2. Texture Assets
      const fabricTex = textureLoader.load('/images/3d/fabric-texture.webp');
      fabricTex.wrapS = THREE.RepeatWrapping;
      fabricTex.wrapT = THREE.RepeatWrapping;
      fabricTex.repeat.set(4, 6);

      const windowTex = textureLoader.load('/images/3d/daylight-window.webp');
      const floorTex = textureLoader.load('/images/3d/light-oak-floor.webp');
      floorTex.wrapS = THREE.RepeatWrapping;
      floorTex.wrapT = THREE.RepeatWrapping;
      floorTex.repeat.set(3, 3);

      // 3. Bright Natural Daylight Lighting
      const ambientLight = new THREE.AmbientLight(0xfffbf2, 1.4);
      scene.add(ambientLight);

      // Main Sunbeam streaming through window
      const sunLight = new THREE.DirectionalLight(0xfff5e4, 2.6);
      sunLight.position.set(2.8, 3.8, -2.0);
      sunLight.castShadow = true;
      sunLight.shadow.mapSize.set(1024, 1024);
      sunLight.shadow.bias = -0.0002;
      scene.add(sunLight);

      // Soft Daylight Bounce
      const bounceLight = new THREE.DirectionalLight(0xe8f0fe, 0.9);
      bounceLight.position.set(-2.5, 2.0, 3.5);
      scene.add(bounceLight);

      // 4. Bright Architectural Room Backdrop
      const roomGroup = new THREE.Group();

      // Champagne Brushed Gold Rod
      const rodMat = new THREE.MeshStandardMaterial({
        color: 0xd6b265,
        roughness: 0.28,
        metalness: 0.85
      });
      const rod = new THREE.Mesh(new THREE.CylinderGeometry(0.036, 0.036, 7.6, 32), rodMat);
      rod.rotation.z = Math.PI / 2;
      rod.position.set(0, 2.5, 0);
      rod.castShadow = true;
      roomGroup.add(rod);

      // Rod Finials
      const finialGeo = new THREE.SphereGeometry(0.085, 24, 24);
      const finialL = new THREE.Mesh(finialGeo, rodMat);
      finialL.position.set(-3.85, 2.5, 0);
      const finialR = new THREE.Mesh(finialGeo, rodMat);
      finialR.position.set(3.85, 2.5, 0);
      roomGroup.add(finialL, finialR);

      // Daylight Window View Outside
      const winGeo = new THREE.PlaneGeometry(7.2, 5.2);
      const winMat = new THREE.MeshBasicMaterial({ map: windowTex });
      const win = new THREE.Mesh(winGeo, winMat);
      win.position.set(0, 0.1, -0.3);
      roomGroup.add(win);

      // Sleek Window Frame
      const frameMat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.8 });
      const mullionV = new THREE.Mesh(new THREE.BoxGeometry(0.06, 5.2, 0.05), frameMat);
      mullionV.position.set(0, 0.1, -0.22);
      const mullionH = new THREE.Mesh(new THREE.BoxGeometry(7.2, 0.06, 0.05), frameMat);
      mullionH.position.set(0, 0.1, -0.22);
      roomGroup.add(mullionV, mullionH);

      // Light Blonde Oak Flooring
      const floorMat = new THREE.MeshStandardMaterial({ map: floorTex, roughness: 0.6, metalness: 0.05 });
      const floor = new THREE.Mesh(new THREE.PlaneGeometry(12, 8), floorMat);
      floor.rotation.x = -Math.PI / 2;
      floor.position.set(0, -2.5, 1.5);
      floor.receiveShadow = true;
      roomGroup.add(floor);

      // Left & Right Warm Cream Walls
      const wallMat = new THREE.MeshStandardMaterial({ color: 0xf5f2eb, roughness: 0.95 });
      const wallL = new THREE.Mesh(new THREE.PlaneGeometry(6, 6), wallMat);
      wallL.rotation.y = Math.PI / 2;
      wallL.position.set(-4.2, 0.5, 1);
      const wallR = new THREE.Mesh(new THREE.PlaneGeometry(6, 6), wallMat);
      wallR.rotation.y = -Math.PI / 2;
      wallR.position.set(4.2, 0.5, 1);
      roomGroup.add(wallL, wallR);

      scene.add(roomGroup);

      // 5. Parametric High-Density Pleated Curtains
      const eyeletRingGeo = new THREE.TorusGeometry(0.062, 0.011, 16, 24);
      const eyeletRingMat = new THREE.MeshStandardMaterial({ color: 0xd6b265, roughness: 0.25, metalness: 0.85 });

      function createCurtainPanel(side: 'left' | 'right') {
        const width = 3.6;
        const height = 5.0;
        const segX = 64;
        const segY = 64;

        const geo = new THREE.PlaneGeometry(width, height, segX, segY);
        const pos = geo.attributes.position;
        const orig = new Float32Array(pos.count * 3);

        // Apply deep S-fold pleat curves
        for (let i = 0; i < pos.count; i++) {
          const u = (pos.getX(i) + width / 2) / width;
          const pleatZ = Math.sin(u * Math.PI * 16) * 0.17;
          pos.setZ(i, pos.getZ(i) + pleatZ);

          orig[i * 3] = pos.getX(i);
          orig[i * 3 + 1] = pos.getY(i);
          orig[i * 3 + 2] = pos.getZ(i);
        }
        geo.computeVertexNormals();

        // Elegant Warm Terracotta/Caramel PBR Material
        const mat = new THREE.MeshStandardMaterial({
          map: fabricTex,
          color: 0x934330, // Rich warm terracotta
          roughness: 0.88,
          metalness: 0.02,
          side: THREE.DoubleSide
        });

        const mesh = new THREE.Mesh(geo, mat);
        mesh.position.set(side === 'left' ? -1.8 : 1.8, 0, 0);
        mesh.castShadow = true;
        mesh.receiveShadow = true;

        // Sliding Eyelet rings on rod
        const rings: THREE.Mesh[] = [];
        const ringCount = 8;
        for (let r = 0; r < ringCount; r++) {
          const ring = new THREE.Mesh(eyeletRingGeo, eyeletRingMat);
          ring.rotation.y = Math.PI / 2;
          ring.position.set(0, 2.5, 0);
          ring.castShadow = true;
          scene.add(ring);
          rings.push(ring);
        }

        return { mesh, geo, orig, side, width, height, rings, ringCount };
      }

      const leftCurtain = createCurtainPanel('left');
      const rightCurtain = createCurtainPanel('right');
      scene.add(leftCurtain.mesh);
      scene.add(rightCurtain.mesh);

      // 6. Smooth Video-Like Cinematic Motion
      let openProgress = 0.0;
      let targetProgress = 0.80; // Starts closed, opens gracefully
      let isDragging = false;
      let startMouseX = 0;

      setTimeout(() => {
        targetProgress = 0.82;
      }, 350);

      // Interactive Toggle Button
      if (toggleBtn) {
        toggleBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          targetProgress = targetProgress > 0.4 ? 0.06 : 0.84;
        });
      }

      // Drag / Tap Controls
      canvas.addEventListener('pointerdown', (e) => {
        isDragging = true;
        startMouseX = e.clientX;
      });

      window.addEventListener('pointermove', (e) => {
        if (isDragging) {
          const diffX = Math.abs(e.clientX - startMouseX);
          const factor = diffX / (window.innerWidth * 0.35);
          targetProgress = Math.max(0.05, Math.min(0.92, targetProgress > 0.5 ? 0.85 - factor : 0.05 + factor));
        }
      });

      window.addEventListener('pointerup', () => {
        isDragging = false;
      });

      canvas.addEventListener('click', () => {
        targetProgress = targetProgress > 0.45 ? 0.08 : 0.84;
      });

      // Mouse Parallax Damping
      const mouse = { x: 0, y: 0, targetX: 0, targetY: 0 };
      window.addEventListener('mousemove', (e) => {
        mouse.targetX = (e.clientX / window.innerWidth) * 2 - 1;
        mouse.targetY = -(e.clientY / window.innerHeight) * 2 + 1;
      }, { passive: true });

      // Resize Handler
      window.addEventListener('resize', () => {
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
      });

      // 7. 60 FPS Render Loop
      const clock = new THREE.Clock();

      function animate() {
        requestAnimationFrame(animate);

        const delta = clock.getDelta();
        const elapsed = clock.getElapsedTime();

        // Smooth video-like easing
        openProgress += (targetProgress - openProgress) * 0.04;

        // Camera Parallax & Zoom
        mouse.x += (mouse.targetX - mouse.x) * 0.05;
        mouse.y += (mouse.targetY - mouse.y) * 0.05;
        camera.position.x = 0.6 + mouse.x * 0.3;
        camera.position.y = 0.1 + mouse.y * 0.15;
        camera.lookAt(0.2, 0.1, 0);

        // Update Cloth Physics and Eyelet Rings
        [leftCurtain, rightCurtain].forEach((c) => {
          const pos = c.geo.attributes.position;
          const orig = c.orig;
          const compression = THREE.MathUtils.lerp(1.0, 0.28, openProgress);
          const gatherOffset = c.side === 'left' ? -1.62 * openProgress : 1.62 * openProgress;

          for (let i = 0; i < pos.count; i++) {
            const origX = orig[i * 3];
            const origY = orig[i * 3 + 1];
            const origZ = orig[i * 3 + 2];

            const normY = (origY + 2.5) / 5.0;
            const hangWeight = Math.sin((1 - normY) * Math.PI * 0.5);

            // Gentle natural wave
            const breeze = Math.sin(elapsed * 1.8 + origY * 1.2 + origX * 2.0) * 0.035 * hangWeight;
            const ripple = Math.cos(elapsed * 2.5 + origX * 3.2) * 0.015 * hangWeight;

            let targetX = origX * compression;
            if (c.side === 'left') {
              targetX = (origX + c.width / 2) * compression - c.width / 2 + gatherOffset;
            } else {
              targetX = (origX - c.width / 2) * compression + c.width / 2 + gatherOffset;
            }

            pos.setX(i, targetX);
            pos.setY(i, origY);
            pos.setZ(i, origZ + breeze + ripple);
          }

          pos.needsUpdate = true;
          c.geo.computeVertexNormals();

          // Move eyelet rings smoothly on rod
          const baseLeft = c.side === 'left' ? -1.8 + gatherOffset - (c.width * compression * 0.5) : 1.8 + gatherOffset - (c.width * compression * 0.5);
          const stepX = (c.width * compression) / (c.ringCount - 1);

          c.rings.forEach((ring, rIdx) => {
            ring.position.x = baseLeft + rIdx * stepX;
            ring.position.z = Math.sin((rIdx / c.ringCount) * Math.PI * 8) * 0.04;
          });
        });

        renderer.render(scene, camera);
      }

      animate();
    } catch (err) {
      console.warn('WebGL initialization error:', err);
      if (fallback) fallback.style.opacity = '1';
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init3DCurtainHero);
  } else {
    init3DCurtainHero();
  }
</script>
