---
// CartDrawer.astro - High-converting Right Slide-over Cart Drawer
---

<!-- Cart Drawer Backdrop Overlay -->
<div
  id="cart-drawer-backdrop"
  class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-50 transition-opacity duration-300 opacity-0 pointer-events-none"
  aria-hidden="true"
></div>

<!-- Cart Slide-over Panel (Slides in from Right) -->
<aside
  id="cart-drawer"
  class="fixed inset-y-0 right-0 max-w-md w-full bg-white shadow-2xl z-50 transform translate-x-full transition-transform duration-300 ease-out flex flex-col pointer-events-none"
  aria-labelledby="cart-drawer-title"
  role="dialog"
  aria-modal="true"
>
  <!-- Drawer Header -->
  <div class="p-5 border-b border-slate-100 flex items-center justify-between bg-slate-50/90">
    <div class="flex items-center gap-2.5">
      <span class="text-2xl">🛒</span>
      <div>
        <h2 id="cart-drawer-title" class="font-black text-slate-900 text-base leading-tight">
          Your Shopping Cart
        </h2>
        <div class="flex items-center gap-1.5 mt-0.5">
          <span id="drawer-item-count" class="text-[11px] font-extrabold text-amber-800 bg-amber-100 px-2 py-0.5 rounded-full">
            0 Items
          </span>
          <span class="text-[11px] text-slate-400 font-medium">Teepul Curtain Store</span>
        </div>
      </div>
    </div>
    
    <button
      id="cart-drawer-close"
      type="button"
      class="w-9 h-9 rounded-full bg-slate-200/80 hover:bg-slate-300 text-slate-700 flex items-center justify-center font-bold text-sm transition focus:outline-none focus:ring-2 focus:ring-amber-800 cursor-pointer"
      title="Close Cart (Esc)"
      aria-label="Close Cart"
    >
      ✕
    </button>
  </div>

  <!-- Free All-India Shipping Progress Banner -->
  <div class="bg-gradient-to-r from-emerald-600 to-teal-700 text-white px-3.5 py-2 sm:px-5 sm:py-2.5 flex items-center justify-between gap-2 text-[11px] sm:text-xs font-bold shadow-sm whitespace-nowrap overflow-hidden">
    <div class="flex items-center gap-1.5 truncate">
      <span class="text-xs sm:text-sm shrink-0">🚚</span>
      <span class="truncate">Free Delivery Unlocked Across India</span>
    </div>
    <span class="bg-white/20 text-white text-[9px] sm:text-[10px] font-black px-2 py-0.5 rounded-full uppercase shrink-0 whitespace-nowrap">
      4-7 Days
    </span>
  </div>

  <!-- Dynamic Cart Items Container (Scrollable) -->
  <div id="drawer-items-list" class="flex-1 overflow-y-auto p-5 space-y-4 divide-y divide-slate-100">
    <!-- Populated dynamically via JavaScript -->
  </div>

  <!-- Empty Cart View -->
  <div id="drawer-empty-view" class="hidden flex-1 flex flex-col items-center justify-center p-8 text-center space-y-4">
    <div class="w-20 h-20 bg-amber-50 rounded-full flex items-center justify-center text-4xl shadow-inner border border-amber-200/60">
      🛍️
    </div>
    <div class="space-y-1">
      <h3 class="font-extrabold text-slate-900 text-lg">Your Cart is Empty</h3>
      <p class="text-xs text-slate-500 max-w-xs leading-relaxed">
        Looks like you haven't added any premium curtains to your cart yet. Explore our 5ft, 7ft & 9ft collection!
      </p>
    </div>
    <a
      href="/products"
      onclick="window.closeCartDrawer?.()"
      class="bg-slate-900 hover:bg-amber-800 text-white font-extrabold text-xs px-6 py-3.5 rounded-2xl shadow-lg transition duration-200"
    >
      Explore Curtains Catalog &rarr;
    </a>
  </div>

  <!-- Drawer Footer (Order Summary & Checkout Button) -->
  <div id="drawer-footer" class="border-t border-slate-200 p-5 bg-slate-50 space-y-4 shadow-[0_-4px_20px_rgba(0,0,0,0.05)]">
    <!-- Price Breakdown -->
    <div class="space-y-1.5 text-xs">
      <div class="flex justify-between text-slate-600">
        <span class="font-medium">Cart Subtotal</span>
        <span id="drawer-subtotal" class="font-bold text-slate-900">₹0</span>
      </div>
      <div class="flex justify-between text-slate-600">
        <span class="font-medium">All-India Express Delivery</span>
        <span class="font-black text-emerald-600 uppercase tracking-wide">FREE</span>
      </div>
      <div class="flex justify-between text-slate-600">
        <span class="font-medium">GST & Taxes</span>
        <span class="text-slate-400 font-medium">Included in MRP</span>
      </div>
      <div class="border-t border-slate-200 pt-2 flex justify-between items-center text-sm font-black text-slate-900">
        <span class="text-slate-900 font-extrabold">Total Payable</span>
        <span id="drawer-total" class="text-amber-800 text-lg font-black">₹0</span>
      </div>
    </div>

    <!-- Proceed to Checkout Primary Button -->
    <button
      id="drawer-checkout-btn"
      type="button"
      class="w-full bg-slate-900 hover:bg-slate-800 active:scale-[0.99] text-white font-bold text-sm py-3.5 rounded-xl shadow-xs transition flex items-center justify-center gap-2 cursor-pointer"
    >
      <span>🔒 Proceed to Checkout &rarr;</span>
    </button>

    <!-- Trust Badges -->
    <div class="flex items-center justify-center gap-4 text-[10px] text-slate-500 font-medium pt-1">
      <span class="flex items-center gap-1">🛡️ 100% Safe Pay</span>
      <span class="flex items-center gap-1">💵 Cash on Delivery</span>
      <span class="flex items-center gap-1">⚡ 7-Day Returns</span>
    </div>
  </div>
</aside>

<script is:inline>
  (function () {
    function getCart() {
      try {
        return JSON.parse(localStorage.getItem('teepul_cart') || '[]');
      } catch (e) {
        return [];
      }
    }

    function saveCart(cart) {
      try {
        localStorage.setItem('teepul_cart', JSON.stringify(cart));
      } catch (e) {}
      if (typeof window.updateCartBadge === 'function') {
        window.updateCartBadge();
      }
    }

    // Open Cart Drawer (slides smoothly from right)
    window.openCartDrawer = function () {
      const backdrop = document.getElementById('cart-drawer-backdrop');
      const drawer = document.getElementById('cart-drawer');
      window.renderCartDrawer();
      if (backdrop && drawer) {
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
        backdrop.classList.add('opacity-100', 'pointer-events-auto');

        drawer.classList.remove('translate-x-full', 'pointer-events-none');
        drawer.classList.add('translate-x-0', 'pointer-events-auto');

        document.body.classList.add('overflow-hidden');
      }
    };

    // Close Cart Drawer (slides back to right)
    window.closeCartDrawer = function () {
      const backdrop = document.getElementById('cart-drawer-backdrop');
      const drawer = document.getElementById('cart-drawer');
      if (backdrop && drawer) {
        backdrop.classList.remove('opacity-100', 'pointer-events-auto');
        backdrop.classList.add('opacity-0', 'pointer-events-none');

        drawer.classList.remove('translate-x-0', 'pointer-events-auto');
        drawer.classList.add('translate-x-full', 'pointer-events-none');

        document.body.classList.remove('overflow-hidden');

        // Log drawer closed event if items present in cart
        try {
          const cart = getCart();
          if (cart.length > 0) {
            const subtotal = cart.reduce((acc, item) => acc + (Number(item.price) || 0) * (Number(item.quantity) || 1), 0);
            fetch('/api/analytics/cart-event', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                action: 'cart.drawer_closed',
                productName: `${cart.length} Curtain Item(s) in Cart`,
                itemCount: cart.length,
                cartTotal: subtotal,
                details: cart.map(i => `${i.name} (${i.size || '7ft'} x${i.quantity || 1})`).join(', ')
              })
            }).catch(() => {});
          }
        } catch (e) {}
      }
    };

    // Render Cart Items into Drawer
    window.renderCartDrawer = function () {
      const cart = getCart();
      const itemsList = document.getElementById('drawer-items-list');
      const emptyView = document.getElementById('drawer-empty-view');
      const footer = document.getElementById('drawer-footer');
      const itemCountEl = document.getElementById('drawer-item-count');
      const subtotalEl = document.getElementById('drawer-subtotal');
      const totalEl = document.getElementById('drawer-total');

      const totalQty = cart.reduce((acc, item) => acc + (Number(item.quantity) || 1), 0);
      const subtotal = cart.reduce((acc, item) => acc + (Number(item.price) || 0) * (Number(item.quantity) || 1), 0);

      if (itemCountEl) {
        itemCountEl.innerText = `${totalQty} Item${totalQty === 1 ? '' : 's'}`;
      }

      if (subtotalEl) subtotalEl.innerText = `₹${subtotal.toLocaleString('en-IN')}`;
      if (totalEl) totalEl.innerText = `₹${subtotal.toLocaleString('en-IN')}`;

      if (cart.length === 0) {
        if (itemsList) itemsList.classList.add('hidden');
        if (emptyView) emptyView.classList.remove('hidden');
        if (footer) footer.classList.add('hidden');
        return;
      }

      if (itemsList) itemsList.classList.remove('hidden');
      if (emptyView) emptyView.classList.add('hidden');
      if (footer) footer.classList.remove('hidden');

      if (!itemsList) return;

      itemsList.innerHTML = cart
        .map((item, index) => {
          const itemPrice = Number(item.price) || 0;
          const itemQty = Number(item.quantity) || 1;
          const itemTotal = itemPrice * itemQty;
          const imageSrc = item.image || 'https://images.meesho.com/images/products/686758974/aygfb_512.jpg';
          const sizeLabel = item.size || '7 Feet (Door)';
          const colorLabel = item.color || '';

          return `
            <div class="pt-4 first:pt-0 flex gap-3.5 items-start">
              <a href="/products/${item.slug || ''}" class="block flex-shrink-0">
                <img
                  src="${imageSrc}"
                  alt="${item.name}"
                  class="w-20 h-24 object-cover rounded-2xl border border-slate-200 shadow-sm hover:opacity-90 transition"
                  onerror="this.src='https://images.meesho.com/images/products/686758974/aygfb_512.jpg'"
                />
              </a>

              <div class="flex-1 min-w-0 space-y-1.5">
                <div class="flex items-start justify-between gap-2">
                  <a href="/products/${item.slug || ''}" class="font-bold text-xs sm:text-sm text-slate-900 hover:text-amber-800 line-clamp-2 leading-snug">
                    ${item.name}
                  </a>
                  <button
                    type="button"
                    onclick="window.removeCartItem(${index})"
                    class="text-slate-400 hover:text-red-500 text-sm p-2 -mr-1 transition cursor-pointer active:scale-90"
                    title="Remove item"
                  >
                    🗑️
                  </button>
                </div>

                <div class="flex flex-wrap items-center gap-1.5 text-[10px] font-bold">
                  <span class="bg-amber-100 text-amber-900 px-2 py-0.5 rounded-md border border-amber-200">
                    📏 ${sizeLabel}
                  </span>
                  ${colorLabel ? `
                    <span class="bg-slate-100 text-slate-700 px-2 py-0.5 rounded-md border border-slate-200">
                      🎨 ${colorLabel}
                    </span>
                  ` : ''}
                </div>

                <div class="flex items-center justify-between pt-1">
                  <!-- Quantity Stepper (Thumb-friendly 36px+ Touch Target) -->
                  <div class="flex items-center border border-slate-200 rounded-xl overflow-hidden bg-slate-50 shadow-sm">
                    <button
                      type="button"
                      onclick="window.updateCartItemQty(${index}, -1)"
                      class="w-9 h-9 flex items-center justify-center font-bold text-base text-slate-700 hover:bg-slate-200 active:bg-slate-300 transition cursor-pointer select-none"
                      aria-label="Decrease quantity"
                    >
                      -
                    </button>
                    <span class="w-9 text-center text-xs font-black text-slate-900 select-none">${itemQty}</span>
                    <button
                      type="button"
                      onclick="window.updateCartItemQty(${index}, 1)"
                      class="w-9 h-9 flex items-center justify-center font-bold text-base text-slate-700 hover:bg-slate-200 active:bg-slate-300 transition cursor-pointer select-none"
                      aria-label="Increase quantity"
                    >
                      +
                    </button>
                  </div>

                  <!-- Item Price Total -->
                  <div class="text-right">
                    <div class="text-xs font-black text-slate-900">₹${itemTotal.toLocaleString('en-IN')}</div>
                    <div class="text-[10px] text-slate-400 font-medium">₹${itemPrice.toLocaleString('en-IN')} each</div>
                  </div>
                </div>
              </div>
            </div>
          `;
        })
        .join('');
    };

    // Update Quantity Helper
    window.updateCartItemQty = function (index, delta) {
      const cart = getCart();
      if (!cart[index]) return;
      const item = cart[index];
      const newQty = (Number(item.quantity) || 1) + delta;
      if (newQty <= 0) {
        cart.splice(index, 1);
      } else if (newQty > 10) {
        item.quantity = 10;
      } else {
        item.quantity = newQty;
      }
      saveCart(cart);
      window.renderCartDrawer();

      // Log quantity change in database audit history
      try {
        fetch('/api/analytics/cart-event', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: delta > 0 ? 'cart.qty_increase' : 'cart.qty_decrease',
            productName: item.name,
            slug: item.slug,
            size: item.size,
            color: item.color,
            price: item.price,
            quantity: newQty > 0 ? newQty : 0,
          }),
        }).catch(() => {});
      } catch (e) {}
    };

    // Remove Item Helper
    window.removeCartItem = function (index) {
      const cart = getCart();
      if (!cart[index]) return;
      const removed = cart[index];
      cart.splice(index, 1);
      saveCart(cart);
      window.renderCartDrawer();

      // Log item removal in database audit history
      try {
        fetch('/api/analytics/cart-event', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'cart.remove',
            productName: removed.name,
            slug: removed.slug,
            size: removed.size,
            color: removed.color,
            price: removed.price,
            quantity: removed.quantity,
          }),
        }).catch(() => {});
      } catch (e) {}
    };

    // Fast Add To Cart Global Helper (Upgraded to automatically open Right Drawer & Log History)
    window.quickAddToCart = function (name, slug, price, image, size, color, quantity) {
      try {
        const cart = getCart();
        const selectedSize = size || '7 Feet (Door)';
        const selectedColor = color || 'Default';
        const addQty = Number(quantity) || 1;

        const existingIndex = cart.findIndex(
          (i) => i.slug === slug && i.size === selectedSize && i.color === selectedColor
        );

        if (existingIndex > -1) {
          const currentQty = Number(cart[existingIndex].quantity) || 1;
          cart[existingIndex].quantity = Math.min(10, currentQty + addQty);
          if (price) cart[existingIndex].price = price;
        } else {
          cart.push({
            name,
            slug,
            price: Number(price) || 0,
            image: image || '',
            size: selectedSize,
            color: selectedColor,
            quantity: Math.min(10, addQty),
          });
        }

        saveCart(cart);
        window.openCartDrawer();

        // Send Cart History Event to Database
        try {
          fetch('/api/analytics/cart-event', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'cart.add',
              productName: name,
              slug: slug,
              size: selectedSize,
              color: selectedColor,
              price: price,
              quantity: addQty,
            }),
          }).catch(() => {});
        } catch (err) {}
      } catch (e) {
        console.error('Cart error:', e);
      }
    };

    function attachListeners() {
      const closeBtn = document.getElementById('cart-drawer-close');
      const backdrop = document.getElementById('cart-drawer-backdrop');
      const checkoutBtn = document.getElementById('drawer-checkout-btn');
      const whatsappBtn = document.getElementById('drawer-whatsapp-btn');

      closeBtn?.addEventListener('click', window.closeCartDrawer);
      backdrop?.addEventListener('click', window.closeCartDrawer);

      let hasCheckedOut = false;

      // Checkout Navigation Handler
      checkoutBtn?.addEventListener('click', () => {
        const cart = getCart();
        if (cart.length === 0) {
          alert('Your cart is empty! Please add a curtain first.');
          return;
        }

        hasCheckedOut = true;
        const subtotal = cart.reduce((acc, item) => acc + (Number(item.price) || 0) * (Number(item.quantity) || 1), 0);
        
        // Log Checkout Click Event
        try {
          fetch('/api/analytics/cart-event', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'cart.checkout_click',
              productName: `Checkout (${cart.length} items)`,
              itemCount: cart.length,
              cartTotal: subtotal,
              details: cart.map(i => `${i.name} (${i.size || '7ft'} x${i.quantity || 1})`).join(', ')
            })
          }).catch(() => {});
        } catch (e) {}

        const primary = cart[0];
        const checkoutUrl = `/checkout?product=${encodeURIComponent(primary.slug)}&size=${encodeURIComponent(primary.size || '7 Feet')}&color=${encodeURIComponent(primary.color || 'Standard')}&price=${primary.price}&qty=${primary.quantity || 1}`;

        const savedPhone = localStorage.getItem('teepul_customer_phone');
        const savedName = localStorage.getItem('teepul_customer_name') || '';
        if (savedPhone) {
          window.location.href = checkoutUrl + '&phone=' + encodeURIComponent(savedPhone) + (savedName ? '&name=' + encodeURIComponent(savedName) : '');
        } else {
          window.location.href = checkoutUrl;
        }
      });

      // WhatsApp Cart Order Handler
      whatsappBtn?.addEventListener('click', () => {
        const cart = getCart();
        if (cart.length === 0) return;

        hasCheckedOut = true;
        const subtotal = cart.reduce((acc, item) => acc + (Number(item.price) || 0) * (Number(item.quantity) || 1), 0);

        // Log WhatsApp Order Click Event
        try {
          fetch('/api/analytics/cart-event', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              action: 'cart.whatsapp_click',
              productName: `WhatsApp Order (${cart.length} items)`,
              itemCount: cart.length,
              cartTotal: subtotal,
              details: cart.map(i => `${i.name} (${i.size || '7ft'} x${i.quantity || 1})`).join(', ')
            })
          }).catch(() => {});
        } catch (e) {}

        let itemsSummary = cart
          .map((i, idx) => `${idx + 1}. *${i.name}*\n   Size: ${i.size || '7 Feet'} | Qty: ${i.quantity} | Price: ₹${i.price * i.quantity}`)
          .join('\n\n');

        const msg = `Hi Teepul Store! I want to order my shopping cart:\n\n${itemsSummary}\n\n*Total Amount:* ₹${subtotal.toLocaleString('en-IN')}\n*Delivery:* FREE All-India Shipping\n\nPlease confirm availability and payment details!`;
        window.open(`https://wa.me/919896374239?text=${encodeURIComponent(msg)}`, '_blank');
      });

      // Track Cart Abandonment (when user leaves / switches away with items in cart)
      window.addEventListener('visibilitychange', function () {
        if (document.visibilityState === 'hidden' && !hasCheckedOut) {
          try {
            const cart = getCart();
            if (cart.length > 0) {
              const subtotal = cart.reduce((acc, item) => acc + (Number(item.price) || 0) * (Number(item.quantity) || 1), 0);
              const payload = JSON.stringify({
                action: 'cart.abandoned',
                productName: `Unfinished Cart (${cart.length} items)`,
                itemCount: cart.length,
                cartTotal: subtotal,
                details: cart.map(i => `${i.name} (${i.size || '7ft'} x${i.quantity || 1})`).join(', ')
              });

              if (navigator.sendBeacon) {
                const blob = new Blob([payload], { type: 'application/json' });
                navigator.sendBeacon('/api/analytics/cart-event', blob);
              }
            }
          } catch (e) {}
        }
      });

      document.querySelectorAll('.cart-trigger, #header-cart-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          window.openCartDrawer();
        });
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        window.closeCartDrawer();
      }
    });

    document.addEventListener('DOMContentLoaded', attachListeners);
    setTimeout(attachListeners, 300);
  })();
</script>
