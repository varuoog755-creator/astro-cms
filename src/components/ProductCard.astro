---
interface Props {
  product: {
    id: number;
    title: string;
    slug: string;
    summary?: string;
    price: number;
    compare_at_price?: number;
    image_url: string;
    badge?: string;
    rating?: number;
    reviews_count?: number;
    stock?: number;
  };
}

const { product } = Astro.props;
const discountPercent = product.compare_at_price 
  ? Math.round(((product.compare_at_price - product.price) / product.compare_at_price) * 100)
  : 0;
---

<div class="product-card">
  <div class="product-img-wrapper">
    {product.badge && <span class="product-badge">{product.badge}</span>}
    {discountPercent > 0 && <span class="product-discount">-{discountPercent}% OFF</span>}
    
    <a href={`/products/${product.slug}`}>
      <img 
        src={product.image_url} 
        alt={product.title} 
        loading="lazy" 
        class="product-img" 
      />
    </a>

    <button 
      class="quick-add-btn" 
      onclick={`addToCart({ id: ${product.id}, title: ${JSON.stringify(product.title)}, price: ${product.price}, image_url: ${JSON.stringify(product.image_url)} })`}
    >
      + Add to Bag
    </button>
  </div>

  <div class="product-info">
    <div class="product-rating">
      <span class="stars">★★★★★</span>
      <span class="rating-val">{product.rating || 4.9}</span>
      <span class="reviews-count">({product.reviews_count || 142})</span>
    </div>

    <h3 class="product-title">
      <a href={`/products/${product.slug}`}>{product.title}</a>
    </h3>

    {product.summary && <p class="product-summary">{product.summary}</p>}

    <div class="product-price-row">
      <div class="price-box">
        <span class="current-price">₹{product.price.toLocaleString('en-IN')}</span>
        {product.compare_at_price && (
          <span class="compare-price">₹{product.compare_at_price.toLocaleString('en-IN')}</span>
        )}
      </div>

      <span class="stock-status">
        {product.stock && product.stock < 15 ? `🔥 Only ${product.stock} left` : 'In Stock'}
      </span>
    </div>
  </div>
</div>

<style>
  .product-card {
    background: #ffffff;
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    position: relative;
  }

  .product-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 32px -10px rgba(0,0,0,0.12);
  }

  .product-img-wrapper {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f4f4f4;
  }

  .product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .product-card:hover .product-img {
    transform: scale(1.06);
  }

  .product-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: #000000;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 4px;
    z-index: 2;
    text-transform: uppercase;
  }

  .product-discount {
    position: absolute;
    top: 12px;
    right: 12px;
    background: #ff3b30;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 4px 8px;
    border-radius: 4px;
    z-index: 2;
  }

  .quick-add-btn {
    position: absolute;
    bottom: 12px;
    left: 12px;
    right: 12px;
    background: rgba(0,0,0,0.9);
    color: #ffffff;
    border: none;
    padding: 0.75rem;
    border-radius: 8px;
    font-weight: 800;
    font-size: 0.88rem;
    cursor: pointer;
    transform: translateY(120%);
    opacity: 0;
    transition: transform 0.25s ease, opacity 0.25s ease, background 0.15s ease;
    z-index: 3;
  }

  .product-card:hover .quick-add-btn {
    transform: translateY(0);
    opacity: 1;
  }

  .quick-add-btn:hover {
    background: #ff3b30;
  }

  .product-info {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-rating {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 0.78rem;
    color: #ff9500;
    margin-bottom: 0.4rem;
  }

  .rating-val {
    font-weight: 800;
    color: #1d2327;
  }

  .reviews-count {
    color: #8e8e93;
  }

  .product-title {
    font-size: 1.1rem;
    font-weight: 800;
    margin: 0 0 0.4rem 0;
    line-height: 1.3;
    font-family: 'Outfit', sans-serif;
  }

  .product-title a {
    color: #1d2327;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .product-title a:hover {
    color: #ff3b30;
  }

  .product-summary {
    font-size: 0.82rem;
    color: #636366;
    line-height: 1.4;
    margin-bottom: 0.85rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-price-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 0.5rem;
    border-top: 1px solid #f2f2f7;
  }

  .current-price {
    font-size: 1.25rem;
    font-weight: 900;
    color: #000000;
    font-family: 'Outfit', sans-serif;
  }

  .compare-price {
    font-size: 0.88rem;
    color: #8e8e93;
    text-decoration: line-through;
    margin-left: 6px;
  }

  .stock-status {
    font-size: 0.75rem;
    font-weight: 700;
    color: #ff3b30;
  }
</style>
