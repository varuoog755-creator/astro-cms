---
---

<footer class="teepul-footer">
  <div class="container footer-grid">
    <!-- Brand Info Column -->
    <div class="footer-col brand-col">
      <div class="footer-brand-name">TEEPUL</div>
      <div class="footer-brand-tag">Heavyweight 240 GSM Oversized Streetwear &bull; India</div>
      <p class="footer-desc">
        India’s premier streetwear brand crafting architectural drop-shoulder 240 GSM French Terry Cotton t-shirts and 500 GSM fleece hoodies. Powered by WordPress & Astro.
      </p>

      <div class="trust-pills">
        <span class="pill">🇮🇳 19,000+ Pincodes COD</span>
        <span class="pill">⚡ Dispatched in 24 Hours</span>
        <span class="pill">🔄 7-Day Easy Exchange</span>
      </div>
    </div>

    <!-- Quick Navigation Links -->
    <div class="footer-col">
      <h4>Streetwear Drops</h4>
      <ul>
        <li><a href="/products?category=oversized-tees">240 GSM Oversized Tees</a></li>
        <li><a href="/products?category=anime-hoodies">500 GSM Cyber Hoodies</a></li>
        <li><a href="/products?category=quote-tees">Comedy & Statement Tees</a></li>
        <li><a href="/products?category=desi-coords">Co-ord Cargo Sets</a></li>
      </ul>
    </div>

    <!-- WordPress & Resources -->
    <div class="footer-col">
      <h4>WordPress Portal</h4>
      <ul>
        <li><a href="/blog">Streetwear Journal</a></li>
        <li><a href="/login">WordPress Login Portal</a></li>
        <li><a href="/admin">CMS Admin Dashboard</a></li>
        <li><a href="/api/wp/v2/posts" target="_blank">REST API Endpoint</a></li>
      </ul>
    </div>

    <!-- Newsletter & Support -->
    <div class="footer-col">
      <h4>Join Teepul Secret Drops</h4>
      <p style="font-size: 0.88rem; color: #a0a0a0; margin-bottom: 1rem;">
        Get VIP early access to 240 GSM limited drops & exclusive discount codes.
      </p>
      <form class="newsletter-form" onsubmit="event.preventDefault(); alert('Subscribed to Teepul Drop Alerts!');">
        <input type="email" placeholder="Enter your email" required class="newsletter-input" />
        <button type="submit" class="newsletter-btn">Subscribe</button>
      </form>
      <div style="font-size: 0.8rem; color: #666; margin-top: 1rem;">
        Need support? Email <a href="mailto:care@teepul.com" style="color: #ff3b30;">care@teepul.com</a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-flex">
      <div>
        &copy; {new Date().getFullYear()} Teepul.com Streetwear India. All Rights Reserved. Built with Astro & WordPress REST API.
      </div>
      <div class="payment-methods">
        <span>GPay</span> &bull; <span>PhonePe</span> &bull; <span>Paytm</span> &bull; <span>UPI</span> &bull; <span>Cash on Delivery</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .teepul-footer {
    background: #050505;
    color: #ffffff;
    padding-top: 4rem;
    border-top: 1px solid rgba(255,255,255,0.1);
    font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1.5fr;
    gap: 3rem;
    padding-bottom: 3.5rem;
  }

  .footer-brand-name {
    font-size: 2.2rem;
    font-weight: 900;
    letter-spacing: 2px;
  }

  .footer-brand-tag {
    font-size: 0.75rem;
    font-weight: 700;
    color: #ff3b30;
    margin-bottom: 1rem;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .footer-desc {
    font-size: 0.9rem;
    color: #a0a0a0;
    line-height: 1.6;
    margin-bottom: 1.5rem;
  }

  .trust-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pill {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    font-size: 0.75rem;
    padding: 4px 10px;
    border-radius: 4px;
    color: #d0d0d0;
  }

  .footer-col h4 {
    font-size: 1.05rem;
    font-weight: 800;
    margin-bottom: 1.25rem;
    color: #ffffff;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-col li {
    margin-bottom: 0.75rem;
  }

  .footer-col a {
    color: #a0a0a0;
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.15s ease;
  }

  .footer-col a:hover {
    color: #ff3b30;
  }

  .newsletter-form {
    display: flex;
    gap: 8px;
  }

  .newsletter-input {
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.2);
    color: #fff;
    padding: 0.65rem 0.85rem;
    border-radius: 4px;
    font-size: 0.88rem;
    flex: 1;
    outline: none;
  }

  .newsletter-input:focus {
    border-color: #ff3b30;
  }

  .newsletter-btn {
    background: #ff3b30;
    color: #fff;
    border: none;
    padding: 0.65rem 1.25rem;
    border-radius: 4px;
    font-weight: 800;
    cursor: pointer;
    font-size: 0.88rem;
  }

  .newsletter-btn:hover {
    background: #e02d23;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.08);
    padding: 1.5rem 0;
    font-size: 0.82rem;
    color: #666666;
  }

  .footer-bottom-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .payment-methods span {
    color: #a0a0a0;
    font-weight: 700;
  }

  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 600px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
