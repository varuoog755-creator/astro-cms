---
import '../styles/global.css';
import '../styles/admin.css';
import type { UserSession } from '../types';

interface Props {
  title?: string;
  activeNav?: string;
}

const { title = 'Admin Dashboard', activeNav = 'dashboard' } = Astro.props;
const user: UserSession | null = Astro.locals.user;

const isMasterAdmin =
  user &&
  (user.email?.toLowerCase() === 'govinda755rock755@gmail.com' ||
    user.username?.toLowerCase() === 'govinda755') &&
  user.role === 'Super Admin';

if (!isMasterAdmin) {
  return Astro.redirect('/admin/login');
}

const navItems = [
  { id: 'orders', label: '🛍️ Orders & EKart Courier', icon: '🛍️', href: '/admin/orders' },
  { id: 'users', label: '👥 Customers & Users', icon: '👥', href: '/admin/users' },
  { id: 'audit', label: '🛡️ Active Logs & Cart History', icon: '🛡️', href: '/admin/audit-logs' },
  { id: 'products_catalog', label: '📦 Curtains & Decor Catalog', icon: '📦', href: '/admin/products' },
  { id: 'dashboard', label: '📊 Dashboard Overview', icon: '📊', href: '/admin' },
  { id: 'analytics', label: '📈 Live Sales Analytics', icon: '📈', href: '/admin/analytics' },
  { id: 'integrations', label: '⚡ Payments & Logistics', icon: '⚡', href: '/admin/integrations' },
  { id: 'categories', label: '📁 Categories & Fabrics', icon: '📁', href: '/admin/categories' },
  { id: 'posts', label: '📝 Interior Decor Blog', icon: '📝', href: '/admin/posts' },
  { id: 'pages', label: '📄 Custom Pages', icon: '📄', href: '/admin/pages' },
  { id: 'settings', label: '⚙️ Store Settings', icon: '⚙️', href: '/admin/settings/general' },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - Teepul Curtain Seller Admin</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-gray-100 font-['Inter',sans-serif] text-gray-900 min-h-screen flex flex-col">
    <div class="flex h-screen overflow-hidden">
      <!-- Sidebar -->
      <aside class="w-64 bg-slate-950 text-slate-200 flex flex-col flex-shrink-0 border-r border-slate-800">
        <div class="p-5 border-b border-slate-800 flex items-center justify-between">
          <a href="/admin" class="flex items-center gap-3">
            <div class="w-9 h-9 bg-amber-600 rounded-xl flex items-center justify-center font-black text-white text-xl shadow-lg">T</div>
            <div>
              <div class="font-bold text-white leading-tight text-sm">TEEPUL STORE</div>
              <div class="text-[10px] text-amber-400 font-extrabold uppercase tracking-wider">Curtain Seller Panel</div>
            </div>
          </a>
        </div>

        <nav class="flex-1 overflow-y-auto p-4 space-y-1">
          {navItems.map((item) => {
            const isActive = activeNav === item.id;
            return (
              <a
                href={item.href}
                class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold transition ${
                  isActive
                    ? 'bg-amber-800 text-white shadow-md'
                    : 'text-slate-300 hover:bg-slate-800 hover:text-white'
                }`}
              >
                <span>{item.label}</span>
              </a>
            );
          })}
        </nav>

        <div class="p-4 border-t border-slate-800 bg-slate-950 space-y-3">
          <div class="bg-slate-900/90 border border-slate-800 p-3 rounded-2xl flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-gradient-to-tr from-amber-600 to-amber-400 flex items-center justify-center text-white font-black text-xs shadow">
              G
            </div>
            <div class="min-w-0 flex-1">
              <div class="text-xs font-black text-white truncate">Govinda Admin</div>
              <div class="text-[10px] text-slate-400 truncate">@govinda755</div>
              <div class="text-[9px] font-bold text-emerald-400 uppercase tracking-wider flex items-center gap-1 mt-0.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>Super Admin · active</span>
              </div>
            </div>
          </div>
          <a href="/" target="_blank" class="flex items-center justify-between text-xs text-slate-400 hover:text-white px-2 py-1 transition font-bold">
            <span>🌐 View Live Store</span>
            <span>↗</span>
          </a>
        </div>
      </aside>

      <!-- Main Content Area -->
      <div class="flex-1 flex flex-col min-w-0 overflow-hidden bg-gray-50">
        <!-- Top Navigation Header -->
        <header class="bg-white border-b border-gray-200 h-16 flex items-center justify-between px-6 flex-shrink-0 shadow-sm">
          <div class="flex items-center gap-4">
            <h1 class="text-base font-extrabold text-gray-900">{title}</h1>
          </div>

          <div class="flex items-center gap-4">
            <div class="text-right hidden sm:block">
              <div class="text-xs font-bold text-gray-900">Govinda Admin</div>
              <div class="text-[10px] text-emerald-600 font-extrabold uppercase flex items-center justify-end gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span>Super Admin · active</span>
              </div>
            </div>

            <form action="/api/auth/logout" method="POST">
              <button type="submit" class="text-xs font-extrabold bg-red-50 hover:bg-red-100 text-red-600 px-3.5 py-1.5 rounded-xl border border-red-200 transition">
                Logout 🚪
              </button>
            </form>
          </div>
        </header>

        <!-- Top Core Navigation Tabs Bar (Visible on Desktop & Mobile) -->
        <div class="bg-white border-b border-slate-200 px-4 sm:px-6 py-2.5 flex items-center justify-between gap-2 overflow-x-auto scrollbar-none shadow-sm flex-shrink-0">
          <div class="flex items-center gap-1.5 sm:gap-2">
            <a
              href="/admin/orders"
              class={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-black transition whitespace-nowrap ${
                activeNav === 'orders' ? 'bg-amber-800 text-white shadow-sm' : 'bg-slate-100 text-slate-700 hover:bg-amber-50 hover:text-amber-900'
              }`}
            >
              <span>🛍️ Orders</span>
            </a>
            <a
              href="/admin/users"
              class={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-black transition whitespace-nowrap ${
                activeNav === 'users' ? 'bg-amber-800 text-white shadow-sm' : 'bg-slate-100 text-slate-700 hover:bg-amber-50 hover:text-amber-900'
              }`}
            >
              <span>👥 Customers</span>
            </a>
            <a
              href="/admin/audit-logs"
              class={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-black transition whitespace-nowrap ${
                activeNav === 'audit' ? 'bg-amber-800 text-white shadow-sm' : 'bg-slate-100 text-slate-700 hover:bg-amber-50 hover:text-amber-900'
              }`}
            >
              <span>🛡️ Active Logs</span>
            </a>
            <a
              href="/admin/products"
              class={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-black transition whitespace-nowrap ${
                activeNav === 'products_catalog' ? 'bg-amber-800 text-white shadow-sm' : 'bg-slate-100 text-slate-700 hover:bg-amber-50 hover:text-amber-900'
              }`}
            >
              <span>📦 Products</span>
            </a>
            <a
              href="/admin"
              class={`flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-black transition whitespace-nowrap ${
                activeNav === 'dashboard' ? 'bg-amber-800 text-white shadow-sm' : 'bg-slate-100 text-slate-700 hover:bg-amber-50 hover:text-amber-900'
              }`}
            >
              <span>📊 Dashboard</span>
            </a>
          </div>

          <div class="flex items-center gap-2 shrink-0">
            <a href="/" target="_blank" class="text-xs font-extrabold text-amber-800 hover:underline flex items-center gap-1 whitespace-nowrap px-2.5 py-1.5 bg-amber-50 hover:bg-amber-100 rounded-xl border border-amber-200 transition">
              <span>🌐 View Store</span>
              <span>↗</span>
            </a>
          </div>
        </div>

        <!-- Main Body Content -->
        <main class="flex-1 overflow-y-auto p-6 md:p-8">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
