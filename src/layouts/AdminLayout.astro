---
import '../styles/global.css';
import '../styles/admin.css';
import type { UserSession } from '../types';

interface Props {
  title?: string;
  activeNav?: string;
}

const { title = 'Admin Dashboard', activeNav = 'dashboard' } = Astro.props;
const user: UserSession | null = Astro.locals.user;

const navItems = [
  { id: 'dashboard', label: 'Dashboard', icon: '📊', href: '/admin' },
  { id: 'posts', label: 'Posts', icon: '📝', href: '/admin/posts' },
  { id: 'pages', label: 'Pages', icon: '📄', href: '/admin/pages' },
  { id: 'media', label: 'Media Library', icon: '🖼️', href: '/admin/media' },
  { id: 'categories', label: 'Categories', icon: '📁', href: '/admin/categories' },
  { id: 'tags', label: 'Tags', icon: '🏷️', href: '/admin/tags' },
  { id: 'comments', label: 'Comments', icon: '💬', href: '/admin/comments' },
  { id: 'users', label: 'Users & Roles', icon: '👥', href: '/admin/users' },
  { id: 'appearance', label: 'Themes & Menus', icon: '🎨', href: '/admin/themes' },
  { id: 'plugins', label: 'Plugins', icon: '🔌', href: '/admin/plugins' },
  { id: 'settings', label: 'Settings', icon: '⚙️', href: '/admin/settings/general' },
  { id: 'seo', label: 'SEO & Permalinks', icon: '🔍', href: '/admin/seo' },
  { id: 'analytics', label: 'Analytics', icon: '📈', href: '/admin/analytics' },
  { id: 'audit', label: 'Audit Logs', icon: '📜', href: '/admin/audit-logs' },
  { id: 'tools', label: 'Import / Export', icon: '📦', href: '/admin/tools/export' },
];
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - Astro CMS Admin</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-gray-100 font-['Inter',sans-serif] text-gray-900 min-h-screen flex flex-col">
    <div class="flex h-screen overflow-hidden">
      <!-- Sidebar -->
      <aside class="w-64 bg-slate-900 text-slate-200 flex flex-col flex-shrink-0 border-r border-slate-800">
        <div class="p-5 border-b border-slate-800 flex items-center justify-between">
          <a href="/admin" class="flex items-center gap-3">
            <div class="w-9 h-9 bg-blue-600 rounded-lg flex items-center justify-center font-black text-white text-xl shadow-lg">A</div>
            <div>
              <div class="font-bold text-white leading-tight">Astro CMS</div>
              <div class="text-[11px] text-slate-400">v1.0.0 Enterprise</div>
            </div>
          </a>
        </div>

        <nav class="flex-1 overflow-y-auto p-4 space-y-1">
          {navItems.map((item) => {
            const isActive = activeNav === item.id || (item.id === 'appearance' && (activeNav === 'themes' || activeNav === 'menus'));
            return (
              <a
                href={item.href}
                class={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition ${
                  isActive
                    ? 'bg-blue-600 text-white font-semibold shadow-md'
                    : 'text-slate-300 hover:bg-slate-800 hover:text-white'
                }`}
              >
                <span class="text-base">{item.icon}</span>
                <span>{item.label}</span>
              </a>
            );
          })}
        </nav>

        <div class="p-4 border-t border-slate-800 bg-slate-950/50">
          <a href="/" target="_blank" class="flex items-center justify-between text-xs text-slate-400 hover:text-white px-2 py-1 transition">
            <span>🌐 View Public Site</span>
            <span>↗</span>
          </a>
        </div>
      </aside>

      <!-- Main Content Area -->
      <div class="flex-1 flex flex-col min-w-0 overflow-hidden bg-gray-50">
        <!-- Top Navigation Header -->
        <header class="bg-white border-b border-gray-200 h-16 flex items-center justify-between px-6 flex-shrink-0 shadow-sm">
          <div class="flex items-center gap-4">
            <h1 class="text-lg font-bold text-gray-900">{title}</h1>
          </div>

          <div class="flex items-center gap-4">
            <div class="text-right hidden sm:block">
              <div class="text-sm font-semibold text-gray-900">{user?.displayName || 'Admin'}</div>
              <div class="text-xs text-gray-500">{user?.role || 'Administrator'}</div>
            </div>

            <form action="/api/auth/logout" method="POST">
              <button type="submit" class="text-xs font-semibold bg-gray-100 hover:bg-gray-200 text-gray-700 px-3 py-1.5 rounded-lg border border-gray-300 transition">
                Logout
              </button>
            </form>
          </div>
        </header>

        <!-- Main Body Content -->
        <main class="flex-1 overflow-y-auto p-6 md:p-8">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
