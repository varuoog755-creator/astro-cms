---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Authentication' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - Teepul Customer Portal</title>
    <meta name="robots" content="noindex, nofollow" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-slate-950 text-gray-100 font-sans min-h-screen flex items-center justify-center p-4 selection:bg-amber-600 selection:text-white">
    <div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-3xl shadow-2xl p-8 sm:p-10 space-y-6">
      <div class="text-center space-y-2">
        <a href="/" class="inline-block">
          <img src="/teepul-header-logo.png" alt="Teepul Luxury Home & Drapery" class="h-10 mx-auto object-contain bg-white px-3 py-1.5 rounded-xl shadow" />
        </a>
        <h1 class="text-2xl font-black text-white tracking-tight">{title}</h1>
        <p class="text-xs text-slate-400">Teepul Luxury Home & Drapery Portal</p>
      </div>

      <slot />
    </div>
  </body>
</html>
