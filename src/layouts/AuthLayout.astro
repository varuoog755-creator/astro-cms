---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Authentication' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - Astro CMS</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-slate-950 text-gray-100 font-sans min-h-screen flex items-center justify-center p-4 selection:bg-blue-600 selection:text-white">
    <div class="w-full max-w-md bg-slate-900 border border-slate-800 rounded-3xl shadow-2xl p-8 sm:p-10 space-y-6">
      <div class="text-center space-y-2">
        <div class="w-12 h-12 brand-gradient-bg rounded-2xl flex items-center justify-center font-black text-white text-2xl mx-auto shadow-lg shadow-blue-500/25">A</div>
        <h1 class="text-2xl font-black text-white tracking-tight">{title}</h1>
        <p class="text-xs text-slate-400">Astro CMS Enterprise Edition</p>
      </div>

      <slot />
    </div>
  </body>
</html>
