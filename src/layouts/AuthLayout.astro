---
interface Props {
  title?: string;
}

const { title = 'Authentication' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - Astro CMS</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-slate-900 text-gray-100 font-['Inter',sans-serif] min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-slate-800 border border-slate-700 rounded-2xl shadow-2xl p-8">
      <div class="text-center mb-8">
        <div class="w-12 h-12 bg-blue-600 rounded-xl flex items-center justify-center font-black text-white text-2xl mx-auto mb-3 shadow-lg">A</div>
        <h1 class="text-2xl font-bold text-white tracking-tight">{title}</h1>
        <p class="text-xs text-slate-400 mt-1">Astro CMS Enterprise Edition</p>
      </div>

      <slot />
    </div>
  </body>
</html>
