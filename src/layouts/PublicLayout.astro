---
import { generateSeoMetadata } from '../lib/seo/meta';
import type { SeoOptions } from '../lib/seo/meta';
import prisma from '../lib/db';
import { getIntegrationSettings } from '../lib/settings';
import { getSession } from '../lib/auth/session';
import { getOrSetCache } from '../lib/cache';
import CartDrawer from '../components/CartDrawer.astro';
import CustomerSignupModal from '../components/CustomerSignupModal.astro';
import '../styles/global.css';

interface Props {
  seo?: SeoOptions;
  includeRazorpay?: boolean;
}

const { seo = { title: 'Home' }, includeRazorpay = false } = Astro.props;
const meta = generateSeoMetadata(seo);

// Fetch session token
const sessionToken = Astro.cookies.get('cms_session_token')?.value;

// Parallel cached data fetching: zero redundant DB roundtrips!
const [integrationSettings, currentSession, primaryMenu] = await Promise.all([
  getIntegrationSettings(),
  sessionToken ? getSession(sessionToken) : Promise.resolve(null),
  getOrSetCache('primary_menu', 120, async () => {
    try {
      return await prisma.menu.findFirst({
        where: { isPrimary: true },
        include: {
          items: {
            orderBy: { sortOrder: 'asc' },
          },
        },
      });
    } catch (error) {
      console.error('Failed to fetch primary menu:', error);
      return null;
    }
  }),
]);

// High-Speed Edge Caching: Serve from Cloudflare edge in ~30ms for anonymous users
if (!sessionToken) {
  Astro.response.headers.set(
    'Cache-Control',
    'public, max-age=30, s-maxage=300, stale-while-revalidate=86400'
  );
} else {
  Astro.response.headers.set('Cache-Control', 'private, no-cache, no-store');
}

const defaultMenuItems = [
  { id: '1', title: 'Home', url: '/' },
  { id: '2', title: 'Shop', url: '/products' },
  { id: '4', title: 'About', url: '/about' },
];

const rawMenuItems = primaryMenu?.items?.length ? primaryMenu.items : defaultMenuItems;
const menuItems = rawMenuItems
  .filter((item: any) => item.url !== '/blog')
  .map((item: any) => (item.url === '/products' || item.title === 'Products' ? { ...item, title: 'Shop' } : item));
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="robots" content={meta.robots} />
    <link rel="canonical" href={meta.canonical} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt Model Context" />

    <!-- Open Graph (Facebook, WhatsApp, LinkedIn) -->
    <meta property="og:site_name" content="Teepul Luxury Curtains & Home Decor" />
    <meta property="og:url" content={meta.canonical} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:image" content={meta.ogImage} />
    <meta property="og:type" content={meta.type} />
    <meta property="og:locale" content="en_IN" />

    <!-- Meta Open Graph Product Microdata for Facebook / Meta Catalog Pixel Ingestion -->
    {meta.productMeta && (
      <>
        <meta property="product:retailer_item_id" content={meta.productMeta.retailerItemId} />
        <meta property="product:price:amount" content={meta.productMeta.priceAmount} />
        <meta property="product:price:currency" content={meta.productMeta.priceCurrency} />
        <meta property="product:availability" content={meta.productMeta.availability} />
        <meta property="product:condition" content={meta.productMeta.condition} />
        <meta property="product:brand" content={meta.productMeta.brand} />
        <meta property="product:category" content={meta.productMeta.category} />
        <meta property="og:price:amount" content={meta.productMeta.priceAmount} />
        <meta property="og:price:currency" content={meta.productMeta.priceCurrency} />
      </>
    )}

    <!-- Twitter Cards (X / Twitter Preview) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={meta.ogImage} />

    <!-- LCP Preload Hint (Core Web Vitals Optimization) -->
    {meta.preloadLcpImage && (
      <link rel="preload" as="image" href={meta.preloadLcpImage} fetchpriority="high" />
    )}

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={meta.jsonLd} />

    <!-- Performance: Preconnect & DNS-Prefetch for External CDNs -->
    <link rel="preconnect" href="https://images.meesho.com" crossorigin />
    <link rel="dns-prefetch" href="https://images.meesho.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
    
    <!-- Google Search Console Verification Tag -->
    {integrationSettings.gsc_enabled && integrationSettings.gsc_verification_tag && (
      integrationSettings.gsc_verification_tag.startsWith('<meta') ? (
        <Fragment set:html={integrationSettings.gsc_verification_tag} />
      ) : (
        <meta name="google-site-verification" content={integrationSettings.gsc_verification_tag} />
      )
    )}

    <!-- Razorpay Checkout SDK (Loaded only when checkout flow is required) -->
    {includeRazorpay && (
      <script is:inline src="https://checkout.razorpay.com/v1/checkout.js"></script>
    )}

    <!-- Google Analytics 4 (GA4) -->
    {integrationSettings.ga_enabled && integrationSettings.ga_measurement_id && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${integrationSettings.ga_measurement_id}`}></script>
        <script is:inline define:vars={{ gaId: integrationSettings.ga_measurement_id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    <!-- Meta Pixel Code -->
    {integrationSettings.meta_pixel_enabled && integrationSettings.meta_pixel_id && (
      <>
        <script is:inline define:vars={{ rawPixelId: integrationSettings.meta_pixel_id }}>
          !function(f,b,e,v,n,t,s)
          {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};
          if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
          n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t,s)}(window, document,'script',
          'https://connect.facebook.net/en_US/fbevents.js');
          
          const pixelIds = String(rawPixelId).split(',').map(s => s.trim()).filter(Boolean);
          pixelIds.forEach(id => fbq('init', id));
          fbq('track', 'PageView');
        </script>
        {integrationSettings.meta_pixel_id.split(',').map((id: string) => id.trim()).filter(Boolean).map((id: string) => (
          <noscript>
            <img height="1" width="1" style="display:none"
              src={`https://www.facebook.com/tr?id=${id}&ev=PageView&noscript=1`}
            />
          </noscript>
        ))}
      </>
    )}

    <style>
      .glass-header {
        background: rgba(255, 255, 255, 0.90);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      }
      .brand-gradient-text {
        background: linear-gradient(135deg, #1e40af 0%, #2563eb 50%, #7c3aed 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .brand-gradient-bg {
        background: linear-gradient(135deg, #1e40af 0%, #2563eb 50%, #7c3aed 100%);
      }
    </style>
  </head>
  <body class="bg-[#faf9f6] text-slate-900 font-sans antialiased min-h-screen flex flex-col selection:bg-amber-600 selection:text-white">
    <!-- Accessible Skip to Content Link (WCAG 2.1 AA) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:bg-amber-800 focus:text-white focus:px-4 focus:py-2.5 focus:rounded-xl focus:shadow-2xl focus:outline-none focus:ring-2 focus:ring-amber-400 font-bold text-xs"
    >
      Skip to main content
    </a>

    <!-- Top Announcement Bar -->
    <div class="bg-amber-950 text-amber-100 text-[11px] sm:text-xs py-2 px-3 sm:px-4 text-center border-b border-amber-900/60 flex items-center justify-center gap-1.5 sm:gap-2 overflow-hidden whitespace-nowrap">
      <span class="bg-amber-600 text-white font-extrabold px-2 py-0.5 rounded-full text-[9px] sm:text-[10px] uppercase tracking-wider shadow-sm shrink-0">TEEPUL</span>
      <span class="font-medium truncate sm:hidden">✨ Free All-India Delivery &amp; 7-Day Returns</span>
      <span class="font-medium hidden sm:inline">✨ Premium Door Curtains, Sheer Linen Drapes &amp; Thermal Blackout Drapes</span>
      <a href="/products" class="text-amber-300 font-bold hover:underline ml-1 hidden sm:inline shrink-0">Explore Collection &rarr;</a>
    </div>

    <!-- Header Navigation -->
    <header class="glass-header sticky top-0 z-50 border-b border-amber-900/10 transition-all duration-200 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        
        <!-- Brand Logo -->
        <a href="/" class="flex items-center gap-3 group py-1">
          <img
            src="/teepul-logo-transparent.png"
            alt="Teepul Luxury Home & Drapery"
            class="h-12 sm:h-14 w-auto object-contain group-hover:scale-105 transition-transform"
          />
        </a>

        <!-- Desktop Navigation Menu -->
        <nav class="hidden md:flex items-center gap-8">
          {menuItems.map((item: any) => (
            <a
              href={item.url}
              class="text-xs uppercase tracking-wider font-extrabold text-slate-700 hover:text-amber-700 transition-colors relative py-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-amber-600 hover:after:w-full after:transition-all"
            >
              {item.title}
            </a>
          ))}
        </nav>

        <!-- Search Bar & Actions -->
        <div class="flex items-center gap-2.5 sm:gap-3">
          <form action="/search" method="GET" class="relative hidden sm:block">
            <input
              type="text"
              name="q"
              placeholder="Search curtains, lights, decor..."
              aria-label="Search store curtains, lights, and decor"
              class="w-48 lg:w-56 bg-slate-100/80 text-xs font-medium text-slate-800 rounded-full pl-9 pr-4 py-2 focus:outline-none focus:ring-2 focus:ring-amber-500 border border-slate-200 focus:bg-white transition-all shadow-inner"
            />
            <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </form>

          <!-- Cart Icon & Counter (Desktop & Tablet only on mobile bottom bar handles cart) -->
          <button
            type="button"
            id="header-cart-btn"
            class="cart-trigger relative bg-amber-100/80 hover:bg-amber-200 active:scale-95 text-amber-950 font-bold px-3 py-2 rounded-full hidden sm:flex items-center gap-1.5 text-xs transition border border-amber-300/60 shadow-sm cursor-pointer"
            title="Open Shopping Cart"
            aria-label="Shopping Cart"
          >
            <span class="text-sm">🛒</span>
            <span class="hidden sm:inline font-extrabold text-[11px] uppercase tracking-wider">Cart</span>
            <span id="cart-badge-count" class="bg-amber-800 text-white text-[10px] font-black w-5 h-5 rounded-full flex items-center justify-center">0</span>
          </button>

          <!-- Customer Profile / Login Button -->
          {currentSession ? (
            <div class="hidden sm:flex items-center gap-2">
              <a
                href="/account"
                class="flex items-center gap-1.5 bg-slate-900 hover:bg-amber-800 text-white font-bold text-xs px-3.5 py-2 rounded-full transition shadow-sm"
                title="My Customer Dashboard"
              >
                <span>👤</span>
                <span class="max-w-[110px] truncate">{currentSession.displayName || currentSession.username}</span>
              </a>

              <button
                type="button"
                id="header-logout-btn"
                class="bg-red-50 hover:bg-red-100 text-red-600 font-extrabold text-xs px-3 py-2 rounded-full transition border border-red-200/60"
                title="Logout from Account"
              >
                🚪
              </button>
            </div>
          ) : (
            <a
              href="/login"
              class="hidden sm:flex items-center gap-1.5 bg-slate-900 hover:bg-amber-800 text-white font-bold text-xs px-4 py-2 rounded-full transition shadow-sm"
            >
              <span>👤 Sign In</span>
            </a>
          )}

          <!-- Mobile Hamburger Toggle Button -->
          <button
            type="button"
            id="mobile-menu-toggle"
            class="md:hidden p-2 rounded-xl text-slate-700 hover:bg-slate-100 focus:outline-none"
            aria-label="Toggle Navigation Menu"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Drawer Navigation -->
      <div id="mobile-menu-drawer" class="hidden md:hidden bg-white/95 backdrop-blur-lg border-b border-slate-200 px-4 pt-3 pb-6 space-y-3">
        <form action="/search" method="GET" class="relative">
          <input
            type="text"
            name="q"
            placeholder="Search curtains, lights, decor..."
            aria-label="Search store curtains and decor"
            class="w-full bg-slate-100 text-xs font-medium text-slate-800 rounded-full pl-9 pr-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-amber-500 border border-slate-200"
          />
          <svg class="w-4 h-4 text-slate-400 absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </form>

        <div class="flex flex-col space-y-2 pt-2">
          {menuItems.map((item: any) => (
            <a
              href={item.url}
              class="px-4 py-2.5 rounded-xl text-xs font-extrabold text-slate-800 hover:bg-amber-50 hover:text-amber-700 uppercase tracking-wider transition"
            >
              {item.title}
            </a>
          ))}

          {currentSession ? (
            <>
              <a
                href="/account"
                class="px-4 py-2.5 rounded-xl text-xs font-extrabold text-amber-900 bg-amber-50 flex items-center justify-between border border-amber-200"
              >
                <span>👤 My Dashboard ({currentSession.displayName || currentSession.username})</span>
                <span class="text-[10px] bg-amber-200 text-amber-900 px-2 py-0.5 rounded font-black">OPEN</span>
              </a>

              <button
                type="button"
                id="mobile-logout-btn"
                class="w-full text-left px-4 py-2.5 rounded-xl text-xs font-extrabold text-red-600 bg-red-50 flex items-center gap-2 border border-red-100"
              >
                <span>🚪 Logout</span>
              </button>
            </>
          ) : (
            <a
              href="/login"
              class="px-4 py-2.5 rounded-xl text-xs font-extrabold text-amber-900 bg-amber-50 uppercase tracking-wider transition border border-amber-200"
            >
              🔑 Customer Login / Register
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- Floating Toast Alert for Fast Add to Cart -->
    <div
      id="cart-toast"
      class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 hidden bg-slate-900 text-white px-5 py-3.5 rounded-2xl shadow-2xl border border-slate-700 flex items-center gap-3 transition-all duration-300 text-xs"
    >
      <span class="text-base">✨</span>
      <div>
        <span id="cart-toast-msg" class="font-bold block">Added item to cart!</span>
        <span class="text-[10px] text-slate-300">Ready for express checkout.</span>
      </div>
      <a
        href="/checkout"
        class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-[11px] px-3.5 py-1.5 rounded-xl shadow ml-2 transition shrink-0"
      >
        Checkout 🛒
      </a>
    </div>

    <!-- Main Body Slot -->
    <main id="main-content" role="main" class="flex-1 pb-16 md:pb-0">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-950 text-slate-400 pt-16 pb-12 border-t border-slate-900 mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-slate-800">
          
          <!-- Column 1: Brand Info -->
          <div class="space-y-4 md:col-span-1">
            <a href="/" class="inline-block bg-white px-4 py-2.5 rounded-2xl border border-slate-200 shadow-md">
              <img src="/teepul-header-logo.png" alt="Teepul Luxury Home & Drapery" class="h-9 sm:h-11 w-auto object-contain" />
            </a>
            <p class="text-xs leading-relaxed text-slate-400">
              Luxury Door Curtains, French Sheer Window Drapery, Thermal Blackout & Home Decoration Drapes. Designed for timeless elegance in Indian living spaces.
            </p>
            <div class="flex items-center gap-3 text-slate-400 text-xs">
              <span class="inline-flex items-center gap-1.5 bg-slate-900 border border-slate-800 px-3 py-1 rounded-full text-slate-300">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                Systems Operational
              </span>
            </div>
          </div>

          <!-- Column 2: Quick Links -->
          <div class="space-y-3">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200">Navigation</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="/" class="hover:text-white transition">Home Page</a></li>
              <li><a href="/products" class="hover:text-white transition">Store & Products</a></li>
              <li><a href="/blog" class="hover:text-white transition">Latest Articles</a></li>
              <li><a href="/about" class="hover:text-white transition">About Platform</a></li>
              <li><a href="/search" class="hover:text-white transition">Global Search</a></li>
            </ul>
          </div>

          <!-- Column 3: Customer Care & Policies -->
          <div class="space-y-3">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200">Customer Care & Policies</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="/contact" class="hover:text-white transition">Contact Us & Panipat Studio</a></li>
              <li><a href="/shipping-policy" class="hover:text-white transition">Shipping & Delivery Policy</a></li>
              <li><a href="/refund-policy" class="hover:text-white transition">Refund & Cancellation Policy</a></li>
              <li><a href="/terms" class="hover:text-white transition">Terms and Conditions</a></li>
              <li><a href="/privacy-policy" class="hover:text-white transition">Privacy Policy</a></li>
              <li><a href="/checkout" class="hover:text-white transition">Track Cart & Order</a></li>
            </ul>
          </div>

          <!-- Column 4: Newsletter -->
          <div class="space-y-4">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200">Newsletter</h4>
            <p class="text-xs text-slate-400">Subscribe for release updates, curtain offers, and styling tips.</p>
            <form onsubmit="event.preventDefault(); alert('Subscribed successfully!');" class="space-y-2">
              <input
                type="email"
                placeholder="Enter your email"
                required
                class="w-full bg-slate-900 border border-slate-800 text-xs text-slate-200 rounded-xl px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-amber-500"
              />
              <button type="submit" class="w-full bg-amber-800 hover:bg-amber-700 text-white font-bold text-xs py-2.5 rounded-xl transition">
                Subscribe
              </button>
            </form>
          </div>
        </div>

        <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500">
          <p>© {new Date().getFullYear()} Teepul - Luxury Home Curtains & Drapery. Ashank Ecommerce Pvt Ltd, Panipat, Haryana. All rights reserved.</p>
          <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
            <a href="/blog" class="hover:text-slate-300 transition font-medium text-amber-400/90">Blog</a>
            <a href="/terms" class="hover:text-slate-300 transition">Terms</a>
            <a href="/privacy-policy" class="hover:text-slate-300 transition">Privacy</a>
            <a href="/refund-policy" class="hover:text-slate-300 transition">Refunds</a>
            <a href="/shipping-policy" class="hover:text-slate-300 transition">Shipping</a>
            <a href="/contact" class="hover:text-slate-300 transition">Contact</a>
            <a href="/sitemap.xml" class="hover:text-slate-300 transition">Sitemap</a>
            <a href="/rss.xml" class="hover:text-slate-300 transition">RSS</a>
            <a href="/robots.txt" class="hover:text-slate-300 transition">Robots.txt</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Floating WhatsApp Sales Widget (Desktop & Tablet) -->
    {integrationSettings.whatsapp_enabled && integrationSettings.whatsapp_floating_widget && (
      <a
        href={`https://wa.me/${integrationSettings.whatsapp_number}?text=${encodeURIComponent('Hi! I am browsing the store and have a question about products.')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="fixed bottom-20 sm:bottom-6 right-4 sm:right-6 z-40 bg-emerald-500 hover:bg-emerald-600 text-white p-3.5 rounded-full shadow-2xl hover:scale-110 transition-all hidden sm:flex items-center gap-2 font-bold text-xs group"
        title="Chat on WhatsApp"
      >
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-1.156 4.223 4.299-1.127z"/>
        </svg>
        <span class="max-w-0 overflow-hidden group-hover:max-w-xs transition-all duration-300 whitespace-nowrap">
          Chat with Us
        </span>
      </a>
    )}

    <!-- Mobile App-Style Bottom Navigation Bar (80% Mobile Users - Sleek & Compact) -->
    <nav class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-xl border-t border-slate-200 py-1 px-2 shadow-[0_-3px_15px_rgba(0,0,0,0.06)] flex items-center justify-around" style="padding-bottom: max(0.25rem, env(safe-area-inset-bottom));">
      <a href="/" class="flex flex-col items-center justify-center py-0.5 px-2 text-slate-700 hover:text-amber-800 transition active:scale-95 min-w-[48px]">
        <span class="text-lg">🏠</span>
        <span class="text-[9px] font-extrabold tracking-tight">Home</span>
      </a>

      <a href="/products" class="flex flex-col items-center justify-center py-0.5 px-2 text-slate-700 hover:text-amber-800 transition active:scale-95 min-w-[48px]">
        <span class="text-lg">🛍️</span>
        <span class="text-[9px] font-extrabold tracking-tight">Shop</span>
      </a>

      <button
        type="button"
        onclick="window.openCartDrawer?.()"
        class="flex flex-col items-center justify-center py-0.5 px-2 text-slate-700 hover:text-amber-800 transition active:scale-95 min-w-[48px] relative cursor-pointer"
        aria-label="Open Shopping Cart"
      >
        <div class="relative">
          <span class="text-lg">🛒</span>
          <span id="mobile-bottom-cart-badge" class="absolute -top-1 -right-2 bg-amber-800 text-white text-[8px] font-black w-3.5 h-3.5 rounded-full flex items-center justify-center shadow-xs">0</span>
        </div>
        <span class="text-[9px] font-extrabold tracking-tight">Cart</span>
      </button>

      <a
        href={`https://wa.me/${integrationSettings.whatsapp_number}?text=${encodeURIComponent('Hi Teepul! I am browsing on mobile and need assistance.')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="flex flex-col items-center justify-center py-0.5 px-2 text-emerald-600 hover:text-emerald-700 transition active:scale-95 min-w-[48px]"
      >
        <span class="text-lg">💬</span>
        <span class="text-[9px] font-extrabold tracking-tight">WhatsApp</span>
      </a>
    </nav>

    <!-- Global Cart & Logout Script -->
    <script is:inline>
      // Drawer Toggle
      document.getElementById('mobile-menu-toggle')?.addEventListener('click', () => {
        const drawer = document.getElementById('mobile-menu-drawer');
        if (drawer) drawer.classList.toggle('hidden');
      });

      // Cart Badge Sync
      window.updateCartBadge = function updateCartBadge() {
        try {
          const cart = JSON.parse(localStorage.getItem('teepul_cart') || '[]');
          const count = cart.reduce((acc, item) => acc + (Number(item.quantity) || 1), 0);
          const badge = document.getElementById('cart-badge-count');
          if (badge) badge.innerText = String(count);
          const mobileBadge = document.getElementById('mobile-bottom-cart-badge');
          if (mobileBadge) mobileBadge.innerText = String(count);
        } catch (e) {
          console.error(e);
        }
      };

      window.addEventListener('cart-updated', window.updateCartBadge);

      // Fast Add To Cart Global Helper
      window.quickAddToCart = function (name, slug, price, image) {
        try {
          const cart = JSON.parse(localStorage.getItem('teepul_cart') || '[]');
          const existingIndex = cart.findIndex((i) => i.slug === slug);
          if (existingIndex > -1) {
            cart[existingIndex].quantity = (cart[existingIndex].quantity || 1) + 1;
          } else {
            cart.push({ name, slug, price, image, quantity: 1 });
          }
          localStorage.setItem('teepul_cart', JSON.stringify(cart));
          updateCartBadge();

          // Dispatch cart event directly to Supabase AuditLog
          try {
            fetch('/api/analytics/cart-event', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              keepalive: true,
              body: JSON.stringify({
                action: 'cart.add',
                productName: name,
                slug: slug,
                price: price,
                quantity: 1,
              }),
            }).catch(() => {});
          } catch (err) {}

          // Show Toast
          const toast = document.getElementById('cart-toast');
          const toastMsg = document.getElementById('cart-toast-msg');
          if (toast && toastMsg) {
            toastMsg.innerText = `Added "${name}" to cart! 🛒`;
            toast.classList.remove('hidden');
            setTimeout(() => {
              toast.classList.add('hidden');
            }, 4000);
          }
        } catch (e) {
          console.error('Cart error:', e);
        }
      };

      // Smooth Animated Add to Cart Global Helper
      window.animatedAddToCart = function (btn, name, slug, price, image) {
        if (window.quickAddToCart) {
          window.quickAddToCart(name, slug, price, image);
        }
        if (!btn) return;

        const textEl = btn.querySelector('.btn-text');
        const iconEl = btn.querySelector('.cart-icon');
        const originalText = textEl ? textEl.innerHTML : 'Add to Cart';

        // Apply smooth feedback styling
        btn.classList.add('!bg-emerald-600', '!hover:bg-emerald-700', 'ring-2', 'ring-emerald-300', 'scale-95');
        
        if (textEl) textEl.innerHTML = 'Added! ✓';
        if (iconEl) {
          iconEl.style.transform = 'scale(1.3) rotate(-12deg)';
          iconEl.style.transition = 'transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
        }

        // Pulse badge in header
        const badge = document.getElementById('cart-badge-count');
        if (badge) {
          badge.classList.add('animate-bounce');
          setTimeout(() => badge.classList.remove('animate-bounce'), 800);
        }

        // Revert button after 1.4s
        setTimeout(() => {
          btn.classList.remove('!bg-emerald-600', '!hover:bg-emerald-700', 'ring-2', 'ring-emerald-300', 'scale-95');
          if (textEl) textEl.innerHTML = originalText;
          if (iconEl) {
            iconEl.style.transform = '';
            iconEl.style.transition = '';
          }
        }, 1400);
      };

      // Header & Mobile Logout Handlers
      const triggerLogout = async () => {
        try {
          await fetch('/api/auth/logout', { method: 'POST' });
          window.location.href = '/login';
        } catch (e) {
          window.location.href = '/login';
        }
      };

      document.getElementById('header-logout-btn')?.addEventListener('click', triggerLogout);
      document.getElementById('mobile-logout-btn')?.addEventListener('click', triggerLogout);

      // Initialize badge count on load
      document.addEventListener('DOMContentLoaded', updateCartBadge);
      updateCartBadge();
    </script>

    <CartDrawer />
    <CustomerSignupModal />
  </body>
</html>
