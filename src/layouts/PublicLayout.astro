---
import { generateSeoMetadata } from '../lib/seo/meta';
import type { SeoOptions } from '../lib/seo/meta';
import prisma from '../lib/db';
import { getIntegrationSettings } from '../lib/settings';
import { getSession } from '../lib/auth/session';
import { getOrSetCache } from '../lib/cache';
import CartDrawer from '../components/CartDrawer.astro';
import CustomerSignupModal from '../components/CustomerSignupModal.astro';
import '../styles/global.css';

interface Props {
  seo?: SeoOptions;
  includeRazorpay?: boolean;
  hideMobileNav?: boolean;
}

const { seo = { title: 'Home' }, includeRazorpay = false, hideMobileNav = false } = Astro.props;
const meta = generateSeoMetadata(seo);

// Fetch session token
const sessionToken = Astro.cookies.get('cms_session_token')?.value;

// Parallel cached data fetching: zero redundant DB roundtrips!
const [integrationSettings, currentSession, primaryMenu] = await Promise.all([
  getIntegrationSettings(),
  sessionToken ? getSession(sessionToken) : Promise.resolve(null),
  getOrSetCache('primary_menu', 600, async () => {
    try {
      return await prisma.menu.findFirst({
        where: { isPrimary: true },
        include: {
          items: {
            orderBy: { sortOrder: 'asc' },
          },
        },
      });
    } catch (error) {
      console.error('Failed to fetch primary menu:', error);
      return null;
    }
  }),
]);

// High-Speed Edge Caching: Serve from Cloudflare/CDN edge in ~30ms for anonymous users
if (!sessionToken) {
  Astro.response.headers.set(
    'Cache-Control',
    'public, max-age=60, s-maxage=3600, stale-while-revalidate=604800'
  );
} else {
  Astro.response.headers.set('Cache-Control', 'private, no-cache, no-store');
}

const defaultMenuItems = [
  { id: '1', title: 'Home', url: '/' },
  { id: '2', title: 'Shop', url: '/products' },
  { id: '4', title: 'About', url: '/about' },
];

const rawMenuItems = primaryMenu?.items?.length ? primaryMenu.items : defaultMenuItems;
const menuItems = rawMenuItems
  .filter((item: any) => item.url !== '/blog')
  .map((item: any) => (item.url === '/products' || item.title === 'Products' ? { ...item, title: 'Shop' } : item));
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="robots" content={meta.robots} />
    <link rel="canonical" href={meta.canonical} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLMs.txt Model Context" />

    <!-- Open Graph (Facebook, WhatsApp, LinkedIn) -->
    <meta property="og:site_name" content="Teepul Luxury Curtains & Home Decor" />
    <meta property="og:url" content={meta.canonical} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:image" content={meta.ogImage} />
    <meta property="og:type" content={meta.type} />
    <meta property="og:locale" content="en_IN" />

    <!-- Meta Open Graph Product Microdata for Facebook / Meta Catalog Pixel Ingestion -->
    {meta.productMeta && (
      <>
        <meta property="product:retailer_item_id" content={meta.productMeta.retailerItemId} />
        <meta property="product:price:amount" content={meta.productMeta.priceAmount} />
        <meta property="product:price:currency" content={meta.productMeta.priceCurrency} />
        <meta property="product:availability" content={meta.productMeta.availability} />
        <meta property="product:condition" content={meta.productMeta.condition} />
        <meta property="product:brand" content={meta.productMeta.brand} />
        <meta property="product:category" content={meta.productMeta.category} />
        <meta property="og:price:amount" content={meta.productMeta.priceAmount} />
        <meta property="og:price:currency" content={meta.productMeta.priceCurrency} />
      </>
    )}

    <!-- Twitter Cards (X / Twitter Preview) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={meta.ogImage} />

    <!-- LCP Preload Hint (Core Web Vitals Optimization) -->
    {meta.preloadLcpImage && (
      <link rel="preload" as="image" href={meta.preloadLcpImage} fetchpriority="high" />
    )}

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={meta.jsonLd} />

    <!-- Performance: Preconnect & DNS-Prefetch for External CDNs -->
    <link rel="preconnect" href="https://images.meesho.com" crossorigin />
    <link rel="dns-prefetch" href="https://images.meesho.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" />
    </noscript>
    
    <!-- Google Search Console Verification Tag -->
    {integrationSettings.gsc_enabled && integrationSettings.gsc_verification_tag && (
      integrationSettings.gsc_verification_tag.startsWith('<meta') ? (
        <Fragment set:html={integrationSettings.gsc_verification_tag} />
      ) : (
        <meta name="google-site-verification" content={integrationSettings.gsc_verification_tag} />
      )
    )}

    <!-- Razorpay Checkout SDK (Loaded only when checkout flow is required) -->
    {includeRazorpay && (
      <script is:inline src="https://checkout.razorpay.com/v1/checkout.js"></script>
    )}

    <!-- Google Analytics 4 (GA4) - Deferred for Zero TBT -->
    {integrationSettings.ga_enabled && integrationSettings.ga_measurement_id && (
      <script is:inline define:vars={{ gaId: integrationSettings.ga_measurement_id }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', gaId);

        function loadGA() {
          if (window._gaLoaded) return;
          window._gaLoaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + gaId;
          document.head.appendChild(s);
        }
        if ('requestIdleCallback' in window) {
          requestIdleCallback(loadGA, { timeout: 2000 });
        } else {
          window.addEventListener('load', function() { setTimeout(loadGA, 1000); });
        }
      </script>
    )}

    <!-- Meta Pixel Code - Deferred for Zero TBT -->
    {integrationSettings.meta_pixel_enabled && integrationSettings.meta_pixel_id && (
      <>
        <script is:inline define:vars={{ pixelIds: String(integrationSettings.meta_pixel_id).split(',').map((id: string) => id.trim()).filter(Boolean) }}>
          window.fbq = window.fbq || function() {
            window.fbq.callMethod ? window.fbq.callMethod.apply(window.fbq, arguments) : window.fbq.queue.push(arguments);
          };
          if (!window._fbq) window._fbq = window.fbq;
          window.fbq.push = window.fbq;
          window.fbq.loaded = true;
          window.fbq.version = '2.0';
          window.fbq.queue = window.fbq.queue || [];

          pixelIds.forEach(function(id) {
            window.fbq('init', id);
          });
          window.fbq('track', 'PageView');

          function loadMetaPixel() {
            if (window._metaPixelScriptLoaded) return;
            window._metaPixelScriptLoaded = true;
            var t = document.createElement('script');
            t.async = true;
            t.src = 'https://connect.facebook.net/en_US/fbevents.js';
            var s = document.getElementsByTagName('script')[0];
            s.parentNode.insertBefore(t, s);
          }

          if ('requestIdleCallback' in window) {
            requestIdleCallback(loadMetaPixel, { timeout: 2000 });
          } else {
            window.addEventListener('load', function() { setTimeout(loadMetaPixel, 1000); });
          }
        </script>
        {String(integrationSettings.meta_pixel_id).split(',').map((id: string) => id.trim()).filter(Boolean).map((id: string) => (
          <noscript>
            <img height="1" width="1" style="display:none"
              src={`https://www.facebook.com/tr?id=${id}&ev=PageView&noscript=1`}
            />
          </noscript>
        ))}
      </>
    )}
    <!-- End Meta Pixel Code -->

    <style>
      .glass-header {
        background: rgba(255, 255, 255, 0.90);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      }
      .brand-gradient-text {
        background: linear-gradient(135deg, #1e40af 0%, #2563eb 50%, #7c3aed 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .brand-gradient-bg {
        background: linear-gradient(135deg, #1e40af 0%, #2563eb 50%, #7c3aed 100%);
      }
    </style>
  </head>
  <body class="bg-[#FFF8F1] text-[#171717] font-sans antialiased min-h-screen flex flex-col selection:bg-[#7B1830] selection:text-white">
    <!-- Accessible Skip to Content Link (WCAG 2.1 AA) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:bg-[#7B1830] focus:text-white focus:px-4 focus:py-2.5 focus:rounded-xl focus:shadow-2xl focus:outline-none font-bold text-xs"
    >
      Skip to main content
    </a>

    <!-- Top Announcement Bar (Rich Maroon) -->
    <div class="bg-[#7B1830] text-white text-[11px] sm:text-xs py-2 px-3 sm:px-4 text-center border-b border-[#4A0F1D] flex items-center justify-center gap-2 overflow-hidden whitespace-nowrap shadow-xs">
      <span class="bg-[#FFF8F1] text-[#7B1830] font-black px-2 py-0.5 rounded text-[9px] sm:text-[10px] uppercase tracking-wider shrink-0 shadow-xs">TEEPUL LUXURY</span>
      <span class="font-semibold truncate sm:hidden">✨ Flat 40% OFF · Free All-India COD · 7-Day Easy Returns</span>
      <span class="font-medium hidden sm:inline">✨ Premium Door Curtains, Jacquard Blackout Drapes &amp; Sheer Linen · Direct Panipat Factory Dispatch</span>
      <a href="/products?filter=offers" class="text-[#F3E5D5] font-bold hover:underline ml-1 hidden sm:inline shrink-0">Explore Offers &rarr;</a>
    </div>

    <!-- Main Header Navigation -->
    <header class="bg-[#FFF8F1]/95 backdrop-blur-md sticky top-0 z-50 border-b border-[#E8DED6] transition-all duration-200">
      
      <!-- Top Row: Logo, Search, Quick Actions -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 sm:h-20 flex items-center justify-between gap-4">
        
        <!-- Mobile Left: Hamburger Toggle -->
        <button
          type="button"
          id="mobile-menu-toggle"
          class="lg:hidden p-2 rounded-xl text-[#171717] hover:bg-[#F3E5D5] focus:outline-none transition active:scale-95"
          aria-label="Toggle Navigation Menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <!-- Brand Logo -->
        <a href="/" class="flex items-center gap-3 group py-1 shrink-0">
          <img
            src="/teepul-logo-transparent.png"
            alt="Teepul Luxury Home & Drapery"
            class="h-9 sm:h-12 w-auto object-contain transition-transform group-hover:scale-105"
          />
        </a>

        <!-- Desktop Search Bar -->
        <div class="hidden lg:flex flex-1 max-w-xl mx-4">
          <form action="/search" method="GET" class="relative w-full">
            <input
              type="text"
              name="q"
              placeholder="Search curtains by room, color (Maroon, Brown), or size (7ft, 9ft)..."
              aria-label="Search store curtains and decor"
              class="w-full bg-white text-xs font-medium text-[#171717] rounded-full pl-10 pr-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-[#7B1830] border border-[#E8DED6] focus:bg-white transition-all shadow-xs"
            />
            <svg class="w-4 h-4 text-[#6B625D] absolute left-3.5 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </form>
        </div>

        <!-- Desktop Quick Utility Actions -->
        <div class="flex items-center gap-2 sm:gap-3">
          
          <a
            href="/checkout"
            class="hidden md:flex items-center gap-1.5 text-xs font-semibold text-[#6B625D] hover:text-[#7B1830] transition px-2.5 py-1.5 rounded-lg hover:bg-[#F3E5D5]/50"
            title="Track Order Status"
          >
            <span>📦</span>
            <span class="hidden xl:inline">Track Order</span>
          </a>

          <a
            href="/contact"
            class="hidden md:flex items-center gap-1.5 text-xs font-semibold text-[#6B625D] hover:text-[#7B1830] transition px-2.5 py-1.5 rounded-lg hover:bg-[#F3E5D5]/50"
            title="Customer Help & Support"
          >
            <span>💬</span>
            <span class="hidden xl:inline">Help</span>
          </a>

          <!-- Customer Profile / Login Button -->
          {currentSession ? (
            <div class="hidden sm:flex items-center gap-2">
              <a
                href="/account"
                class="flex items-center gap-1.5 bg-white hover:bg-[#F3E5D5] text-[#171717] font-bold text-xs px-3.5 py-2 rounded-full transition border border-[#E8DED6] shadow-xs"
                title="My Customer Dashboard"
              >
                <span>👤</span>
                <span class="max-w-[100px] truncate">{currentSession.displayName || currentSession.username}</span>
              </a>

              <button
                type="button"
                id="header-logout-btn"
                class="bg-white hover:bg-rose-50 text-[#6B625D] hover:text-rose-700 font-bold text-xs px-2.5 py-2 rounded-full transition border border-[#E8DED6]"
                title="Logout from Account"
              >
                🚪
              </button>
            </div>
          ) : (
            <a
              href="/login"
              class="hidden sm:flex items-center gap-1.5 bg-white hover:bg-[#F3E5D5] text-[#171717] font-bold text-xs px-3.5 py-2 rounded-full transition border border-[#E8DED6] shadow-xs"
            >
              <span>👤 Login</span>
            </a>
          )}

          <!-- Header Cart Button -->
          <button
            type="button"
            id="header-cart-btn"
            onclick="window.openCartDrawer?.()"
            class="cart-trigger relative bg-[#7B1830] hover:bg-[#4A0F1D] active:scale-95 text-white font-bold px-3.5 sm:px-4 py-2 rounded-full flex items-center gap-2 text-xs transition shadow-md cursor-pointer shrink-0"
            title="Open Shopping Cart"
            aria-label="Shopping Cart"
          >
            <span class="text-base sm:text-sm">🛒</span>
            <span class="hidden sm:inline font-bold text-[11px] uppercase tracking-wider">Cart</span>
            <span id="cart-badge-count" class="bg-white text-[#7B1830] text-[11px] font-black w-5 h-5 min-w-[20px] min-h-[20px] rounded-full flex items-center justify-center shadow-xs leading-none">0</span>
          </button>
        </div>
      </div>

      <!-- Desktop Main Category Navigation Bar -->
      <nav class="hidden lg:block bg-white border-t border-[#E8DED6] shadow-xs">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <ul class="flex items-center justify-between text-[11px] xl:text-xs font-bold uppercase tracking-wider text-[#6B625D] py-2.5 whitespace-nowrap overflow-x-auto no-scrollbar">
            <li>
              <a href="/products" class="hover:text-[#7B1830] transition-colors py-1 flex items-center gap-1">
                <span>✨ All Curtains</span>
              </a>
            </li>
            <li>
              <a href="/products?category=Living+Room" class="hover:text-[#7B1830] transition-colors py-1">Living Room</a>
            </li>
            <li>
              <a href="/products?category=Bedroom" class="hover:text-[#7B1830] transition-colors py-1">Bedroom</a>
            </li>
            <li>
              <a href="/products?category=Door+Curtains" class="hover:text-[#7B1830] transition-colors py-1">Door Curtains</a>
            </li>
            <li>
              <a href="/products?category=Window+Curtains" class="hover:text-[#7B1830] transition-colors py-1">Window Curtains</a>
            </li>
            <li>
              <a href="/products#colors" class="hover:text-[#7B1830] transition-colors py-1">Shop by Color</a>
            </li>
            <li>
              <a href="/products#sizes" class="hover:text-[#7B1830] transition-colors py-1">Size Guide (5/7/9 FT)</a>
            </li>
            <li>
              <a href="/products?filter=offers" class="text-[#7B1830] bg-[#FBE7E7] px-2.5 py-1 rounded-full font-black hover:bg-[#7B1830] hover:text-white transition">
                ⚡ Offers (-50%)
              </a>
            </li>
          </ul>
        </div>
      </nav>

      <!-- Mobile Search Bar Below Header -->
      <div class="lg:hidden px-4 py-2.5 bg-white border-t border-[#E8DED6]">
        <form action="/search" method="GET" class="relative">
          <input
            type="text"
            name="q"
            placeholder="Search curtains (Maroon, Brown, 7ft door)..."
            aria-label="Search store curtains and decor"
            class="w-full bg-[#FFF8F1] text-xs font-medium text-[#171717] rounded-full pl-9 pr-4 py-2 focus:outline-none focus:ring-2 focus:ring-[#7B1830] border border-[#E8DED6]"
          />
          <svg class="w-4 h-4 text-[#6B625D] absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </form>
      </div>

      <!-- Mobile Drawer Navigation -->
      <div id="mobile-menu-drawer" class="hidden lg:hidden bg-[#FFF8F1] border-b border-[#E8DED6] px-4 pt-3 pb-6 space-y-3 shadow-xl">
        <div class="flex flex-col space-y-1.5 pt-1">
          <span class="text-[10px] font-black uppercase text-[#6B625D] tracking-widest px-3 py-1">Shop Categories</span>
          <a href="/products" class="px-3.5 py-2 rounded-xl text-xs font-bold text-[#171717] hover:bg-[#F3E5D5] flex items-center justify-between">
            <span>✨ All Curtains Catalog</span>
            <span class="text-xs text-[#7B1830]">&rarr;</span>
          </a>
          <a href="/products?category=Living+Room" class="px-3.5 py-2 rounded-xl text-xs font-bold text-[#171717] hover:bg-[#F3E5D5] flex items-center justify-between">
            <span>🛋️ Living Room Curtains</span>
            <span class="text-xs text-[#7B1830]">&rarr;</span>
          </a>
          <a href="/products?category=Bedroom" class="px-3.5 py-2 rounded-xl text-xs font-bold text-[#171717] hover:bg-[#F3E5D5] flex items-center justify-between">
            <span>🛏️ Bedroom Blackout Curtains</span>
            <span class="text-xs text-[#7B1830]">&rarr;</span>
          </a>
          <a href="/products?category=Door+Curtains" class="px-3.5 py-2 rounded-xl text-xs font-bold text-[#171717] hover:bg-[#F3E5D5] flex items-center justify-between">
            <span>🚪 7 &amp; 9 FT Door Curtains</span>
            <span class="text-xs text-[#7B1830]">&rarr;</span>
          </a>
          <a href="/products?category=Window+Curtains" class="px-3.5 py-2 rounded-xl text-xs font-bold text-[#171717] hover:bg-[#F3E5D5] flex items-center justify-between">
            <span>🪟 5 FT Window Curtains</span>
            <span class="text-xs text-[#7B1830]">&rarr;</span>
          </a>
          <a href="/products#colors" class="px-3.5 py-2 rounded-xl text-xs font-bold text-[#171717] hover:bg-[#F3E5D5] flex items-center justify-between">
            <span>🎨 Shop by Color (Maroon, Brown, Pink, Black)</span>
            <span class="text-xs text-[#7B1830]">&rarr;</span>
          </a>
          <a href="/products#sizes" class="px-3.5 py-2 rounded-xl text-xs font-bold text-[#171717] hover:bg-[#F3E5D5] flex items-center justify-between">
            <span>📏 Size Guide (5ft, 7ft, 9ft)</span>
            <span class="text-xs text-[#7B1830]">&rarr;</span>
          </a>
          <a href="/products?filter=offers" class="px-3.5 py-2 rounded-xl text-xs font-bold text-[#7B1830] bg-[#FBE7E7] flex items-center justify-between">
            <span>⚡ Special Offers (Flat 40% OFF)</span>
            <span class="text-xs font-black">SAVE &rarr;</span>
          </a>

          <div class="border-t border-[#E8DED6] my-2 pt-2">
            <span class="text-[10px] font-black uppercase text-[#6B625D] tracking-widest px-3 py-1">Customer Account</span>
            {currentSession ? (
              <>
                <a
                  href="/account"
                  class="px-3.5 py-2 rounded-xl text-xs font-extrabold text-[#7B1830] bg-white flex items-center justify-between border border-[#E8DED6]"
                >
                  <span>👤 Dashboard ({currentSession.displayName || currentSession.username})</span>
                  <span class="text-[10px] bg-[#F3E5D5] text-[#7B1830] px-2 py-0.5 rounded font-black">OPEN</span>
                </a>
                <button
                  type="button"
                  id="mobile-logout-btn"
                  class="w-full text-left px-3.5 py-2 rounded-xl text-xs font-extrabold text-rose-700 bg-rose-50 flex items-center gap-2 mt-1 border border-rose-100"
                >
                  <span>🚪 Logout</span>
                </button>
              </>
            ) : (
              <a
                href="/login"
                class="px-3.5 py-2 rounded-xl text-xs font-extrabold text-[#7B1830] bg-white flex items-center justify-between border border-[#E8DED6]"
              >
                <span>🔑 Customer Login / Signup</span>
                <span class="text-xs">&rarr;</span>
              </a>
            )}
          </div>
        </div>
      </div>
    </header>

    <!-- Floating Toast Alert for Fast Add to Cart -->
    <div
      id="cart-toast"
      class="fixed bottom-20 md:bottom-6 left-1/2 -translate-x-1/2 z-50 hidden bg-[#171717] text-white px-5 py-3.5 rounded-2xl shadow-2xl border border-[#4A0F1D] flex items-center gap-3 transition-all duration-300 text-xs"
    >
      <span class="text-base">✨</span>
      <div>
        <span id="cart-toast-msg" class="font-bold block">Added item to cart!</span>
        <span class="text-[10px] text-[#F3E5D5]">Ready for express checkout.</span>
      </div>
      <button
        type="button"
        onclick="window.openCartDrawer?.()"
        class="bg-[#7B1830] hover:bg-[#4A0F1D] text-white font-extrabold text-[11px] px-3.5 py-1.5 rounded-xl shadow ml-2 transition shrink-0 cursor-pointer"
      >
        View Cart 🛒
      </button>
    </div>

    <!-- Main Body Slot -->
    <main id="main-content" role="main" class="flex-1 pb-20 md:pb-0">
      <slot />
    </main>

    <!-- Premium Footer (Rich Charcoal & Maroon Accent) -->
