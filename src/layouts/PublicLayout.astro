---
import { generateSeoMetadata } from '../lib/seo/meta';
import type { SeoOptions } from '../lib/seo/meta';
import prisma from '../lib/db';
import { getIntegrationSettings } from '../lib/settings';
import '../styles/global.css';

interface Props {
  seo?: SeoOptions;
}

const { seo = { title: 'Home' } } = Astro.props;
const meta = generateSeoMetadata(seo);
const integrationSettings = await getIntegrationSettings();

// Fetch primary menu
const primaryMenu = await prisma.menu.findFirst({
  where: { isPrimary: true },
  include: {
    items: {
      orderBy: { sortOrder: 'asc' },
    },
  },
});

const defaultMenuItems = [
  { id: '1', title: 'Home', url: '/' },
  { id: '2', title: 'Products', url: '/products' },
  { id: '3', title: 'Blog', url: '/blog' },
  { id: '4', title: 'About', url: '/about' },
];

const menuItems = primaryMenu?.items.length ? primaryMenu.items : defaultMenuItems;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.canonical} />

    <!-- Open Graph -->
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:image" content={meta.ogImage} />
    <meta property="og:type" content={meta.type} />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={meta.jsonLd} />

    <!-- Tailwind CSS (Dual Build & CDN Protection) -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    
    <!-- Google Search Console Verification Tag -->
    {integrationSettings.gsc_enabled && integrationSettings.gsc_verification_tag && (
      integrationSettings.gsc_verification_tag.startsWith('<meta') ? (
        <Fragment set:html={integrationSettings.gsc_verification_tag} />
      ) : (
        <meta name="google-site-verification" content={integrationSettings.gsc_verification_tag} />
      )
    )}

    <!-- Razorpay Checkout SDK -->
    <script is:inline src="https://checkout.razorpay.com/v1/checkout.js"></script>

    <!-- Google Analytics 4 (GA4) -->
    {integrationSettings.ga_enabled && integrationSettings.ga_measurement_id && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${integrationSettings.ga_measurement_id}`}></script>
        <script is:inline define:vars={{ gaId: integrationSettings.ga_measurement_id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId);
        </script>
      </>
    )}

    <!-- Meta Pixel Code -->
    {integrationSettings.meta_pixel_enabled && integrationSettings.meta_pixel_id && (
      <script is:inline define:vars={{ pixelId: integrationSettings.meta_pixel_id }}>
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', pixelId);
        fbq('track', 'PageView');
      </script>
    )}

    <style>
      .glass-header {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
      }
      .brand-gradient-text {
        background: linear-gradient(135deg, #1e40af 0%, #2563eb 50%, #7c3aed 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .brand-gradient-bg {
        background: linear-gradient(135deg, #1e40af 0%, #2563eb 50%, #7c3aed 100%);
      }
    </style>
  </head>
  <body class="bg-slate-50 text-slate-900 font-sans antialiased min-h-screen flex flex-col selection:bg-blue-600 selection:text-white">
    <!-- Top Announcement Bar -->
    <div class="bg-slate-950 text-slate-300 text-xs py-2 px-4 text-center border-b border-slate-800 flex items-center justify-center gap-2">
      <span class="bg-blue-600 text-white font-bold px-2 py-0.5 rounded-full text-[10px] uppercase tracking-wider">NEW</span>
      <span>⚡ Astro CMS 2.0 Engine & Heavyweight Apparel Catalog is Live!</span>
      <a href="/products" class="text-blue-400 font-semibold hover:underline ml-1">Shop Collection &rarr;</a>
    </div>

    <!-- Header Navigation -->
    <header class="glass-header sticky top-0 z-50 border-b border-slate-200/80 transition-all duration-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        
        <!-- Brand Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 brand-gradient-bg rounded-xl flex items-center justify-center font-black text-white text-xl shadow-md shadow-blue-500/20 group-hover:scale-105 transition-transform">
            A
          </div>
          <div class="flex flex-col">
            <span class="font-extrabold text-xl tracking-tight text-slate-900 group-hover:text-blue-600 transition-colors">
              Astro <span class="brand-gradient-text">CMS</span>
            </span>
            <span class="text-[10px] font-semibold tracking-widest text-slate-400 uppercase -mt-1">Enterprise Platform</span>
          </div>
        </a>

        <!-- Desktop Navigation Menu -->
        <nav class="hidden md:flex items-center gap-8">
          {menuItems.map((item) => (
            <a
              href={item.url}
              class="text-sm font-semibold text-slate-600 hover:text-blue-600 transition-colors relative py-1 after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-blue-600 hover:after:w-full after:transition-all"
            >
              {item.title}
            </a>
          ))}
        </nav>

        <!-- Search Bar & Actions -->
        <div class="flex items-center gap-4">
          <form action="/search" method="GET" class="relative hidden sm:block">
            <input
              type="text"
              name="q"
              placeholder="Search store, posts, pages..."
              class="w-56 bg-slate-100 text-xs font-medium text-slate-800 rounded-full pl-9 pr-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500 border border-slate-200 focus:bg-white transition-all shadow-inner"
            />
            <svg class="w-4 h-4 text-slate-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </form>

          <a
            href="/admin"
            class="brand-gradient-bg text-white font-bold text-xs px-5 py-2.5 rounded-full shadow-md shadow-blue-500/25 hover:shadow-blue-500/40 hover:-translate-y-0.5 transition-all flex items-center gap-1.5"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
            </svg>
            Admin Panel
          </a>
        </div>
      </div>
    </header>

    <!-- Main Body Slot -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-950 text-slate-400 pt-16 pb-12 border-t border-slate-900 mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-slate-800">
          
          <!-- Column 1: Brand Info -->
          <div class="space-y-4 md:col-span-1">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 brand-gradient-bg rounded-xl flex items-center justify-center font-bold text-white text-lg shadow-md">A</div>
              <span class="text-white font-extrabold text-xl">Astro CMS</span>
            </div>
            <p class="text-xs leading-relaxed text-slate-400">
              Modern high-performance Content Management & Storefront Platform. Built independently with Astro 7.2, TypeScript, and Prisma ORM.
            </p>
            <div class="flex items-center gap-3 text-slate-400 text-xs">
              <span class="inline-flex items-center gap-1.5 bg-slate-900 border border-slate-800 px-3 py-1 rounded-full text-slate-300">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                Systems Operational
              </span>
            </div>
          </div>

          <!-- Column 2: Quick Links -->
          <div class="space-y-3">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200">Navigation</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="/" class="hover:text-white transition">Home Page</a></li>
              <li><a href="/products" class="hover:text-white transition">Store & Products</a></li>
              <li><a href="/blog" class="hover:text-white transition">Latest Articles</a></li>
              <li><a href="/about" class="hover:text-white transition">About Platform</a></li>
              <li><a href="/search" class="hover:text-white transition">Global Search</a></li>
            </ul>
          </div>

          <!-- Column 3: Platform Features -->
          <div class="space-y-3">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200">Architecture</h4>
            <ul class="space-y-2 text-xs">
              <li><span class="text-slate-400">Block Content Editor</span></li>
              <li><span class="text-slate-400">Granular RBAC Security</span></li>
              <li><span class="text-slate-400">Automated SEO Suite</span></li>
              <li><span class="text-slate-400">REST API & Webhooks</span></li>
              <li><span class="text-slate-400">SQLite & Prisma ORM</span></li>
            </ul>
          </div>

          <!-- Column 4: Newsletter -->
          <div class="space-y-4">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200">Newsletter</h4>
            <p class="text-xs text-slate-400">Subscribe for release updates, apparel drops, and CMS insights.</p>
            <form onsubmit="event.preventDefault(); alert('Subscribed successfully!');" class="space-y-2">
              <input
                type="email"
                placeholder="Enter your email"
                required
                class="w-full bg-slate-900 border border-slate-800 text-xs text-slate-200 rounded-xl px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-500"
              />
              <button type="submit" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs py-2.5 rounded-xl transition">
                Subscribe
              </button>
            </form>
          </div>
        </div>

        <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500">
          <p>© {new Date().getFullYear()} Astro CMS. Crafted with precision in Astro & TypeScript. All rights reserved.</p>
          <div class="flex gap-6">
            <a href="/sitemap.xml" class="hover:text-slate-300 transition">Sitemap</a>
            <a href="/rss.xml" class="hover:text-slate-300 transition">RSS Feed</a>
            <a href="/robots.txt" class="hover:text-slate-300 transition">Robots.txt</a>
            <a href="/admin/login" class="hover:text-slate-300 transition">Portal Login</a>
          </div>
        </div>
      </div>
    </footer>
    <!-- Floating WhatsApp Sales Widget -->
    {integrationSettings.whatsapp_enabled && integrationSettings.whatsapp_floating_widget && (
      <a
        href={`https://wa.me/${integrationSettings.whatsapp_number}?text=${encodeURIComponent('Hi! I am browsing the store and have a question about products.')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="fixed bottom-6 right-6 z-50 bg-emerald-500 hover:bg-emerald-600 text-white p-3.5 rounded-full shadow-2xl hover:scale-110 transition-all flex items-center gap-2 font-bold text-xs group"
        title="Chat on WhatsApp"
      >
        <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
          <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-1.156 4.223 4.299-1.127z"/>
        </svg>
        <span class="max-w-0 overflow-hidden group-hover:max-w-xs transition-all duration-300 whitespace-nowrap">
          Chat with Us
        </span>
      </a>
    )}
  </body>
</html>
