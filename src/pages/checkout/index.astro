---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { getStorefrontProducts, PRODUCTS_CATALOG } from '../../lib/products';
import { getIntegrationSettings } from '../../lib/settings';

const settings = await getIntegrationSettings();

const slug = Astro.url.searchParams.get('product') || '';
const color = Astro.url.searchParams.get('color') || 'Onyx Black';
const size = Astro.url.searchParams.get('size') || 'XL';
const quantityStr = Astro.url.searchParams.get('qty') || '1';
const quantity = Math.max(1, parseInt(quantityStr, 10) || 1);

const rawProducts = await getStorefrontProducts();
const allProducts = (rawProducts?.length ? rawProducts : PRODUCTS_CATALOG).filter(Boolean);
let product = slug ? allProducts.find((p) => p?.slug === slug) : null;
if (!product) {
  product = allProducts[0] || PRODUCTS_CATALOG[0];
}
const itemTotal = (product?.price || 0) * quantity;
---

<PublicLayout seo={{ title: `Checkout - ${product.name}`, description: `Complete your order for ${product.name}` }}>
  <div class="bg-slate-50 min-h-screen py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Checkout Step Header -->
      <div class="mb-10 text-center">
        <span class="bg-blue-100 text-blue-800 text-xs font-extrabold px-3.5 py-1 rounded-full uppercase tracking-wider">
          🔒 Express Checkout & Payment
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mt-3">
          Complete Your Order
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Fast, SSL-Encrypted Indian Checkout powered by Razorpay, Paytm & Direct UPI
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
        
        <!-- Left: Customer & Shipping Details Form -->
        <div class="lg:col-span-7 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm space-y-6">
          <h2 class="text-lg font-bold text-slate-900 border-b border-slate-100 pb-4 flex items-center gap-2">
            <span>📦</span> Shipping Information
          </h2>

          <form id="checkout-form" class="space-y-4">
            <input type="hidden" name="productId" value={product.id} />
            <input type="hidden" name="productTitle" value={product.name} />
            <input type="hidden" name="color" value={color} />
            <input type="hidden" name="size" value={size} />
            <input type="hidden" name="quantity" value={quantity} />
            <input type="hidden" name="unitPrice" value={product.price} />

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Full Name *</label>
              <input
                type="text"
                name="customerName"
                required
                placeholder="e.g. Rahul Sharma"
                class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500 font-medium"
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Mobile Phone (for delivery SMS) *</label>
                <input
                  type="tel"
                  name="customerPhone"
                  required
                  placeholder="9876543210"
                  class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500 font-medium"
                />
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Email Address</label>
                <input
                  type="email"
                  name="customerEmail"
                  placeholder="rahul@example.com"
                  class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500 font-medium"
                />
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Full Delivery Address *</label>
              <textarea
                name="shippingAddress"
                required
                rows="2"
                placeholder="House/Flat No., Street, Landmark"
                class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-blue-500 font-medium"
              ></textarea>
            </div>

            <div class="grid grid-cols-3 gap-3">
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Pincode *</label>
                <input
                  type="text"
                  name="pincode"
                  required
                  placeholder="110001"
                  class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5 font-mono"
                />
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">City</label>
                <input
                  type="text"
                  name="city"
                  placeholder="New Delhi"
                  class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5"
                />
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">State</label>
                <input
                  type="text"
                  name="state"
                  placeholder="Delhi"
                  class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-3 py-2.5"
                />
              </div>
            </div>

            <!-- Payment Method Selector -->
            <div class="pt-6 border-t border-slate-200 space-y-4">
              <h3 class="text-sm font-bold text-slate-900">Select Payment Method</h3>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                
                {settings.razorpay_enabled && (
                  <label class="border border-blue-200 bg-blue-50/50 hover:bg-blue-50 p-4 rounded-2xl flex items-center gap-3 cursor-pointer transition">
                    <input type="radio" name="paymentMethod" value="RAZORPAY" checked class="text-blue-600 focus:ring-blue-500" />
                    <div>
                      <span class="font-bold text-xs text-slate-900 block">⚡ Razorpay Online</span>
                      <span class="text-[10px] text-slate-500">Cards, UPI (GPay/PhonePe), NetBanking</span>
                    </div>
                  </label>
                )}

                {settings.paytm_enabled && (
                  <label class="border border-slate-200 bg-slate-50 hover:bg-slate-100/80 p-4 rounded-2xl flex items-center gap-3 cursor-pointer transition">
                    <input type="radio" name="paymentMethod" value="PAYTM" class="text-blue-600 focus:ring-blue-500" />
                    <div>
                      <span class="font-bold text-xs text-slate-900 block">📱 Paytm / Direct UPI</span>
                      <span class="text-[10px] text-slate-500">VPA Handle: {settings.paytm_vpa}</span>
                    </div>
                  </label>
                )}

                {settings.cod_enabled && (
                  <label class="border border-slate-200 bg-slate-50 hover:bg-slate-100/80 p-4 rounded-2xl flex items-center gap-3 cursor-pointer transition">
                    <input type="radio" name="paymentMethod" value="COD" class="text-emerald-600 focus:ring-emerald-500" />
                    <div>
                      <span class="font-bold text-xs text-slate-900 block">🚚 Cash on Delivery</span>
                      <span class="text-[10px] text-slate-500">Pay cash when package arrives</span>
                    </div>
                  </label>
                )}

                {settings.whatsapp_enabled && (
                  <label class="border border-emerald-200 bg-emerald-50/50 hover:bg-emerald-50 p-4 rounded-2xl flex items-center gap-3 cursor-pointer transition">
                    <input type="radio" name="paymentMethod" value="WHATSAPP" class="text-emerald-600 focus:ring-emerald-500" />
                    <div>
                      <span class="font-bold text-xs text-emerald-900 block">💬 Order on WhatsApp</span>
                      <span class="text-[10px] text-emerald-700">Chat directly with seller</span>
                    </div>
                  </label>
                )}

              </div>
            </div>

            <!-- Submit Action -->
            <div class="pt-4">
              <button
                type="submit"
                id="pay-button"
                class="w-full bg-blue-600 hover:bg-blue-500 text-white font-extrabold text-sm py-4 rounded-2xl transition shadow-lg shadow-blue-500/30 flex items-center justify-center gap-2"
              >
                <span>🔒 Place Order & Pay ₹{itemTotal.toLocaleString('en-IN')}</span>
              </button>
            </div>

          </form>
        </div>

        <!-- Right: Order Summary Card -->
        <div class="lg:col-span-5 space-y-6">
          <div class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-sm space-y-6 sticky top-24">
            <h3 class="text-base font-extrabold text-slate-900 border-b border-slate-100 pb-4">
              Order Summary
            </h3>

            <!-- Item Detail Card -->
            <div class="flex gap-4">
              <img
                src={product.images[0]}
                alt={product.name}
                class="w-20 h-24 object-cover rounded-xl border border-slate-200 flex-shrink-0"
              />
              <div class="space-y-1">
                <span class="text-[10px] font-bold text-blue-600 uppercase tracking-wider">{product.category}</span>
                <h4 class="font-bold text-slate-900 text-xs leading-snug">{product.name}</h4>
                
                <div class="flex items-center gap-2 pt-1 text-[11px] text-slate-500">
                  <span class="bg-slate-100 px-2 py-0.5 rounded font-semibold text-slate-700">Color: {color}</span>
                  <span class="bg-slate-100 px-2 py-0.5 rounded font-semibold text-slate-700">Size: {size}</span>
                </div>

                <div class="text-xs font-bold text-slate-900 pt-1">
                  Qty: {quantity} × ₹{product.price.toLocaleString('en-IN')}
                </div>
              </div>
            </div>

            <!-- Pricing Breakdown -->
            <div class="border-t border-slate-100 pt-4 space-y-2 text-xs">
              <div class="flex justify-between text-slate-600">
                <span>Subtotal</span>
                <span class="font-bold text-slate-900">₹{itemTotal.toLocaleString('en-IN')}</span>
              </div>
              <div class="flex justify-between text-slate-600">
                <span>Express Shipping (India)</span>
                <span class="font-bold text-emerald-600 uppercase">FREE</span>
              </div>
              <div class="flex justify-between text-slate-600">
                <span>Taxes & Duties</span>
                <span class="text-slate-400">Included</span>
              </div>
              <div class="border-t border-slate-200 pt-3 flex justify-between text-slate-900 text-sm font-extrabold">
                <span>Total Amount</span>
                <span class="text-blue-600 text-base">₹{itemTotal.toLocaleString('en-IN')}</span>
              </div>
            </div>

            <!-- Security Badges -->
            <div class="bg-slate-50 rounded-2xl p-4 border border-slate-200 text-center space-y-2">
              <div class="flex items-center justify-center gap-4 text-xs font-bold text-slate-600">
                <span>🛡️ SSL Encrypted</span>
                <span>⚡ 100% Genuine</span>
              </div>
              <p class="text-[10px] text-slate-400">
                Official store checkout. Free replacement within 7 days.
              </p>
            </div>
          </div>
        </div>

      </div>

    </div>
  </div>

  <script is:inline>
    const form = document.getElementById('checkout-form');
    const payBtn = document.getElementById('pay-button');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      payBtn.disabled = true;
      payBtn.innerHTML = '⌛ Processing Order...';

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      try {
        const res = await fetch('/api/checkout/razorpay', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const result = await res.json();

        if (!result.success) {
          alert('Error: ' + (result.error || 'Failed to place order'));
          payBtn.disabled = false;
          payBtn.innerHTML = '🔒 Place Order & Pay';
          return;
        }

        // WhatsApp Order Route
        if (data.paymentMethod === 'WHATSAPP') {
          const msg = `Hi Teepul Store! I placed an order:\n\n*Product:* ${data.productTitle}\n*Color:* ${data.color}\n*Size:* ${data.size}\n*Quantity:* ${data.quantity}\n*Total:* ₹${data.unitPrice * data.quantity}\n*Name:* ${data.customerName}\n*Phone:* ${data.customerPhone}\n*Address:* ${data.shippingAddress}, ${data.pincode}`;
          window.location.href = `https://wa.me/919876543210?text=${encodeURIComponent(msg)}`;
          return;
        }

        // Cash on Delivery or Direct Paytm Route
        if (data.paymentMethod === 'COD' || data.paymentMethod === 'PAYTM') {
          window.location.href = `/checkout/success?orderNumber=${result.orderNumber}`;
          return;
        }

        // Razorpay SDK Checkout Modal Trigger
        if (window.Razorpay) {
          const options = {
            key: result.keyId,
            amount: result.amount,
            currency: result.currency,
            name: "Teepul Streetwear",
            description: `Order ${result.orderNumber}`,
            order_id: result.razorpayOrderId.startsWith('rzp_order_') ? null : result.razorpayOrderId,
            prefill: {
              name: data.customerName,
              email: data.customerEmail,
              contact: data.customerPhone,
            },
            theme: { color: "#2563eb" },
            handler: async function (response) {
              // Verify payment signature
              await fetch('/api/checkout/verify', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  orderId: result.orderId,
                  razorpayPaymentId: response.razorpay_payment_id,
                  razorpayOrderId: response.razorpay_order_id,
                }),
              });

              window.location.href = `/checkout/success?orderNumber=${result.orderNumber}`;
            },
          };

          const rzp = new window.Razorpay(options);
          rzp.open();
        } else {
          // Fallback if Razorpay SDK isn't loaded
          window.location.href = `/checkout/success?orderNumber=${result.orderNumber}`;
        }
      } catch (err) {
        console.error('Checkout error:', err);
        alert('An unexpected error occurred. Please try again.');
        payBtn.disabled = false;
        payBtn.innerHTML = '🔒 Place Order & Pay';
      }
    });
  </script>
</PublicLayout>
