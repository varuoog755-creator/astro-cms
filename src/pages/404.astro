---
import PublicLayout from '../layouts/PublicLayout.astro';
---

<PublicLayout seo={{ title: 'Page Not Found - 404' }}>
  <div class="max-w-md mx-auto text-center py-24 space-y-6">
    <div class="text-6xl font-black text-blue-600">404</div>
    <h1 class="text-2xl font-bold text-gray-900">Page Not Found</h1>
    <p class="text-xs text-gray-500">The page or post you requested could not be located or has been moved.</p>
    <div>
      <a href="/" class="inline-block bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs px-6 py-3 rounded-xl shadow transition">
        Return Home
      </a>
    </div>
  </div>
</PublicLayout>
