---
import PublicLayout from '../layouts/PublicLayout.astro';

Astro.response.status = 404;
---

<PublicLayout seo={{ title: 'Page Not Found (404) - Teepul Luxury Home' }}>
  <div class="max-w-lg mx-auto text-center py-20 px-4 space-y-6">
    <div class="inline-flex items-center gap-2 bg-amber-100 text-amber-900 text-xs font-black px-4 py-1.5 rounded-full uppercase tracking-wider">
      <span>404 ERROR</span>
    </div>
    <div class="text-7xl font-black text-amber-800 tracking-tight">404</div>
    <h1 class="text-3xl font-extrabold text-slate-950">Curtain Collection Not Found</h1>
    <p class="text-xs sm:text-sm text-slate-600 max-w-sm mx-auto leading-relaxed">
      The drapery showcase, article, or catalog page you were searching for has moved or is currently unavailable.
    </p>
    <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
      <a
        href="/products"
        class="bg-amber-800 hover:bg-amber-900 text-white font-extrabold text-xs px-6 py-3.5 rounded-full shadow-lg transition"
      >
        Explore Curtains Store &rarr;
      </a>
      <a
        href="/"
        class="bg-white hover:bg-slate-100 text-slate-800 border border-slate-300 font-bold text-xs px-6 py-3.5 rounded-full shadow-sm transition"
      >
        Back to Home
      </a>
    </div>
  </div>
</PublicLayout>
