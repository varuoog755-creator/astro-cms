        Everything you need to know about Teepul curtains, materials, sizes, and Panipat mill-direct delivery.
      </p>
    </div>

    <div class="space-y-4">
      {homepageFaqs.map((faq, index) => (
        <details class="group bg-white rounded-2xl border border-slate-200 p-5 shadow-sm transition hover:border-amber-400">
          <summary class="flex justify-between items-center cursor-pointer font-bold text-slate-900 text-sm list-none select-none">
            <span class="flex items-center gap-2.5">
              <span class="w-6 h-6 rounded-full bg-amber-100 text-amber-900 font-extrabold text-xs flex items-center justify-center shrink-0">
