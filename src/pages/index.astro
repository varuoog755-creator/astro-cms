---
import PublicLayout from '../layouts/PublicLayout.astro';
import prisma from '../lib/db';
import { getStorefrontProducts, PRODUCTS_CATALOG } from '../lib/products';

let posts: any[] = [];
try {
  posts = await prisma.post.findMany({
    where: { status: 'published' },
    orderBy: { publishedAt: 'desc' },
    take: 3,
    include: { author: true, categories: { include: { category: true } } },
  });
} catch (error) {
  console.error('Failed to load posts for homepage:', error);
}

const allProducts = await getStorefrontProducts();

// Top Sellers: Highest rated items (4.7+)
const topSellers = [...allProducts].sort((a, b) => b.rating - a.rating).slice(0, 4);

// New Arrivals: Latest design launches
const newArrivals = [...allProducts]
  .filter(p => p.id.includes('meesho-ho') || p.id.includes('meesho-hr') || p.id.includes('meesho-c2') || p.badge === 'Teepul Choice')
  .slice(0, 4);

if (newArrivals.length < 4) {
  const existingIds = new Set(newArrivals.map(p => p.id));
  allProducts.forEach(p => {
    if (!existingIds.has(p.id) && newArrivals.length < 4) {
      newArrivals.push(p);
    }
  });
}

const featuredProducts = allProducts.slice(0, 8);
