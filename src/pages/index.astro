---
import PublicLayout from '../layouts/PublicLayout.astro';
import prisma from '../lib/db';
import { getStorefrontProducts, PRODUCTS_CATALOG } from '../lib/products';

let posts: any[] = [];
try {
  posts = await prisma.post.findMany({
    where: { status: 'published' },
    orderBy: { publishedAt: 'desc' },
    take: 3,
    include: { author: true, categories: { include: { category: true } } },
  });
} catch (error) {
  console.error('Failed to load posts for homepage:', error);
}

const allProducts = await getStorefrontProducts();

// Top Sellers: Highest rated items (4.7+)
const topSellers = [...allProducts].sort((a, b) => b.rating - a.rating).slice(0, 4);

// New Arrivals: Latest design launches
const newArrivals = [...allProducts]
  .filter(p => p.id.includes('meesho-ho') || p.id.includes('meesho-hr') || p.id.includes('meesho-c2') || p.badge === 'Teepul Choice')
  .slice(0, 4);

if (newArrivals.length < 4) {
  const existingIds = new Set(newArrivals.map(p => p.id));
  allProducts.forEach(p => {
    if (!existingIds.has(p.id) && newArrivals.length < 4) {
      newArrivals.push(p);
    }
  });
}

const featuredProducts = allProducts.slice(0, 8);

// AEO (Answer Engine Optimization) & GEO (Generative Engine Optimization) FAQs
const homepageFaqs = [
  {
    question: "What fabrics and materials are used in Teepul curtains?",
    answer: "Teepul uses 100% heavyweight virgin polyester, 350+ GSM woven jacquard, slub semi-sheer linen textures, and triple-weave thermal blackout fabrics engineered directly at our Panipat manufacturing mills. They resist fading, block UV rays, and maintain graceful drapes after repeated machine washing."
  },
  {
    question: "What standard sizes do Teepul curtains come in for Indian homes?",
    answer: "Teepul offers 3 standard Indian architectural sizes: Window (5 Feet / 60 Inches / 152 cm), Door (7 Feet / 84 Inches / 213 cm), and Long Door (9 Feet / 108 Inches / 274 cm). All panels come pre-fitted with premium rust-free stainless eyelet grommets for smooth rod sliding."
  },
  {
    question: "How effective are Teepul blackout curtains at blocking sunlight and room heat?",
    answer: "Teepul thermal blackout curtains feature high-density triple-weave construction that blocks up to 99% of harsh tropical sunlight, attenuates external ambient noise, and insulates interiors against summer heat, lowering air conditioning power bills."
  },
  {
    question: "Where is Teepul located and where does it ship?",
    answer: "Teepul is a brand owned by Ashank Ecommerce Pvt Ltd, headquartered in the historic textile hub of Panipat, Haryana, India. We ship directly from our production mills to every pin code across all 28 states and union territories in India with 2-5 day express delivery."
  },
  {
    question: "What is Teepul's return and refund policy?",
    answer: "We offer a 7-day hassle-free door return and replacement policy. If your curtains do not match your room decor or you need a different size or shade, you can initiate a doorstep exchange or refund directly through your Teepul account dashboard or WhatsApp support."
  }
];
---

<PublicLayout
  seo={{
    title: 'Teepul - Luxury Door Curtains, Window Drapery & Home Decor Lighting',
    description: 'Shop luxury door curtains, thermal blackout drapes, linen sheer curtains, and ambient home decor direct from Panipat weaving mills. All-India express delivery with 7-day returns.',
    canonicalUrl: '/',
    preloadLcpImage: featuredProducts[0]?.images?.[0] || PRODUCTS_CATALOG[0]?.images?.[0],
    faqs: homepageFaqs
  }}
>
  
  <!-- Hero Section (Teepul Luxury Light Aesthetic) -->
