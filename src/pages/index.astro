                title="Add to Cart"
              >
                <span class="cart-icon transition-transform duration-300 group-hover/btn:scale-125">🛒</span>
                <span class="btn-text whitespace-nowrap">Add <span class="hidden sm:inline">to Cart</span></span>
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ✨ NEW ARRIVALS SECTION -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12 bg-amber-50/40 rounded-3xl my-6 border border-amber-900/10">
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between mb-6 sm:mb-10 pb-3 border-b border-amber-900/10 gap-2">
