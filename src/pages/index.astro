            </span>
            <span class="transition-transform group-open:rotate-180 text-slate-400 text-xs shrink-0 ml-2">▼</span>
          </summary>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mt-3 pl-8 border-t border-slate-100 pt-3">
            {faq.answer}
          </p>
        </details>
      ))}
    </div>
