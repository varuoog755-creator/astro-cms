            <img
              src={product.images?.[0] || 'https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=1000&q=80'}
              alt={product.name}
              width="400"
              height="400"
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            {product.badge && (
              <span class="absolute top-2 left-2 sm:top-3 sm:left-3 bg-slate-900/90 text-white text-[9px] sm:text-[10px] font-black px-2 py-0.5 sm:px-3 sm:py-1 rounded-full uppercase tracking-wider shadow-md backdrop-blur-sm">
                {product.badge}
              </span>
            )}
          </div>

          <div class="p-3 sm:p-5 space-y-2 sm:space-y-3 flex-1 flex flex-col justify-between">
            <div class="space-y-1.5 sm:space-y-2">
              <div class="flex items-center justify-between text-[10px] sm:text-xs">
                <span class="text-amber-800 font-bold uppercase tracking-wider text-[9px] sm:text-[10px] bg-amber-50 px-2 py-0.5 rounded-md">
                  {product.category}
                </span>
                <div class="flex items-center gap-1 text-amber-500 font-bold text-xs">
                  <span>★</span>
                  <span>{product.rating}</span>
                </div>
              </div>

              <h3 class="text-xs sm:text-sm font-extrabold text-slate-900 group-hover:text-amber-800 transition-colors leading-snug line-clamp-2">
                <a href={`/products/${product.slug}`}>{product.name}</a>
              </h3>
              
              <p class="text-[11px] sm:text-xs text-slate-500 line-clamp-2 leading-relaxed">{product.tagline}</p>
            </div>

            <div class="pt-2 sm:pt-3 border-t border-slate-100 flex items-center justify-between gap-1">
              <div>
                <span class="text-sm sm:text-lg font-black text-slate-900">{product.currency}{product.price.toLocaleString('en-IN')}</span>
                {product.originalPrice && (
                  <span class="text-[10px] sm:text-xs text-slate-400 line-through font-medium block sm:inline sm:ml-1">{product.currency}{product.originalPrice.toLocaleString('en-IN')}</span>
                )}
              </div>

              <button
                type="button"
                onclick={`window.animatedAddToCart(this, '${product.name.replace(/'/g, "\\'")}', '${product.slug}', ${product.price}, '${product.images?.[0] || ''}')`}
                class="bg-amber-800 hover:bg-amber-900 text-white font-extrabold text-[10px] sm:text-xs px-2.5 py-1.5 sm:px-3.5 sm:py-2.5 rounded-xl shadow active:scale-95 transition-all duration-300 shrink-0 flex items-center gap-1 group/btn cursor-pointer whitespace-nowrap"
                title="Add to Cart"
              >
                <span class="cart-icon transition-transform duration-300 group-hover/btn:scale-125">🛒</span>
                <span class="btn-text whitespace-nowrap">Add <span class="hidden sm:inline">to Cart</span></span>
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Customer Verified Reviews Section -->
