            ★★★★★ <span class="text-slate-900 text-xs ml-1 font-bold">5.0</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed italic">
            "Sheer linen window drapes diffuses light beautifully during morning sunshine. Delivered in 2 days to Bangalore. Extremely impressed with Teepul!"
          </p>
          <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="font-bold text-slate-900">Vikram S. (Bengaluru)</span>
            <span class="text-emerald-600 font-semibold">✓ Verified Buyer</span>
          </div>
        </div>

        <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm space-y-4">
          <div class="flex items-center gap-1 text-amber-500 text-sm font-bold">
            ★★★★★ <span class="text-slate-900 text-xs ml-1 font-bold">5.0</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed italic">
            "Ordered the Nordic Brass Globe Lamp along with Jacquard Cushions. The warm lighting creates such a luxurious aesthetic."
          </p>
          <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="font-bold text-slate-900">Pooja M. (Mumbai)</span>
            <span class="text-emerald-600 font-semibold">✓ Verified Buyer</span>
          </div>
        </div>
      </div>
    </div>
  </section>



  <!-- Panipat Heritage & Direct-from-Mill Entity Assurance (GEO / Brand Authority) -->
  <section class="bg-amber-950 text-amber-100 py-16 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
      <div class="space-y-4">
        <span class="text-amber-400 text-xs font-black uppercase tracking-widest">Direct From Panipat Mills</span>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight leading-tight">
