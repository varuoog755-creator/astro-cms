        <div class="grid grid-cols-3 gap-4 pt-4 border-t border-amber-900 text-center">
          <div class="p-3 bg-amber-900/40 rounded-2xl border border-amber-800/60">
            <div class="text-xl font-black text-amber-300">100%</div>
            <div class="text-[10px] uppercase font-bold text-amber-200 mt-1">Pre-Shrunk</div>
