---
import PublicLayout from '../layouts/PublicLayout.astro';
import prisma from '../lib/db';

const posts = await prisma.post.findMany({
  where: { status: 'published' },
  orderBy: { publishedAt: 'desc' },
  take: 6,
  include: { author: true, categories: { include: { category: true } } },
});

const featuredPost = posts[0];
const recentPosts = posts.slice(1);
---

<PublicLayout seo={{ title: 'Home - Modern Astro CMS' }}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Hero Banner -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <span class="bg-blue-100 text-blue-800 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
        ⚡ Astro CMS Engine
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 tracking-tight leading-tight">
        Modern Publishing Platform for High Performance
      </h1>
      <p class="text-lg text-gray-600">
        An open-architecture CMS built on Astro 7.2, TypeScript, and Prisma ORM. Zero bloated client JS, maximum Core Web Vitals score.
      </p>
    </div>

    {featuredPost && (
      <div class="bg-white rounded-3xl border border-gray-200 shadow-lg overflow-hidden mb-16 grid grid-cols-1 md:grid-cols-2">
        <div class="p-8 md:p-12 flex flex-col justify-between">
          <div class="space-y-4">
            <div class="flex items-center gap-2">
              {featuredPost.categories.map((c) => (
                <span class="bg-blue-50 text-blue-700 font-bold px-2.5 py-0.5 rounded-full text-xs">
                  {c.category.name}
                </span>
              ))}
            </div>
            <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 leading-snug">
              <a href={`/blog/${featuredPost.slug}`} class="hover:text-blue-600 transition">
                {featuredPost.title}
              </a>
            </h2>
            <p class="text-gray-600 text-sm line-clamp-3 leading-relaxed">{featuredPost.excerpt}</p>
          </div>

          <div class="mt-8 flex items-center justify-between pt-6 border-t border-gray-100 text-xs text-gray-500">
            <span class="font-semibold text-gray-800">By {featuredPost.author.displayName}</span>
            <span>{new Date(featuredPost.publishedAt || featuredPost.createdAt).toLocaleDateString()}</span>
          </div>
        </div>

        <div class="bg-slate-900 p-8 flex items-center justify-center text-white">
          <div class="text-center space-y-2">
            <div class="text-5xl">🚀</div>
            <div class="font-bold text-xl">Featured Article</div>
            <div class="text-xs text-slate-400">Fast SSR Block Content Rendering</div>
          </div>
        </div>
      </div>
    )}

    <!-- Recent Grid -->
    <h2 class="text-2xl font-bold text-gray-900 mb-8">Latest Articles</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {recentPosts.map((post) => (
        <article class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 flex flex-col justify-between hover:shadow-md transition">
          <div class="space-y-3">
            <div class="flex items-center gap-2">
              {post.categories.map((c) => (
                <span class="bg-gray-100 text-gray-700 font-semibold px-2 py-0.5 rounded text-[10px]">
                  {c.category.name}
                </span>
              ))}
            </div>
            <h3 class="font-bold text-lg text-gray-900 leading-snug">
              <a href={`/blog/${post.slug}`} class="hover:text-blue-600 transition">
                {post.title}
              </a>
            </h3>
            <p class="text-xs text-gray-600 line-clamp-2">{post.excerpt}</p>
          </div>

          <div class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between text-xs text-gray-500">
            <span>{post.author.displayName}</span>
            <span>{new Date(post.createdAt).toLocaleDateString()}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</PublicLayout>
