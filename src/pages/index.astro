---
import PublicLayout from '../layouts/PublicLayout.astro';
import prisma from '../lib/db';
import { getStorefrontProducts, PRODUCTS_CATALOG } from '../lib/products';
import { getOrSetCache } from '../lib/cache';

// Parallel cached loading for ultra-fast homepage TTFB
const [posts, allProducts] = await Promise.all([
  getOrSetCache('homepage_posts', 120, async () => {
    try {
      return await prisma.post.findMany({
        where: { status: 'published' },
        orderBy: { publishedAt: 'desc' },
        take: 3,
        include: { author: true, categories: { include: { category: true } } },
      });
    } catch (error) {
      console.error('Failed to load posts for homepage:', error);
      return [];
    }
  }),
  getStorefrontProducts(),
]);

// Top Sellers: Highest rated items (4.7+)
const topSellers = [...allProducts].sort((a, b) => b.rating - a.rating).slice(0, 8);

const categories = [
  {
    name: 'Living Room',
    tagline: '7ft & 9ft Statement Drapes',
    image: '/images/category-living-room.jpg',
    href: '/products?category=Living+Room',
    badge: 'Trending',
  },
  {
    name: 'Bedroom Blackout',
    tagline: '85%+ Glare & Thermal Shield',
    image: '/images/category-bedroom.jpg',
    href: '/products?category=Bedroom',
    badge: 'Popular',
  },
  {
    name: 'Door Curtains',
    tagline: '7 FT Standard Door Height',
    image: '/images/hero-curtains.jpg',
    href: '/products?category=Door+Curtains',
    badge: 'Most Bought',
  },
  {
    name: 'Window Curtains',
    tagline: '5 FT Standard Window Fit',
    image: '/images/size-guide-comparison.jpg',
    href: '/products?category=Window+Curtains',
    badge: 'Essential',
  },
  {
    name: 'Combo Packs',
    tagline: 'Curated Sets for Full Home',
    image: '/images/colors-palette.jpg',
    href: '/products?category=Combo+Packs',
    badge: 'Extra Value',
  },
];

const colorHues = [
  { name: 'Royal Maroon', hex: '#7B1830', bgClass: 'bg-[#7B1830]', textClass: 'text-white', slug: 'maroon' },
  { name: 'Coffee Brown', hex: '#4A2C2A', bgClass: 'bg-[#4A2C2A]', textClass: 'text-white', slug: 'brown' },
  { name: 'Navy Blue', hex: '#1B2E4B', bgClass: 'bg-[#1B2E4B]', textClass: 'text-white', slug: 'navy' },
  { name: 'Slate Grey', hex: '#4B5563', bgClass: 'bg-[#4B5563]', textClass: 'text-white', slug: 'grey' },
  { name: 'Blush Pink', hex: '#E8A598', bgClass: 'bg-[#E8A598]', textClass: 'text-slate-900', slug: 'pink' },
  { name: 'Jet Black', hex: '#1E1E1E', bgClass: 'bg-[#1E1E1E]', textClass: 'text-white', slug: 'black' },
];

const ugcVideos = [
  {
    src: '/ugc/ugc-1.mp4',
    title: 'Panipat Factory-Direct Craft',
    tag: '⚡ Direct Mill Finish',
  },
  {
    src: '/ugc/ugc-2.mp4',
    title: '85%+ Blackout & Room Darkening',
    tag: '☀️ Thermal Shield',
  },
  {
    src: '/ugc/ugc-3.mp4',
    title: 'Anti-Rust Eyelets & Smooth Glide',
    tag: '✨ Stainless Rings',
  },
  {
    src: '/ugc/ugc-4.mp4',
    title: 'Living Room Real Home Aesthetic',
    tag: '🏡 Real Indian Homes',
  },
];

const customerReviews = [
  {
    name: 'Pooja Sharma',
    city: 'South Delhi',
    rating: 5,
    title: 'Completely transformed our living room',
    comment: 'The 9ft velvet door curtains completely changed the vibe of our living room. 85%+ blackout, heavy fabric fall, and smooth rust-free brass eyelets!',
  },
  {
    name: 'Vikram Sundaram',
    city: 'Bengaluru',
    rating: 5,
    title: 'Accurate sizing & fast Panipat delivery',
    comment: 'Delivered in 3 days to Bangalore. The eyelet rings glide effortlessly on the rod and the fabric does not wrinkle or bleed color after washing.',
  },
  {
    name: 'Ananya Deshmukh',
    city: 'Mumbai',
    rating: 5,
    title: 'Best value factory-direct curtains',
    comment: 'Bought 3 sets of Pack of 2 for our bedrooms and balcony. Direct factory price is unmatchable compared to offline retail showrooms.',
  },
];

const homepageFaqs = [
  {
    category: 'Size Guide',
    question: 'How do I choose the right curtain size for my windows or doors?',
    answer: 'Measure from your curtain rod to the floor or sill: Window curtains are 5 Feet (152 cm). Standard Door curtains are 7 Feet (213 cm). Long Door / Balcony curtains are 9 Feet (274 cm). Every panel comes pre-fitted with 48mm eyelet grommets for standard rods.',
  },
  {
    category: 'Fabric & Quality',
    question: 'What fabric materials are used in Teepul curtains?',
    answer: 'Teepul uses 100% premium virgin polyester, dense woven jacquard, and crushed textures directly manufactured in Panipat mills. Fabrics are pre-shrunk, fade-resistant, and provide superior room darkening.',
  },
  {
    category: 'Wash Care',
    question: 'Are these curtains safe for home washing?',
    answer: 'Yes. All Teepul curtains are 100% machine wash and hand wash safe in cold water. The eyelet rings are manufactured with anti-rust stainless alloy that will not corrode or stain the fabric.',
  },
  {
    category: 'Delivery & COD',
    question: 'What is the delivery timeline and shipping cost?',
    answer: 'We offer 100% Free Express Shipping and Cash on Delivery across India. Orders are dispatched from our Panipat manufacturing unit within 24 hours and delivered in 2 to 5 business days to all pin codes.',
  },
  {
    category: 'Returns & Replacements',
    question: 'What is Teepul’s return and size exchange policy?',
    answer: 'We offer a 7-day hassle-free door return and replacement policy. If you need a different size, shade, or pattern, you can initiate a doorstep pickup directly through WhatsApp or your account.',
  },
];
---

<PublicLayout
  seo={{
    title: 'Teepul - Premium Curtains & Luxury Home Decor for Indian Homes',
    description: 'Shop luxury door curtains, blackout window drapes, and textured eyelet curtains direct from Panipat mills. Free express delivery, Cash on Delivery, and 7-day easy replacements.',
    canonicalUrl: '/',
    preloadLcpImage: '/images/hero-curtains.jpg',
    faqs: homepageFaqs.map(f => ({ question: f.question, answer: f.answer }))
  }}
>

  <!-- ========================================================================= -->
  <!-- 1. HERO SECTION (Editorial Indian Home Decor Showcase)                    -->
  <!-- ========================================================================= -->
  <section class="relative bg-gradient-to-b from-[#FFF8F1] via-[#FDF5EB] to-[#F3E5D5]/40 overflow-hidden pt-8 pb-14 sm:pt-14 sm:pb-24 border-b border-[#7B1830]/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        
        <!-- Left Text & CTAs (7 cols) -->
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          
          <!-- Trust Pill -->
          <div class="inline-flex items-center gap-2 bg-[#7B1830]/10 border border-[#7B1830]/20 px-3.5 py-1.5 rounded-full shadow-xs">
            <span class="w-2 h-2 rounded-full bg-[#7B1830] animate-pulse"></span>
            <span class="text-[11px] sm:text-xs font-black uppercase tracking-wider text-[#7B1830]">
              Direct From Panipat Weaving Mills
            </span>
          </div>

          <!-- Main Heading -->
          <div class="space-y-3">
            <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-serif text-[#171717] tracking-tight leading-[1.15]">
              Ghar Ko Banaye Aur Bhi <span class="text-[#7B1830] underline decoration-[#7B1830]/30 underline-offset-8">Khoobsurat</span>
            </h1>
            <p class="text-sm sm:text-lg text-[#6B625D] font-medium max-w-2xl leading-relaxed">
              Stylish, Durable &amp; Budget Friendly Curtains for Every Indian Home. Heavyweight drape, 85%+ glare control, and anti-rust pre-fitted rings.
            </p>
          </div>

          <!-- Feature Badges Row -->
          <div class="flex flex-wrap items-center justify-center lg:justify-start gap-2 sm:gap-2.5 pt-1">
            <span class="inline-flex items-center gap-1.5 bg-white px-3 py-1.5 rounded-full text-xs font-bold text-slate-800 border border-slate-200 shadow-xs">
              <span class="text-[#7B1830]">✦</span> Premium Fabric
            </span>
            <span class="inline-flex items-center gap-1.5 bg-white px-3 py-1.5 rounded-full text-xs font-bold text-slate-800 border border-slate-200 shadow-xs">
              <span class="text-[#7B1830]">✦</span> Easy to Wash
            </span>
            <span class="inline-flex items-center gap-1.5 bg-white px-3 py-1.5 rounded-full text-xs font-bold text-slate-800 border border-slate-200 shadow-xs">
              <span class="text-[#7B1830]">✦</span> Fade Resistant
            </span>
            <span class="inline-flex items-center gap-1.5 bg-white px-3 py-1.5 rounded-full text-xs font-bold text-slate-800 border border-slate-200 shadow-xs">
              <span class="text-[#7B1830]">✦</span> Pre-Fitted Eyelets
            </span>
            <span class="inline-flex items-center gap-1.5 bg-white px-3 py-1.5 rounded-full text-xs font-bold text-[#7B1830] border border-[#7B1830]/20 shadow-xs">
              <span>🇮🇳</span> Perfect for Indian Homes
            </span>
          </div>

          <!-- Action Buttons & Guarantee -->
          <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
            <a
              href="/products"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-[#7B1830] hover:bg-[#4A0F1D] text-white font-extrabold text-sm sm:text-base px-8 py-4 rounded-2xl shadow-xl hover:shadow-2xl hover:-translate-y-0.5 transition-all duration-300 active:scale-95 text-center cursor-pointer"
            >
              <span>🛍️ Shop Curtains</span>
              <span>&rarr;</span>
            </a>
            
            <a
              href="#size-guide"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-white hover:bg-[#FFF8F1] text-slate-900 font-bold text-sm sm:text-base px-7 py-4 rounded-2xl border border-slate-300 shadow-sm transition hover:border-[#7B1830]/40 text-center"
            >
              <span>📏 Visual Size Guide</span>
            </a>
          </div>

          <!-- Social Proof Micro Banner -->
          <div class="pt-4 flex flex-wrap items-center justify-center lg:justify-start gap-6 text-xs text-slate-600 font-medium">
            <div class="flex items-center gap-2">
              <div class="flex text-amber-500 text-sm">★★★★★</div>
              <span class="font-bold text-slate-900">4.9 / 5.0</span>
              <span class="text-slate-400">|</span>
              <span>10,000+ Indian Homes</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-emerald-700 font-bold">✓ Cash on Delivery</span>
              <span class="text-slate-400">|</span>
              <span class="text-emerald-700 font-bold">✓ Free Express Shipping</span>
            </div>
          </div>

        </div>

        <!-- Right Hero Image Showcase (5 cols) -->
        <div class="lg:col-span-5 relative">
          <div class="relative mx-auto max-w-md lg:max-w-none">
            <!-- Decorative Glow Background -->
            <div class="absolute -inset-2 bg-gradient-to-tr from-[#7B1830]/20 via-[#F3E5D5] to-[#7B1830]/10 rounded-3xl blur-xl opacity-70 transform -rotate-1"></div>
            
            <!-- Main Hero Image Card -->
            <div class="relative bg-white rounded-3xl overflow-hidden shadow-2xl border-4 border-white">
              <img
                src="/images/hero-curtains.jpg"
                alt="Modern Indian living room with luxury maroon curtains and natural daylight"
                width="800"
                height="800"
                class="w-full aspect-[4/5] object-cover hover:scale-105 transition-transform duration-700"
                loading="eager"
                decoding="async"
              />
              
              <!-- Floating Overlay Tags -->
              <div class="absolute top-4 left-4 bg-slate-950/80 backdrop-blur-md text-white text-[11px] font-black px-3.5 py-1.5 rounded-full border border-white/20 shadow-lg flex items-center gap-1.5">
                <span class="text-amber-400">★</span>
                <span>Top Selling Maroon Leaf Drapes</span>
              </div>

              <div class="absolute bottom-4 inset-x-4 bg-white/95 backdrop-blur-md rounded-2xl p-4 shadow-xl border border-slate-200/80 flex items-center justify-between">
                <div>
                  <div class="text-[11px] font-bold text-slate-500 uppercase tracking-wider">Starting From</div>
                  <div class="flex items-baseline gap-1.5">
                    <span class="text-xl font-black text-[#7B1830]">₹455</span>
                    <span class="text-xs text-slate-400 line-through">₹1,299</span>
                    <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded">65% OFF</span>
                  </div>
                </div>
                <a
                  href="/products"
                  class="bg-[#7B1830] hover:bg-[#4A0F1D] text-white text-xs font-extrabold px-4 py-2.5 rounded-xl shadow transition"
                >
                  View Collection &rarr;
                </a>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 2. CATEGORY BROWSER (Horizontal on Mobile, Grid on Desktop)                -->
  <!-- ========================================================================= -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between mb-8 pb-3 border-b border-slate-200 gap-2">
      <div>
        <span class="text-[11px] font-black uppercase text-[#7B1830] tracking-widest bg-[#7B1830]/10 px-3 py-1 rounded-full">
          CURATED ROOM SOLUTIONS
        </span>
        <h2 class="text-2xl sm:text-3xl font-black font-serif text-slate-950 mt-2">Shop by Category</h2>
      </div>
      <a href="/products" class="text-xs font-bold text-[#7B1830] hover:underline flex items-center gap-1">
        <span>View All Categories</span>
        <span>&rarr;</span>
      </a>
    </div>

    <!-- Scrollable container on mobile, 5 cols on desktop -->
    <div class="flex sm:grid sm:grid-cols-3 lg:grid-cols-5 gap-4 overflow-x-auto no-scrollbar pb-3 snap-x snap-mandatory">
      {categories.map((cat) => (
        <a
          href={cat.href}
          class="min-w-[200px] sm:min-w-0 flex-1 bg-white rounded-3xl border border-slate-200/90 shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 overflow-hidden group snap-start flex flex-col justify-between"
        >
          <div class="relative aspect-[4/3] bg-slate-100 overflow-hidden">
            <img
              src={cat.image}
              alt={cat.name}
              width="400"
              height="300"
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
              loading="lazy"
            />
            <span class="absolute top-2.5 left-2.5 bg-slate-900/80 backdrop-blur-md text-white text-[9px] font-black px-2.5 py-0.5 rounded-full uppercase tracking-wider shadow">
              {cat.badge}
            </span>
          </div>

          <div class="p-4 bg-white text-center space-y-1">
            <h3 class="font-extrabold text-sm sm:text-base text-slate-900 group-hover:text-[#7B1830] transition-colors">
              {cat.name}
            </h3>
            <p class="text-[11px] text-slate-500 line-clamp-1 leading-snug">
              {cat.tagline}
            </p>
            <span class="text-[11px] font-bold text-[#7B1830] pt-2 inline-block group-hover:underline">
              Explore &rarr;
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 3. SHOP BY COLOR PALETTE                                                  -->
  <!-- ========================================================================= -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="bg-gradient-to-r from-[#FFF8F1] via-[#FDF5EB] to-[#F3E5D5]/60 rounded-3xl border border-[#7B1830]/15 p-6 sm:p-10 shadow-sm">
      <div class="flex flex-col md:flex-row items-center justify-between gap-6 mb-8">
        <div class="text-center md:text-left space-y-1">
          <span class="text-[10px] sm:text-xs font-black uppercase text-[#7B1830] tracking-widest bg-white px-3 py-1 rounded-full border border-[#7B1830]/20">
            ROOM COLOR HARMONY
          </span>
          <h2 class="text-2xl sm:text-3xl font-black font-serif text-slate-950">Shop by Color</h2>
          <p class="text-xs sm:text-sm text-slate-600">Select rich Panipat jacquard and solid shades matched to your wall tones.</p>
        </div>
        
        <a href="/products" class="text-xs font-black text-[#7B1830] bg-white px-4 py-2 rounded-xl border border-slate-200 shadow-xs hover:bg-[#7B1830] hover:text-white transition">
          View All Hues &rarr;
        </a>
      </div>

      <!-- Color Swatches Grid -->
      <div class="grid grid-cols-3 sm:grid-cols-6 gap-3 sm:gap-4">
        {colorHues.map((color) => (
          <a
            href={`/products?color=${color.name}`}
            class="bg-white rounded-2xl p-3 sm:p-4 border border-slate-200 shadow-xs hover:shadow-lg hover:-translate-y-1 transition text-center flex flex-col items-center gap-2.5 group"
          >
            <div class={`w-12 h-12 sm:w-14 sm:h-14 rounded-full ${color.bgClass} shadow-md border-2 border-white ring-2 ring-slate-200 group-hover:scale-110 group-hover:ring-[#7B1830] transition duration-300 flex items-center justify-center`}>
            </div>
            <div class="space-y-0.5">
              <span class="text-xs font-extrabold text-slate-900 block group-hover:text-[#7B1830] transition">
                {color.name}
              </span>
              <span class="text-[10px] text-slate-400 font-mono block">
                {color.hex}
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 4. VISUAL SIZE GUIDE SECTION (5 FT, 7 FT, 9 FT)                           -->
  <!-- ========================================================================= -->
  <section id="size-guide" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 scroll-mt-24">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-[11px] font-black uppercase text-[#7B1830] tracking-widest bg-[#7B1830]/10 px-3.5 py-1 rounded-full">
        ZERO CONFUSION MEASUREMENTS
      </span>
      <h2 class="text-3xl sm:text-4xl font-black font-serif text-slate-950 mt-3">Simple 3-Size Guide</h2>
      <p class="text-xs sm:text-sm text-slate-600 mt-2">
        Standard Indian home dimensions. Every curtain panel width is standard 4 Feet (48 inches / 122 cm).
      </p>
    </div>

    <!-- 3 Sizing Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 items-stretch mb-8">
      
      <!-- 5 FT Window -->
      <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 sm:p-7 flex flex-col justify-between hover:border-[#7B1830]/50 hover:shadow-xl transition duration-300">
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-2xl font-black text-[#7B1830]">5 FT</span>
            <span class="text-[10px] font-black uppercase tracking-wider bg-slate-100 text-slate-700 px-2.5 py-1 rounded-full">
              152 CM / 60 INCH
            </span>
          </div>
          <div>
            <h3 class="text-lg font-black text-slate-900">Window Curtain</h3>
            <p class="text-xs text-slate-500 mt-1">Standard bedroom, study, and kitchen windows extending just past the sill.</p>
          </div>
          <ul class="space-y-2 text-xs text-slate-700 font-medium pt-2 border-t border-slate-100">
            <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> 8 Pre-fitted eyelet rings</li>
            <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> 4 Feet wide standard panel</li>
            <li class="flex items-center gap-2"><span class="text-emerald-600 font-bold">✓</span> Eliminates table/sill interference</li>
          </ul>
        </div>
        <div class="pt-6">
          <a
            href="/products?size=5ft"
            class="block w-full text-center bg-slate-100 hover:bg-[#7B1830] hover:text-white text-slate-900 font-extrabold text-xs py-3 rounded-xl transition"
          >
            Shop 5 FT Windows (From ₹455) &rarr;
          </a>
        </div>
      </div>

      <!-- 7 FT Door (Most Popular) -->
      <div class="bg-gradient-to-b from-[#FFF8F1] to-white rounded-3xl border-2 border-[#7B1830] shadow-xl p-6 sm:p-7 flex flex-col justify-between relative transform md:-translate-y-2">
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 bg-[#7B1830] text-white text-[10px] font-black px-4 py-1 rounded-full uppercase tracking-wider shadow">
          ⭐ MOST POPULAR FOR INDIAN HOMES
        </div>
        <div class="space-y-4 pt-2">
          <div class="flex items-center justify-between">
            <span class="text-3xl font-black text-[#7B1830]">7 FT</span>
            <span class="text-[10px] font-black uppercase tracking-wider bg-[#7B1830]/10 text-[#7B1830] px-2.5 py-1 rounded-full font-bold">
              213 CM / 84 INCH
            </span>
          </div>
          <div>
            <h3 class="text-lg font-black text-slate-900">Standard Door Curtain</h3>
            <p class="text-xs text-slate-600 mt-1">Standard height for bedroom doors, hall entryways, and 7ft patio doors.</p>
          </div>
          <ul class="space-y-2 text-xs text-slate-800 font-semibold pt-2 border-t border-[#7B1830]/10">
            <li class="flex items-center gap-2"><span class="text-[#7B1830] font-bold">✓</span> Fits 90% of Indian room doors</li>
            <li class="flex items-center gap-2"><span class="text-[#7B1830] font-bold">✓</span> Floor skimming architectural fall</li>
            <li class="flex items-center gap-2"><span class="text-[#7B1830] font-bold">✓</span> 85%+ glare &amp; dust shield</li>
          </ul>
        </div>
        <div class="pt-6">
          <a
            href="/products?size=7ft"
            class="block w-full text-center bg-[#7B1830] hover:bg-[#4A0F1D] text-white font-extrabold text-xs py-3.5 rounded-xl shadow-lg transition"
          >
            Shop 7 FT Doors (From ₹515) &rarr;
          </a>
        </div>
      </div>

      <!-- 9 FT Long Door / Balcony -->
      <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 sm:p-7 flex flex-col justify-between hover:border-[#7B1830]/50 hover:shadow-xl transition duration-300">
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-2xl font-black text-[#7B1830]">9 FT</span>
            <span class="text-[10px] font-black uppercase tracking-wider bg-slate-100 text-slate-700 px-2.5 py-1 rounded-full">
              274 CM / 108 INCH
            </span>
          </div>
          <div>
            <h3 class="text-lg font-black text-slate-900">Long Door &amp; Balcony</h3>
            <p class="text-xs text-slate-500 mt-1">High ceiling living rooms, French glass doors, and luxury floor-to-ceiling drapery.</p>
          </div>
