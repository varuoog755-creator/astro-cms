---
import PublicLayout from '../layouts/PublicLayout.astro';
import prisma from '../lib/db';
import { getStorefrontProducts, PRODUCTS_CATALOG } from '../lib/products';
import { getOrSetCache } from '../lib/cache';

// Parallel cached loading for ultra-fast homepage TTFB
const [posts, allProducts] = await Promise.all([
  getOrSetCache('homepage_posts', 120, async () => {
    try {
      return await prisma.post.findMany({
        where: { status: 'published' },
        orderBy: { publishedAt: 'desc' },
        take: 3,
        include: { author: true, categories: { include: { category: true } } },
      });
    } catch (error) {
      console.error('Failed to load posts for homepage:', error);
      return [];
    }
  }),
  getStorefrontProducts(),
]);

// Top Sellers: Highest rated items (4.7+)
const topSellers = [...allProducts].sort((a, b) => b.rating - a.rating).slice(0, 8);

const ugcVideos = [
  {
    src: '/ugc/ugc-1.mp4',
    title: 'Panipat Factory-Direct Craft',
    tag: '⚡ Direct Mill Finish',
  },
  {
    src: '/ugc/ugc-2.mp4',
    title: '85%+ Blackout & Room Darkening',
    tag: '☀️ Thermal Shield',
  },
  {
    src: '/ugc/ugc-3.mp4',
    title: 'Anti-Rust Eyelets & Smooth Glide',
    tag: '✨ Stainless Rings',
  },
  {
    src: '/ugc/ugc-4.mp4',
    title: 'Living Room Real Home Aesthetic',
    tag: '🏡 Real Indian Homes',
  },
];

const customerReviews = [
  {
    name: 'Pooja Sharma',
    city: 'South Delhi',
    rating: 5,
    title: 'Completely transformed our living room',
    comment: 'The 9ft velvet door curtains completely changed the vibe of our living room. 85%+ blackout, heavy fabric fall, and smooth rust-free brass eyelets!',
  },
  {
    name: 'Vikram Sundaram',
    city: 'Bengaluru',
    rating: 5,
    title: 'Accurate sizing & fast Panipat delivery',
    comment: 'Delivered in 3 days to Bangalore. The eyelet rings glide effortlessly on the rod and the fabric does not wrinkle or bleed color after washing.',
  },
  {
    name: 'Ananya Deshmukh',
    city: 'Mumbai',
    rating: 5,
    title: 'Best value factory-direct curtains',
    comment: 'Bought 3 sets of Pack of 2 for our bedrooms and balcony. Direct factory price is unmatchable compared to offline retail showrooms.',
  },
];

const homepageFaqs = [
  {
    category: 'Size Guide',
    question: 'How do I choose the right curtain size for my windows or doors?',
    answer: 'Measure your rod to the floor or sill: Window curtains are 5 Feet (152 cm). Standard Door curtains are 7 Feet (213 cm). Long Door / Balcony curtains are 9 Feet (274 cm). Every panel comes pre-fitted with eyelet grommets designed for standard rods.',
  },
  {
    category: 'Fabric & Quality',
    question: 'What fabric materials are used in Teepul curtains?',
    answer: 'Teepul uses 100% premium virgin polyester, dense woven jacquard, and crushed velvet textures directly manufactured in Panipat mills. Fabrics are pre-shrunk, fade-resistant, and provide superior room darkening.',
  },
  {
    category: 'Wash Care',
    question: 'Are these curtains safe for home washing?',
    answer: 'Yes. All Teepul curtains are 100% machine wash and hand wash safe in cold water. The eyelet rings are manufactured with anti-rust stainless alloy that will not corrode or stain the fabric.',
  },
  {
    category: 'Delivery',
    question: 'What is the delivery timeline and shipping cost?',
    answer: 'We offer 100% Free Express Shipping across India. Orders are dispatched from our Panipat manufacturing unit within 24 hours and delivered in 2 to 5 business days to all pin codes.',
  },
  {
    category: 'Returns & Replacements',
    question: 'What is Teepul’s return and size exchange policy?',
    answer: 'We offer a 7-day hassle-free door return and replacement policy. If you need a different size, shade, or pattern, you can initiate a doorstep pickup directly through WhatsApp or your account.',
  },
];
---

<PublicLayout
  seo={{
    title: 'Teepul - Luxury Door Curtains, Window Drapery & Home Decor',
    description: 'Shop luxury door curtains, thermal blackout drapes, linen sheer curtains, and printed eyelet curtains direct from Panipat weaving mills. All-India express delivery with 7-day returns.',
    canonicalUrl: '/',
    preloadLcpImage: topSellers[0]?.images?.[0] || PRODUCTS_CATALOG[0]?.images?.[0],
    faqs: homepageFaqs.map(f => ({ question: f.question, answer: f.answer }))
  }}
>

  <!-- 1. HERO SECTION -->
  <section class="relative bg-white text-slate-900 overflow-hidden py-12 lg:py-20 px-4 sm:px-6 lg:px-8 border-b border-slate-200/80">
    <div class="relative max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Hero Copy -->
      <div class="lg:col-span-7 space-y-6 text-left">
        <div class="inline-flex items-center gap-2 bg-amber-50 border border-amber-200 text-amber-900 text-[11px] font-extrabold px-3.5 py-1.5 rounded-full uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>PANIPAT MILLS · FACTORY DIRECT VALUE</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-slate-950 leading-[1.12]">
          Room ka look <span class="text-amber-800 underline decoration-amber-300 decoration-wavy">dull lag raha hai?</span>
        </h1>

        <p class="text-slate-600 text-sm sm:text-base leading-relaxed max-w-2xl font-normal">
          Upgrade your home with Panipat factory-direct luxury curtains. Heavyweight <strong>85%+ room-darkening drapes</strong>, pre-fitted rust-proof eyelet rings, and elegant fall for every window &amp; door.
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a
            href="/products"
            class="bg-slate-900 hover:bg-slate-800 active:scale-95 text-white font-black text-xs sm:text-sm px-8 py-4 rounded-full shadow-lg hover:-translate-y-0.5 transition-all flex items-center gap-2"
          >
            <span>🛍️ Shop Curtains</span>
            <span>&rarr;</span>
          </a>

          <a
            href="/products"
            class="bg-white hover:bg-slate-50 active:scale-95 text-slate-900 border border-slate-300 font-bold text-xs sm:text-sm px-6 py-4 rounded-full shadow-xs hover:-translate-y-0.5 transition-all flex items-center gap-2"
          >
            <span>✨ View All Designs</span>
          </a>
        </div>

        <!-- Trust Highlights -->
        <div class="grid grid-cols-3 gap-4 pt-6 border-t border-slate-100 text-xs">
          <div>
            <div class="text-xl sm:text-2xl font-black text-slate-900">Pack of 2</div>
            <div class="text-slate-500 text-[11px] mt-0.5">2 Full Panels Included</div>
          </div>
          <div>
            <div class="text-xl sm:text-2xl font-black text-amber-800">85%+ Blackout</div>
            <div class="text-slate-500 text-[11px] mt-0.5">Thermal &amp; Glare Shield</div>
          </div>
          <div>
            <div class="text-xl sm:text-2xl font-black text-emerald-700">★ 4.9 Rating</div>
            <div class="text-slate-500 text-[11px] mt-0.5">10,000+ Happy Homes</div>
          </div>
        </div>
      </div>

      <!-- Hero Visual Grid -->
      <div class="lg:col-span-5 relative">
        <div class="grid grid-cols-2 gap-4">
          <div class="space-y-4">
            <div class="rounded-3xl overflow-hidden shadow-sm border border-slate-200 aspect-[4/5] bg-white group">
              <img
                src={topSellers[0]?.images?.[0] || 'https://images.meesho.com/images/products/423378719/fp7sq_512.jpg'}
                alt="Teepul Door Curtains - Premium Thermal Blackout Drapery"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                width="400"
                height="500"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="p-3 bg-white/95 backdrop-blur-md -mt-12 relative text-center">
                <span class="text-[10px] font-bold uppercase text-slate-900 tracking-wider">Thermal Blackout</span>
              </div>
            </div>
            <div class="rounded-3xl overflow-hidden shadow-xs border border-slate-200 aspect-square bg-white group">
              <img
                src={topSellers[2]?.images?.[0] || 'https://images.meesho.com/images/products/842387294/qxit7_512.jpg'}
                alt="Teepul Luxury Printed & Eyelet Curtains"
                loading="lazy"
                decoding="async"
                width="400"
                height="400"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
          </div>

          <div class="space-y-4 pt-8">
            <div class="rounded-3xl overflow-hidden shadow-xs border border-slate-200 aspect-square bg-white group">
              <img
                src={topSellers[3]?.images?.[0] || 'https://images.meesho.com/images/products/472112728/nndos_512.jpg'}
                alt="Teepul Premium Living Room Curtains"
                loading="lazy"
                decoding="async"
                width="400"
                height="400"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="rounded-3xl overflow-hidden shadow-sm border border-slate-200 aspect-[4/5] bg-white group">
              <img
                src={topSellers[1]?.images?.[0] || 'https://images.meesho.com/images/products/920841731/ftnjt_512.jpg'}
                alt="Teepul Window Curtains - Modern Printed Drapes"
                loading="lazy"
                decoding="async"
                width="400"
                height="500"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="p-3 bg-white/95 backdrop-blur-md -mt-12 relative text-center">
                <span class="text-[10px] font-bold uppercase text-slate-900 tracking-wider">Modern Printed</span>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 2. BEFORE → AFTER SECTION -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 border-b border-slate-100">
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
      <span class="text-xs font-black uppercase text-amber-800 tracking-widest bg-amber-50 border border-amber-200 px-3.5 py-1 rounded-full">
        BEFORE → AFTER
      </span>
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 mt-3">Small Change. Big Difference.</h2>
      <p class="text-xs sm:text-sm text-slate-600 mt-2">
        See how simply upgrading to Teepul curtains turns harsh outdoor glare into cozy, magazine-worthy living rooms.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-10 items-stretch">
      <!-- BEFORE CARD -->
      <div class="bg-rose-50/50 rounded-3xl p-6 sm:p-8 border border-rose-200/80 flex flex-col justify-between space-y-6">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 bg-rose-600 text-white text-[11px] font-black px-3 py-1 rounded-full uppercase tracking-wider">
            <span>❌ BEFORE TEEPUL</span>
          </div>
          <h3 class="text-xl font-black text-slate-900">Dull, Harsh &amp; Overheated Room</h3>
          <ul class="space-y-2.5 text-xs text-slate-700 font-medium pt-2">
            <li class="flex items-center gap-2">
              <span class="text-rose-600 font-bold">✗</span>
              <span>Harsh afternoon sunlight causing TV glare &amp; room heating</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-rose-600 font-bold">✗</span>
              <span>Zero daytime privacy from outside neighbors or street</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-rose-600 font-bold">✗</span>
              <span>Cheap flimsy fabric that shrinks, fades, and wrinkles easily</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-rose-600 font-bold">✗</span>
              <span>Stuck or squeaky plastic rings that tear fabric loops</span>
            </li>
          </ul>
        </div>

        <div class="p-4 bg-white/80 rounded-2xl border border-rose-200 text-xs text-slate-500 italic">
          "Pehle din me hall me garmi aur dhoop rehti thi, aur room khali lagta tha."
        </div>
      </div>

      <!-- AFTER CARD -->
      <div class="bg-emerald-50/60 rounded-3xl p-6 sm:p-8 border border-emerald-300 shadow-lg flex flex-col justify-between space-y-6 relative overflow-hidden">
        <div class="space-y-3">
          <div class="inline-flex items-center gap-2 bg-emerald-700 text-white text-[11px] font-black px-3 py-1 rounded-full uppercase tracking-wider">
            <span>✨ AFTER TEEPUL CURTAINS</span>
          </div>
          <h3 class="text-xl font-black text-slate-900">Luxurious, Cool &amp; 100% Private</h3>
          <ul class="space-y-2.5 text-xs text-slate-800 font-semibold pt-2">
            <li class="flex items-center gap-2">
              <span class="text-emerald-700 font-bold">✓</span>
              <span><strong>85%+ Sunlight Shield:</strong> Keeps room cool and glare-free</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-700 font-bold">✓</span>
              <span><strong>Complete Privacy:</strong> Thick woven polyester blocks outside view</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-700 font-bold">✓</span>
              <span><strong>Architectural Drape:</strong> Heavyweight fall with flawless pleating</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-700 font-bold">✓</span>
              <span><strong>Stainless Eyelets:</strong> Silent, smooth gliding on any standard rod</span>
            </li>
          </ul>
        </div>

        <div class="p-4 bg-white rounded-2xl border border-emerald-200 text-xs text-emerald-950 font-semibold shadow-xs flex items-center justify-between">
          <span>Instant upgrade in under 2 minutes!</span>
          <a href="/products" class="text-emerald-800 font-black hover:underline">Shop Now &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. SHOP BY NEED SECTION -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 bg-[#faf8f5] rounded-3xl my-6 border border-amber-900/10">
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
      <span class="text-xs font-black uppercase text-amber-800 tracking-widest bg-amber-100/80 px-3.5 py-1 rounded-full">
        COLLECTIONS BY INTENT
      </span>
      <h2 class="text-3xl sm:text-4xl font-black text-slate-900 mt-3">Shop By Need</h2>
      <p class="text-xs sm:text-sm text-slate-600 mt-2">
        Find the exact curtain solution tailored to your room type and light requirement.
      </p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      <a href="/products" class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition text-center group flex flex-col justify-between">
        <div>
          <div class="w-14 h-14 rounded-2xl bg-amber-50 text-amber-800 font-extrabold text-2xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition">🛋️</div>
          <h3 class="font-extrabold text-sm text-slate-900">Living Room</h3>
          <p class="text-[11px] text-slate-500 mt-1 leading-snug">7ft &amp; 9ft Statement Drapes for Grand Windows &amp; Doors</p>
        </div>
        <span class="text-xs font-bold text-amber-800 mt-4 block group-hover:underline">Explore Living &rarr;</span>
      </a>

      <a href="/products" class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition text-center group flex flex-col justify-between">
        <div>
          <div class="w-14 h-14 rounded-2xl bg-amber-50 text-amber-800 font-extrabold text-2xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition">🛏️</div>
          <h3 class="font-extrabold text-sm text-slate-900">Bedroom Blackout</h3>
          <p class="text-[11px] text-slate-500 mt-1 leading-snug">85%+ Room Darkening for Deep Sleep &amp; Glare Control</p>
        </div>
        <span class="text-xs font-bold text-amber-800 mt-4 block group-hover:underline">Explore Blackout &rarr;</span>
      </a>

      <a href="/products" class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition text-center group flex flex-col justify-between">
        <div>
          <div class="w-14 h-14 rounded-2xl bg-amber-50 text-amber-800 font-extrabold text-2xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition">🛡️</div>
          <h3 class="font-extrabold text-sm text-slate-900">Complete Privacy</h3>
          <p class="text-[11px] text-slate-500 mt-1 leading-snug">Dense Woven Jacquard with 0% Outdoor Visibility</p>
        </div>
        <span class="text-xs font-bold text-amber-800 mt-4 block group-hover:underline">Explore Privacy &rarr;</span>
      </a>

      <a href="/products" class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition text-center group flex flex-col justify-between">
        <div>
          <div class="w-14 h-14 rounded-2xl bg-amber-50 text-amber-800 font-extrabold text-2xl flex items-center justify-center mx-auto mb-4 group-hover:scale-110 transition">☀️</div>
          <h3 class="font-extrabold text-sm text-slate-900">Light Control</h3>
          <p class="text-[11px] text-slate-500 mt-1 leading-snug">Soft Semi-Sheer Linen Textures for Gentle Daylight</p>
        </div>
        <span class="text-xs font-bold text-amber-800 mt-4 block group-hover:underline">Explore Sheers &rarr;</span>
      </a>
    </div>
  </section>

  <!-- 4. BESTSELLERS SECTION -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between mb-8 pb-3 border-b border-slate-200 gap-2">
      <div>
        <div class="inline-flex items-center gap-1.5 bg-amber-50 border border-amber-200 text-amber-900 text-[10px] sm:text-xs font-black px-3 py-1 rounded-full uppercase tracking-wider">
          <span>⭐</span>
          <span>CURATED BESTSELLERS</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mt-2">Bestseller Curtains</h2>
      </div>
      <a href="/products" class="text-xs font-bold text-amber-800 hover:underline flex items-center gap-1">
        <span>View All Designs ({allProducts.length})</span>
        <span>&rarr;</span>
      </a>
    </div>

    <!-- Responsive Grid (2 columns on mobile, 4 on desktop) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6">
      {topSellers.map((product) => (
        <div class="bg-white rounded-2xl sm:rounded-3xl border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between overflow-hidden group">
          <div class="relative aspect-square bg-slate-100 overflow-hidden">
            <img
              src={product.images?.[0] || 'https://images.meesho.com/images/products/423378719/fp7sq_512.jpg'}
              alt={product.name}
              width="400"
              height="400"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute top-2 left-2 flex flex-col gap-1">
              <span class="bg-rose-600 text-white text-[9px] sm:text-[10px] font-black px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-full uppercase tracking-wider shadow">
                {product.badge || '🔥 BESTSELLER'}
              </span>
            </div>
            {product.originalPrice && (
              <span class="absolute top-2 right-2 bg-emerald-600 text-white text-[9px] sm:text-[10px] font-black px-2 py-0.5 rounded-full shadow">
                -{Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100)}%
              </span>
            )}
          </div>

          <div class="p-3 sm:p-5 space-y-2 sm:space-y-3 flex-1 flex flex-col justify-between">
            <div class="space-y-1.5 sm:space-y-2">
              <div class="flex items-center justify-between text-[10px] sm:text-xs">
                <span class="text-amber-900 font-bold uppercase tracking-wider text-[9px] sm:text-[10px] bg-amber-50 px-2 py-0.5 rounded">
                  {product.category}
                </span>
                <div class="flex items-center gap-0.5 text-amber-500 font-bold">
                  <span>★</span>
                  <span>{product.rating}</span>
                </div>
              </div>

              <h3 class="text-xs sm:text-sm font-extrabold text-slate-900 group-hover:text-amber-800 transition-colors leading-snug line-clamp-2">
                <a href={`/products/${product.slug}`}>{product.name}</a>
              </h3>
            </div>

            <div class="pt-2 sm:pt-3 border-t border-slate-100 flex items-center justify-between gap-1">
              <div>
                <span class="text-sm sm:text-lg font-black text-slate-900">{product.currency}{product.price.toLocaleString('en-IN')}</span>
                {product.originalPrice && (
                  <span class="text-[10px] sm:text-xs text-slate-400 line-through font-medium block sm:inline sm:ml-1">{product.currency}{product.originalPrice.toLocaleString('en-IN')}</span>
                )}
              </div>

              <button
                type="button"
                onclick={`window.animatedAddToCart(this, '${product.name.replace(/'/g, "\\'")}', '${product.slug}', ${product.price}, '${product.images?.[0] || ''}')`}
                class="bg-amber-800 hover:bg-amber-900 text-white font-extrabold text-[10px] sm:text-xs px-2.5 py-1.5 sm:px-3.5 sm:py-2.5 rounded-xl shadow active:scale-95 transition-all duration-300 shrink-0 flex items-center gap-1 group/btn cursor-pointer whitespace-nowrap"
                title="Add to Cart"
              >
                <span class="cart-icon transition-transform duration-300 group-hover/btn:scale-125">🛒</span>
                <span class="btn-text whitespace-nowrap font-bold">Add to Cart</span>
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 5. WHY OUR CURTAINS? SECTION -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 bg-slate-900 text-white rounded-3xl my-6">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs font-black uppercase text-amber-400 tracking-widest bg-slate-800 px-3.5 py-1 rounded-full border border-slate-700">
        THE TEEPUL ADVANTAGE
      </span>
      <h2 class="text-3xl sm:text-4xl font-black text-white mt-3">Why Choose Our Curtains?</h2>
      <p class="text-xs sm:text-sm text-slate-400 mt-2">
        Engineered in Panipat weaving mills with premium hardware and flawless finishing.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <div class="bg-slate-800/90 rounded-2xl border border-slate-700/80 overflow-hidden flex flex-col justify-between group hover:border-amber-400/50 transition duration-300">
        <div class="aspect-[16/10] overflow-hidden bg-slate-950">
          <img
            src="/images/advantage/easy-install.webp"
            alt="Easy to Install Curtains on Standard Rod"
            width="640"
            height="400"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
        </div>
