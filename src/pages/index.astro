      </div>
      <a href="/products" class="text-xs font-bold text-amber-800 hover:underline mt-2 sm:mt-0">
        View Full Storefront Catalog ({featuredProducts.length}) &rarr;
      </a>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6">
      {featuredProducts.map((product) => (
        <div class="bg-white rounded-2xl sm:rounded-3xl border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between overflow-hidden group">
