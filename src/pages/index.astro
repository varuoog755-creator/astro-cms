  <!-- Interactive 3D Canvas Engine Script -->
  <script is:inline>
    (function () {
      const canvas = document.getElementById('fabric3DCanvas');
      if (!canvas) return;

      const ctx = canvas.getContext('2d');
      let width = 0;
      let height = 0;
      let rotationY = 0;
      let rotationX = 0.2;
      let isDragging = false;
      let lastMouseX = 0;
      let lastMouseY = 0;
      let moodColor = 'gold';

      function resize() {
        const rect = canvas.parentElement.getBoundingClientRect();
        const dpr = window.devicePixelRatio || 1;
        canvas.width = rect.width * dpr;
        canvas.height = rect.height * dpr;
        width = canvas.width;
        height = canvas.height;
        ctx.scale(dpr, dpr);
      }

      window.addEventListener('resize', resize);
      resize();

      function onStart(x, y) {
        isDragging = true;
        lastMouseX = x;
        lastMouseY = y;
      }

      function onMove(x, y) {
        if (!isDragging) return;
        const dx = x - lastMouseX;
        const dy = y - lastMouseY;
        rotationY += dx * 0.008;
        rotationX += dy * 0.005;
        rotationX = Math.max(-0.6, Math.min(0.6, rotationX));
        lastMouseX = x;
        lastMouseY = y;
      }

      function onEnd() {
        isDragging = false;
      }

      canvas.addEventListener('mousedown', (e) => onStart(e.clientX, e.clientY));
      window.addEventListener('mousemove', (e) => onMove(e.clientX, e.clientY));
      window.addEventListener('mouseup', onEnd);

      canvas.addEventListener('touchstart', (e) => {
        if (e.touches.length > 0) {
          onStart(e.touches[0].clientX, e.touches[0].clientY);
        }
      }, { passive: true });

      canvas.addEventListener('touchmove', (e) => {
        if (e.touches.length > 0) {
          onMove(e.touches[0].clientX, e.touches[0].clientY);
        }
      }, { passive: true });

      canvas.addEventListener('touchend', onEnd);

      const goldBtn = document.getElementById('btn-mood-gold');
      const velvetBtn = document.getElementById('btn-mood-velvet');
      const emeraldBtn = document.getElementById('btn-mood-emerald');

      function setMood(mood, activeBtn) {
        moodColor = mood;
        [goldBtn, velvetBtn, emeraldBtn].forEach(b => {
          if (b) {
            b.classList.remove('active', 'border-amber-400/40', 'text-amber-300', 'bg-amber-500/20');
            b.classList.add('bg-slate-800/60', 'text-slate-300');
          }
        });
        if (activeBtn) {
          activeBtn.classList.add('active', 'border-amber-400/40', 'text-amber-300', 'bg-amber-500/20');
        }
      }

      if (goldBtn) goldBtn.addEventListener('click', () => setMood('gold', goldBtn));
      if (velvetBtn) velvetBtn.addEventListener('click', () => setMood('velvet', velvetBtn));
      if (emeraldBtn) emeraldBtn.addEventListener('click', () => setMood('emerald', emeraldBtn));

      const particles = Array.from({ length: 40 }, () => ({
        x: (Math.random() - 0.5) * 400,
        y: (Math.random() - 0.5) * 400,
        z: (Math.random() - 0.5) * 400,
        radius: Math.random() * 2.5 + 1,
        alpha: Math.random() * 0.8 + 0.2
      }));

      let time = 0;
      function render() {
        time += 0.02;
        if (!isDragging) {
          rotationY += 0.005;
        }

        const displayWidth = width / (window.devicePixelRatio || 1);
        const displayHeight = height / (window.devicePixelRatio || 1);

        ctx.clearRect(0, 0, displayWidth, displayHeight);

        const cx = displayWidth / 2;
        const cy = displayHeight / 2;

        let bgGrad;
        if (moodColor === 'gold') {
          bgGrad = ctx.createRadialGradient(cx, cy, 20, cx, cy, displayWidth * 0.7);
          bgGrad.addColorStop(0, 'rgba(217, 119, 6, 0.35)');
          bgGrad.addColorStop(0.6, 'rgba(15, 23, 42, 0.95)');
          bgGrad.addColorStop(1, 'rgba(2, 6, 23, 1)');
        } else if (moodColor === 'velvet') {
          bgGrad = ctx.createRadialGradient(cx, cy, 20, cx, cy, displayWidth * 0.7);
          bgGrad.addColorStop(0, 'rgba(99, 102, 241, 0.25)');
          bgGrad.addColorStop(0.6, 'rgba(15, 23, 42, 0.95)');
          bgGrad.addColorStop(1, 'rgba(2, 6, 23, 1)');
        } else {
          bgGrad = ctx.createRadialGradient(cx, cy, 20, cx, cy, displayWidth * 0.7);
          bgGrad.addColorStop(0, 'rgba(16, 185, 129, 0.25)');
          bgGrad.addColorStop(0.6, 'rgba(6, 78, 59, 0.95)');
          bgGrad.addColorStop(1, 'rgba(2, 6, 23, 1)');
        }

        ctx.fillStyle = bgGrad;
        ctx.fillRect(0, 0, displayWidth, displayHeight);

        particles.forEach((p) => {
          const cosY = Math.cos(rotationY * 0.5);
          const sinY = Math.sin(rotationY * 0.5);
          const rx = p.x * cosY - p.z * sinY;
          const rz = p.x * sinY + p.z * cosY;

          const fov = 350;
          const scale = fov / (fov + rz + 300);
          const px = cx + rx * scale;
          const py = cy + (p.y + Math.sin(time + p.x) * 15) * scale;

          ctx.beginPath();
          ctx.arc(px, py, p.radius * scale, 0, Math.PI * 2);
          ctx.fillStyle = moodColor === 'gold' ? `rgba(251, 191, 36, ${p.alpha * scale})` : moodColor === 'velvet' ? `rgba(199, 210, 254, ${p.alpha * scale})` : `rgba(167, 243, 208, ${p.alpha * scale})`;
          ctx.fill();
        });

        const numPanels = 18;
        const panelWidth = displayWidth * 0.035;

        ctx.save();
        ctx.translate(cx, cy);
        ctx.rotate(rotationX * 0.3);

        for (let i = 0; i < numPanels; i++) {
          const xOffset = (i - numPanels / 2) * panelWidth;
          const wavePhase = i * 0.45 + rotationY * 2.5;
          const zDepth = Math.sin(wavePhase) * 45;
          const waveScale = 300 / (300 + zDepth);

          const px = xOffset * waveScale;
          const pyTop = -140 * waveScale;
          const pyBottom = 140 * waveScale;

          const shade = Math.cos(wavePhase);
          let strokeStyle, fillStyle;

          if (moodColor === 'gold') {
            const baseLum = 40 + shade * 25;
            fillStyle = `hsl(38, 80%, ${baseLum}%)`;
            strokeStyle = `hsl(43, 90%, ${baseLum + 20}%)`;
          } else if (moodColor === 'velvet') {
            const baseLum = 25 + shade * 20;
            fillStyle = `hsl(260, 40%, ${baseLum}%)`;
            strokeStyle = `hsl(265, 60%, ${baseLum + 20}%)`;
          } else {
            const baseLum = 25 + shade * 20;
            fillStyle = `hsl(160, 60%, ${baseLum}%)`;
            strokeStyle = `hsl(165, 80%, ${baseLum + 20}%)`;
          }

          ctx.beginPath();
          ctx.moveTo(px, pyTop);
          ctx.lineTo(px + panelWidth * waveScale, pyTop);
          ctx.lineTo(px + panelWidth * waveScale, pyBottom);
          ctx.lineTo(px, pyBottom);
          ctx.closePath();

          ctx.fillStyle = fillStyle;
          ctx.shadowColor = 'rgba(0,0,0,0.5)';
          ctx.shadowBlur = 12 * waveScale;
          ctx.fill();

          ctx.lineWidth = 1 * waveScale;
          ctx.strokeStyle = strokeStyle;
          ctx.stroke();

          if (i % 2 === 0) {
            ctx.beginPath();
            ctx.arc(px + (panelWidth * waveScale) / 2, pyTop + 12 * waveScale, 5 * waveScale, 0, Math.PI * 2);
            ctx.fillStyle = '#f59e0b';
            ctx.fill();
            ctx.strokeStyle = '#78350f';
            ctx.stroke();
          }
        }

        ctx.restore();

        requestAnimationFrame(render);
      }

      render();
    })();
  </script>
