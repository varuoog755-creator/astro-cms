---
import PublicLayout from '../layouts/PublicLayout.astro';
import BlockRenderer from '../components/editor/BlockRenderer.astro';
import prisma from '../lib/db';

const { slug } = Astro.params;

if (slug === '404') {
  Astro.response.status = 404;
}

let page: any = null;
try {
  page = await prisma.page.findUnique({
    where: { slug: slug || '' },
  });
} catch (error) {
  console.error('Failed to fetch page:', error);
}

if (!page || page.status === 'trash') {
  if (slug === '404') {
    page = {
      title: '404 - Page Not Found',
      content: JSON.stringify([]),
    };
  } else {
    return Astro.redirect('/404');
  }
}
---

<PublicLayout seo={{ title: page.title }}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-4xl font-extrabold text-gray-900 mb-8">{page.title}</h1>

    <div class="bg-white p-8 md:p-12 rounded-3xl border border-gray-200 shadow-sm">
      <BlockRenderer content={page.content} />
    </div>
  </div>
</PublicLayout>
