---
import PublicLayout from '../layouts/PublicLayout.astro';
---

<PublicLayout
  seo={{
    title: 'Contact Us - Teepul Customer Support & Panipat Studio',
    description: 'Get in touch with Teepul customer care. Visit our Panipat textile studio, contact our support team via phone, WhatsApp, or email, or submit a support inquiry.',
    canonicalUrl: '/contact',
  }}
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-[#f7f4ef] via-[#faf8f4] to-[#f4efe6] text-slate-900 overflow-hidden py-14 lg:py-20 px-4 sm:px-6 lg:px-8 border-b border-amber-900/10">
    <div class="relative max-w-4xl mx-auto text-center space-y-4">
      <div class="inline-flex items-center gap-2 bg-amber-900/10 border border-amber-900/20 text-amber-900 text-xs font-black px-4 py-1.5 rounded-full uppercase tracking-wider">
        <span>💬 Always Here to Assist</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-slate-950">
        Contact <span class="bg-gradient-to-r from-amber-800 via-amber-700 to-amber-900 bg-clip-text text-transparent">Teepul Support</span>
      </h1>
      <p class="text-sm sm:text-base text-slate-600 font-medium max-w-2xl mx-auto">
        Have questions regarding curtain sizes, custom drapery orders, or shipment tracking? Our Panipat care team is ready to help.
      </p>
    </div>
  </section>

  <!-- Support Channels & Interactive Form Section -->
  <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
      
      <!-- Left Column: Contact Cards & Details (1 col) -->
      <div class="space-y-6 lg:col-span-1">
        
        <!-- Address Card -->
        <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 space-y-3">
          <div class="w-10 h-10 rounded-2xl bg-amber-100 text-amber-800 flex items-center justify-center text-xl font-bold">
            📍
          </div>
          <h2 class="text-base font-black text-slate-900">Manufacturing & Registered Office</h2>
          <p class="text-xs text-slate-600 leading-relaxed font-medium">
            <strong>Ashank Ecommerce Private Limited (Teepul)</strong><br />
            Plot No. 142, Sector-25, HSIIDC Industrial Area, Phase-2,<br />
            Panipat, Haryana – 132103, India.
          </p>
          <div class="pt-2 border-t border-slate-100 text-[11px] text-slate-500">
            Open for studio visits: Mon–Sat, 10:00 AM – 6:00 PM IST
          </div>
        </div>

        <!-- Phone & WhatsApp Card -->
        <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 space-y-3">
          <div class="w-10 h-10 rounded-2xl bg-emerald-100 text-emerald-800 flex items-center justify-center text-xl font-bold">
            📞
          </div>
          <h2 class="text-base font-black text-slate-900">Direct Phone & WhatsApp</h2>
          <p class="text-xs text-slate-600 leading-relaxed">
            Speak directly with our Panipat drapery advisors for immediate assistance:
          </p>
          <div class="space-y-2 pt-1">
            <a
              href="https://wa.me/919876543210?text=Hi%20Teepul%20Support!%20I%20have%20an%20inquiry%20regarding%20an%20order."
              target="_blank"
              rel="noopener noreferrer"
              class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs py-2.5 px-4 rounded-xl flex items-center justify-center gap-2 transition"
            >
              <span>💬 WhatsApp Us: +91 98765 43210</span>
            </a>
            <a
              href="tel:+919876543210"
              class="w-full bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs py-2.5 px-4 rounded-xl flex items-center justify-center gap-2 transition"
            >
              <span>📞 Call Support: +91 98765 43210</span>
            </a>
          </div>
          <div class="pt-2 border-t border-slate-100 text-[11px] text-slate-500">
            Helpline Hours: Mon–Sat, 9:00 AM – 7:00 PM IST
          </div>
        </div>

        <!-- Email Inboxes -->
        <div class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 space-y-3">
          <div class="w-10 h-10 rounded-2xl bg-blue-100 text-blue-800 flex items-center justify-center text-xl font-bold">
            ✉️
          </div>
          <h2 class="text-base font-black text-slate-900">Email Desks</h2>
          <div class="space-y-2 text-xs">
            <div>
              <span class="block text-[10px] uppercase font-bold text-slate-400">Order & Sizing Queries</span>
              <a href="mailto:support@teepul.com" class="font-bold text-amber-800 hover:underline">support@teepul.com</a>
            </div>
            <div>
              <span class="block text-[10px] uppercase font-bold text-slate-400">Customer Care & Replacements</span>
              <a href="mailto:care@teepul.com" class="font-bold text-amber-800 hover:underline">care@teepul.com</a>
            </div>
            <div>
              <span class="block text-[10px] uppercase font-bold text-slate-400">Grievance Officer</span>
              <a href="mailto:grievance@teepul.com" class="font-bold text-amber-800 hover:underline">grievance@teepul.com</a>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Support Inquiry Form (2 cols) -->
      <div class="lg:col-span-2 bg-white rounded-3xl border border-slate-200 shadow-sm p-6 sm:p-10 space-y-6">
        <div>
          <h2 class="text-2xl font-black text-slate-900">Send Us an Inquiry</h2>
          <p class="text-xs text-slate-500 mt-1">
            Fill out the form below. We respond to all inquiries within <strong>24 business hours</strong>.
          </p>
        </div>

        <form id="contact-form" class="space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-name" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Your Full Name *</label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                placeholder="e.g. Gourav Kumar"
                class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white font-medium"
              />
            </div>
            <div>
              <label for="contact-phone" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Mobile Number *</label>
              <input
                type="tel"
                id="contact-phone"
                name="phone"
                required
                placeholder="e.g. 9876543210"
                class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white font-medium"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Email Address *</label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                placeholder="you@example.com"
                class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white font-medium"
              />
            </div>
            <div>
              <label for="contact-order-id" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Order Number (Optional)</label>
              <input
                type="text"
                id="contact-order-id"
                name="orderId"
                placeholder="e.g. ORD-10023"
                class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white font-medium"
              />
            </div>
          </div>

          <div>
            <label for="contact-subject" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Inquiry Category *</label>
            <select
              id="contact-subject"
              name="subject"
              required
              class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white font-medium"
            >
              <option value="Delivery & Order Tracking">Delivery & Order Tracking (AWB)</option>
              <option value="7-Day Return / Replacement Request">7-Day Return / Replacement Request</option>
              <option value="Fabric, Fitting & Sizing Question">Fabric, Fitting & Sizing Question (5ft, 6ft, 7ft, 9ft)</option>
              <option value="Custom Measurement or Bulk Order">Custom Measurement or Bulk Order</option>
              <option value="Payment / Refund Verification">Payment / Refund Verification</option>
              <option value="General Feedback">General Inquiry / Other</option>
            </select>
          </div>

          <div>
            <label for="contact-message" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Message *</label>
            <textarea
              id="contact-message"
              name="message"
              required
              rows="4"
              placeholder="Tell us how we can assist you..."
              class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-amber-500 focus:bg-white font-medium"
            ></textarea>
          </div>

          <div id="form-feedback" class="hidden p-3 rounded-xl text-xs font-bold text-center"></div>

          <button
            type="submit"
            id="submit-button"
            class="w-full sm:w-auto bg-amber-800 hover:bg-amber-900 text-white font-extrabold text-sm px-8 py-3.5 rounded-xl shadow-lg shadow-amber-800/20 hover:shadow-amber-800/40 transition duration-200 flex items-center justify-center gap-2"
          >
            <span>Send Message to Support</span>
            <span>&rarr;</span>
          </button>
        </form>

        <script is:inline>
          document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('contact-form');
            const feedback = document.getElementById('form-feedback');
            const btn = document.getElementById('submit-button');

            if (form) {
              form.addEventListener('submit', (e) => {
                e.preventDefault();
                btn.disabled = true;
                btn.innerText = 'Sending Inquiry...';

                setTimeout(() => {
                  feedback.className = 'p-3 rounded-xl text-xs font-bold text-center bg-emerald-50 border border-emerald-200 text-emerald-900 block';
                  feedback.innerText = '✅ Thank you! Your message has been sent to our Panipat care desk. An advisor will contact you within 24 hours.';
                  form.reset();
                  btn.disabled = false;
                  btn.innerHTML = '<span>Send Another Message</span> <span>&rarr;</span>';
                }, 700);
              });
            }
          });
        </script>

        <!-- Customer Service Commitment -->
        <div class="pt-6 border-t border-slate-100 grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-slate-500">
          <div class="flex items-start gap-2">
            <span class="text-amber-800 font-black">✓</span>
            <span><strong>24-Hour SLA:</strong> Dedicated resolution within 24 business hours for all inquiries.</span>
          </div>
          <div class="flex items-start gap-2">
            <span class="text-amber-800 font-black">✓</span>
            <span><strong>Order Assistance:</strong> Priority tracking and replacement dispatched directly from Panipat.</span>
          </div>
        </div>

      </div>

    </div>
  </main>
</PublicLayout>
