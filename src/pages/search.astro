---
import PublicLayout from '../layouts/PublicLayout.astro';
import prisma from '../lib/db';

const query = Astro.url.searchParams.get('q') || '';

let matchingPosts: any[] = [];
let matchingPages: any[] = [];

if (query.trim().length > 0) {
  matchingPosts = await prisma.post.findMany({
    where: {
      status: 'published',
      OR: [
        { title: { contains: query } },
        { excerpt: { contains: query } },
        { content: { contains: query } },
      ],
    },
    include: { author: true },
  });

  matchingPages = await prisma.page.findMany({
    where: {
      status: 'published',
      OR: [
        { title: { contains: query } },
        { content: { contains: query } },
      ],
    },
  });
}
---

<PublicLayout seo={{ title: `Search Results for "${query}"` }}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="max-w-2xl mx-auto mb-12 text-center">
      <h1 class="text-3xl font-extrabold text-gray-900 mb-4">Global Search</h1>

      <form action="/search" method="GET" class="flex gap-2">
        <input
          type="text"
          name="q"
          value={query}
          placeholder="Search articles, pages, tutorials..."
          class="w-full text-sm bg-white border border-gray-300 rounded-2xl px-5 py-3 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
        <button type="submit" class="bg-blue-600 hover:bg-blue-500 text-white font-bold px-6 py-3 rounded-2xl shadow transition text-sm">
          Search
        </button>
      </form>
    </div>

    {query && (
      <div class="space-y-8">
        <h2 class="text-xl font-bold text-gray-900">
          Found {matchingPosts.length + matchingPages.length} results for "<span class="text-blue-600">{query}</span>"
        </h2>

        <div class="space-y-4">
          {matchingPosts.map((post) => (
            <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm space-y-2">
              <span class="text-[10px] font-bold uppercase bg-blue-100 text-blue-800 px-2 py-0.5 rounded">Post</span>
              <h3 class="font-bold text-lg text-gray-900">
                <a href={`/blog/${post.slug}`} class="hover:text-blue-600 transition">
                  {post.title}
                </a>
              </h3>
              <p class="text-xs text-gray-600">{post.excerpt}</p>
            </div>
          ))}

          {matchingPages.map((page) => (
            <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm space-y-2">
              <span class="text-[10px] font-bold uppercase bg-indigo-100 text-indigo-800 px-2 py-0.5 rounded">Page</span>
              <h3 class="font-bold text-lg text-gray-900">
                <a href={`/${page.slug}`} class="hover:text-blue-600 transition">
                  {page.title}
                </a>
              </h3>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</PublicLayout>
