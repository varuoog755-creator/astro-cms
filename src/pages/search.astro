---
import PublicLayout from '../layouts/PublicLayout.astro';
import prisma from '../lib/db';
import { PRODUCTS_CATALOG } from '../lib/products';

const query = Astro.url.searchParams.get('q') || '';

let matchingPosts: any[] = [];
let matchingPages: any[] = [];
let matchingProducts: any[] = [];

if (query.trim().length > 0) {
  const qLower = query.toLowerCase();

  matchingProducts = PRODUCTS_CATALOG.filter(
    (p) =>
      p.name.toLowerCase().includes(qLower) ||
      p.description.toLowerCase().includes(qLower) ||
      p.category.toLowerCase().includes(qLower) ||
      p.tagline.toLowerCase().includes(qLower)
  );

  matchingPosts = await prisma.post.findMany({
    where: {
      status: 'published',
      OR: [
        { title: { contains: query } },
        { excerpt: { contains: query } },
        { content: { contains: query } },
      ],
    },
    include: { author: true },
  });

  matchingPages = await prisma.page.findMany({
    where: {
      status: 'published',
      OR: [
        { title: { contains: query } },
        { content: { contains: query } },
      ],
    },
  });
}

const totalCount = matchingPosts.length + matchingPages.length + matchingProducts.length;
---

<PublicLayout seo={{ title: `Search Results for "${query}"` }}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="max-w-2xl mx-auto mb-12 text-center space-y-4">
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900">Global Search</h1>
      <p class="text-xs text-slate-500">Search products, store merch, blog posts, static pages, and docs</p>

      <form action="/search" method="GET" class="flex gap-2">
        <input
          type="text"
          name="q"
          value={query}
          placeholder="Search products, hoodies, articles, pages..."
          class="w-full text-xs font-medium bg-white border border-slate-300 rounded-2xl px-5 py-3 shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
        <button type="submit" class="bg-blue-600 hover:bg-blue-500 text-white font-extrabold text-xs px-6 py-3 rounded-2xl shadow transition">
          Search
        </button>
      </form>
    </div>

    {query && (
      <div class="space-y-8">
        <div class="border-b border-slate-200 pb-4 flex items-center justify-between">
          <h2 class="text-xl font-black text-slate-900">
            Found {totalCount} results for "<span class="text-blue-600">{query}</span>"
          </h2>
        </div>

        <div class="space-y-4">
          <!-- Matching Products -->
          {matchingProducts.map((product) => (
            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between gap-4 hover:border-blue-500 transition">
              <div class="flex items-center gap-4">
                <img src={product.images[0]} alt={product.name} class="w-16 h-16 rounded-xl object-cover" />
                <div>
                  <span class="text-[10px] font-extrabold uppercase bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded">Product Item</span>
                  <h3 class="font-bold text-base text-slate-900 mt-1">
                    <a href={`/products/${product.slug}`} class="hover:text-blue-600 transition">
                      {product.name}
                    </a>
                  </h3>
                  <p class="text-xs text-slate-500">{product.tagline}</p>
                </div>
              </div>

              <div class="text-right">
                <div class="font-black text-base text-slate-900">{product.currency}{product.price}</div>
                <a href={`/products/${product.slug}`} class="text-xs font-bold text-blue-600 hover:underline">
                  View Product &rarr;
                </a>
              </div>
            </div>
          ))}

          <!-- Matching Posts -->
          {matchingPosts.map((post) => (
            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-2 hover:border-blue-500 transition">
              <span class="text-[10px] font-extrabold uppercase bg-blue-100 text-blue-800 px-2 py-0.5 rounded">Blog Post</span>
              <h3 class="font-bold text-base text-slate-900">
                <a href={`/blog/${post.slug}`} class="hover:text-blue-600 transition">
                  {post.title}
                </a>
              </h3>
              <p class="text-xs text-slate-500">{post.excerpt}</p>
            </div>
          ))}

          <!-- Matching Pages -->
          {matchingPages.map((page) => (
            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-2 hover:border-blue-500 transition">
              <span class="text-[10px] font-extrabold uppercase bg-purple-100 text-purple-800 px-2 py-0.5 rounded">Static Page</span>
              <h3 class="font-bold text-base text-slate-900">
                <a href={`/${page.slug}`} class="hover:text-blue-600 transition">
                  {page.title}
                </a>
              </h3>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</PublicLayout>
