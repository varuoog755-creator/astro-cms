---
import PublicLayout from '../layouts/PublicLayout.astro';
import prisma from '../lib/db';
import { getStorefrontProducts } from '../lib/products';

const query = Astro.url.searchParams.get('q') || '';

let matchingPosts: any[] = [];
let matchingPages: any[] = [];
let matchingProducts: any[] = [];

if (query.trim().length > 0) {
  const qLower = query.toLowerCase();
  const allProducts = await getStorefrontProducts();

  matchingProducts = allProducts.filter(
    (p) =>
      p.name.toLowerCase().includes(qLower) ||
      p.description.toLowerCase().includes(qLower) ||
      p.category.toLowerCase().includes(qLower) ||
      (p.tagline && p.tagline.toLowerCase().includes(qLower))
  );

  try {
    matchingPosts = await prisma.post.findMany({
      where: {
        status: 'published',
        OR: [
          { title: { contains: query } },
          { excerpt: { contains: query } },
          { content: { contains: query } },
        ],
      },
      include: { author: true },
    });
  } catch (error) {
    console.error('Failed to search posts:', error);
  }

  try {
    matchingPages = await prisma.page.findMany({
      where: {
        status: 'published',
        OR: [
          { title: { contains: query } },
          { content: { contains: query } },
        ],
      },
    });
  } catch (error) {
    console.error('Failed to search pages:', error);
  }
}

const totalCount = matchingPosts.length + matchingPages.length + matchingProducts.length;
---

<PublicLayout seo={{ title: `Search Results for "${query}" - Teepul Store` }}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="max-w-2xl mx-auto mb-12 text-center space-y-4">
      <div class="inline-flex items-center gap-2 bg-amber-100 text-amber-900 text-xs font-black px-4 py-1.5 rounded-full uppercase tracking-wider">
        <span>STOREFRONT CATALOG SEARCH</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900">Search Curtains & Decor</h1>
      <p class="text-xs text-slate-500">Search luxury door curtains, window drapes, ambient lighting, and interior styling articles</p>

      <form action="/search" method="GET" class="flex gap-2">
        <label for="global-search-input" class="sr-only">Search curtains, lights, articles</label>
        <input
          id="global-search-input"
          type="text"
          name="q"
          value={query}
          placeholder="Search blackout curtains, sheer linen, lighting..."
          aria-label="Search store products and guides"
          class="w-full text-xs font-medium bg-white border border-slate-300 rounded-2xl px-5 py-3.5 shadow-sm focus:outline-none focus:ring-2 focus:ring-amber-500"
        />
        <button
          type="submit"
          class="bg-amber-800 hover:bg-amber-900 text-white font-extrabold text-xs px-7 py-3.5 rounded-2xl shadow transition shrink-0 cursor-pointer"
        >
          Search
        </button>
      </form>
    </div>

    {query && (
      <div class="space-y-8">
        <div class="border-b border-slate-200 pb-4 flex items-center justify-between">
          <h2 class="text-xl font-black text-slate-900">
            Found {totalCount} results for "<span class="text-amber-800">{query}</span>"
          </h2>
        </div>

        <div class="space-y-4">
          <!-- Matching Products -->
          {matchingProducts.map((product) => (
            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between gap-4 hover:border-amber-400 transition">
              <div class="flex items-center gap-4">
                <img
                  src={product.images[0]}
                  alt={product.name}
                  width="64"
                  height="64"
                  loading="lazy"
                  class="w-16 h-16 rounded-xl object-cover"
                />
                <div>
                  <span class="text-[10px] font-extrabold uppercase bg-amber-100 text-amber-900 px-2 py-0.5 rounded">Product Item</span>
                  <h3 class="font-bold text-base text-slate-900 mt-1">
                    <a href={`/products/${product.slug}`} class="hover:text-amber-800 transition">
                      {product.name}
                    </a>
                  </h3>
                  <p class="text-xs text-slate-500">{product.tagline}</p>
                </div>
              </div>

              <div class="text-right">
                <div class="font-black text-base text-slate-900">{product.currency}{product.price.toLocaleString('en-IN')}</div>
                <a href={`/products/${product.slug}`} class="text-xs font-bold text-amber-800 hover:underline">
                  View Product &rarr;
                </a>
              </div>
            </div>
          ))}

          <!-- Matching Posts -->
          {matchingPosts.map((post) => (
            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-2 hover:border-amber-400 transition">
              <span class="text-[10px] font-extrabold uppercase bg-amber-50 text-amber-900 px-2 py-0.5 rounded border border-amber-200">Decor Guide</span>
              <h3 class="font-bold text-base text-slate-900">
                <a href={`/blog/${post.slug}`} class="hover:text-amber-800 transition">
                  {post.title}
                </a>
              </h3>
              <p class="text-xs text-slate-500">{post.excerpt}</p>
            </div>
          ))}

          <!-- Matching Pages -->
          {matchingPages.map((page) => (
            <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-2 hover:border-amber-400 transition">
              <span class="text-[10px] font-extrabold uppercase bg-slate-100 text-slate-800 px-2 py-0.5 rounded">Information Page</span>
              <h3 class="font-bold text-base text-slate-900">
                <a href={`/${page.slug}`} class="hover:text-amber-800 transition">
                  {page.title}
                </a>
              </h3>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</PublicLayout>
