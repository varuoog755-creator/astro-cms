---
import AdminLayout from '../../layouts/AdminLayout.astro';
import prisma from '../../lib/db';

const tags = await prisma.tag.findMany({
  orderBy: { name: 'asc' },
  include: { _count: { select: { posts: true } } },
});
---

<AdminLayout title="Tags" activeNav="tags">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm space-y-4">
      <h3 class="text-sm font-bold text-gray-900">Add New Tag</h3>

      <form action="/api/tags" method="POST" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold text-gray-700 mb-1">Name</label>
          <input type="text" name="name" required placeholder="Tag name..." class="w-full text-xs border border-gray-300 rounded-lg px-3 py-2" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-700 mb-1">Slug</label>
          <input type="text" name="slug" placeholder="tag-slug" class="w-full text-xs font-mono border border-gray-300 rounded-lg px-3 py-2" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-700 mb-1">Description</label>
          <textarea name="description" rows="3" class="w-full text-xs border border-gray-300 rounded-lg p-2"></textarea>
        </div>

        <button type="submit" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs py-2.5 rounded-xl shadow transition">
          Add Tag
        </button>
      </form>
    </div>

    <div class="lg:col-span-2 bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
      <table class="w-full text-left text-xs text-gray-700">
        <thead class="bg-gray-100 text-gray-600 font-bold uppercase tracking-wider border-b border-gray-200">
          <tr>
            <th class="px-6 py-3.5">Name</th>
            <th class="px-6 py-3.5">Slug</th>
            <th class="px-6 py-3.5">Posts Count</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100">
          {tags.map((tag) => (
            <tr class="hover:bg-gray-50/80 transition">
              <td class="px-6 py-4 font-bold text-gray-900">{tag.name}</td>
              <td class="px-6 py-4 font-mono text-gray-500">/{tag.slug}</td>
              <td class="px-6 py-4 font-semibold text-blue-600">{tag._count.posts}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>
