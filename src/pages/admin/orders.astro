---
import AdminLayout from '../../layouts/AdminLayout.astro';
import prisma from '../../lib/db';

const orders = await prisma.order.findMany({
  orderBy: { createdAt: 'desc' },
  include: { items: true },
});

const totalRevenue = orders
  .filter((o) => o.paymentStatus === 'PAID')
  .reduce((sum, o) => sum + o.totalAmount, 0);

const paidOrdersCount = orders.filter((o) => o.paymentStatus === 'PAID').length;
const pendingOrdersCount = orders.filter((o) => o.paymentStatus === 'PENDING' || o.paymentStatus === 'COD_PENDING').length;
---

<AdminLayout title="Customer Orders Management">
  <div class="space-y-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-200 pb-6">
      <div>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Customer Orders</h1>
        <p class="text-sm text-slate-500 mt-1">Track storefront sales, Razorpay payments, Paytm orders, and Cash on Delivery requests.</p>
      </div>

      <div class="flex items-center gap-3">
        <a href="/admin/integrations" class="bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold px-4 py-2.5 rounded-xl transition">
          ⚙️ Payment Settings
        </a>
      </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Sales Revenue</span>
        <div class="text-3xl font-black text-slate-900 mt-2">₹{totalRevenue.toLocaleString('en-IN')}</div>
        <span class="text-[11px] text-emerald-600 font-semibold mt-1 inline-block">Verified Paid Transactions</span>
      </div>

      <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Paid Orders</span>
        <div class="text-3xl font-black text-emerald-600 mt-2">{paidOrdersCount}</div>
        <span class="text-[11px] text-slate-500 mt-1 inline-block">Razorpay / Paytm / Online</span>
      </div>

      <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Pending / COD</span>
        <div class="text-3xl font-black text-amber-500 mt-2">{pendingOrdersCount}</div>
        <span class="text-[11px] text-slate-500 mt-1 inline-block">Awaiting fulfillment</span>
      </div>
    </div>

    <!-- Orders Table -->
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="p-6 border-b border-slate-200 flex items-center justify-between">
        <h2 class="font-extrabold text-slate-900 text-base">Recent Customer Orders ({orders.length})</h2>
      </div>

      {orders.length === 0 ? (
        <div class="p-12 text-center text-slate-500">
          <span class="text-4xl block mb-2">🛍️</span>
          <p class="font-semibold text-sm">No customer orders placed yet.</p>
          <p class="text-xs text-slate-400 mt-1">Orders placed on the storefront will appear here instantly.</p>
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-slate-600">
            <thead class="bg-slate-50 text-slate-700 font-bold uppercase text-[10px] tracking-wider border-b border-slate-200">
              <tr>
                <th class="p-4">Order ID</th>
                <th class="p-4">Customer</th>
                <th class="p-4">Items</th>
                <th class="p-4">Method</th>
                <th class="p-4">Payment</th>
                <th class="p-4">Total</th>
                <th class="p-4">Date</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {orders.map((o) => (
                <tr class="hover:bg-slate-50/80 transition">
                  <td class="p-4 font-mono font-bold text-slate-900">{o.orderNumber}</td>
                  <td class="p-4">
                    <div class="font-bold text-slate-900">{o.customerName}</div>
                    <div class="text-[11px] text-slate-500">{o.customerPhone} | {o.customerEmail}</div>
                    <div class="text-[10px] text-slate-400 truncate max-w-xs">{o.shippingAddress}, {o.pincode}</div>
                  </td>
                  <td class="p-4 space-y-1">
                    {o.items.map((item) => (
                      <div class="text-slate-800 font-medium">
                        {item.quantity}x {item.productTitle}
                        {item.color && <span class="text-[10px] text-slate-500"> ({item.color}, {item.size})</span>}
                      </div>
                    ))}
                  </td>
                  <td class="p-4 font-bold text-slate-700">
                    <span class="bg-slate-100 text-slate-800 px-2.5 py-1 rounded-full text-[10px]">
                      {o.paymentMethod}
                    </span>
                  </td>
                  <td class="p-4">
                    {o.paymentStatus === 'PAID' ? (
                      <span class="bg-emerald-100 text-emerald-800 font-bold px-2.5 py-1 rounded-full text-[10px] border border-emerald-300">
                        ✓ PAID
                      </span>
                    ) : (
                      <span class="bg-amber-100 text-amber-800 font-bold px-2.5 py-1 rounded-full text-[10px] border border-amber-300">
                        ⏳ {o.paymentStatus}
                      </span>
                    )}
                  </td>
                  <td class="p-4 font-extrabold text-slate-900 text-sm">₹{o.totalAmount.toLocaleString('en-IN')}</td>
                  <td class="p-4 text-[11px] text-slate-500">
                    {new Date(o.createdAt).toLocaleDateString('en-IN', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </div>
</AdminLayout>
