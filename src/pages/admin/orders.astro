---
import AdminLayout from '../../layouts/AdminLayout.astro';
import prisma from '../../lib/db';
import { PRODUCTS_CATALOG } from '../../lib/products';

const orders = await prisma.order.findMany({
  orderBy: { createdAt: 'desc' },
  include: { items: true },
});

const dbProducts = await prisma.product.findMany();

const totalRevenue = orders
  .filter((o) => o.paymentStatus === 'PAID')
  .reduce((sum, o) => sum + o.totalAmount, 0);

const paidOrdersCount = orders.filter((o) => o.paymentStatus === 'PAID').length;
const pendingPaymentCount = orders.filter((o) => o.paymentStatus === 'PENDING').length;
const codOrdersCount = orders.filter((o) => o.paymentStatus === 'COD_PENDING' || o.paymentMethod === 'COD').length;
const pendingOrdersCount = pendingPaymentCount + codOrdersCount;

// Helper to look up product data and variant thumbnail for each order item
function getItemProductInfo(item: any) {
  const prod = dbProducts.find((p) => p.id === item.productId || p.slug === item.productId) ||
               PRODUCTS_CATALOG.find((p) => p.id === item.productId || p.slug === item.productId) ||
               dbProducts.find((p) => p.name.toLowerCase().trim() === item.productTitle?.toLowerCase().trim()) ||
               PRODUCTS_CATALOG.find((p) => p.name.toLowerCase().trim() === item.productTitle?.toLowerCase().trim());

  let colors: any[] = [];
  let images: string[] = [];

  if (prod) {
    if (Array.isArray((prod as any).colors)) {
      colors = (prod as any).colors;
    } else if (typeof (prod as any).colorsJson === 'string') {
      try { colors = JSON.parse((prod as any).colorsJson || '[]'); } catch {}
    }

    if (Array.isArray((prod as any).images)) {
      images = (prod as any).images;
    } else if (typeof (prod as any).imagesJson === 'string') {
      try { images = JSON.parse((prod as any).imagesJson || '[]'); } catch {}
    }
  }

  const matchedColor = colors.find((c: any) => c?.name?.toLowerCase().trim() === item.color?.toLowerCase().trim());
  const variantImage = (matchedColor?.images && matchedColor.images[0]) || images[0] || '/uploads/grey-eyelet-curtain-front.webp';
  const colorHex = matchedColor?.hex || '#722f37';
  const slug = prod?.slug || item.productId;

  return {
    slug,
    variantImage,
    colorHex,
    productName: prod?.name || item.productTitle,
  };
}
---

<AdminLayout title="Teepul Customer Orders & Fulfillment" activeNav="orders">
  <div class="space-y-6">

    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-200 pb-6">
      <div>
        <div class="inline-flex items-center gap-2 bg-amber-100 border border-amber-300 text-amber-900 text-[10px] font-black px-3 py-1 rounded-full uppercase tracking-wider mb-2">
          <span>📦 LIVE STORE ORDERS</span>
        </div>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Customer Orders & Specifications</h1>
        <p class="text-sm text-slate-500 mt-1">Permanent customer orders with photos, color swatches, sizes, and direct product links.</p>
      </div>

      <div class="flex items-center gap-3">
        <button
          type="button"
          id="export-orders-top-btn"
          class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-extrabold px-4 py-2.5 rounded-xl transition shadow flex items-center gap-2 cursor-pointer"
        >
          <span>📊</span>
          <span>Download Excel Sheet</span>
        </button>
        <a href="/admin/analytics" class="bg-amber-800 hover:bg-amber-900 text-white text-xs font-extrabold px-4 py-2.5 rounded-xl transition shadow">
          📈 Live Sales Analytics
        </a>
      </div>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-5">
      <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Sales Revenue</span>
        <div class="text-2xl font-black text-slate-900 mt-1">₹{totalRevenue.toLocaleString('en-IN')}</div>
        <span class="text-[10px] text-emerald-600 font-bold mt-1 block">Verified Customer Payments</span>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Orders Count</span>
        <div class="text-2xl font-black text-blue-600 mt-1">{orders.length}</div>
        <span class="text-[10px] text-slate-500 mt-1 block">Permanent Order Log</span>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Cash on Delivery (COD)</span>
        <div class="text-2xl font-black text-sky-600 mt-1">{codOrdersCount}</div>
        <span class="text-[10px] text-sky-700 font-bold mt-1 block">🚚 COD Orders</span>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm">
        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Paid / Confirmed</span>
        <div class="text-2xl font-black text-emerald-600 mt-1">{paidOrdersCount}</div>
        <span class="text-[10px] text-emerald-600 font-bold mt-1 block">✓ Online Paid</span>
      </div>
    </div>

    <!-- Day-by-Day, Payment Status & Fulfillment Filter Control Bar -->
    <div class="bg-white p-4 sm:p-5 rounded-3xl border border-slate-200 shadow-sm space-y-3.5 text-xs">
      
      <!-- Row 1: Payment Status Filter Pills -->
      <div class="flex flex-wrap items-center gap-2 pb-3 border-b border-slate-100" id="payment-filter-group">
        <span class="font-extrabold text-slate-900 uppercase tracking-wider text-[11px] mr-1 flex items-center gap-1">
          <span>💳</span> Payment Status:
        </span>
        <button data-payment="all" class="payment-btn bg-slate-900 text-white font-bold px-3.5 py-1.5 rounded-full shadow-sm transition">All Orders ({orders.length})</button>
        <button data-payment="PAID" class="payment-btn bg-emerald-50 text-emerald-900 border border-emerald-300 font-bold px-3.5 py-1.5 rounded-full hover:bg-emerald-100 transition">✓ Paid / Confirmed ({paidOrdersCount})</button>
        <button data-payment="PENDING" class="payment-btn bg-amber-50 text-amber-950 border border-amber-300 font-bold px-3.5 py-1.5 rounded-full hover:bg-amber-100 transition">⚠️ Payment Pending ({pendingPaymentCount})</button>
        <button data-payment="COD" class="payment-btn bg-sky-50 text-sky-950 border border-sky-300 font-bold px-3.5 py-1.5 rounded-full hover:bg-sky-100 transition">🚚 Cash on Delivery ({codOrdersCount})</button>
      </div>

      <!-- Row 2: Date Filters & Search -->
      <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-3">
        <!-- Date Filter Buttons -->
        <div class="flex flex-wrap items-center gap-2" id="date-filter-group">
          <span class="font-extrabold text-slate-800 uppercase tracking-wider text-[10px] mr-1">📅 Date:</span>
          <button data-date="all" class="date-btn bg-amber-800 text-white font-bold px-3.5 py-1.5 rounded-full shadow-sm transition">All Time</button>
          <button data-date="today" class="date-btn bg-slate-100 text-slate-700 font-bold px-3 py-1.5 rounded-full hover:bg-amber-100 hover:text-amber-900 transition">☀️ Today</button>
          <button data-date="yesterday" class="date-btn bg-slate-100 text-slate-700 font-bold px-3 py-1.5 rounded-full hover:bg-amber-100 hover:text-amber-900 transition">🌙 Yesterday</button>
          <button data-date="7days" class="date-btn bg-slate-100 text-slate-700 font-bold px-3 py-1.5 rounded-full hover:bg-amber-100 hover:text-amber-900 transition">🗓️ Last 7 Days</button>
          <button data-date="month" class="date-btn bg-slate-100 text-slate-700 font-bold px-3 py-1.5 rounded-full hover:bg-amber-100 hover:text-amber-900 transition">📊 This Month</button>
        </div>

        <!-- Status & Search Inputs -->
        <div class="flex flex-wrap items-center gap-2.5">
          <select id="status-filter" class="bg-slate-100 text-xs font-bold text-slate-800 rounded-2xl px-3 py-2 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500">
            <option value="active" selected>Active Orders (Hide Cancelled)</option>
            <option value="all">All Orders (Including Cancelled)</option>
            <option value="PROCESSING">PROCESSING</option>
            <option value="SHIPPED">SHIPPED</option>
            <option value="DELIVERED">DELIVERED</option>
            <option value="CANCELLED">CANCELLED</option>
            <option value="ARCHIVED">ARCHIVED</option>
          </select>

          <input
            type="text"
            id="order-search-input"
            placeholder="Search Order #, Phone, Name..."
            class="bg-slate-100 text-xs font-medium text-slate-800 rounded-2xl px-4 py-2 border border-slate-200 focus:outline-none focus:ring-2 focus:ring-amber-500 w-full sm:w-56"
          />
        </div>
      </div>
    </div>

    <!-- Orders Cards / Detailed Permanent List -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="p-4 sm:p-6 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-slate-50/70">
        <div class="flex items-center gap-4">
          <label class="flex items-center gap-2 text-xs font-black text-slate-800 cursor-pointer select-none">
            <input
              type="checkbox"
              id="select-all-orders-checkbox"
              class="w-4 h-4 rounded text-amber-800 focus:ring-amber-500 border-slate-300 cursor-pointer"
            />
            <span>Select All</span>
          </label>
          <span class="text-xs text-slate-400 font-bold">•</span>
          <span class="text-xs font-bold text-slate-600">
            Selected: <strong id="selected-orders-count" class="text-amber-900 bg-amber-100 px-2.5 py-0.5 rounded-full font-mono">0</strong>
          </span>
          <span class="text-xs text-slate-400 font-bold">•</span>
          <span class="text-xs text-slate-500 font-medium">Visible: <strong id="visible-order-count">{orders.length}</strong></span>
        </div>

        <div class="flex items-center gap-2.5">
          <button
            type="button"
            id="download-selected-orders-btn"
            class="bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-extrabold px-4 py-2 rounded-xl transition shadow-xs flex items-center gap-1.5 cursor-pointer disabled:opacity-40 disabled:cursor-not-allowed"
            disabled
          >
            <span>📥</span>
            <span>Download Selected (<span id="btn-selected-count">0</span>)</span>
          </button>

          <button
            type="button"
            id="download-all-orders-btn"
            class="bg-slate-900 hover:bg-slate-800 text-white text-xs font-extrabold px-4 py-2 rounded-xl transition shadow-xs flex items-center gap-1.5 cursor-pointer"
          >
            <span>📑</span>
            <span>Download All ({orders.length})</span>
          </button>
        </div>
      </div>

      {orders.length === 0 ? (
        <div class="p-12 text-center text-slate-500">
          <span class="text-4xl block mb-2">📦</span>
          <p class="font-bold text-sm">No customer orders received yet.</p>
          <p class="text-xs text-slate-400 mt-1">Storefront orders will appear here automatically.</p>
        </div>
      ) : (
        <div class="divide-y divide-slate-200" id="orders-list-container">
          {orders.map((o) => {
            const isoDate = new Date(o.createdAt).toISOString();
            const searchText = `${o.orderNumber} ${o.customerName} ${o.customerPhone} ${o.customerEmail} ${o.shippingAddress} ${o.pincode}`.toLowerCase();

            return (
              <div
                class="order-card-row p-6 hover:bg-slate-50/50 transition space-y-4"
                data-order-id={o.id}
                data-created-at={isoDate}
                data-status={o.orderStatus}
                data-payment-status={o.paymentStatus}
                data-payment-method={o.paymentMethod}
                data-search={searchText}
              >
                
                <!-- Top Row: Order ID, Date, Payment Status & Total -->
                <div class="flex flex-wrap items-center justify-between gap-3 text-xs">
                  <div class="flex items-center gap-3">
                    <input
                      type="checkbox"
                      class="order-select-checkbox w-4 h-4 rounded text-amber-800 focus:ring-amber-500 border-slate-300 cursor-pointer shrink-0"
                      data-order-id={o.id}
                      aria-label={`Select order ${o.orderNumber}`}
                    />
                    <span class="font-mono font-black text-slate-900 text-base bg-slate-100 px-3 py-1 rounded-xl border border-slate-200">
                      #{o.orderNumber}
                    </span>
                    <span class="text-slate-400 font-medium">
                      {new Date(o.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })}
                    </span>
                  </div>

                  <div class="flex flex-wrap items-center gap-2">
                    <span class="font-black text-base text-slate-900 bg-amber-50 border border-amber-200 px-3 py-1 rounded-xl">
                      Total: ₹{o.totalAmount?.toLocaleString('en-IN')}
                    </span>
                    <span class="bg-slate-100 text-slate-800 font-bold px-3 py-1 rounded-full text-[10px] uppercase">
                      Payment: {o.paymentMethod}
                    </span>
                    <span class={`font-black px-3 py-1 rounded-full text-[10px] uppercase border shadow-sm ${
                      o.paymentStatus === 'PAID'
                        ? 'bg-emerald-100 text-emerald-900 border-emerald-300'
                        : o.paymentStatus === 'COD_PENDING' || o.paymentMethod === 'COD'
                        ? 'bg-sky-100 text-sky-900 border-sky-300'
                        : 'bg-amber-100 text-amber-950 border-amber-300'
                    }`}>
                      {o.paymentStatus === 'PAID'
                        ? '✓ PAID'
                        : o.paymentStatus === 'COD_PENDING' || o.paymentMethod === 'COD'
                        ? '🚚 COD PENDING'
                        : '⚠️ PAYMENT PENDING'}
                    </span>

                    <!-- Order Status Selector -->
                    <select
                      class="order-status-select bg-slate-900 hover:bg-slate-800 text-white font-extrabold text-[10px] uppercase px-2.5 py-1.5 rounded-xl border border-slate-700 cursor-pointer focus:outline-none focus:ring-2 focus:ring-amber-500 transition shadow-xs"
                      data-order-id={o.id}
                      aria-label="Update Order Status"
                    >
                      <option value="PROCESSING" selected={o.orderStatus === 'PROCESSING'}>🔵 PROCESSING</option>
                      <option value="SHIPPED" selected={o.orderStatus === 'SHIPPED'}>🚚 SHIPPED</option>
                      <option value="DELIVERED" selected={o.orderStatus === 'DELIVERED'}>✅ DELIVERED</option>
                      <option value="CANCELLED" selected={o.orderStatus === 'CANCELLED'}>🚫 CANCELLED</option>
                      <option value="ARCHIVED" selected={o.orderStatus === 'ARCHIVED'}>🗑️ ARCHIVED</option>
                    </select>

                    <!-- Quick Delete / Cancel Button -->
                    {o.orderStatus !== 'CANCELLED' && o.orderStatus !== 'ARCHIVED' ? (
                      <button
                        type="button"
                        class="archive-order-btn bg-rose-50 hover:bg-rose-100 text-rose-700 hover:text-rose-900 border border-rose-200 text-[10px] font-black px-2.5 py-1.5 rounded-xl transition cursor-pointer flex items-center gap-1 shadow-2xs"
                        data-order-id={o.id}
                        data-order-number={o.orderNumber}
                        title="Delete / Cancel this order (move to archive)"
                      >
                        <span>🗑️ Delete</span>
                      </button>
                    ) : (
                      <button
                        type="button"
                        class="restore-order-btn bg-emerald-50 hover:bg-emerald-100 text-emerald-700 hover:text-emerald-900 border border-emerald-200 text-[10px] font-black px-2.5 py-1.5 rounded-xl transition cursor-pointer flex items-center gap-1 shadow-2xs"
                        data-order-id={o.id}
                        data-order-number={o.orderNumber}
                        title="Restore this order back to active processing"
                      >
                        <span>🔄 Restore</span>
                      </button>
                    )}
                  </div>
                </div>

                <!-- Middle Content: 2-Column Clean Layout (Customer Info & Ordered Products with Photo) -->
                <div class="grid grid-cols-1 md:grid-cols-12 gap-6 pt-2">
                  
                  <!-- Left: Customer Details & Address -->
                  <div class="md:col-span-5 bg-slate-50 p-5 rounded-2xl border border-slate-200/80 space-y-3 text-xs flex flex-col justify-between">
                    <div>
                      <span class="font-extrabold text-slate-900 block text-xs border-b border-slate-200 pb-2 flex items-center justify-between">
                        <span class="flex items-center gap-1.5">
                          <span>👤</span> Customer & Delivery Address
                        </span>
                        <span class="text-[10px] text-slate-400 font-mono font-normal">ID: {o.id.slice(0, 8)}</span>
                      </span>

                      <div class="space-y-2 pt-2.5">
                        <div class="font-extrabold text-slate-900 text-sm">{o.customerName}</div>
                        
                        <div class="flex flex-wrap items-center gap-2 pt-0.5">
                          <a
                            href={`tel:${o.customerPhone}`}
                            class="inline-flex items-center gap-1 bg-white hover:bg-slate-100 text-slate-800 font-bold px-2.5 py-1 rounded-lg border border-slate-300 transition"
                          >
                            <span>📞</span> {o.customerPhone}
                          </a>

                          <a
                            href={`https://wa.me/${o.customerPhone.replace(/\D/g, '')}?text=${encodeURIComponent(`Namaste ${o.customerName}! 🙏\n\nThank you for shopping with *Teepul Luxury Curtains*.\n\n✅ *Your Order is Confirmed!*\n📋 *Order Number:* ${o.orderNumber}\n💵 *Total Amount:* ₹${o.totalAmount.toLocaleString('en-IN')}\n💳 *Payment Status:* ${o.paymentStatus}\n📍 *Delivery Address:* ${o.shippingAddress}, ${o.pincode}\n\nYour order is currently being packed and will be dispatched via express courier shortly.\n\nNeed help? Reply directly to this WhatsApp chat. ✨`)}`}
                            target="_blank"
                            class="inline-flex items-center gap-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-black text-[11px] px-3 py-1 rounded-lg border border-emerald-700 transition shadow-xs"
                            title="Send instant order confirmation WhatsApp message to customer"
                          >
                            <span>💬 Send Confirm WhatsApp</span>
                          </a>
                        </div>

                        <div class="text-slate-500 font-mono text-[11px] pt-1">📧 {o.customerEmail}</div>
                        
                        <div class="text-slate-800 font-medium text-xs pt-1.5 bg-white p-3 rounded-xl border border-slate-200 leading-relaxed">
                          📍 <strong>Delivery Address:</strong><br />
                          {o.shippingAddress}
                          <div class="text-slate-600 text-xs font-bold pt-1">
                            {o.city ? `${o.city}, ` : ''}{o.state ? `${o.state} - ` : ''}<span class="font-mono text-slate-900 bg-amber-100 px-1.5 py-0.5 rounded">{o.pincode}</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Right: Ordered Product Specifications (with Photo, Color Swatch & Live Link) -->
                  <div class="md:col-span-7 bg-amber-50/40 p-5 rounded-2xl border border-amber-200/80 space-y-3 text-xs">
                    <span class="font-extrabold text-amber-950 block text-xs border-b border-amber-200 pb-2 flex items-center gap-1.5">
                      <span>🚪</span> Ordered Product & Variant Details
                    </span>

                    <div class="space-y-3 pt-1">
                      {o.items.map((item) => {
                        const info = getItemProductInfo(item);
                        return (
                          <div class="bg-white p-4 rounded-2xl border border-amber-200 shadow-2xs flex flex-col sm:flex-row items-start sm:items-center gap-4">
                            
                            <!-- Product Variant Image -->
                            <div class="w-20 h-24 sm:w-24 sm:h-28 rounded-xl overflow-hidden border border-slate-200 bg-slate-100 shrink-0 shadow-xs relative group">
                              <img
                                src={info.variantImage}
                                alt={`${info.productName} - ${item.color || 'Variant'}`}
                                width="96"
                                height="112"
                                loading="lazy"
                                class="w-full h-full object-cover"
                              />
                            </div>

                            <!-- Product Info & Specs -->
                            <div class="space-y-2 flex-1 min-w-0">
                              <div class="font-extrabold text-slate-900 text-sm leading-snug">
                                {item.productTitle}
                              </div>

                              <div class="flex flex-wrap items-center gap-2 text-xs font-bold pt-0.5">
                                <!-- Color Badge with swatch -->
                                <span class="bg-amber-100 text-amber-950 px-2.5 py-1 rounded-lg border border-amber-300 flex items-center gap-1.5">
                                  <span class="w-3 h-3 rounded-full border border-slate-400 shrink-0 shadow-2xs" style={`background-color: ${info.colorHex}`}></span>
                                  <span>Color: <strong>{item.color || 'Standard'}</strong></span>
                                </span>

                                <!-- Size Badge -->
                                <span class="bg-blue-50 text-blue-950 px-2.5 py-1 rounded-lg border border-blue-200">
                                  📏 Size: <strong>{item.size || '5 Feet (Window)'}</strong>
                                </span>

                                <!-- Qty & Price -->
                                <span class="bg-slate-100 text-slate-800 px-2.5 py-1 rounded-lg font-mono">
                                  Qty: {item.quantity} × ₹{item.unitPrice?.toLocaleString('en-IN')} = <strong>₹{item.totalPrice?.toLocaleString('en-IN')}</strong>
                                </span>
                              </div>

                              <!-- Live Product Link with Pre-selected Variant -->
                              <div class="pt-2 border-t border-slate-100">
                                <a
                                  href={`/products/${info.slug}?color=${encodeURIComponent(item.color || '')}&size=${encodeURIComponent(item.size || '')}`}
                                  target="_blank"
                                  class="inline-flex items-center gap-1.5 text-xs font-extrabold text-amber-900 bg-amber-50 hover:bg-amber-100 border border-amber-300 px-3 py-1.5 rounded-xl transition hover:shadow-2xs"
                                >
                                  <span>🔗 View Live Product (Variant Pre-selected)</span>
                                  <span>↗</span>
                                </a>
                              </div>

                            </div>

                          </div>
                        );
                      })}
                    </div>
                  </div>

                </div>

              </div>
            );
          })}
        </div>
      )}
    </div>

  </div>

  <script is:inline>
    // Day-by-Day, Payment Status & Fulfillment Interactive Filter Script
    document.addEventListener('DOMContentLoaded', () => {
      const paymentBtns = document.querySelectorAll('.payment-btn');
      const dateBtns = document.querySelectorAll('.date-btn');
      const statusSelect = document.getElementById('status-filter');
      const searchInput = document.getElementById('order-search-input');
      const orderRows = document.querySelectorAll('.order-card-row');
      const visibleCountEl = document.getElementById('visible-order-count');

      let currentPaymentFilter = 'all';
      let currentDateFilter = 'all';
      let currentStatusFilter = 'active';
      let currentQuery = '';

      function applyFilters() {
        const now = new Date();
        const todayStart = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
        const yesterdayStart = todayStart - (24 * 60 * 60 * 1000);
        const sevenDaysAgo = todayStart - (7 * 24 * 60 * 60 * 1000);
        const monthStart = new Date(now.getFullYear(), now.getMonth(), 1).getTime();

        let visibleCount = 0;

        orderRows.forEach((row) => {
          const rawDate = row.getAttribute('data-created-at');
          const rowTime = rawDate ? new Date(rawDate).getTime() : 0;
          const rowStatus = row.getAttribute('data-status') || '';
          const rowPaymentStatus = row.getAttribute('data-payment-status') || '';
          const rowPaymentMethod = row.getAttribute('data-payment-method') || '';
          const rowSearch = row.getAttribute('data-search') || '';

          // 1. Payment status condition
          let passPayment = false;
          if (currentPaymentFilter === 'all') {
            passPayment = true;
          } else if (currentPaymentFilter === 'PAID') {
            passPayment = rowPaymentStatus === 'PAID';
          } else if (currentPaymentFilter === 'PENDING') {
            passPayment = rowPaymentStatus === 'PENDING';
          } else if (currentPaymentFilter === 'COD') {
            passPayment = rowPaymentStatus === 'COD_PENDING' || rowPaymentMethod === 'COD';
          }

          // 2. Date filter condition
          let passDate = false;
          if (currentDateFilter === 'all') passDate = true;
          else if (currentDateFilter === 'today' && rowTime >= todayStart) passDate = true;
          else if (currentDateFilter === 'yesterday' && rowTime >= yesterdayStart && rowTime < todayStart) passDate = true;
          else if (currentDateFilter === '7days' && rowTime >= sevenDaysAgo) passDate = true;
          else if (currentDateFilter === 'month' && rowTime >= monthStart) passDate = true;

          // 3. Status filter condition (Hide CANCELLED/ARCHIVED by default on 'active')
          let passStatus = false;
          if (currentStatusFilter === 'active') {
            passStatus = rowStatus !== 'CANCELLED' && rowStatus !== 'ARCHIVED';
          } else if (currentStatusFilter === 'all') {
            passStatus = true;
          } else if (rowStatus === currentStatusFilter) {
            passStatus = true;
          }

          // 4. Search query condition
          let passSearch = false;
          if (!currentQuery || rowSearch.includes(currentQuery)) passSearch = true;

          if (passPayment && passDate && passStatus && passSearch) {
            row.style.display = 'block';
            visibleCount += 1;
          } else {
            row.style.display = 'none';
          }
        });

        if (visibleCountEl) visibleCountEl.innerText = String(visibleCount);
      }

      // Order Status Select Change Handler
      document.querySelectorAll('.order-status-select').forEach((sel) => {
        sel.addEventListener('change', async () => {
          const orderId = sel.getAttribute('data-order-id');
          const newStatus = sel.value;
          if (!orderId) return;

          try {
            sel.disabled = true;
            const res = await fetch('/api/admin/orders/update-status', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ orderId, orderStatus: newStatus }),
            });
            const data = await res.json();
            if (data.success) {
              const row = sel.closest('.order-card-row');
              if (row) {
                row.setAttribute('data-status', newStatus);
              }
              applyFilters();
            } else {
              alert('Error updating status: ' + (data.error || 'Failed'));
            }
          } catch (err) {
            console.error(err);
            alert('Failed to update order status');
          } finally {
            sel.disabled = false;
          }
        });
      });

      // Quick Delete / Cancel Order Handler
      document.querySelectorAll('.archive-order-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const orderId = btn.getAttribute('data-order-id');
          const orderNumber = btn.getAttribute('data-order-number');
          if (!orderId) return;

          if (!confirm(`Are you sure you want to delete / cancel order #${orderNumber}? It will be hidden from active orders.`)) {
            return;
          }

          try {
            btn.disabled = true;
            btn.innerText = '⌛ Deleting...';
            const res = await fetch('/api/admin/orders/update-status', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ orderId, orderStatus: 'CANCELLED' }),
            });
            const data = await res.json();
            if (data.success) {
              const row = btn.closest('.order-card-row');
              if (row) {
                row.setAttribute('data-status', 'CANCELLED');
                const sel = row.querySelector('.order-status-select');
                if (sel) sel.value = 'CANCELLED';
              }
              applyFilters();
            } else {
              alert('Error: ' + (data.error || 'Failed'));
              btn.disabled = false;
              btn.innerText = '🗑️ Delete';
            }
          } catch (err) {
            console.error(err);
            alert('Failed to delete order');
            btn.disabled = false;
            btn.innerText = '🗑️ Delete';
          }
        });
      });

      // Quick Restore Order Handler
      document.querySelectorAll('.restore-order-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const orderId = btn.getAttribute('data-order-id');
          const orderNumber = btn.getAttribute('data-order-number');
          if (!orderId) return;

          try {
            btn.disabled = true;
            btn.innerText = '⌛ Restoring...';
            const res = await fetch('/api/admin/orders/update-status', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ orderId, orderStatus: 'PROCESSING' }),
            });
            const data = await res.json();
            if (data.success) {
              const row = btn.closest('.order-card-row');
              if (row) {
                row.setAttribute('data-status', 'PROCESSING');
                const sel = row.querySelector('.order-status-select');
                if (sel) sel.value = 'PROCESSING';
              }
              applyFilters();
            } else {
              alert('Error: ' + (data.error || 'Failed'));
              btn.disabled = false;
              btn.innerText = '🔄 Restore';
            }
          } catch (err) {
            console.error(err);
            alert('Failed to restore order');
            btn.disabled = false;
            btn.innerText = '🔄 Restore';
          }
        });
      });

      // Initial Filter Run on Load
      applyFilters();

      paymentBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          paymentBtns.forEach((b) => {
            b.classList.remove('bg-slate-900', 'text-white');
            b.classList.add('bg-slate-100', 'text-slate-700');
          });
          btn.classList.remove('bg-slate-100', 'text-slate-700', 'bg-emerald-50', 'bg-amber-50', 'bg-sky-50');
          btn.classList.add('bg-slate-900', 'text-white');

          currentPaymentFilter = btn.getAttribute('data-payment') || 'all';
          applyFilters();
        });
      });

      dateBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          dateBtns.forEach((b) => {
            b.classList.remove('bg-amber-800', 'text-white');
            b.classList.add('bg-slate-100', 'text-slate-700');
          });
          btn.classList.remove('bg-slate-100', 'text-slate-700');
          btn.classList.add('bg-amber-800', 'text-white');

          currentDateFilter = btn.getAttribute('data-date') || 'all';
          applyFilters();
        });
      });

      statusSelect?.addEventListener('change', (e) => {
        currentStatusFilter = e.target.value;
        applyFilters();
      });

      searchInput?.addEventListener('input', (e) => {
        currentQuery = e.target.value.toLowerCase().trim();
        applyFilters();
      });

      // ==========================================
      // Order Checkbox Selection & Excel / CSV Export
      // ==========================================
      const rawOrdersJson = document.getElementById('orders-json-data')?.textContent;
      const allOrders = rawOrdersJson ? JSON.parse(rawOrdersJson) : [];

      const selectAllCheckbox = document.getElementById('select-all-orders-checkbox');
      const orderCheckboxes = document.querySelectorAll('.order-select-checkbox');
      const selectedCountBadge = document.getElementById('selected-orders-count');
      const btnSelectedCount = document.getElementById('btn-selected-count');
      const downloadSelectedBtn = document.getElementById('download-selected-orders-btn');
      const downloadAllBtn = document.getElementById('download-all-orders-btn');
      const exportTopBtn = document.getElementById('export-orders-top-btn');

      function getSelectedOrderIds() {
        const ids = [];
        orderCheckboxes.forEach((cb) => {
          if (cb.checked) {
            ids.push(cb.getAttribute('data-order-id'));
          }
        });
        return ids;
      }

      function updateSelectionUI() {
        const selectedIds = getSelectedOrderIds();
        const count = selectedIds.length;

        if (selectedCountBadge) selectedCountBadge.innerText = String(count);
        if (btnSelectedCount) btnSelectedCount.innerText = String(count);

        if (downloadSelectedBtn) {
          downloadSelectedBtn.disabled = count === 0;
        }

        // Highlight selected order rows
        orderRows.forEach((row) => {
          const cb = row.querySelector('.order-select-checkbox');
          if (cb && cb.checked) {
            row.classList.add('bg-amber-50/40', 'ring-1', 'ring-amber-400');
          } else {
            row.classList.remove('bg-amber-50/40', 'ring-1', 'ring-amber-400');
          }
        });

        // Update Select All checkbox state
        const visibleRows = Array.from(orderRows).filter((r) => r.style.display !== 'none');
        const visibleCheckboxes = visibleRows.map((r) => r.querySelector('.order-select-checkbox')).filter(Boolean);
        if (selectAllCheckbox && visibleCheckboxes.length > 0) {
          const allVisibleChecked = visibleCheckboxes.every((cb) => cb.checked);
          const someVisibleChecked = visibleCheckboxes.some((cb) => cb.checked);
          selectAllCheckbox.checked = allVisibleChecked;
          selectAllCheckbox.indeterminate = !allVisibleChecked && someVisibleChecked;
        }
      }

      selectAllCheckbox?.addEventListener('change', (e) => {
        const isChecked = e.target.checked;
        orderRows.forEach((row) => {
          if (row.style.display !== 'none') {
            const cb = row.querySelector('.order-select-checkbox');
            if (cb) cb.checked = isChecked;
          }
        });
        updateSelectionUI();
      });

      orderCheckboxes.forEach((cb) => {
        cb.addEventListener('change', updateSelectionUI);
      });

      // Escape CSV values
      function escapeCsv(val) {
        if (val === null || val === undefined) return '';
        const str = String(val).trim();
        if (str.includes(',') || str.includes('"') || str.includes('\n') || str.includes('\r')) {
          return `"${str.replace(/"/g, '""')}"`;
        }
        return str;
      }

      // Format Date: DD-MM-YYYY
      function formatDate(raw) {
        if (!raw) return '';
        const d = new Date(raw);
        const day = String(d.getDate()).padStart(2, '0');
        const month = String(d.getMonth() + 1).padStart(2, '0');
        const year = d.getFullYear();
        return `${day}-${month}-${year}`;
      }

      // Generate Exact Courier CSV Format
      function generateOrdersCsv(ordersToExport) {
        const headers = [
          'Order_id',
          'Order_Created_Date',
          'Shipping_Address_FirstName',
          'Shipping_Address_LastName',
          'Shipping_Address',
          'Shipping_Address_Phone',
          'Shipping_Address_Alternate_Phone',
          'Shipping_Address_Pincode/Zipcode',
          'Customer_GSTIN',
          'Line_Item_SKU',
          'Line_Item_HSN',
          'Line_Item_Name',
          'Line_Item_Description',
          'Line_Item_Retail_Price',
          'Line_Item_Tax/VAT_Slab',
          'Shipping_Charges',
          'Line_Item_Quantity',
          'Payment_Mode',
          'Is_Confirmed',
          'Latitude',
          'Longitude'
        ];

        const rows = [headers.join(',')];

        ordersToExport.forEach((o) => {
          const dateStr = formatDate(o.createdAt);
          const nameParts = (o.customerName || '').trim().split(/\s+/);
          const firstName = nameParts[0] || '';
          const lastName = nameParts.slice(1).join(' ') || '';
          const fullAddress = [o.shippingAddress, o.city, o.state].filter(Boolean).join(', ');
          const phone = o.customerPhone || '';
          const altPhone = '';
          const pincode = o.pincode || '';
          const gstin = '';
          const paymentMode = (o.paymentMethod === 'COD' || o.paymentStatus === 'COD_PENDING') ? 'COD' : 'Prepaid';
          const isConfirmed = (o.paymentStatus === 'PAID' || o.orderStatus === 'PROCESSING' || o.orderStatus === 'SHIPPED' || o.orderStatus === 'DELIVERED') ? 'true' : 'false';

          const items = (o.items && o.items.length > 0) ? o.items : [
            {
              productId: 'CURTAIN-PANEL',
              productTitle: 'Luxury Curtain Panel',
              color: 'Standard',
              size: '7ft Door',
              unitPrice: o.totalAmount,
              quantity: 1
            }
          ];

          items.forEach((item) => {
            const sku = item.productId || 'SKU-' + (item.productTitle ? item.productTitle.slice(0, 10).replace(/\s+/g, '-').toUpperCase() : 'CURTAIN');
            const hsn = '6303';
            const itemName = item.productTitle || 'Teepul Luxury Curtain Panel';
            const descParts = [];
            if (item.color) descParts.push(`Color: ${item.color}`);
            if (item.size) descParts.push(`Size: ${item.size}`);
            const itemDesc = descParts.join(', ') || 'Curtains & Drapery';
            const price = item.unitPrice ?? o.totalAmount;
            const taxSlab = 0;
            const shippingCharges = 0;
            const qty = item.quantity ?? 1;

            const row = [
              escapeCsv(o.orderNumber || o.id),
              escapeCsv(dateStr),
              escapeCsv(firstName),
              escapeCsv(lastName),
              escapeCsv(fullAddress),
              escapeCsv(phone),
              escapeCsv(altPhone),
              escapeCsv(pincode),
              escapeCsv(gstin),
              escapeCsv(sku),
              escapeCsv(hsn),
              escapeCsv(itemName),
              escapeCsv(itemDesc),
              escapeCsv(price),
              escapeCsv(taxSlab),
              escapeCsv(shippingCharges),
              escapeCsv(qty),
              escapeCsv(paymentMode),
              escapeCsv(isConfirmed),
              escapeCsv(''),
              escapeCsv('')
            ];
            rows.push(row.join(','));
          });
        });

        // Prepend UTF-8 BOM so Excel opens with proper character encoding
        return '\uFEFF' + rows.join('\r\n');
      }

      function triggerDownload(csvContent, filename) {
        const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = filename;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);
      }

      // Download Selected Action
      downloadSelectedBtn?.addEventListener('click', () => {
        const selectedIds = getSelectedOrderIds();
        if (selectedIds.length === 0) {
          alert('Please select at least 1 order using the checkboxes.');
          return;
        }
        const selectedOrders = allOrders.filter((o) => selectedIds.includes(o.id));
        const csv = generateOrdersCsv(selectedOrders);
        const filename = `teepul-selected-orders-${selectedOrders.length}-${new Date().toISOString().slice(0, 10)}.csv`;
        triggerDownload(csv, filename);
      });

      // Download All Orders Action
      downloadAllBtn?.addEventListener('click', () => {
        if (allOrders.length === 0) {
          alert('No orders found to export.');
          return;
        }
        const csv = generateOrdersCsv(allOrders);
        const filename = `teepul-all-orders-${allOrders.length}-${new Date().toISOString().slice(0, 10)}.csv`;
        triggerDownload(csv, filename);
      });

      // Top Header Export Button (Downloads selected if any, otherwise all)
      exportTopBtn?.addEventListener('click', () => {
        const selectedIds = getSelectedOrderIds();
        const exportList = selectedIds.length > 0 ? allOrders.filter((o) => selectedIds.includes(o.id)) : allOrders;
        if (exportList.length === 0) {
          alert('No orders found to export.');
          return;
        }
        const csv = generateOrdersCsv(exportList);
        const prefix = selectedIds.length > 0 ? `selected-${exportList.length}` : `all-${exportList.length}`;
        const filename = `teepul-orders-${prefix}-${new Date().toISOString().slice(0, 10)}.csv`;
        triggerDownload(csv, filename);
      });
    });
  </script>

  <!-- Embed orders JSON data for instant client-side Excel/CSV generation -->
  <script id="orders-json-data" type="application/json" set:html={JSON.stringify(orders)} />
</AdminLayout>

