---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import BlockEditor from '../../../components/editor/BlockEditor.astro';
import prisma from '../../../lib/db';

const { id } = Astro.params;

const post = await prisma.post.findUnique({
  where: { id },
  include: {
    categories: true,
    tags: true,
    featuredImage: true,
  },
});

if (!post) {
  return Astro.redirect('/admin/posts');
}

const categories = await prisma.category.findMany({ orderBy: { name: 'asc' } });
const tags = await prisma.tag.findMany({ orderBy: { name: 'asc' } });

let initialBlocks = [];
try {
  initialBlocks = JSON.parse(post.content);
} catch (e) {
  initialBlocks = [{ id: 'b1', type: 'paragraph', data: { text: post.content } }];
}

const selectedCatIds = post.categories.map((c) => c.categoryId);
const selectedTagIds = post.tags.map((t) => t.tagId);

const seoRecord = await prisma.seoMetadata.findUnique({
  where: { entityId: post.id },
});
---

<AdminLayout title={`Edit Post: ${post.title}`} activeNav="posts">
  <form action={`/api/posts/${post.id}`} method="POST" class="space-y-8">
    <input type="hidden" name="_method" value="PUT" />

    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <a href="/admin/posts" class="text-xs text-gray-500 hover:text-gray-900 font-semibold">← Back to Posts</a>
      </div>
      <div class="flex items-center gap-3">
        <button type="submit" name="status" value="draft" class="bg-gray-200 hover:bg-gray-300 text-gray-800 text-xs font-bold px-4 py-2.5 rounded-xl transition">
          Save Draft
        </button>
        <button type="submit" name="status" value="published" class="bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold px-5 py-2.5 rounded-xl shadow transition">
          Update Post
        </button>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 space-y-6">
        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm space-y-4">
          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Post Title</label>
            <input
              type="text"
              name="title"
              value={post.title}
              required
              class="w-full text-xl font-bold border border-gray-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Slug</label>
            <input
              type="text"
              name="slug"
              value={post.slug}
              required
              class="w-full text-xs font-mono border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Excerpt</label>
            <textarea
              name="excerpt"
              rows="3"
              class="w-full text-xs border border-gray-300 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-blue-500"
            >{post.excerpt}</textarea>
          </div>
        </div>

        <BlockEditor initialBlocks={initialBlocks} fieldName="content" />

        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm space-y-4">
          <h3 class="text-sm font-bold text-gray-900 flex items-center gap-2">
            <span>🔍 SEO Settings</span>
          </h3>

          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1">SEO Meta Title</label>
            <input type="text" name="seoTitle" value={seoRecord?.seoTitle || ''} class="w-full text-xs border border-gray-300 rounded-lg px-3 py-2" />
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1">Meta Description</label>
            <textarea name="metaDescription" rows="2" class="w-full text-xs border border-gray-300 rounded-lg p-3">{seoRecord?.metaDescription || ''}</textarea>
          </div>
        </div>
      </div>

      <div class="space-y-6">
        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
          <h3 class="text-xs font-bold uppercase tracking-wider text-gray-700 mb-3">Categories</h3>
          <div class="space-y-2 max-h-48 overflow-y-auto">
            {categories.map((c) => (
              <label class="flex items-center gap-2 text-xs text-gray-700 cursor-pointer">
                <input
                  type="checkbox"
                  name="categories"
                  value={c.id}
                  checked={selectedCatIds.includes(c.id)}
                  class="rounded text-blue-600 focus:ring-blue-500"
                />
                <span>{c.name}</span>
              </label>
            ))}
          </div>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
          <h3 class="text-xs font-bold uppercase tracking-wider text-gray-700 mb-3">Tags</h3>
          <div class="space-y-2 max-h-48 overflow-y-auto">
            {tags.map((t) => (
              <label class="flex items-center gap-2 text-xs text-gray-700 cursor-pointer">
                <input
                  type="checkbox"
                  name="tags"
                  value={t.id}
                  checked={selectedTagIds.includes(t.id)}
                  class="rounded text-blue-600 focus:ring-blue-500"
                />
                <span>{t.name}</span>
              </label>
            ))}
          </div>
        </div>

        <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm">
          <h3 class="text-xs font-bold uppercase tracking-wider text-gray-700 mb-3">Featured Image</h3>
          <input
            type="text"
            name="featuredImageUrl"
            value={post.featuredImage?.url || ''}
            placeholder="URL e.g. /uploads/image.jpg"
            class="w-full text-xs border border-gray-300 rounded-lg px-3 py-2 mb-2"
          />
        </div>
      </div>
    </div>
  </form>
</AdminLayout>
