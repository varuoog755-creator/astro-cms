---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import prisma from '../../../lib/db';

const id = Astro.url.searchParams.get('id');
const error = Astro.url.searchParams.get('error');

let product = null;
if (id) {
  const existing = await prisma.product.findUnique({ where: { id } });
  if (existing) {
    product = {
      ...existing,
      colors: JSON.parse(existing.colorsJson || '[]').map((c: any) => c.name).join(', '),
      sizes: JSON.parse(existing.sizesJson || '[]').join(', '),
      images: JSON.parse(existing.imagesJson || '[]').join('\n'),
      features: JSON.parse(existing.featuresJson || '[]').join(', '),
    };
  }
}
---

<AdminLayout title={product ? 'Edit Product' : 'Add New Product'} activeNav="products_catalog">
  <div class="max-w-4xl space-y-8">
    <div class="flex items-center justify-between border-b border-slate-200 pb-6">
      <div>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">
          {product ? `Edit ${product.name}` : 'Add New Product'}
        </h1>
        <p class="text-sm text-slate-500 mt-1">List new door curtains, window drapes, lights, and home decor items.</p>
      </div>
      <a href="/admin/products" class="bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold px-4 py-2.5 rounded-xl transition">
        &larr; Back to Products
      </a>
    </div>

    {error && (
      <div class="bg-rose-50 border border-rose-300 text-rose-800 text-xs font-bold px-4 py-3 rounded-xl">
        {error}
      </div>
    )}

    <form action="/api/admin/products/save" method="POST" class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm space-y-6">
      {product && <input type="hidden" name="id" value={product.id} />}

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Product Title *</label>
          <input
            type="text"
            name="name"
            required
            value={product?.name || ''}
            placeholder="e.g. Teepul Royal Velvet Door Curtain"
            class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 font-semibold focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Category *</label>
          <select name="category" class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 font-bold focus:ring-2 focus:ring-blue-500">
            <option value="Door Curtains" selected={product?.category === 'Door Curtains'}>Door Curtains (7ft / 9ft)</option>
            <option value="Window Curtains" selected={product?.category === 'Window Curtains'}>Window Curtains (5ft / 7ft)</option>
            <option value="Ambient Lighting" selected={product?.category === 'Ambient Lighting'}>Ambient Lighting & Globes</option>
            <option value="Home Accents" selected={product?.category === 'Home Accents'}>Luxury Cushion Covers & Accents</option>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Tagline</label>
        <input
          type="text"
          name="tagline"
          value={product?.tagline || ''}
          placeholder="100% Thermal Blackout Velvet Drapery"
          class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 focus:ring-2 focus:ring-blue-500"
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Selling Price (₹) *</label>
          <input
            type="number"
            step="0.01"
            name="price"
            required
            value={product?.price || ''}
            placeholder="1899"
            class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 font-bold focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Original Price (₹)</label>
          <input
            type="number"
            step="0.01"
            name="originalPrice"
            value={product?.originalPrice || ''}
            placeholder="2999"
            class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 font-medium focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Fabric GSM</label>
          <input
            type="number"
            name="gsm"
            value={product?.gsm || 350}
            placeholder="350"
            class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 font-medium focus:ring-2 focus:ring-blue-500"
          />
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Product Description *</label>
        <textarea
          name="description"
          required
          rows="4"
          placeholder="Describe fabric specs, grommets, light blockage, and care instructions..."
          class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl p-4 focus:ring-2 focus:ring-blue-500 font-sans"
        >{product?.description || ''}</textarea>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Colors (comma separated)</label>
          <input
            type="text"
            name="colors"
            value={product?.colors || 'Royal Cream Ivory, Soft Champagne Gold, Warm Beige'}
            class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-4 py-3"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Sizes (comma separated)</label>
          <input
            type="text"
            name="sizes"
            value={product?.sizes || '7 Foot (Door), 9 Foot (Long Door)'}
            class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-4 py-3"
          />
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Image URLs (one URL per line)</label>
        <textarea
          name="images"
          rows="3"
          placeholder="https://images.unsplash.com/photo-1513694203232-719a280e022f"
          class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl p-4 font-mono focus:ring-2 focus:ring-blue-500"
        >{product?.images || ''}</textarea>
      </div>

      <div class="flex items-center justify-between border-t border-slate-200 pt-6">
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" name="inStock" value="true" checked={product ? product.inStock : true} class="w-4 h-4 text-blue-600 rounded" />
          <span class="text-xs font-bold text-slate-800">Product In Stock & Available for Order</span>
        </label>

        <button
          type="submit"
          class="bg-blue-600 hover:bg-blue-500 text-white font-extrabold text-xs px-8 py-3.5 rounded-xl shadow-lg shadow-blue-500/20 transition"
        >
          {product ? 'Update Product' : 'Publish Product to Storefront'} &rarr;
        </button>
      </div>
    </form>
  </div>
</AdminLayout>
