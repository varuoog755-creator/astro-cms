---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import prisma from '../../../lib/db';

const id = Astro.url.searchParams.get('id');
const error = Astro.url.searchParams.get('error');

let product = null;
let productSizes: { name: string; price: number; originalPrice?: number }[] = [];

if (id) {
  const existing = await prisma.product.findUnique({ where: { id } });
  if (existing) {
    try {
      const raw = JSON.parse(existing.sizesJson || '[]');
      productSizes = raw.map((s: any) => {
        if (typeof s === 'string') {
          return { name: s, price: existing.price, originalPrice: existing.originalPrice || undefined };
        }
        return { name: s.name, price: s.price || existing.price, originalPrice: s.originalPrice };
      });
    } catch (e) {
      productSizes = [];
    }

    product = {
      ...existing,
      colors: JSON.parse(existing.colorsJson || '[]').map((c: any) => c.name).join(', '),
      sizes: productSizes.map(s => `${s.name}:${s.price}`).join(', '),
      images: JSON.parse(existing.imagesJson || '[]').join('\n'),
      features: JSON.parse(existing.featuresJson || '[]').join(', '),
    };
  }
}

if (!productSizes.length) {
  productSizes = [
    { name: '5 Feet (Window)', price: 499, originalPrice: 799 },
    { name: '6 Feet', price: 549, originalPrice: 849 },
    { name: '7 Feet (Door)', price: 599, originalPrice: 999 },
    { name: '9 Feet (Long Door)', price: 799, originalPrice: 1299 },
  ];
}
---

<AdminLayout title={product ? 'Edit Product' : 'Add New Product'} activeNav="products_catalog">
  <div class="max-w-4xl space-y-8">
    <div class="flex items-center justify-between border-b border-slate-200 pb-6">
      <div>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">
          {product ? `Edit ${product.name}` : 'Add New Product'}
        </h1>
        <p class="text-sm text-slate-500 mt-1">List new door curtains, window drapes, lights, and home decor items.</p>
      </div>
      <a href="/admin/products" class="bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold px-4 py-2.5 rounded-xl transition">
        &larr; Back to Products
      </a>
    </div>

    {error && (
      <div class="bg-rose-50 border border-rose-300 text-rose-800 text-xs font-bold px-4 py-3 rounded-xl">
        {error}
      </div>
    )}

    <form action="/api/admin/products/save" method="POST" class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm space-y-6">
      {product && <input type="hidden" name="id" value={product.id} />}

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Product Title *</label>
          <input
            type="text"
            name="name"
            required
            value={product?.name || ''}
            placeholder="e.g. Teepul Royal Velvet Door Curtain"
            class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 font-semibold focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Category *</label>
          <select name="category" class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 font-bold focus:ring-2 focus:ring-blue-500">
            <option value="Door Curtains" selected={product?.category === 'Door Curtains'}>Door Curtains (7ft / 9ft)</option>
            <option value="Window Curtains" selected={product?.category === 'Window Curtains'}>Window Curtains (5ft / 7ft)</option>
            <option value="Ambient Lighting" selected={product?.category === 'Ambient Lighting'}>Ambient Lighting & Globes</option>
            <option value="Home Accents" selected={product?.category === 'Home Accents'}>Luxury Cushion Covers & Accents</option>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Tagline</label>
        <input
          type="text"
          name="tagline"
          value={product?.tagline || ''}
          placeholder="100% Thermal Blackout Velvet Drapery"
          class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 focus:ring-2 focus:ring-blue-500"
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Selling Price (₹) *</label>
          <input
            type="number"
            step="0.01"
            name="price"
            required
            value={product?.price || ''}
            placeholder="1899"
            class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 font-bold focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Original Price (₹)</label>
          <input
            type="number"
            step="0.01"
            name="originalPrice"
            value={product?.originalPrice || ''}
            placeholder="2999"
            class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 font-medium focus:ring-2 focus:ring-blue-500"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Fabric Weave / Density</label>
          <input
            type="number"
            name="gsm"
            value={product?.gsm || 280}
            placeholder="280"
            class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-4 py-3 font-medium focus:ring-2 focus:ring-blue-500"
          />
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Product Description *</label>
        <textarea
          name="description"
          required
          rows="4"
          placeholder="Describe fabric specs, grommets, light blockage, and care instructions..."
          class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl p-4 focus:ring-2 focus:ring-blue-500 font-sans"
        >{product?.description || ''}</textarea>
      </div>

      <div class="space-y-6">
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Colors (comma separated)</label>
          <input
            type="text"
            name="colors"
            value={product?.colors || 'Royal Cream Ivory, Soft Champagne Gold, Warm Beige'}
            class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-4 py-3"
          />
        </div>

        <!-- Curtain Size & Price Manager -->
        <div class="bg-slate-50 border border-slate-200 rounded-2xl p-5 space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
              <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider flex items-center gap-1.5">
                <span>📏</span> Curtain Sizes & Length-wise Pricing (₹)
              </h3>
              <p class="text-[11px] text-slate-500 mt-0.5">
                Window (5ft, 6ft) aur Door (7ft, 9ft) curtains ke alag-alag selling price set karein. Customer jis size par click karega website wahi price dynamic dikhayegi.
              </p>
            </div>
            <button
              type="button"
              id="add-size-row-btn"
              class="bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 text-xs font-bold px-3 py-1.5 rounded-lg transition flex items-center gap-1 self-start sm:self-auto cursor-pointer"
            >
              <span>+ Add Size Option</span>
            </button>
          </div>

          <input type="hidden" name="sizes_json" id="sizes_json_input" value="" />
          <input type="hidden" name="sizes" id="sizes_fallback_input" value="" />

          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs border-collapse">
              <thead>
                <tr class="border-b border-slate-200 text-slate-500 font-bold uppercase text-[10px]">
                  <th class="py-2 px-3">Size / Length (e.g. 5 Feet)</th>
                  <th class="py-2 px-3">Selling Price (₹)</th>
                  <th class="py-2 px-3">MRP / Cut Price (₹)</th>
                  <th class="py-2 px-3 text-right">Action</th>
                </tr>
              </thead>
              <tbody id="sizes-table-body" class="divide-y divide-slate-100">
                {productSizes.map((sz) => (
                  <tr class="size-row">
                    <td class="py-2 px-2">
                      <input
                        type="text"
                        name="size_name"
                        value={sz.name}
                        placeholder="e.g. 7 Feet (Door)"
                        required
                        class="size-name-input w-full bg-white border border-slate-300 rounded-lg px-3 py-2 font-semibold text-slate-900 text-xs focus:ring-1 focus:ring-blue-500"
                      />
                    </td>
                    <td class="py-2 px-2">
                      <input
                        type="number"
                        name="size_price"
                        value={sz.price}
                        step="0.01"
                        placeholder="599"
                        required
                        class="size-price-input w-full bg-white border border-slate-300 rounded-lg px-3 py-2 font-bold text-slate-900 text-xs focus:ring-1 focus:ring-blue-500"
                      />
                    </td>
                    <td class="py-2 px-2">
                      <input
                        type="number"
                        name="size_original_price"
                        value={sz.originalPrice || ''}
                        step="0.01"
                        placeholder="999"
                        class="size-origprice-input w-full bg-white border border-slate-300 rounded-lg px-3 py-2 text-slate-600 text-xs focus:ring-1 focus:ring-blue-500"
                      />
                    </td>
                    <td class="py-2 px-2 text-right">
                      <button
                        type="button"
                        class="remove-size-btn text-rose-600 hover:text-rose-800 hover:bg-rose-50 p-1.5 rounded-md transition font-bold cursor-pointer"
                        title="Delete Size"
                      >
                        ✕
                      </button>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <div class="flex items-center gap-2 pt-2 border-t border-slate-200/60 text-[11px] text-slate-500">
            <span class="font-bold">Quick Presets:</span>
            <button
              type="button"
              id="preset-curtains-btn"
              class="text-blue-600 hover:underline font-semibold bg-white border border-slate-200 px-2.5 py-1 rounded-md shadow-xs cursor-pointer"
            >
              Curtain Standard (5ft, 6ft, 7ft, 9ft)
            </button>
          </div>
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Image URLs (one URL per line)</label>
        <textarea
          name="images"
          rows="3"
          placeholder="https://images.unsplash.com/photo-1513694203232-719a280e022f"
          class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl p-4 font-mono focus:ring-2 focus:ring-blue-500"
        >{product?.images || ''}</textarea>
      </div>

      <div class="flex items-center justify-between border-t border-slate-200 pt-6">
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="checkbox" name="inStock" value="true" checked={product ? product.inStock : true} class="w-4 h-4 text-blue-600 rounded" />
          <span class="text-xs font-bold text-slate-800">Product In Stock & Available for Order</span>
        </label>

        <button
          type="submit"
          class="bg-blue-600 hover:bg-blue-500 text-white font-extrabold text-xs px-8 py-3.5 rounded-xl shadow-lg shadow-blue-500/20 transition"
        >
          {product ? 'Update Product' : 'Publish Product to Storefront'} &rarr;
        </button>
      </div>
    </form>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const tableBody = document.getElementById('sizes-table-body');
      const addBtn = document.getElementById('add-size-row-btn');
      const presetBtn = document.getElementById('preset-curtains-btn');
      const jsonInput = document.getElementById('sizes_json_input');
      const fallbackInput = document.getElementById('sizes_fallback_input');
      const form = document.querySelector('form');

      function syncSizes() {
        const rows = document.querySelectorAll('.size-row');
        const list = [];
        const fallback = [];

        rows.forEach((row) => {
          const nameInput = row.querySelector('.size-name-input');
          const priceInput = row.querySelector('.size-price-input');
          const origPriceInput = row.querySelector('.size-origprice-input');

          const name = nameInput ? nameInput.value.trim() : '';
          const price = priceInput ? parseFloat(priceInput.value) : 0;
          const origPrice = origPriceInput && origPriceInput.value ? parseFloat(origPriceInput.value) : undefined;

          if (name) {
            list.push({ name, price, originalPrice: origPrice });
            fallback.push(`${name}:${price}`);
          }
        });

        if (jsonInput) jsonInput.value = JSON.stringify(list);
        if (fallbackInput) fallbackInput.value = fallback.join(', ');
      }

      function attachRowListeners(row) {
        const removeBtn = row.querySelector('.remove-size-btn');
        if (removeBtn) {
          removeBtn.addEventListener('click', () => {
            if (document.querySelectorAll('.size-row').length > 1) {
              row.remove();
              syncSizes();
            } else {
              alert('Product must have at least 1 size option.');
            }
          });
        }
        row.querySelectorAll('input').forEach((inp) => {
          inp.addEventListener('input', syncSizes);
        });
      }

      document.querySelectorAll('.size-row').forEach(attachRowListeners);

      addBtn?.addEventListener('click', () => {
        const tr = document.createElement('tr');
        tr.className = 'size-row';
        tr.innerHTML = `
          <td class="py-2 px-2">
            <input
              type="text"
              name="size_name"
              placeholder="e.g. 5 Feet (Window)"
              required
              class="size-name-input w-full bg-white border border-slate-300 rounded-lg px-3 py-2 font-semibold text-slate-900 text-xs focus:ring-1 focus:ring-blue-500"
            />
          </td>
          <td class="py-2 px-2">
            <input
              type="number"
              name="size_price"
              step="0.01"
              placeholder="499"
              required
              class="size-price-input w-full bg-white border border-slate-300 rounded-lg px-3 py-2 font-bold text-slate-900 text-xs focus:ring-1 focus:ring-blue-500"
            />
          </td>
          <td class="py-2 px-2">
            <input
              type="number"
              name="size_original_price"
              step="0.01"
              placeholder="799"
              class="size-origprice-input w-full bg-white border border-slate-300 rounded-lg px-3 py-2 text-slate-600 text-xs focus:ring-1 focus:ring-blue-500"
            />
          </td>
          <td class="py-2 px-2 text-right">
            <button
              type="button"
              class="remove-size-btn text-rose-600 hover:text-rose-800 hover:bg-rose-50 p-1.5 rounded-md transition font-bold cursor-pointer"
              title="Delete Size"
            >
              ✕
            </button>
          </td>
        `;
        tableBody.appendChild(tr);
        attachRowListeners(tr);
        syncSizes();
      });

      presetBtn?.addEventListener('click', () => {
        const basePrice = parseFloat(document.querySelector('input[name="price"]')?.value || '599') || 599;
        const presets = [
          { name: '5 Feet (Window)', price: Math.round(basePrice * 0.85), orig: Math.round(basePrice * 1.4) },
          { name: '6 Feet', price: Math.round(basePrice * 0.92), orig: Math.round(basePrice * 1.5) },
          { name: '7 Feet (Door)', price: basePrice, orig: Math.round(basePrice * 1.6) },
          { name: '9 Feet (Long Door)', price: Math.round(basePrice * 1.25), orig: Math.round(basePrice * 1.9) },
        ];
        tableBody.innerHTML = '';
        presets.forEach((p) => {
          const tr = document.createElement('tr');
          tr.className = 'size-row';
          tr.innerHTML = `
            <td class="py-2 px-2">
              <input type="text" name="size_name" value="${p.name}" required class="size-name-input w-full bg-white border border-slate-300 rounded-lg px-3 py-2 font-semibold text-slate-900 text-xs focus:ring-1 focus:ring-blue-500" />
            </td>
            <td class="py-2 px-2">
              <input type="number" name="size_price" value="${p.price}" step="0.01" required class="size-price-input w-full bg-white border border-slate-300 rounded-lg px-3 py-2 font-bold text-slate-900 text-xs focus:ring-1 focus:ring-blue-500" />
            </td>
            <td class="py-2 px-2">
              <input type="number" name="size_original_price" value="${p.orig}" step="0.01" class="size-origprice-input w-full bg-white border border-slate-300 rounded-lg px-3 py-2 text-slate-600 text-xs focus:ring-1 focus:ring-blue-500" />
            </td>
            <td class="py-2 px-2 text-right">
              <button type="button" class="remove-size-btn text-rose-600 hover:text-rose-800 hover:bg-rose-50 p-1.5 rounded-md transition font-bold cursor-pointer" title="Delete Size">✕</button>
            </td>
          `;
          tableBody.appendChild(tr);
          attachRowListeners(tr);
        });
        syncSizes();
      });

      form?.addEventListener('submit', () => {
        syncSizes();
      });

      syncSizes();
    });
  </script>
</AdminLayout>
