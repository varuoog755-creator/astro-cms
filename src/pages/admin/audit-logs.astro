---
import AdminLayout from '../../layouts/AdminLayout.astro';
import prisma from '../../lib/db';

const logs = await prisma.auditLog.findMany({
  orderBy: { createdAt: 'desc' },
  include: { user: true },
  take: 50,
});
---

<AdminLayout title="Audit Logs" activeNav="audit">
  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
    <table class="w-full text-left text-xs text-gray-700">
      <thead class="bg-gray-100 text-gray-600 font-bold uppercase tracking-wider border-b border-gray-200">
        <tr>
          <th class="px-6 py-3.5">Action</th>
          <th class="px-6 py-3.5">User</th>
          <th class="px-6 py-3.5">Entity</th>
          <th class="px-6 py-3.5">Timestamp</th>
          <th class="px-6 py-3.5">Metadata</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        {logs.map((log) => (
          <tr class="hover:bg-gray-50/80 transition">
            <td class="px-6 py-4 font-mono font-bold text-blue-600">{log.action}</td>
            <td class="px-6 py-4 font-semibold text-gray-900">{log.user?.displayName || 'System'}</td>
            <td class="px-6 py-4 font-semibold text-gray-600">{log.entity}</td>
            <td class="px-6 py-4 text-gray-500">{new Date(log.createdAt).toLocaleString()}</td>
            <td class="px-6 py-4 font-mono text-[11px] text-gray-400 truncate max-w-xs">{log.metadata || '—'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AdminLayout>
