---
import AdminLayout from '../../layouts/AdminLayout.astro';
import prisma from '../../lib/db';
import { resolveGeoLocation } from '../../lib/utilities/geo';

const filter = Astro.url.searchParams.get('filter') || 'all';

let whereClause: any = {};
if (filter === 'cart') {
  whereClause = { action: { startsWith: 'cart.' } };
} else if (filter === 'order') {
  whereClause = { action: { startsWith: 'order.' } };
} else if (filter === 'auth') {
  whereClause = { action: { startsWith: 'auth.' } };
}

const [rawLogs, totalCount, cartCount, orderCount, userCount, paymentTxns, courierShipments] = await Promise.all([
  prisma.auditLog.findMany({
    where: whereClause,
    orderBy: { createdAt: 'desc' },
    include: { user: true },
    take: 100,
  }),
  prisma.auditLog.count(),
  prisma.auditLog.count({ where: { action: { startsWith: 'cart.' } } }),
  prisma.auditLog.count({ where: { action: { startsWith: 'order.' } } }),
  prisma.user.count(),
  prisma.paymentTransaction.findMany({ orderBy: { createdAt: 'desc' }, take: 50 }),
  prisma.courierShipment.findMany({ orderBy: { createdAt: 'desc' }, take: 50 }),
]);

const logs = await Promise.all(
  rawLogs.map(async (log) => {
    let metaObj: any = {};
    try {
      if (log.metadata) metaObj = JSON.parse(log.metadata);
    } catch (e) {}

    let locationStr = metaObj.location;
    if (!locationStr) {
      const g = await resolveGeoLocation(log.ipAddress);
      locationStr = g.locationStr;
    }
    return { ...log, metaObj, resolvedLocation: locationStr };
  })
);
---

<AdminLayout title="System Audit & Cart Activity Logs" activeNav="audit">
  <div class="space-y-6">

    <!-- Top Security & Permanent Data Lock Banner -->
    <div class="bg-gradient-to-r from-slate-900 via-amber-950 to-slate-900 text-white rounded-3xl p-6 sm:p-8 shadow-xl border border-amber-900/40 relative overflow-hidden flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="space-y-2 z-10">
        <div class="inline-flex items-center gap-2 bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-xs font-black px-3.5 py-1 rounded-full uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>🔒 PERMANENT DATA LOCK ACTIVE · IMMUTABLE DATABASE</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
          Audit Trail & Live Cart Activity History 🛡️
        </h1>
        <p class="text-xs sm:text-sm text-slate-300 max-w-2xl font-medium leading-relaxed">
          Zero-Deletion Policy enforced. All customer accounts, order records, delivery details, logins, and live cart additions are permanently stored in Supabase PostgreSQL and protected against deletion.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 z-10">
        <div class="bg-white/10 backdrop-blur-sm border border-white/20 px-4 py-3 rounded-2xl text-center">
          <div class="text-[10px] uppercase font-bold text-slate-300 tracking-wider">Total Stored Records</div>
          <div class="text-xl font-black text-amber-400">{totalCount}</div>
        </div>
        <div class="bg-emerald-500/20 border border-emerald-400/30 px-4 py-3 rounded-2xl text-center">
          <div class="text-[10px] uppercase font-bold text-emerald-300 tracking-wider">Database Integrity</div>
          <div class="text-xs font-black text-white">100% Protected</div>
        </div>
      </div>
    </div>

    <!-- Metrics Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div class="space-y-1">
          <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Registered Users</div>
          <div class="text-2xl font-black text-slate-900">{userCount}</div>
          <div class="text-[11px] text-emerald-600 font-bold">✓ Accounts Locked in DB</div>
        </div>
        <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center text-xl font-black shadow-inner">
          👥
        </div>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div class="space-y-1">
          <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Cart Additions Logged</div>
          <div class="text-2xl font-black text-amber-800">{cartCount}</div>
          <div class="text-[11px] text-amber-700 font-bold">🛒 Live Customer Intent</div>
        </div>
        <div class="w-12 h-12 bg-amber-50 text-amber-800 rounded-2xl flex items-center justify-center text-xl font-black shadow-inner">
          🛒
        </div>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div class="space-y-1">
          <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Orders Preserved</div>
          <div class="text-2xl font-black text-emerald-600">{orderCount}</div>
          <div class="text-[11px] text-emerald-600 font-bold">✓ Zero Data Deletion</div>
        </div>
        <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center text-xl font-black shadow-inner">
          🛍️
        </div>
      </div>

      <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div class="space-y-1">
          <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Deletion Lock</div>
          <div class="text-base font-black text-slate-900">HARD-LOCKED</div>
          <div class="text-[11px] text-blue-600 font-bold">Permanent Supabase PostgreSQL</div>
        </div>
        <div class="w-12 h-12 bg-slate-100 text-slate-700 rounded-2xl flex items-center justify-center text-xl font-black shadow-inner">
          🔐
        </div>
      </div>
    </div>

    <!-- Filter & Action Controls Bar -->
    <div class="bg-white p-4 rounded-3xl border border-slate-200 shadow-sm flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4">
      <!-- Filter Tabs -->
      <div class="flex flex-wrap items-center gap-2">
        <a
          href="/admin/audit-logs"
          class={`px-3.5 py-2 rounded-xl text-xs font-bold transition ${filter === 'all' ? 'bg-slate-900 text-white shadow-sm' : 'bg-slate-100 hover:bg-slate-200 text-slate-700'}`}
        >
          All Activity ({totalCount})
        </a>
        <a
          href="/admin/audit-logs?filter=cart"
          class={`px-3.5 py-2 rounded-xl text-xs font-bold transition ${filter === 'cart' ? 'bg-amber-800 text-white shadow-sm' : 'bg-slate-100 hover:bg-slate-200 text-slate-700'}`}
        >
          🛒 Cart Activities ({cartCount})
        </a>
        <a
          href="/admin/audit-logs?filter=order"
          class={`px-3.5 py-2 rounded-xl text-xs font-bold transition ${filter === 'order' ? 'bg-emerald-700 text-white shadow-sm' : 'bg-slate-100 hover:bg-slate-200 text-slate-700'}`}
        >
          🛍️ Orders Logged ({orderCount})
        </a>
        <a
          href="/admin/audit-logs?filter=auth"
          class={`px-3.5 py-2 rounded-xl text-xs font-bold transition ${filter === 'auth' ? 'bg-blue-600 text-white shadow-sm' : 'bg-slate-100 hover:bg-slate-200 text-slate-700'}`}
        >
          🔑 Admin & Auth Logins
        </a>
      </div>

      <!-- Quick Actions & Instant Filter -->
      <div class="flex flex-wrap items-center gap-3">
        <!-- Instant Search Box -->
        <div class="relative flex-1 sm:flex-none">
          <input
            type="text"
            id="audit-search-input"
            placeholder="🔍 Search customer, phone, product, city..."
            class="w-full sm:w-64 text-xs bg-slate-50 border border-slate-300 rounded-xl px-3.5 py-2 focus:outline-none focus:ring-2 focus:ring-amber-500 font-medium"
          />
        </div>

        <!-- 1-Click Live Test Activity Button -->
        <button
          type="button"
          id="run-test-activity-btn"
          class="bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-white font-extrabold text-xs px-3.5 py-2 rounded-xl shadow-sm transition flex items-center gap-1.5 cursor-pointer"
          title="Fires a real test cart event to verify live capture"
        >
          <span>🧪 Test Cart Event</span>
        </button>

        <!-- Refresh Button -->
        <button
          type="button"
          onclick="window.location.reload()"
          class="bg-slate-100 hover:bg-slate-200 active:scale-95 text-slate-700 font-bold text-xs px-3 py-2 rounded-xl transition flex items-center gap-1.5 cursor-pointer"
          title="Reload latest records"
        >
          <span>🔄 Refresh</span>
        </button>
      </div>
    </div>

    <!-- Logs Table Container -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-slate-700" id="audit-table">
          <thead class="bg-slate-50 text-slate-500 font-bold uppercase tracking-wider border-b border-slate-200 text-[11px]">
            <tr>
              <th class="px-6 py-4">Event / Action</th>
              <th class="px-6 py-4">User / Customer</th>
              <th class="px-6 py-4">Activity Details (Real Numbers)</th>
              <th class="px-6 py-4">City, State & IP 📍</th>
              <th class="px-6 py-4">Date & Time</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100" id="audit-table-body">
            {logs.length === 0 ? (
              <tr>
                <td colspan="5" class="px-6 py-12 text-center text-slate-400">
                  <span class="text-3xl block mb-2">📋</span>
                  <p class="font-bold text-xs">No audit records found matching this filter.</p>
                </td>
              </tr>
            ) : (
              logs.map((log) => {
                const metaObj = log.metaObj || {};

                const isCart = log.action.startsWith('cart.');
                const isOrder = log.action.startsWith('order.');
                const isAuth = log.action.startsWith('auth.');

                const phone = metaObj.customerPhone || metaObj.phone;
                const email = log.user?.email || metaObj.userEmail || metaObj.customerEmail;
                const name = log.user?.displayName || metaObj.userName || metaObj.customerName;

                return (
                  <tr class="audit-row hover:bg-slate-50/70 transition">
                    <!-- Action Badge -->
                    <td class="px-6 py-4 font-mono font-bold whitespace-nowrap">
                      {log.action === 'cart.add' ? (
                        <span class="inline-flex items-center gap-1 bg-emerald-100 text-emerald-900 border border-emerald-300 px-2.5 py-1 rounded-lg text-[11px] font-extrabold shadow-sm">
                          🛒 Cart Added
                        </span>
                      ) : log.action === 'cart.remove' ? (
                        <span class="inline-flex items-center gap-1 bg-rose-100 text-rose-900 border border-rose-300 px-2.5 py-1 rounded-lg text-[11px] font-extrabold shadow-sm">
                          🗑️ Item Removed
                        </span>
                      ) : log.action === 'cart.qty_increase' ? (
                        <span class="inline-flex items-center gap-1 bg-sky-100 text-sky-900 border border-sky-300 px-2.5 py-1 rounded-lg text-[11px] font-extrabold shadow-sm">
                          ➕ Qty Increased
                        </span>
                      ) : log.action === 'cart.qty_decrease' ? (
                        <span class="inline-flex items-center gap-1 bg-amber-100 text-amber-900 border border-amber-300 px-2.5 py-1 rounded-lg text-[11px] font-extrabold shadow-sm">
                          ➖ Qty Decreased
                        </span>
                      ) : log.action === 'cart.checkout_click' ? (
                        <span class="inline-flex items-center gap-1 bg-purple-100 text-purple-900 border border-purple-300 px-2.5 py-1 rounded-lg text-[11px] font-extrabold shadow-sm">
                          ⚡ Checkout Clicked
                        </span>
                      ) : log.action === 'cart.whatsapp_click' ? (
                        <span class="inline-flex items-center gap-1 bg-teal-100 text-teal-900 border border-teal-300 px-2.5 py-1 rounded-lg text-[11px] font-extrabold shadow-sm">
                          💬 WhatsApp Order
                        </span>
                      ) : log.action === 'cart.cleared_checkout' ? (
                        <span class="inline-flex items-center gap-1 bg-emerald-100 text-emerald-950 border border-emerald-400 px-2.5 py-1 rounded-lg text-[11px] font-black shadow-sm">
                          ✅ Cart Cleared / Purchased
                        </span>
                      ) : log.action === 'cart.abandoned' ? (
                        <span class="inline-flex items-center gap-1 bg-amber-100 text-amber-950 border border-amber-300 px-2.5 py-1 rounded-lg text-[11px] font-extrabold shadow-sm">
                          ⚠️ Cart Left / Inactive
                        </span>
                      ) : log.action === 'cart.drawer_closed' ? (
                        <span class="inline-flex items-center gap-1 bg-slate-100 text-slate-800 border border-slate-300 px-2.5 py-1 rounded-lg text-[11px] font-bold">
                          🚪 Drawer Closed
                        </span>
                      ) : log.action === 'order.placed' ? (
                        <span class="inline-flex items-center gap-1 bg-emerald-100 text-emerald-900 border border-emerald-300 px-2.5 py-1 rounded-lg text-[11px] font-black shadow-sm">
                          📦 Order Placed
                        </span>
                      ) : log.action === 'order.paid' ? (
                        <span class="inline-flex items-center gap-1 bg-emerald-600 text-white border border-emerald-700 px-2.5 py-1 rounded-lg text-[11px] font-black shadow-sm">
                          💳 Payment Verified
                        </span>
                      ) : isCart ? (
                        <span class="inline-flex items-center gap-1 bg-amber-100 text-amber-900 border border-amber-200 px-2.5 py-1 rounded-lg text-[11px] font-bold">
                          🛒 {log.action}
                        </span>
                      ) : isOrder ? (
                        <span class="inline-flex items-center gap-1 bg-emerald-100 text-emerald-900 border border-emerald-300 px-2.5 py-1 rounded-lg text-[11px] font-black shadow-sm">
                          🛍️ {log.action}
                        </span>
                      ) : isAuth ? (
                        <span class="inline-flex items-center gap-1 bg-blue-100 text-blue-900 border border-blue-200 px-2.5 py-1 rounded-lg text-[11px] font-bold">
                          🔑 {log.action}
                        </span>
                      ) : (
                        <span class="inline-flex items-center gap-1 bg-slate-100 text-slate-800 border border-slate-200 px-2.5 py-1 rounded-lg text-[11px]">
                          ⚡ {log.action}
                        </span>
                      )}
                    </td>

                    <!-- User Name / Email / Real Phone -->
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="font-black text-slate-900">
                        {name || 'Guest Customer'}
                      </div>
                      <div class="text-[11px] text-slate-400">
                        {email || 'Anonymous Visitor'}
                      </div>
                      {phone && (
                        <div class="text-[11px] font-mono text-emerald-700 font-extrabold flex items-center gap-1 mt-0.5">
                          <span>📞</span>
                          <span>{phone}</span>
                        </div>
                      )}
                    </td>

                    <!-- Activity Details (Real Numbers) -->
                    <td class="px-6 py-4">
                      {metaObj.orderNumber ? (
                        <div class="space-y-1">
                          <div class="flex flex-wrap items-center gap-1.5">
                            <span class="font-extrabold text-slate-900 text-xs">
                              Order #{metaObj.orderNumber}
                            </span>
                            {metaObj.paymentMethod && (
                              <span class="bg-blue-100 text-blue-800 text-[10px] font-bold px-2 py-0.5 rounded-md">
                                {metaObj.paymentMethod}
                              </span>
                            )}
                            <span class="bg-emerald-100 text-emerald-900 text-[11px] font-black px-2 py-0.5 rounded-md border border-emerald-200">
                              ₹{Number(metaObj.totalAmount || 0).toLocaleString('en-IN')}
                            </span>
                          </div>
                          <div class="text-[11px] text-slate-600 flex flex-wrap items-center gap-1.5 pt-0.5">
                            <span class="font-bold text-slate-800">{metaObj.itemTitle || 'Curtain Product'}</span>
                            {metaObj.size && <span class="bg-slate-100 px-1.5 py-0.5 rounded text-slate-700 font-bold">📏 {metaObj.size}</span>}
                            {metaObj.color && <span class="bg-slate-100 px-1.5 py-0.5 rounded text-slate-700">🎨 {metaObj.color}</span>}
                            {metaObj.quantity && <span class="bg-slate-200 text-slate-800 px-1.5 py-0.5 rounded font-black">Qty: {metaObj.quantity}</span>}
                          </div>
                        </div>
                      ) : log.action === 'cart.cleared_checkout' ? (
                        <div class="space-y-0.5">
                          <div class="font-extrabold text-emerald-700 text-xs flex items-center gap-1">
                            <span>✅</span> Cart Emptied on Successful Checkout
                          </div>
                          <div class="text-[11px] text-slate-500">
                            Local cart reset to 0 items after customer placed order.
                          </div>
                        </div>
                      ) : metaObj.cartTotal !== undefined ? (
                        <div class="space-y-1">
                          <div class="font-bold text-slate-900 text-xs line-clamp-1">
                            {metaObj.productName || 'Cart Session'}
                          </div>
                          <div class="text-[11px] text-slate-500 flex flex-wrap items-center gap-1.5 font-medium">
                            <span class="bg-amber-100 text-amber-900 font-black px-2 py-0.5 rounded-md border border-amber-200">
                              Cart Total: ₹{Number(metaObj.cartTotal).toLocaleString('en-IN')}
                            </span>
                            {metaObj.itemCount !== undefined && (
                              <span class="bg-slate-100 text-slate-700 font-bold px-1.5 py-0.5 rounded">
                                {metaObj.itemCount} Item(s)
                              </span>
                            )}
                          </div>
                          {metaObj.details && (
                            <div class="text-[10px] text-slate-500 italic line-clamp-1">
                              {metaObj.details}
                            </div>
                          )}
                        </div>
                      ) : metaObj.productName ? (
                        <div class="space-y-1">
                          <div class="font-bold text-slate-900 text-xs line-clamp-1">
                            {metaObj.productName}
                          </div>
                          <div class="text-[11px] text-slate-600 flex flex-wrap items-center gap-1.5">
                            {metaObj.size && <span class="bg-slate-100 px-1.5 py-0.5 rounded text-slate-700 font-bold">📏 {metaObj.size}</span>}
                            {metaObj.color && <span class="bg-slate-100 px-1.5 py-0.5 rounded text-slate-700">🎨 {metaObj.color}</span>}
                            {metaObj.price !== undefined && (
                              <span class="font-bold text-slate-800 bg-amber-50 border border-amber-200 px-1.5 py-0.5 rounded">
                                ₹{Number(metaObj.price).toLocaleString('en-IN')} × {metaObj.quantity || 1}
                              </span>
                            )}
                            {metaObj.total !== undefined && (
                              <span class="font-black text-emerald-800 bg-emerald-50 border border-emerald-200 px-1.5 py-0.5 rounded">
                                Total ₹{Number(metaObj.total).toLocaleString('en-IN')}
                              </span>
                            )}
                          </div>
                        </div>
                      ) : (
                        <div class="text-[11px] font-mono text-slate-500 truncate max-w-sm">
                          {log.metadata || '—'}
                        </div>
                      )}
                    </td>

                    <!-- Location (City, State) & Client IP -->
                    <td class="px-6 py-4 whitespace-nowrap text-[11px]">
                      <div class="font-extrabold text-slate-900 flex items-center gap-1.5">
                        <span class="text-rose-500 text-xs">📍</span>
                        <span class="bg-rose-50 text-rose-900 border border-rose-200/80 px-2 py-0.5 rounded-md font-bold">
                          {log.resolvedLocation || 'Panipat, Haryana (HQ)'}
                        </span>
                      </div>
                      <div class="font-mono text-slate-400 text-[10px] pl-5 mt-0.5">
                        {log.ipAddress || '127.0.0.1'}
                      </div>
                    </td>

                    <!-- Timestamp -->
                    <td class="px-6 py-4 whitespace-nowrap text-slate-500 text-[11px]">
                      <div class="font-medium">
                        {new Date(log.createdAt).toLocaleString('en-IN', {
                          timeZone: 'Asia/Kolkata',
                          day: 'numeric',
                          month: 'short',
                          year: 'numeric',
                          hour: '2-digit',
                          minute: '2-digit',
                          second: '2-digit',
                        })}
                      </div>
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <script is:inline>
    // Real-Time Table Search Filter
    const searchInput = document.getElementById('audit-search-input');
    const tableBody = document.getElementById('audit-table-body');

    searchInput?.addEventListener('input', (e) => {
      const query = (e.target.value || '').toLowerCase().trim();
      const rows = tableBody?.querySelectorAll('tr.audit-row');
      rows?.forEach((row) => {
        const text = row.innerText.toLowerCase();
        if (!query || text.includes(query)) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    });

    // 1-Click Live Test Activity Generator
    const testBtn = document.getElementById('run-test-activity-btn');
    testBtn?.addEventListener('click', async () => {
      testBtn.disabled = true;
      testBtn.innerHTML = '⌛ Sending Test...';

      try {
        const res = await fetch('/api/analytics/cart-event', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            action: 'cart.add',
            productName: 'Stylish Curtains for Door & Windows (Pack of 2) [TEST CHECK]',
            slug: 'stylish-curtains-for-door-windows-5-6-7-9-feet-pack-of-2-eupceo',
            size: '7 Feet (Door)',
            color: 'Coffee Brown & Cream',
            price: 450,
            quantity: 2,
            itemCount: 2,
            cartTotal: 900,
            details: 'Live Verification Check Test: Real numbers ₹450 x 2 = ₹900'
          })
        });

        const data = await res.json();
        if (data.success) {
          testBtn.innerHTML = '✓ Logged! Reloading...';
          setTimeout(() => {
            window.location.reload();
          }, 600);
        } else {
          alert('Failed to send test event');
          testBtn.disabled = false;
          testBtn.innerHTML = '🧪 Test Cart Event';
        }
      } catch (err) {
        console.error('Test event error:', err);
        testBtn.disabled = false;
        testBtn.innerHTML = '🧪 Test Cart Event';
      }
    });
  </script>

  <!-- ✅ Payment Transactions Table -->
  <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="bg-gradient-to-r from-blue-900 to-indigo-900 text-white p-6 flex items-center justify-between">
      <div>
        <h2 class="text-lg font-extrabold">💳 Payment Transactions</h2>
        <p class="text-xs text-blue-200 mt-1">Every payment attempt permanently saved — Paytm, Razorpay, COD, WhatsApp</p>
      </div>
      <span class="bg-blue-500/30 text-blue-100 text-xs font-bold px-3 py-1.5 rounded-full border border-blue-400/30">
        {paymentTxns.length} Records
      </span>
    </div>

    {paymentTxns.length === 0 ? (
      <div class="p-10 text-center text-slate-400 text-sm">
        <span class="text-3xl block mb-2">💳</span>
        No payment transactions yet. First order karao!
      </div>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full text-xs">
          <thead class="bg-slate-50 border-b border-slate-200">
            <tr>
              <th class="text-left px-4 py-3 font-bold text-slate-600 uppercase tracking-wider">Order #</th>
              <th class="text-left px-4 py-3 font-bold text-slate-600 uppercase tracking-wider">Method</th>
              <th class="text-left px-4 py-3 font-bold text-slate-600 uppercase tracking-wider">Gateway</th>
              <th class="text-left px-4 py-3 font-bold text-slate-600 uppercase tracking-wider">Amount</th>
              <th class="text-left px-4 py-3 font-bold text-slate-600 uppercase tracking-wider">Status</th>
              <th class="text-left px-4 py-3 font-bold text-slate-600 uppercase tracking-wider">Razorpay ID</th>
              <th class="text-left px-4 py-3 font-bold text-slate-600 uppercase tracking-wider">Location</th>
              <th class="text-left px-4 py-3 font-bold text-slate-600 uppercase tracking-wider">Date</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {paymentTxns.map((txn) => (
              <tr class="hover:bg-slate-50/70 transition">
                <td class="px-4 py-3 font-mono font-bold text-slate-900">{txn.orderNumber}</td>
                <td class="px-4 py-3">
                  <span class={`font-bold px-2 py-0.5 rounded-full text-[10px] uppercase border ${
                    txn.paymentMethod === 'RAZORPAY' ? 'bg-blue-100 text-blue-800 border-blue-300' :
                    txn.paymentMethod === 'PAYTM' ? 'bg-indigo-100 text-indigo-800 border-indigo-300' :
                    txn.paymentMethod === 'COD' ? 'bg-amber-100 text-amber-800 border-amber-300' :
                    'bg-emerald-100 text-emerald-800 border-emerald-300'
                  }`}>
                    {txn.paymentMethod}
                  </span>
                </td>
                <td class="px-4 py-3 text-slate-500 font-mono">{txn.paymentGateway || '—'}</td>
                <td class="px-4 py-3 font-black text-slate-900">₹{txn.amount.toLocaleString('en-IN')}</td>
                <td class="px-4 py-3">
                  <span class={`font-bold px-2 py-0.5 rounded-full text-[10px] uppercase border ${
                    txn.status === 'PAID' ? 'bg-emerald-100 text-emerald-800 border-emerald-300' :
                    txn.status === 'FAILED' ? 'bg-red-100 text-red-800 border-red-300' :
                    'bg-amber-100 text-amber-800 border-amber-300'
                  }`}>
                    {txn.status}
                  </span>
                </td>
                <td class="px-4 py-3 font-mono text-[10px] text-slate-500">{txn.razorpayPaymentId || '—'}</td>
                <td class="px-4 py-3 text-slate-500">{txn.location || '—'}</td>
                <td class="px-4 py-3 text-slate-400 whitespace-nowrap">
                  {new Date(txn.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>

  <!-- ✅ Courier Shipments Table -->
  <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden">
    <div class="bg-gradient-to-r from-amber-900 to-amber-800 text-white p-6 flex items-center justify-between">
      <div>
        <h2 class="text-lg font-extrabold">🚚 Courier Shipments</h2>
        <p class="text-xs text-amber-200 mt-1">Every EKart & courier booking permanently saved — AWB, route, charges</p>
      </div>
      <span class="bg-amber-500/30 text-amber-100 text-xs font-bold px-3 py-1.5 rounded-full border border-amber-400/30">
        {courierShipments.length} Bookings
      </span>
    </div>

    {courierShipments.length === 0 ? (
      <div class="p-10 text-center text-slate-400 text-sm">
        <span class="text-3xl block mb-2">🚚</span>
        No courier bookings yet. Order aane ke baad EKart se book karo.
      </div>
    ) : (
      <div class="overflow-x-auto">
        <table class="w-full text-xs">
          <thead class="bg-slate-50 border-b border-slate-200">
            <tr>
              <th class="text-left px-4 py-3 font-bold text-slate-600 uppercase tracking-wider">Order #</th>
              <th class="text-left px-4 py-3 font-bold text-slate-600 uppercase tracking-wider">Courier</th>
              <th class="text-left px-4 py-3 font-bold text-slate-600 uppercase tracking-wider">AWB</th>
              <th class="text-left px-4 py-3 font-bold text-slate-600 uppercase tracking-wider">Pickup PIN</th>
              <th class="text-left px-4 py-3 font-bold text-slate-600 uppercase tracking-wider">Delivery PIN</th>
              <th class="text-left px-4 py-3 font-bold text-slate-600 uppercase tracking-wider">Charge</th>
              <th class="text-left px-4 py-3 font-bold text-slate-600 uppercase tracking-wider">Status</th>
              <th class="text-left px-4 py-3 font-bold text-slate-600 uppercase tracking-wider">Booked By</th>
              <th class="text-left px-4 py-3 font-bold text-slate-600 uppercase tracking-wider">Date</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {courierShipments.map((ship) => (
              <tr class="hover:bg-slate-50/70 transition">
                <td class="px-4 py-3 font-mono font-bold text-slate-900">{ship.orderNumber}</td>
                <td class="px-4 py-3 font-bold text-amber-900">{ship.courierPartner}</td>
                <td class="px-4 py-3">
                  {ship.trackingUrl ? (
                    <a href={ship.trackingUrl} target="_blank" class="font-mono text-blue-700 font-bold hover:underline text-[10px]">
                      {ship.awbNumber} ↗
                    </a>
                  ) : (
                    <span class="font-mono text-slate-700">{ship.awbNumber || '—'}</span>
                  )}
                </td>
                <td class="px-4 py-3 font-mono text-slate-700">{ship.pickupPincode || '—'}</td>
                <td class="px-4 py-3 font-mono text-slate-700">{ship.deliveryPincode || '—'}</td>
                <td class="px-4 py-3 font-bold text-emerald-700">₹{ship.chargeAmount || '—'}</td>
                <td class="px-4 py-3">
                  <span class={`font-bold px-2 py-0.5 rounded-full text-[10px] uppercase border ${
                    ship.status === 'DELIVERED' ? 'bg-emerald-100 text-emerald-800 border-emerald-300' :
                    ship.status === 'IN_TRANSIT' ? 'bg-blue-100 text-blue-800 border-blue-300' :
                    'bg-amber-100 text-amber-800 border-amber-300'
                  }`}>
                    {ship.status}
                  </span>
                </td>
                <td class="px-4 py-3 text-slate-500 font-mono text-[10px]">{ship.bookedBy || '—'}</td>
                <td class="px-4 py-3 text-slate-400 whitespace-nowrap">
                  {new Date(ship.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </div>

</AdminLayout>
