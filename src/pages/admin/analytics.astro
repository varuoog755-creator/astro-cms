---
import AdminLayout from '../../layouts/AdminLayout.astro';
import prisma from '../../lib/db';

const orders = await prisma.order.findMany({
  orderBy: { createdAt: 'desc' },
  include: { items: true },
});

const totalRevenue = orders
  .filter((o) => o.paymentStatus === 'PAID')
  .reduce((sum, o) => sum + o.totalAmount, 0);

const totalOrders = orders.length;
const aov = totalOrders > 0 ? Math.round(totalRevenue / totalOrders) : 0;

// Breakdown by Payment Method
const paymentStats: Record<string, { count: number; total: number }> = {};
orders.forEach((o) => {
  const method = o.paymentMethod || 'OTHER';
  if (!paymentStats[method]) {
    paymentStats[method] = { count: 0, total: 0 };
  }
  paymentStats[method].count += 1;
  if (o.paymentStatus === 'PAID') {
    paymentStats[method].total += o.totalAmount;
  }
});

// Breakdown by Order Status
const statusStats: Record<string, number> = {
  PROCESSING: 0,
  SHIPPED: 0,
  DELIVERED: 0,
  CANCELLED: 0,
};

orders.forEach((o) => {
  const st = o.orderStatus || 'PROCESSING';
  statusStats[st] = (statusStats[st] || 0) + 1;
});

// EKart Logistics Count
const ekartBookedCount = orders.filter((o) => o.courierPartner?.includes('EKart') || Boolean(o.trackingNumber)).length;
---

<AdminLayout title="Live Advanced Sales & Logistics Analytics" activeNav="analytics">
  <div class="space-y-8">
    
    <!-- Top Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-200 pb-6">
      <div>
        <div class="inline-flex items-center gap-2 bg-emerald-100 border border-emerald-300 text-emerald-900 text-[10px] font-black px-3 py-1 rounded-full uppercase tracking-wider mb-2">
          <span>📈 REAL-TIME DATA ANALYTICS</span>
        </div>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Live Storefront Advanced Analytics</h1>
        <p class="text-sm text-slate-500 mt-1">Real-time tracking of revenue, EKart courier bookings, curtain sales & customer payment methods.</p>
      </div>

      <div class="flex items-center gap-3">
        <a href="/admin/orders" class="bg-amber-800 hover:bg-amber-900 text-white text-xs font-extrabold px-4 py-2.5 rounded-xl transition shadow">
          🛍️ Manage Orders & EKart
        </a>
      </div>
    </div>

    <!-- 4 Metrics Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-5">
      
      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm space-y-2">
        <div class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Sales Revenue</div>
        <div class="text-3xl font-black text-slate-900">₹{totalRevenue.toLocaleString('en-IN')}</div>
        <div class="text-xs text-emerald-600 font-bold">✓ Live Verified Transactions</div>
      </div>

      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm space-y-2">
        <div class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Orders Placed</div>
        <div class="text-3xl font-black text-blue-600">{totalOrders}</div>
        <div class="text-xs text-blue-600 font-bold">Door & Window Curtains</div>
      </div>

      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm space-y-2">
        <div class="text-xs font-bold text-slate-400 uppercase tracking-wider">Average Order Value (AOV)</div>
        <div class="text-3xl font-black text-amber-800">₹{aov.toLocaleString('en-IN')}</div>
        <div class="text-xs text-amber-800 font-bold">Per Order Average</div>
      </div>

      <div class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm space-y-2">
        <div class="text-xs font-bold text-slate-400 uppercase tracking-wider">EKart Pickups Booked</div>
        <div class="text-3xl font-black text-emerald-600">{ekartBookedCount}</div>
        <div class="text-xs text-emerald-600 font-bold">🚚 EKart Express Courier</div>
      </div>

    </div>

    <!-- Payment & Logistics Breakdown Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Left: Payment Methods Distribution -->
      <div class="lg:col-span-6 bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-5">
        <h2 class="text-base font-extrabold text-slate-900 border-b border-slate-100 pb-3 flex items-center justify-between">
          <span class="flex items-center gap-2">
            <span>💳</span> Payment Methods Revenue
          </span>
          <span class="text-xs text-slate-400 font-normal">Real-time breakdown</span>
        </h2>

        <div class="space-y-4">
          {Object.entries(paymentStats).map(([method, data]) => {
            const pct = totalRevenue > 0 ? Math.round((data.total / totalRevenue) * 100) : 0;
            return (
              <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200/80 space-y-2 text-xs">
                <div class="flex items-center justify-between font-bold">
                  <span class="text-slate-900">{method}</span>
                  <span class="text-amber-800">₹{data.total.toLocaleString('en-IN')} ({data.count} orders)</span>
                </div>

                <div class="w-full bg-slate-200 h-2 rounded-full overflow-hidden">
                  <div class="bg-amber-800 h-full rounded-full transition-all duration-500" style={`width: ${pct}%`}></div>
                </div>

                <div class="text-[10px] text-slate-400 font-semibold text-right">
                  {pct}% of Total Storefront Revenue
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- Right: Fulfillment & EKart Status Breakdown -->
      <div class="lg:col-span-6 bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-5">
        <h2 class="text-base font-extrabold text-slate-900 border-b border-slate-100 pb-3 flex items-center justify-between">
          <span class="flex items-center gap-2">
            <span>🚚</span> Order Status & EKart Fulfillment
          </span>
          <span class="text-xs text-slate-400 font-normal">Live Tracking</span>
        </h2>

        <div class="grid grid-cols-2 gap-4">
          
          <div class="bg-blue-50/70 border border-blue-200 p-4 rounded-2xl space-y-1">
            <span class="text-slate-500 block text-[10px] font-bold uppercase">PROCESSING</span>
            <span class="text-2xl font-black text-blue-800">{statusStats.PROCESSING || 0}</span>
            <span class="text-[10px] text-blue-600 block">Pending EKart booking</span>
          </div>

          <div class="bg-amber-50/70 border border-amber-200 p-4 rounded-2xl space-y-1">
            <span class="text-amber-800 block text-[10px] font-bold uppercase">SHIPPED / IN-TRANSIT</span>
            <span class="text-2xl font-black text-amber-900">{statusStats.SHIPPED || 0}</span>
            <span class="text-[10px] text-amber-800 block">With EKart Courier</span>
          </div>

          <div class="bg-emerald-50/70 border border-emerald-200 p-4 rounded-2xl space-y-1">
            <span class="text-emerald-800 block text-[10px] font-bold uppercase">DELIVERED</span>
            <span class="text-2xl font-black text-emerald-900">{statusStats.DELIVERED || 0}</span>
            <span class="text-[10px] text-emerald-700 block">Successfully Delivered</span>
          </div>

          <div class="bg-red-50/70 border border-red-200 p-4 rounded-2xl space-y-1">
            <span class="text-red-800 block text-[10px] font-bold uppercase">CANCELLED</span>
            <span class="text-2xl font-black text-red-900">{statusStats.CANCELLED || 0}</span>
            <span class="text-[10px] text-red-600 block">Cancelled Orders</span>
          </div>

        </div>

        <div class="pt-2">
          <div class="bg-slate-900 text-white p-5 rounded-2xl space-y-2 text-xs">
            <div class="font-extrabold text-amber-400 flex items-center gap-1.5">
              <span>⚡</span> Live Courier Rate Calculator (EKart)
            </div>
            <p class="text-slate-300 text-[11px] leading-relaxed">
              EKart pickup fees are calculated dynamically based on regional postal pincodes across North, West, South, and East India.
            </p>
          </div>
        </div>
      </div>

    </div>

  </div>
</AdminLayout>
