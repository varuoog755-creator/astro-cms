---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import prisma from '../../../lib/db';

const users = await prisma.user.findMany({
  orderBy: { createdAt: 'desc' },
  include: { role: true },
});
---

<AdminLayout title="User Management" activeNav="users">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-sm font-bold text-gray-700 uppercase tracking-wider">Site Users ({users.length})</h2>
    <a href="/admin/users/new" class="bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow transition">
      + Add User
    </a>
  </div>

  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
    <table class="w-full text-left text-xs text-gray-700">
      <thead class="bg-gray-100 text-gray-600 font-bold uppercase tracking-wider border-b border-gray-200">
        <tr>
          <th class="px-6 py-3.5">User</th>
          <th class="px-6 py-3.5">Username</th>
          <th class="px-6 py-3.5">Role</th>
          <th class="px-6 py-3.5">Status</th>
          <th class="px-6 py-3.5">Joined</th>
          <th class="px-6 py-3.5 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        {users.map((u) => (
          <tr class="hover:bg-gray-50/80 transition">
            <td class="px-6 py-4">
              <div class="font-bold text-gray-900 text-sm">{u.displayName}</div>
              <div class="text-[11px] text-gray-400">{u.email}</div>
            </td>
            <td class="px-6 py-4 font-mono font-semibold text-gray-800">@{u.username}</td>
            <td class="px-6 py-4">
              <span class="bg-purple-50 text-purple-700 font-bold px-2.5 py-1 rounded-md text-[11px]">
                {u.role.name}
              </span>
            </td>
            <td class="px-6 py-4">
              <span class={`font-bold px-2.5 py-1 rounded-full text-[10px] uppercase ${
                u.status === 'active' ? 'bg-emerald-100 text-emerald-800' : 'bg-red-100 text-red-800'
              }`}>
                {u.status}
              </span>
            </td>
            <td class="px-6 py-4 text-gray-500">{new Date(u.createdAt).toLocaleDateString()}</td>
            <td class="px-6 py-4 text-right">
              <a href={`/admin/users/${u.id}`} class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold px-2.5 py-1 rounded text-[11px]">
                Edit Role / Status
              </a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AdminLayout>
