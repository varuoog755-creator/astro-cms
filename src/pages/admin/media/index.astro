---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import prisma from '../../../lib/db';

const mediaItems = await prisma.media.findMany({
  orderBy: { createdAt: 'desc' },
});
---

<AdminLayout title="Media Library" activeNav="media">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-sm font-bold text-gray-700 uppercase tracking-wider">All Media Assets ({mediaItems.length})</h2>
  </div>

  <div class="bg-white p-6 rounded-2xl border-2 border-dashed border-gray-300 mb-8 text-center hover:border-blue-500 transition">
    <form action="/api/media" method="POST" enctype="multipart/form-data" class="space-y-3">
      <div class="text-4xl">📁</div>
      <div class="text-sm font-bold text-gray-800">Upload New Files</div>
      <p class="text-xs text-gray-500">Supports JPG, PNG, WEBP, GIF, SVG, PDF, MP4, MP3 up to 50MB</p>
      <input type="file" name="file" required class="text-xs bg-gray-50 border border-gray-300 rounded-lg p-2" />
      <div>
        <button type="submit" class="bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs px-5 py-2.5 rounded-xl shadow transition">
          Upload File
        </button>
      </div>
    </form>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
    {mediaItems.map((item) => (
      <div class="bg-white border border-gray-200 rounded-xl p-2 shadow-sm group relative">
        <div class="h-32 bg-gray-100 rounded-lg overflow-hidden flex items-center justify-center mb-2">
          {item.mimeType.startsWith('image/') ? (
            <img src={item.url} alt={item.altText || item.filename} class="w-full h-full object-cover" />
          ) : (
            <div class="text-center">
              <span class="text-2xl font-black uppercase text-gray-400">{item.mimeType.split('/')[1]}</span>
            </div>
          )}
        </div>

        <div class="text-xs font-semibold text-gray-800 truncate">{item.originalName}</div>
        <div class="text-[10px] text-gray-400">{item.mimeType} · {(item.size / 1024).toFixed(1)} KB</div>

        <div class="mt-2 flex gap-1">
          <button
            onclick={`navigator.clipboard.writeText('${item.url}'); alert('URL copied to clipboard!');`}
            class="text-[10px] bg-blue-50 text-blue-600 font-bold px-2 py-1 rounded w-full hover:bg-blue-100 transition"
          >
            Copy URL
          </button>
        </div>
      </div>
    ))}
  </div>
</AdminLayout>
