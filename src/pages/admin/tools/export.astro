---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Import & Export Tools" activeNav="tools">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <!-- JSON Export Box -->
    <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm space-y-4">
      <h3 class="text-base font-bold text-gray-900">Export CMS Content</h3>
      <p class="text-xs text-gray-500">Download a full JSON backup of all posts, pages, categories, tags, and site settings.</p>
      <a href="/api/tools/export" download class="inline-block bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs px-5 py-2.5 rounded-xl shadow transition">
        Export JSON Backup ↓
      </a>
    </div>

    <!-- Safe Data Protection & Backup Box -->
    <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm space-y-4">
      <div class="inline-flex items-center gap-2 bg-emerald-100 text-emerald-800 text-[10px] font-black px-3 py-1 rounded-full uppercase tracking-wider">
        <span>🔒 IMMUTABLE DATA PRESERVATION</span>
      </div>
      <h3 class="text-base font-bold text-gray-900">Database Lock & Safety Policy</h3>
      <p class="text-xs text-gray-600 leading-relaxed">
        Per Teepul production policy, customer accounts, orders, payment transactions, and live audit logs are permanently locked and cannot be wiped, overwritten, or truncated by import files.
      </p>
      <div class="p-4 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-700 space-y-2">
        <div class="font-bold text-slate-900">Active Protections:</div>
        <ul class="list-disc pl-4 space-y-1 text-[11px] text-slate-600">
          <li>Customer user records & delivery addresses: <strong>Protected</strong></li>
          <li>Orders & Razorpay/Paytm transactions: <strong>Immutable</strong></li>
          <li>Full audit log tracking: <strong>Permanent</strong></li>
        </ul>
      </div>
    </div>
  </div>
</AdminLayout>
