---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<AdminLayout title="Import & Export Tools" activeNav="tools">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <!-- JSON Export Box -->
    <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm space-y-4">
      <h3 class="text-base font-bold text-gray-900">Export CMS Content</h3>
      <p class="text-xs text-gray-500">Download a full JSON backup of all posts, pages, categories, tags, and site settings.</p>
      <a href="/api/tools/export" download class="inline-block bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs px-5 py-2.5 rounded-xl shadow transition">
        Export JSON Backup ↓
      </a>
    </div>

    <!-- JSON Import Box -->
    <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm space-y-4">
      <h3 class="text-base font-bold text-gray-900">Import CMS Backup</h3>
      <p class="text-xs text-gray-500">Restore or import posts and pages from a valid JSON export file.</p>
      <form action="/api/tools/import" method="POST" enctype="multipart/form-data" class="space-y-3">
        <input type="file" name="backup" accept=".json" required class="text-xs border border-gray-300 rounded-lg p-2 w-full" />
        <button type="submit" class="bg-gray-900 hover:bg-gray-800 text-white font-bold text-xs px-5 py-2.5 rounded-xl shadow transition">
          Import Content ↑
        </button>
      </form>
    </div>
  </div>
</AdminLayout>
