---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getIntegrationSettings } from '../../lib/settings';

const settings = await getIntegrationSettings();
const saved = Astro.url.searchParams.get('saved') === 'true';
const origin = Astro.url.origin;
---

<AdminLayout title="Payments & Growth Integrations">
  <div class="space-y-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-200 pb-6">
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Payments & Growth Hub</h1>
          <span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1 rounded-full border border-emerald-300">
            PRO ENTERPRISE
          </span>
        </div>
        <p class="text-sm text-slate-500 mt-1">
          Configure Razorpay, Paytm, Google Search Console, Merchant XML Feed, GA4, Meta Pixel, and WhatsApp Sales Engine.
        </p>
      </div>

      {saved && (
        <div class="bg-emerald-50 border border-emerald-300 text-emerald-800 text-xs font-bold px-4 py-2.5 rounded-xl flex items-center gap-2 shadow-sm animate-bounce">
          <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          Settings Saved & Integrations Synced!
        </div>
      )}
    </div>

    <!-- Main Form -->
    <form action="/api/admin/integrations/save" method="POST" class="space-y-8">
      
      <!-- Section 1: Indian Payment Gateways -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="bg-gradient-to-r from-blue-900 to-indigo-900 text-white p-6 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center font-bold text-xl">💳</div>
            <div>
              <h2 class="text-lg font-bold">Indian Payment Gateways</h2>
              <p class="text-xs text-blue-200">Enable Razorpay, Paytm, Direct UPI QR, and Cash on Delivery</p>
            </div>
          </div>
          <span class="bg-blue-500/30 text-blue-100 text-xs font-semibold px-3 py-1 rounded-full border border-blue-400/30">
            INR ₹ Auto Currency
          </span>
        </div>

        <div class="p-6 grid grid-cols-1 lg:grid-cols-2 gap-8">
          
          <!-- Razorpay Card -->
          <div class="border border-slate-200 rounded-xl p-5 bg-slate-50/50 space-y-4">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="text-2xl">⚡</span>
                <div>
                  <h3 class="font-bold text-slate-900 text-sm">Razorpay Checkout SDK</h3>
                  <p class="text-[11px] text-slate-500">Cards, UPI (GPay/PhonePe), NetBanking, Wallets</p>
                </div>
              </div>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" name="razorpay_enabled" value="true" checked={settings.razorpay_enabled} class="sr-only peer" />
                <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
              </label>
            </div>

            <div class="space-y-3 pt-2">
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Razorpay Key ID</label>
                <input
                  type="text"
                  name="razorpay_key_id"
                  value={settings.razorpay_key_id}
                  placeholder="rzp_live_xxxxxxxxxxxxx"
                  class="w-full text-xs bg-white border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 font-mono"
                />
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Razorpay Key Secret</label>
                <input
                  type="password"
                  name="razorpay_key_secret"
                  value={settings.razorpay_key_secret}
                  placeholder="••••••••••••••••••••••••"
                  class="w-full text-xs bg-white border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 font-mono"
                />
              </div>
            </div>
          </div>

          <!-- Paytm / UPI Card -->
          <div class="border border-slate-200 rounded-xl p-5 bg-slate-50/50 space-y-4">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="text-2xl">📱</span>
                <div>
                  <h3 class="font-bold text-slate-900 text-sm">Paytm & Direct UPI QR</h3>
                  <p class="text-[11px] text-slate-500">Paytm Wallet, Direct UPI ID VPA</p>
                </div>
              </div>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" name="paytm_enabled" value="true" checked={settings.paytm_enabled} class="sr-only peer" />
                <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
              </label>
            </div>

            <div class="space-y-3 pt-2">
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-xs font-bold text-slate-700 mb-1">Paytm MID</label>
                  <input
                    type="text"
                    name="paytm_mid"
                    value={settings.paytm_mid}
                    placeholder="Merchant ID"
                    class="w-full text-xs bg-white border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 font-mono"
                  />
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-700 mb-1">Paytm Key</label>
                  <input
                    type="password"
                    name="paytm_mkey"
                    value={settings.paytm_mkey}
                    placeholder="Merchant Key"
                    class="w-full text-xs bg-white border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 font-mono"
                  />
                </div>
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">UPI VPA Handle (QR Code)</label>
                <input
                  type="text"
                  name="paytm_vpa"
                  value={settings.paytm_vpa}
                  placeholder="storename@upi or mobile@paytm"
                  class="w-full text-xs bg-white border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500 font-mono"
                />
              </div>
            </div>
          </div>

          <!-- Cash on Delivery Option -->
          <div class="lg:col-span-2 border border-slate-200 rounded-xl p-4 bg-emerald-50/50 flex items-center justify-between">
            <div class="flex items-center gap-3">
              <span class="text-2xl">🚚</span>
              <div>
                <h4 class="font-bold text-slate-900 text-xs">Cash on Delivery (COD)</h4>
                <p class="text-[11px] text-slate-500">Allow customers to pay cash when product is delivered to their address</p>
              </div>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="checkbox" name="cod_enabled" value="true" checked={settings.cod_enabled} class="sr-only peer" />
              <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-600"></div>
            </label>
          </div>

        </div>
      </div>

      <!-- Section 2: Google Growth Suite (Search Console & Merchant Center) -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="bg-slate-900 text-white p-6 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center font-bold text-xl">🔍</div>
            <div>
              <h2 class="text-lg font-bold">Google Growth & SEO Suite</h2>
              <p class="text-xs text-slate-400">Google Search Console indexing and Google Merchant Center XML feed</p>
            </div>
          </div>
          <span class="bg-emerald-500/20 text-emerald-300 text-xs font-semibold px-3 py-1 rounded-full border border-emerald-400/30">
            AUTO FEED LIVE
          </span>
        </div>

        <div class="p-6 grid grid-cols-1 lg:grid-cols-2 gap-8">

          <!-- Google Search Console -->
          <div class="space-y-4 border border-slate-200 rounded-xl p-5 bg-slate-50/50">
            <div class="flex items-center justify-between">
              <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2">
                <span>🌐</span> Google Search Console
              </h3>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" name="gsc_enabled" value="true" checked={settings.gsc_enabled} class="sr-only peer" />
                <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
              </label>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">GSC Meta Verification Tag</label>
              <input
                type="text"
                name="gsc_verification_tag"
                value={settings.gsc_verification_tag}
                placeholder='<meta name="google-site-verification" content="XYZ..." /> or XYZ...'
                class="w-full text-xs bg-white border border-slate-300 rounded-lg px-3 py-2 font-mono"
              />
            </div>

            <div class="bg-blue-50 border border-blue-200 rounded-lg p-3 text-xs text-blue-900 space-y-1">
              <span class="font-bold block">📌 Google Search Console Sitemap URL:</span>
              <div class="flex items-center justify-between bg-white px-2 py-1 rounded border border-blue-200 font-mono text-[11px] text-slate-700 select-all">
                <span>{origin}/sitemap.xml</span>
                <a href="/sitemap.xml" target="_blank" class="text-blue-600 hover:underline text-[10px] font-bold">Open ↗</a>
              </div>
            </div>
          </div>

          <!-- Google Merchant Center XML Feed -->
          <div class="space-y-4 border border-slate-200 rounded-xl p-5 bg-slate-50/50">
            <div class="flex items-center justify-between">
              <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2">
                <span>🛍️</span> Google Merchant Center Feed
              </h3>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" name="gmc_enabled" value="true" checked={settings.gmc_enabled} class="sr-only peer" />
                <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
              </label>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Brand Name</label>
                <input
                  type="text"
                  name="gmc_brand_name"
                  value={settings.gmc_brand_name}
                  placeholder="Teepul Streetwear"
                  class="w-full text-xs bg-white border border-slate-300 rounded-lg px-3 py-2"
                />
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Currency Code</label>
                <input
                  type="text"
                  name="gmc_currency"
                  value={settings.gmc_currency}
                  placeholder="INR"
                  class="w-full text-xs bg-white border border-slate-300 rounded-lg px-3 py-2 font-mono uppercase"
                />
              </div>
            </div>

            <div class="bg-indigo-50 border border-indigo-200 rounded-lg p-3 text-xs text-indigo-900 space-y-1">
              <span class="font-bold block">🔗 Google Merchant XML Feed URL:</span>
              <div class="flex items-center justify-between bg-white px-2 py-1 rounded border border-indigo-200 font-mono text-[11px] text-slate-700 select-all">
                <span>{origin}/feeds/google-merchant.xml</span>
                <a href="/feeds/google-merchant.xml" target="_blank" class="text-indigo-600 hover:underline text-[10px] font-bold">Inspect XML ↗</a>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- Section 3: Analytics & Meta Ads Pixel -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="bg-slate-900 text-white p-6 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center font-bold text-xl">📊</div>
            <div>
              <h2 class="text-lg font-bold">Analytics & Paid Ads Tracking</h2>
              <p class="text-xs text-slate-400">Google Analytics 4 (GA4) and Meta Pixel (Facebook / Instagram Ads)</p>
            </div>
          </div>
        </div>

        <div class="p-6 grid grid-cols-1 lg:grid-cols-2 gap-8">
          
          <!-- Google Analytics 4 -->
          <div class="space-y-4 border border-slate-200 rounded-xl p-5 bg-slate-50/50">
            <div class="flex items-center justify-between">
              <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2">
                <span>📈</span> Google Analytics 4 (GA4)
              </h3>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" name="ga_enabled" value="true" checked={settings.ga_enabled} class="sr-only peer" />
                <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
              </label>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Measurement ID (G-XXXXXXXXXX)</label>
              <input
                type="text"
                name="ga_measurement_id"
                value={settings.ga_measurement_id}
                placeholder="G-ABC123XYZ"
                class="w-full text-xs bg-white border border-slate-300 rounded-lg px-3 py-2 font-mono uppercase"
              />
            </div>
          </div>

          <!-- Meta Pixel -->
          <div class="space-y-4 border border-slate-200 rounded-xl p-5 bg-slate-50/50">
            <div class="flex items-center justify-between">
              <h3 class="font-bold text-slate-900 text-sm flex items-center gap-2">
                <span>🎯</span> Meta Ads & Facebook Pixel
              </h3>
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" name="meta_pixel_enabled" value="true" checked={settings.meta_pixel_enabled} class="sr-only peer" />
                <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-blue-600"></div>
              </label>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">Meta Pixel ID</label>
              <input
                type="text"
                name="meta_pixel_id"
                value={settings.meta_pixel_id}
                placeholder="123456789012345"
                class="w-full text-xs bg-white border border-slate-300 rounded-lg px-3 py-2 font-mono"
              />
            </div>
          </div>

        </div>
      </div>

      <!-- Section 4: WhatsApp Sales Engine -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="bg-emerald-950 text-white p-6 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-800/60 flex items-center justify-center font-bold text-xl">💬</div>
            <div>
              <h2 class="text-lg font-bold">WhatsApp Commerce & Chat Widget</h2>
              <p class="text-xs text-emerald-200">1-Click Direct WhatsApp Ordering & Floating Chat Button</p>
            </div>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" name="whatsapp_enabled" value="true" checked={settings.whatsapp_enabled} class="sr-only peer" />
            <div class="w-11 h-6 bg-emerald-900 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
          </label>
        </div>

        <div class="p-6 space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
              <label class="block text-xs font-bold text-slate-700 mb-1">WhatsApp Phone Number (with Country Code)</label>
              <input
                type="text"
                name="whatsapp_number"
                value={settings.whatsapp_number}
                placeholder="919876543210"
                class="w-full text-xs bg-white border border-slate-300 rounded-lg px-3 py-2 font-mono"
              />
            </div>

            <div class="flex items-center justify-between border border-slate-200 rounded-xl p-3 bg-slate-50">
              <div>
                <span class="text-xs font-bold text-slate-900 block">Floating Chat Widget</span>
                <span class="text-[10px] text-slate-500">Show WhatsApp button in bottom corner</span>
              </div>
              <input type="checkbox" name="whatsapp_floating_widget" value="true" checked={settings.whatsapp_floating_widget} class="w-4 h-4 text-emerald-600 rounded" />
            </div>

            <div class="flex items-center justify-between border border-slate-200 rounded-xl p-3 bg-slate-50">
              <div>
                <span class="text-xs font-bold text-slate-900 block">Direct Product Buy Button</span>
                <span class="text-[10px] text-slate-500">Show "Order via WhatsApp" button on products</span>
              </div>
              <input type="checkbox" name="whatsapp_buy_button" value="true" checked={settings.whatsapp_buy_button} class="w-4 h-4 text-emerald-600 rounded" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Default Pre-filled Order Message Template</label>
            <textarea
              name="whatsapp_default_message"
              rows="2"
              class="w-full text-xs bg-white border border-slate-300 rounded-lg p-3 focus:ring-2 focus:ring-emerald-500 font-sans"
            >{settings.whatsapp_default_message}</textarea>
            <span class="text-[10px] text-slate-500 mt-1 block">Placeholders: &#123;product_title&#125;, &#123;color&#125;, &#123;size&#125;, &#123;price&#125;</span>
          </div>
        </div>
      </div>

      <!-- Save Bar -->
      <div class="sticky bottom-6 bg-slate-900 text-white p-4 rounded-2xl shadow-xl border border-slate-800 flex items-center justify-between z-40">
        <div class="flex items-center gap-3">
          <div class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></div>
          <span class="text-xs font-semibold">Changes are saved directly to database & applied instantly to storefront.</span>
        </div>
        <button
          type="submit"
          class="bg-blue-600 hover:bg-blue-500 text-white font-extrabold text-xs px-8 py-3 rounded-xl transition shadow-lg shadow-blue-500/30 flex items-center gap-2"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          Save All Integrations & Settings
        </button>
      </div>

    </form>
  </div>
</AdminLayout>
