---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import prisma from '../../../lib/db';

const { section = 'general' } = Astro.params;

const settingsList = await prisma.setting.findMany({
  where: { group: section },
});

const settingsMap = Object.fromEntries(settingsList.map((s) => [s.key, s.value]));

const sections = [
  { id: 'general', label: 'General' },
  { id: 'sms', label: '📱 SMS & OTP' },
  { id: 'reading', label: 'Reading' },
  { id: 'writing', label: 'Writing' },
  { id: 'discussion', label: 'Discussion' },
  { id: 'media', label: 'Media' },
  { id: 'permalinks', label: 'Permalinks' },
  { id: 'seo', label: 'SEO' },
  { id: 'security', label: 'Security' },
];
---

<AdminLayout title={`Settings: ${section.toUpperCase()}`} activeNav="settings">
  <div class="flex gap-2 border-b border-gray-200 pb-4 mb-6 overflow-x-auto">
    {sections.map((s) => (
      <a
        href={`/admin/settings/${s.id}`}
        class={`px-4 py-2 rounded-xl text-xs font-bold transition whitespace-nowrap ${
          section === s.id ? 'bg-blue-600 text-white shadow' : 'text-gray-600 hover:bg-gray-200'
        }`}
      >
        {s.label}
      </a>
    ))}
  </div>

  <div class="max-w-2xl bg-white p-8 rounded-2xl border border-gray-200 shadow-sm">
    <form action="/api/settings" method="POST" class="space-y-6">
      <input type="hidden" name="group" value={section} />

      {section === 'general' && (
        <>
          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Site Title</label>
            <input type="text" name="site_title" value={settingsMap['site_title'] || 'Astro CMS'} class="w-full text-sm border border-gray-300 rounded-lg px-3 py-2" />
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Tagline</label>
            <input type="text" name="site_tagline" value={settingsMap['site_tagline'] || ''} class="w-full text-sm border border-gray-300 rounded-lg px-3 py-2" />
          </div>
          <div>
            <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Admin Email</label>
            <input type="email" name="admin_email" value={settingsMap['admin_email'] || ''} class="w-full text-sm border border-gray-300 rounded-lg px-3 py-2" />
          </div>
        </>
      )}

      {section === 'sms' && (
        <div class="space-y-6">
          <div class="bg-amber-50 border border-amber-200 rounded-2xl p-4 text-xs space-y-2">
            <h4 class="font-extrabold text-amber-950 text-sm flex items-center gap-1.5">
              <span>🇮🇳</span> Real Indian SMS OTP Gateway Integration
            </h4>
            <p class="text-slate-600 leading-relaxed">
              To deliver real SMS OTP codes to customer mobile numbers in India, configure your preferred SMS provider API key below. <strong>Fast2SMS</strong> is recommended for India because its pre-approved OTP route delivers instantly without requiring manual DLT registration.
            </p>
          </div>

          <!-- Fast2SMS Configuration -->
          <div class="space-y-3 p-4 bg-slate-50 rounded-2xl border border-slate-200">
            <div class="flex items-center justify-between">
              <span class="font-bold text-xs text-slate-900 uppercase tracking-wider">Fast2SMS (Recommended for India)</span>
              <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-full">Instant OTP Route</span>
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">Fast2SMS API Authorization Key</label>
              <input
                type="password"
                name="fast2sms_api_key"
                value={settingsMap['fast2sms_api_key'] || ''}
                placeholder="Paste Fast2SMS API Key from fast2sms.com/dev/bulkV2"
                class="w-full text-sm font-mono border border-gray-300 rounded-lg px-3 py-2 bg-white"
              />
              <p class="text-[10px] text-slate-500 mt-1">Free ₹50 test credits available at <a href="https://www.fast2sms.com" target="_blank" class="text-blue-600 underline">fast2sms.com</a></p>
            </div>
          </div>

          <!-- 2Factor.in Configuration -->
          <div class="space-y-3 p-4 bg-slate-50 rounded-2xl border border-slate-200">
            <div class="flex items-center justify-between">
              <span class="font-bold text-xs text-slate-900 uppercase tracking-wider">2Factor.in Gateway</span>
              <span class="text-[10px] font-bold text-blue-700 bg-blue-100 px-2 py-0.5 rounded-full">Indian SMS</span>
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">2Factor API Key</label>
              <input
                type="password"
                name="twofactor_api_key"
                value={settingsMap['twofactor_api_key'] || ''}
                placeholder="2Factor.in API Key"
                class="w-full text-sm font-mono border border-gray-300 rounded-lg px-3 py-2 bg-white"
              />
            </div>
          </div>

          <!-- Twilio Configuration -->
          <div class="space-y-3 p-4 bg-slate-50 rounded-2xl border border-slate-200">
            <div class="flex items-center justify-between">
              <span class="font-bold text-xs text-slate-900 uppercase tracking-wider">Twilio SMS (Global)</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-bold text-gray-700 mb-1">Account SID</label>
                <input
                  type="text"
                  name="twilio_account_sid"
                  value={settingsMap['twilio_account_sid'] || ''}
                  placeholder="ACxxxxxxxxxxxxxxxxxxxxxxxx"
                  class="w-full text-sm font-mono border border-gray-300 rounded-lg px-3 py-2 bg-white"
                />
              </div>
              <div>
                <label class="block text-xs font-bold text-gray-700 mb-1">Auth Token</label>
                <input
                  type="password"
                  name="twilio_auth_token"
                  value={settingsMap['twilio_auth_token'] || ''}
                  placeholder="Twilio Auth Token"
                  class="w-full text-sm font-mono border border-gray-300 rounded-lg px-3 py-2 bg-white"
                />
              </div>
            </div>
            <div>
              <label class="block text-xs font-bold text-gray-700 mb-1">From Phone Number</label>
              <input
                type="text"
                name="twilio_from_phone"
                value={settingsMap['twilio_from_phone'] || ''}
                placeholder="+1234567890"
                class="w-full text-sm font-mono border border-gray-300 rounded-lg px-3 py-2 bg-white"
              />
            </div>
          </div>
        </div>
      )}

      {section === 'reading' && (
        <div>
          <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Posts Per Page</label>
          <input type="number" name="posts_per_page" value={settingsMap['posts_per_page'] || '10'} class="w-full text-sm border border-gray-300 rounded-lg px-3 py-2" />
        </div>
      )}

      {section === 'permalinks' && (
        <div>
          <label class="block text-xs font-bold text-gray-700 uppercase mb-1">Permalink Structure</label>
          <select name="permalink_structure" class="w-full text-sm border border-gray-300 rounded-lg px-3 py-2 bg-white">
            <option value="/blog/:slug" selected={settingsMap['permalink_structure'] === '/blog/:slug'}>/blog/:slug (Default)</option>
            <option value="/:slug" selected={settingsMap['permalink_structure'] === '/:slug'}>/:slug (Post Name)</option>
          </select>
        </div>
      )}

      <button type="submit" class="bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs px-6 py-3 rounded-xl shadow transition">
        Save Settings
      </button>
    </form>
  </div>
</AdminLayout>
