---
import PublicLayout from '../../layouts/PublicLayout.astro';
import prisma from '../../lib/db';

const { slug } = Astro.params;

const user = await prisma.user.findFirst({
  where: { username: slug },
  include: {
    posts: {
      where: { status: 'published' },
      orderBy: { createdAt: 'desc' },
      include: { author: true },
    },
  },
});

if (!user) return Astro.redirect('/404');
---

<PublicLayout seo={{ title: `Author: ${user.displayName}` }}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="mb-12 border-b border-gray-200 pb-6 flex items-center gap-4">
      <div class="w-16 h-16 bg-blue-600 rounded-full flex items-center justify-center font-extrabold text-white text-2xl">
        {user.displayName[0]}
      </div>
      <div>
        <h1 class="text-3xl font-extrabold text-gray-900">{user.displayName}</h1>
        <p class="text-xs text-gray-500 mt-1">@{user.username} · {user.bio || 'Author'}</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {user.posts.map((post) => (
        <article class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 flex flex-col justify-between hover:shadow-md transition">
          <div class="space-y-3">
            <h2 class="font-bold text-lg text-gray-900 leading-snug">
              <a href={`/blog/${post.slug}`} class="hover:text-blue-600 transition">
                {post.title}
              </a>
            </h2>
            <p class="text-xs text-gray-600 line-clamp-3">{post.excerpt}</p>
          </div>

          <div class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between text-xs text-gray-500">
            <span>By {user.displayName}</span>
            <span>{new Date(post.createdAt).toLocaleDateString()}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</PublicLayout>
