---
import AuthLayout from '../layouts/AuthLayout.astro';
---

<AuthLayout title="Registration Closed">
  <div class="p-6 bg-slate-900/90 border border-slate-800 rounded-2xl text-center space-y-4">
    <div class="w-12 h-12 bg-amber-500/10 text-amber-500 rounded-full flex items-center justify-center mx-auto text-xl font-bold">
      🔒
    </div>
    <h2 class="text-base font-bold text-white">Registration Disabled</h2>
    <p class="text-xs text-slate-400 leading-relaxed">
      New user registration has been disabled by the system administrator.
    </p>
    <div class="pt-2">
      <a href="/admin/login" class="inline-block bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs px-6 py-2.5 rounded-xl shadow transition">
        Go to Admin Login
      </a>
    </div>
  </div>
</AuthLayout>
