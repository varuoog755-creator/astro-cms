---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { getStorefrontProducts } from '../../lib/products';

const products = await getStorefrontProducts();
---

<PublicLayout
  seo={{
    title: 'Teepul Storefront - Luxury Door Curtains, Window Drapery & Ambient Decor Lights',
    description: 'Browse Teepul luxury door curtains, French sheer window drapery, ambient brass lights, and 3D woven jacquard cushion covers.',
  }}
>
  <!-- Hero Header -->
  <div class="relative bg-gradient-to-b from-[#f7f4ef] via-[#faf8f4] to-[#f4efe6] text-slate-900 overflow-hidden py-16 px-4 sm:px-6 lg:px-8 border-b border-amber-900/10">
    <div class="relative max-w-7xl mx-auto text-center space-y-4">
      <span class="inline-flex items-center gap-2 bg-amber-900/10 border border-amber-900/20 text-amber-900 text-xs font-black px-4 py-1.5 rounded-full uppercase tracking-wider">
        <span>✨ Teepul Luxury Home Collection</span>
      </span>
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-slate-950 leading-tight">
        Curtains, Drapery & <span class="bg-gradient-to-r from-amber-800 via-amber-700 to-amber-900 bg-clip-text text-transparent">Home Decor Catalog</span>
      </h1>
      <p class="max-w-2xl mx-auto text-slate-700 text-sm sm:text-base leading-relaxed font-medium">
        Handcrafted 350 GSM thermal blackout door curtains, French sheer window drapes, and dimmable frosted glass lights for sophisticated living spaces.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Category & Filter Header -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-10 pb-6 border-b border-slate-200">
      <div>
        <h2 class="text-2xl font-black text-slate-900">Storefront Collection ({products.length})</h2>
        <p class="text-xs text-slate-500 mt-0.5">Express Doorstep Delivery Across India</p>
      </div>

      <div class="flex flex-wrap items-center gap-2" id="filter-container">
        <button data-filter="all" class="filter-btn bg-amber-800 text-white font-bold text-xs px-4 py-1.5 rounded-full shadow-sm transition">All Items ({products.length})</button>
        <button data-filter="Door Curtains" class="filter-btn bg-slate-100 text-slate-700 font-semibold text-xs px-3.5 py-1.5 rounded-full hover:bg-amber-50 hover:text-amber-800 transition">Door Curtains</button>
        <button data-filter="Window Curtains" class="filter-btn bg-slate-100 text-slate-700 font-semibold text-xs px-3.5 py-1.5 rounded-full hover:bg-amber-50 hover:text-amber-800 transition">Window Curtains</button>
        <button data-filter="Ambient Lighting" class="filter-btn bg-slate-100 text-slate-700 font-semibold text-xs px-3.5 py-1.5 rounded-full hover:bg-amber-50 hover:text-amber-800 transition">Ambient Lighting</button>
      </div>
    </div>

    <!-- Products Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" id="products-grid">
      {products.map((product) => (
        <div data-category={product.category} class="product-card bg-white rounded-3xl border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between overflow-hidden group">
          <!-- Product Image Container -->
          <div class="relative aspect-square bg-slate-100 overflow-hidden">
            <img
              src={product.images[0]}
              alt={product.name}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            {product.badge && (
              <span class="absolute top-3 left-3 bg-slate-900/90 text-white text-[10px] font-black px-3 py-1 rounded-full uppercase tracking-wider shadow-md backdrop-blur-sm">
                {product.badge}
              </span>
            )}
            {product.fabricSpecs.gsm > 0 && (
              <span class="absolute top-3 right-3 bg-amber-800 text-white text-[10px] font-extrabold px-2.5 py-0.5 rounded-lg shadow-md">
                {product.fabricSpecs.gsm} GSM
              </span>
            )}
          </div>

          <!-- Content Body -->
          <div class="p-5 space-y-4 flex-1 flex flex-col justify-between">
            <div class="space-y-2">
              <div class="flex items-center justify-between text-xs">
                <span class="text-amber-800 font-bold uppercase tracking-wider text-[10px] bg-amber-50 px-2 py-0.5 rounded-md">
                  {product.category}
                </span>
                <div class="flex items-center gap-1 text-amber-500 font-bold text-xs">
                  <span>★</span>
                  <span>{product.rating}</span>
                  <span class="text-slate-400 font-normal">({product.reviewCount})</span>
                </div>
              </div>

              <h3 class="text-base font-extrabold text-slate-900 group-hover:text-amber-800 transition-colors leading-snug">
                <a href={`/products/${product.slug}`}>{product.name}</a>
              </h3>
              
              <p class="text-xs text-slate-500 line-clamp-2 leading-relaxed">{product.tagline}</p>
            </div>

            <!-- Features Tags -->
            <div class="flex flex-wrap gap-1.5 pt-1">
              {product.features.slice(0, 2).map((feat) => (
                <span class="bg-slate-100 text-slate-600 text-[10px] font-medium px-2 py-0.5 rounded">
                  ✓ {feat}
                </span>
              ))}
            </div>

            <!-- Price & Buy Section -->
            <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
              <div>
                <div class="flex items-baseline gap-1">
                  <span class="text-lg font-black text-slate-900">{product.currency}{product.price.toLocaleString('en-IN')}</span>
                  {product.originalPrice && (
                    <span class="text-xs text-slate-400 line-through font-medium">{product.currency}{product.originalPrice.toLocaleString('en-IN')}</span>
                  )}
                </div>
                <span class="text-[10px] text-emerald-600 font-semibold block">Free Shipping</span>
              </div>

              <a
                href={`/products/${product.slug}`}
                class="bg-slate-900 hover:bg-amber-800 text-white font-bold text-xs px-3.5 py-2.5 rounded-xl shadow transition-colors"
              >
                View & Buy &rarr;
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const filterBtns = document.querySelectorAll('.filter-btn');
      const productCards = document.querySelectorAll<HTMLElement>('.product-card');

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter');
          
          filterBtns.forEach(b => {
            b.classList.remove('bg-amber-800', 'text-white');
            b.classList.add('bg-slate-100', 'text-slate-700');
          });
          btn.classList.remove('bg-slate-100', 'text-slate-700');
          btn.classList.add('bg-amber-800', 'text-white');

          productCards.forEach(card => {
            const cat = card.getAttribute('data-category');
            if (filter === 'all' || cat === filter) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    });
  </script>
</PublicLayout>
