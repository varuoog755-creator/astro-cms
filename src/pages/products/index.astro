---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { getStorefrontProducts } from '../../lib/products';

const products = await getStorefrontProducts();

const categories = [
  { id: 'all', label: 'All Curtains' },
  { id: 'Living Room', label: 'Living Room' },
  { id: 'Bedroom', label: 'Bedroom' },
  { id: 'Door Curtains', label: 'Door Curtains' },
  { id: 'Window Curtains', label: 'Window Curtains' },
  { id: 'Combo Packs', label: 'Combo Packs' },
];

const colorFilters = [
  { name: 'All Colors', hex: '', slug: 'all' },
  { name: 'Maroon', hex: '#7B1830', slug: 'maroon' },
  { name: 'Brown', hex: '#4A2C2A', slug: 'brown' },
  { name: 'Navy Blue', hex: '#1B2E4B', slug: 'navy' },
  { name: 'Slate Grey', hex: '#4B5563', slug: 'grey' },
  { name: 'Pink', hex: '#E8A598', slug: 'pink' },
  { name: 'Black', hex: '#1E1E1E', slug: 'black' },
];
---

<PublicLayout
  seo={{
    title: 'Shop Premium Curtains - Teepul Luxury Home Collection',
    description: 'Explore the complete Teepul curtain collection: 5ft window curtains, 7ft door curtains, and 9ft long balcony drapes direct from Panipat mills.',
    canonicalUrl: '/products',
  }}
>
  <!-- Hero Header -->
  <div class="relative bg-gradient-to-b from-[#FFF8F1] via-[#FDF5EB] to-[#F3E5D5]/30 text-slate-900 overflow-hidden py-10 sm:py-16 px-4 sm:px-6 lg:px-8 border-b border-[#7B1830]/10">
    <div class="relative max-w-7xl mx-auto text-center space-y-3">
      <span class="inline-flex items-center gap-2 bg-[#7B1830]/10 border border-[#7B1830]/20 text-[#7B1830] text-xs font-black px-4 py-1.5 rounded-full uppercase tracking-wider">
        <span>✨ Panipat Mill-Direct Curtains</span>
      </span>
      <h1 class="text-3xl sm:text-5xl font-black font-serif tracking-tight text-[#171717] leading-tight">
        Curtain Collection for <span class="text-[#7B1830]">Every Indian Home</span>
      </h1>
      <p class="max-w-2xl mx-auto text-[#6B625D] text-xs sm:text-sm leading-relaxed font-medium">
        Handcrafted 150 GSM dense polyester curtains, rust-proof pre-fitted eyelets, 85%+ thermal blackout, and all-India express delivery with Cash on Delivery.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    
    <!-- Filter Section (Categories & Colors) -->
    <div class="space-y-4 mb-8 pb-6 border-b border-slate-200">
      
      <!-- Category Tabs -->
      <div class="flex items-center justify-between gap-4">
        <div>
          <h2 class="text-xl sm:text-2xl font-black font-serif text-slate-950">Curtains Catalog (<span id="visible-count">{products.length}</span>)</h2>
          <p class="text-xs text-slate-500 mt-0.5">Showing 5ft, 7ft &amp; 9ft options with free door delivery</p>
        </div>
      </div>

      <!-- Category Filter Pills -->
      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1 max-w-full" id="category-filter-container">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-category={cat.id}
            class={`category-btn font-bold text-xs px-4 py-2 rounded-full transition whitespace-nowrap shrink-0 cursor-pointer ${
              idx === 0
                ? 'bg-[#7B1830] text-white shadow-sm'
                : 'bg-white text-slate-700 border border-slate-200 hover:border-[#7B1830]/50 hover:text-[#7B1830]'
            }`}
          >
            {cat.label}
          </button>
        ))}
      </div>

      <!-- Color Swatch Quick Filter -->
      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pt-1" id="color-filter-container">
        <span class="text-xs font-bold text-slate-500 mr-1 shrink-0">Color:</span>
        {colorFilters.map((col, idx) => (
          <button
            type="button"
            data-color={col.slug}
            class={`color-filter-btn flex items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-full border transition whitespace-nowrap shrink-0 cursor-pointer ${
              idx === 0
                ? 'bg-slate-900 text-white border-slate-900'
                : 'bg-white text-slate-700 border-slate-200 hover:border-[#7B1830]'
            }`}
          >
            {col.hex && (
              <span class="w-3 h-3 rounded-full border border-white shadow-xs inline-block" style={`background-color: ${col.hex};`}></span>
            )}
            <span>{col.name}</span>
          </button>
        ))}
      </div>

    </div>

    <!-- Products Grid (2 columns on mobile, 4 on desktop) -->
    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-6" id="products-grid">
      {products.map((product) => {
        const discountPct = product.originalPrice
          ? Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100)
          : 0;
        
        // Match color name to lowercase slug for filtering
        const colorName = product.colors?.[0]?.name?.toLowerCase() || product.name.toLowerCase();
        
        return (
          <div
            data-category={product.category}
            data-name={product.name.toLowerCase()}
            data-color={colorName}
            class="product-card bg-white rounded-2xl sm:rounded-3xl border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between overflow-hidden group"
          >
            <!-- Product Image Container -->
            <a href={`/products/${product.slug}`} class="block relative aspect-square bg-slate-100 overflow-hidden">
              <img
                src={product.images[0] || '/images/hero-curtains.jpg'}
                alt={product.name}
                width="400"
                height="400"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              {product.badge && (
                <span class="absolute top-2 left-2 sm:top-3 sm:left-3 bg-[#7B1830] text-white text-[9px] sm:text-[10px] font-black px-2 py-0.5 sm:px-3 sm:py-1 rounded-full uppercase tracking-wider shadow-md backdrop-blur-sm">
                  {product.badge}
                </span>
              )}
              {discountPct > 0 && (
                <span class="absolute top-2 right-2 sm:top-3 sm:right-3 bg-emerald-700 text-white text-[9px] sm:text-[10px] font-black px-1.5 py-0.5 sm:px-2 sm:py-0.5 rounded-full shadow">
                  -{discountPct}%
                </span>
              )}
            </a>

            <!-- Content Body -->
            <div class="p-3.5 sm:p-5 space-y-2 sm:space-y-3 flex-1 flex flex-col justify-between">
              <div class="space-y-1.5">
                <div class="flex items-center justify-between text-[10px] sm:text-xs">
                  <span class="text-[#7B1830] font-bold uppercase tracking-wider text-[9px] sm:text-[10px] bg-[#7B1830]/10 px-2 py-0.5 rounded truncate max-w-[100px] sm:max-w-none">
                    {product.category}
                  </span>
                  <div class="flex items-center gap-0.5 text-amber-500 font-bold text-[10px] sm:text-xs">
                    <span>★</span>
                    <span>{product.rating}</span>
                  </div>
                </div>

                <h3 class="text-xs sm:text-sm font-extrabold text-slate-900 group-hover:text-[#7B1830] transition-colors leading-snug line-clamp-2">
                  <a href={`/products/${product.slug}`}>{product.name}</a>
                </h3>

                <!-- Available Sizes Tag -->
                <div class="flex items-center gap-1 text-[10px] text-slate-500 pt-0.5">
                  <span class="font-bold text-slate-700">Sizes:</span>
                  <span>5ft · 7ft · 9ft</span>
                </div>
              </div>

              <!-- Price & Buy Section -->
              <div class="pt-2 sm:pt-3 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div>
                  <div class="flex items-baseline gap-1">
                    <span class="text-sm sm:text-lg font-black text-[#171717]">{product.currency}{product.price.toLocaleString('en-IN')}</span>
                    {product.originalPrice && (
                      <span class="text-[10px] sm:text-xs text-slate-400 line-through font-medium">{product.currency}{product.originalPrice.toLocaleString('en-IN')}</span>
                    )}
                  </div>
                  <span class="text-[9px] sm:text-[10px] text-emerald-700 font-bold block">Free Express Delivery</span>
                </div>

                <div class="w-full sm:w-auto">
                  <button
                    type="button"
                    onclick={`window.animatedAddToCart(this, '${product.name.replace(/'/g, "\\'")}', '${product.slug}', ${product.price}, '${product.images[0]}')`}
                    class="w-full sm:w-auto bg-[#7B1830] hover:bg-[#4A0F1D] text-white font-extrabold text-xs py-2 px-3 sm:px-3.5 rounded-xl shadow-xs active:scale-95 transition-all duration-300 flex items-center justify-center gap-1.5 group/btn cursor-pointer whitespace-nowrap"
                    title="Add to Cart"
                  >
                    <span class="cart-icon transition-transform duration-300 group-hover/btn:scale-125 text-xs">🛒</span>
                    <span class="btn-text whitespace-nowrap font-bold">Add to Cart</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Empty State -->
    <div id="no-products-msg" class="hidden text-center py-16 space-y-4">
      <div class="text-4xl">🔍</div>
      <h3 class="text-lg font-black text-slate-900">No Curtains Match Your Filter</h3>
      <p class="text-xs text-slate-500 max-w-sm mx-auto">Try clearing your filters to view our full collection of 5ft, 7ft, and 9ft curtains.</p>
      <button
        type="button"
        onclick="window.location.href='/products'"
        class="inline-block bg-[#7B1830] text-white text-xs font-bold px-5 py-2.5 rounded-full"
      >
        View All Curtains
      </button>
    </div>

  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const categoryBtns = document.querySelectorAll('.category-btn');
      const colorBtns = document.querySelectorAll('.color-filter-btn');
      const productCards = document.querySelectorAll<HTMLElement>('.product-card');
      const countEl = document.getElementById('visible-count');
      const emptyEl = document.getElementById('no-products-msg');

      let currentCategory = 'all';
      let currentColor = 'all';

      // Parse URL parameters (e.g. ?category=Living+Room or ?color=maroon)
      const urlParams = new URLSearchParams(window.location.search);
      const urlCategory = urlParams.get('category');
      const urlColor = urlParams.get('color');

      if (urlCategory) {
        currentCategory = urlCategory;
      }
      if (urlColor) {
        currentColor = urlColor.toLowerCase();
      }

      function updateActiveStyles() {
        categoryBtns.forEach(btn => {
          const cat = btn.getAttribute('data-category');
          if ((currentCategory === 'all' && cat === 'all') || (cat && cat.toLowerCase() === currentCategory.toLowerCase())) {
            btn.classList.add('bg-[#7B1830]', 'text-white', 'shadow-sm');
            btn.classList.remove('bg-white', 'text-slate-700');
          } else {
            btn.classList.remove('bg-[#7B1830]', 'text-white', 'shadow-sm');
            btn.classList.add('bg-white', 'text-slate-700');
          }
        });

        colorBtns.forEach(btn => {
          const col = btn.getAttribute('data-color');
          if (col === currentColor || (currentColor === 'all' && col === 'all')) {
            btn.classList.add('bg-slate-900', 'text-white', 'border-slate-900');
            btn.classList.remove('bg-white', 'text-slate-700', 'border-slate-200');
          } else {
            btn.classList.remove('bg-slate-900', 'text-white', 'border-slate-900');
            btn.classList.add('bg-white', 'text-slate-700', 'border-slate-200');
          }
        });
      }

      function filterProducts() {
        let visibleCount = 0;

        productCards.forEach(card => {
          const cat = card.getAttribute('data-category') || '';
          const name = card.getAttribute('data-name') || '';
          const col = card.getAttribute('data-color') || '';

          const matchCat = (currentCategory === 'all') || 
            (cat.toLowerCase().includes(currentCategory.toLowerCase())) ||
            (currentCategory === 'Living Room' && (cat.includes('Door') || cat.includes('Living'))) ||
            (currentCategory === 'Bedroom' && (cat.includes('Window') || cat.includes('Bedroom'))) ||
            (currentCategory === 'Window Curtains' && (cat.includes('Window') || name.includes('window'))) ||
            (currentCategory === 'Door Curtains' && (cat.includes('Door') || name.includes('door'))) ||
            (currentCategory === 'Combo Packs' && (name.includes('pack') || cat.includes('Combo')));

          const matchColor = (currentColor === 'all') || 
            (col.includes(currentColor)) || 
            (name.includes(currentColor));

          if (matchCat && matchColor) {
            card.style.display = 'flex';
            visibleCount++;
          } else {
            card.style.display = 'none';
          }
        });

        if (countEl) countEl.textContent = visibleCount.toString();
        if (emptyEl) {
          if (visibleCount === 0) {
            emptyEl.classList.remove('hidden');
          } else {
            emptyEl.classList.add('hidden');
          }
        }
      }

      categoryBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          currentCategory = btn.getAttribute('data-category') || 'all';
          updateActiveStyles();
          filterProducts();
        });
      });

      colorBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          currentColor = btn.getAttribute('data-color') || 'all';
          updateActiveStyles();
          filterProducts();
        });
      });

      updateActiveStyles();
      filterProducts();
    });
  </script>
</PublicLayout>
