---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { getStorefrontProducts } from '../../lib/products';

const products = await getStorefrontProducts();
---

<PublicLayout
  seo={{
    title: 'Teepul Storefront - Luxury Door Curtains, Window Drapery & Ambient Decor Lights',
    description: 'Browse Teepul luxury door curtains, French sheer window drapery, ambient brass lights, and 3D woven jacquard cushion covers.',
    canonicalUrl: '/products',
  }}
>
  <!-- Hero Header -->
  <div class="relative bg-gradient-to-b from-[#f7f4ef] via-[#faf8f4] to-[#f4efe6] text-slate-900 overflow-hidden py-16 px-4 sm:px-6 lg:px-8 border-b border-amber-900/10">
    <div class="relative max-w-7xl mx-auto text-center space-y-4">
      <span class="inline-flex items-center gap-2 bg-amber-900/10 border border-amber-900/20 text-amber-900 text-xs font-black px-4 py-1.5 rounded-full uppercase tracking-wider">
        <span>✨ Teepul Luxury Home Collection</span>
      </span>
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight text-slate-950 leading-tight">
        Curtains, Drapery & <span class="bg-gradient-to-r from-amber-800 via-amber-700 to-amber-900 bg-clip-text text-transparent">Home Decor Catalog</span>
      </h1>
      <p class="max-w-2xl mx-auto text-slate-700 text-sm sm:text-base leading-relaxed font-medium">
        Handcrafted premium heavyweight polyester thermal blackout door curtains, French sheer window drapes, and elegant decor for sophisticated living spaces.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Category & Filter Header -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-10 pb-6 border-b border-slate-200">
      <div>
        <h2 class="text-2xl font-black text-slate-900">Storefront Collection ({products.length})</h2>
        <p class="text-xs text-slate-500 mt-0.5">Express Doorstep Delivery Across India</p>
      </div>

      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1 max-w-full w-full sm:w-auto" id="filter-container">
        <button data-filter="all" class="filter-btn bg-amber-800 text-white font-bold text-xs px-4 py-2 rounded-full shadow-sm transition whitespace-nowrap shrink-0">All Items ({products.length})</button>
        <button data-filter="Door Curtains" class="filter-btn bg-slate-100 text-slate-700 font-semibold text-xs px-3.5 py-2 rounded-full hover:bg-amber-50 hover:text-amber-800 transition whitespace-nowrap shrink-0">Door Curtains</button>
        <button data-filter="Window Curtains" class="filter-btn bg-slate-100 text-slate-700 font-semibold text-xs px-3.5 py-2 rounded-full hover:bg-amber-50 hover:text-amber-800 transition whitespace-nowrap shrink-0">Window Curtains</button>
        <button data-filter="Ambient Lighting" class="filter-btn bg-slate-100 text-slate-700 font-semibold text-xs px-3.5 py-2 rounded-full hover:bg-amber-50 hover:text-amber-800 transition whitespace-nowrap shrink-0">Ambient Lighting</button>
      </div>
    </div>

    <!-- Products Grid (2 columns on mobile, 4 on desktop) -->
    <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6" id="products-grid">
      {products.map((product) => (
        <div data-category={product.category} class="product-card bg-white rounded-2xl sm:rounded-3xl border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between overflow-hidden group">
          <!-- Product Image Container -->
          <div class="relative aspect-square bg-slate-100 overflow-hidden">
            <img
              src={product.images[0]}
              alt={product.name}
              width="400"
              height="400"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            {product.badge && (
              <span class="absolute top-2 left-2 sm:top-3 sm:left-3 bg-slate-900/90 text-white text-[9px] sm:text-[10px] font-black px-2 py-0.5 sm:px-3 sm:py-1 rounded-full uppercase tracking-wider shadow-md backdrop-blur-sm">
                {product.badge}
              </span>
            )}
            {product.originalPrice && (
              <span class="absolute top-2 right-2 sm:top-3 sm:right-3 bg-emerald-600 text-white text-[9px] sm:text-[10px] font-black px-1.5 py-0.5 sm:px-2 sm:py-0.5 rounded-full shadow">
                -{Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100)}%
              </span>
            )}
          </div>

          <!-- Content Body -->
          <div class="p-3 sm:p-5 space-y-2 sm:space-y-4 flex-1 flex flex-col justify-between">
            <div class="space-y-1.5 sm:space-y-2">
              <div class="flex items-center justify-between text-[10px] sm:text-xs">
                <span class="text-amber-800 font-bold uppercase tracking-wider text-[9px] sm:text-[10px] bg-amber-50 px-1.5 py-0.5 rounded border border-amber-200 truncate max-w-[90px] sm:max-w-none">
                  {product.category}
                </span>
                <div class="flex items-center gap-0.5 text-amber-500 font-bold text-[10px] sm:text-xs">
                  <span>★</span>
                  <span>{product.rating}</span>
                </div>
              </div>

              <h3 class="text-xs sm:text-base font-extrabold text-slate-900 group-hover:text-amber-800 transition-colors leading-snug line-clamp-2">
                <a href={`/products/${product.slug}`}>{product.name}</a>
              </h3>
              
              <p class="text-[11px] sm:text-xs text-slate-500 line-clamp-1 sm:line-clamp-2 leading-relaxed hidden sm:block">{product.tagline}</p>
            </div>

            <!-- Price & Buy Section -->
            <div class="pt-2 sm:pt-3 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div>
                <div class="flex items-baseline gap-1">
                  <span class="text-sm sm:text-lg font-black text-slate-900">{product.currency}{product.price.toLocaleString('en-IN')}</span>
                  {product.originalPrice && (
                    <span class="text-[10px] sm:text-xs text-slate-400 line-through font-medium">{product.currency}{product.originalPrice.toLocaleString('en-IN')}</span>
                  )}
                </div>
                <span class="text-[9px] sm:text-[10px] text-emerald-600 font-bold block">Free Delivery</span>
              </div>

              <div class="flex items-center gap-1.5 w-full sm:w-auto">
                <button
                  type="button"
                  onclick={`window.animatedAddToCart(this, '${product.name.replace(/'/g, "\\'")}', '${product.slug}', ${product.price}, '${product.images[0]}')`}
                  class="bg-amber-800 hover:bg-amber-900 text-white font-extrabold text-[10px] sm:text-xs py-2 px-2.5 sm:px-3 sm:py-2 rounded-xl shadow active:scale-95 transition-all duration-300 flex items-center justify-center gap-1 group/btn cursor-pointer flex-1 sm:flex-none whitespace-nowrap"
                  title="Add to Cart"
                >
                  <span class="cart-icon transition-transform duration-300 group-hover/btn:scale-125">🛒</span>
                  <span class="btn-text whitespace-nowrap">Add <span class="hidden sm:inline">to Cart</span></span>
                </button>

                <a
                  href={`/products/${product.slug}`}
                  class="bg-slate-900 hover:bg-amber-800 text-white font-bold text-[10px] sm:text-xs py-2 px-2.5 sm:px-3 sm:py-2 rounded-xl shadow transition-colors text-center shrink-0"
                >
                  View &rarr;
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const filterBtns = document.querySelectorAll('.filter-btn');
      const productCards = document.querySelectorAll<HTMLElement>('.product-card');

      filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const filter = btn.getAttribute('data-filter');
          
          filterBtns.forEach(b => {
            b.classList.remove('bg-amber-800', 'text-white');
            b.classList.add('bg-slate-100', 'text-slate-700');
          });
          btn.classList.remove('bg-slate-100', 'text-slate-700');
          btn.classList.add('bg-amber-800', 'text-white');

          productCards.forEach(card => {
            const cat = card.getAttribute('data-category');
            if (filter === 'all' || cat === filter) {
              card.style.display = 'flex';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    });
  </script>
</PublicLayout>
