---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import db from '../../db/index';

const { searchParams } = Astro.url;
const selectedCategory = searchParams.get('category');

let query = 'SELECT * FROM products';
const params: any[] = [];

if (selectedCategory) {
  const cat = db.prepare('SELECT id FROM categories WHERE slug = ?').get(selectedCategory) as any;
  if (cat) {
    query += ' WHERE category_id = ?';
    params.push(cat.id);
  }
}

query += ' ORDER BY id DESC';
const products = db.prepare(query).all(...params) as any[];
const categories = db.prepare('SELECT * FROM categories ORDER BY id ASC').all() as any[];
---

<Layout title="Streetwear Drops Catalog &mdash; Teepul 240 GSM Oversized Tees" description="Browse 240 GSM Heavyweight Terry Cotton T-Shirts, Anime Hoodies, and Co-ord Sets on Teepul.com.">
  <section class="catalog-hero">
    <div class="container text-center">
      <span class="badge-brand">🔥 OFFICIAL TEEPUL CATALOG</span>
      <h1 class="catalog-title">Heavyweight Streetwear Drops</h1>
      <p class="catalog-sub">
        Architectural oversized drop-shoulder fits, 240 GSM French Terry Cotton, and high-density screenprints. Cash on Delivery across 19,000+ Indian pincodes.
      </p>

      <!-- Category Filter Bar -->
      <div class="catalog-filter-bar">
        <a href="/products" class={!selectedCategory ? 'filter-chip active' : 'filter-chip'}>
          All Drops ({products.length})
        </a>
        {categories.map(cat => (
          <a 
            href={`/products?category=${cat.slug}`} 
            class={selectedCategory === cat.slug ? 'filter-chip active' : 'filter-chip'}
          >
            {cat.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section style="padding: 4rem 0 6rem; background: #fafafa;">
    <div class="container">
      {products.length === 0 ? (
        <div class="empty-state">
          <h3>No products found in this collection</h3>
          <a href="/products" class="btn-primary">View All Products &rarr;</a>
        </div>
      ) : (
        <div class="product-grid">
          {products.map(product => (
            <ProductCard product={product} />
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>

<style>
  .catalog-hero {
    background: #0a0a0a;
    color: #ffffff;
    padding: 4.5rem 0 3rem;
    text-align: center;
    font-family: 'Outfit', sans-serif;
  }

  .badge-brand {
    background: #ff3b30;
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 800;
    padding: 4px 12px;
    border-radius: 20px;
  }

  .catalog-title {
    font-size: 3.2rem;
    font-weight: 900;
    margin: 1rem 0 0.8rem;
  }

  .catalog-sub {
    font-size: 1.1rem;
    color: #a0a0a0;
    max-width: 720px;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
  }

  .catalog-filter-bar {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .filter-chip {
    background: rgba(255,255,255,0.08);
    color: #ffffff;
    text-decoration: none;
    padding: 0.6rem 1.25rem;
    border-radius: 20px;
    font-size: 0.88rem;
    font-weight: 700;
    border: 1px solid rgba(255,255,255,0.15);
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .filter-chip:hover, .filter-chip.active {
    background: #ffffff;
    color: #000000;
    border-color: #ffffff;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 1rem;
  }

  .btn-primary {
    display: inline-block;
    background: #000;
    color: #fff;
    padding: 0.85rem 2rem;
    border-radius: 6px;
    font-weight: 800;
    text-decoration: none;
    margin-top: 1rem;
  }
</style>
