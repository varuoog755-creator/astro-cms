            <div class="text-3xl sm:text-4xl font-black text-amber-900 leading-none">4.7</div>
            <div class="flex items-center gap-0.5 text-amber-500 text-xs mt-1">
              <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
            </div>
          </div>
          <div class="border-l border-amber-200 pl-4 text-xs font-medium text-slate-700">
            <div class="font-bold text-slate-900">128 Verified Ratings</div>
            <div class="text-emerald-700 font-semibold flex items-center gap-1 mt-0.5">
              <span>✓</span> 100% Genuine Buyers
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
        {customerReviews.map((rev) => (
          <div class="bg-slate-50/80 border border-slate-200 rounded-2xl p-5 space-y-3 hover:border-amber-300 transition-colors">
            <div class="flex items-start justify-between gap-2">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-amber-800 text-white font-bold text-xs flex items-center justify-center shrink-0">
                  {rev.name.charAt(0)}
                </div>
                <div>
                  <h4 class="font-bold text-xs sm:text-sm text-slate-900 leading-tight">{rev.name}</h4>
                  <span class="text-[10px] text-slate-500 font-medium">{rev.city}</span>
                </div>
              </div>
              <span class="inline-flex items-center gap-1 bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5 rounded-full shrink-0">
                <span>✓</span> Verified Buyer
              </span>
            </div>

            <div class="flex items-center gap-2 text-xs">
              <div class="flex text-amber-500 text-xs">
                {Array.from({ length: rev.rating }).map(() => <span>★</span>)}
              </div>
              <span class="text-[11px] font-bold text-slate-900">{rev.title}</span>
            </div>

            <p class="text-xs text-slate-600 leading-relaxed">
              "{rev.comment}"
            </p>

            <div class="text-[10px] text-slate-400 font-medium pt-1 border-t border-slate-200/60">
              {rev.date}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- 1️⃣2️⃣ DELIVERY + TRUST (🚚 Delivery, 🔒 Secure Checkout, ↩️ Return / Replacement*, 💳 Payment Options) -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-md p-6 sm:p-10 space-y-6">
      <div class="border-b border-slate-100 pb-4">
        <span class="text-[10px] font-black uppercase tracking-widest text-amber-900 bg-amber-50 border border-amber-200 px-3 py-1 rounded-full">BUYER PROTECTION</span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 mt-2">Delivery &amp; Trust Guarantees</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <div class="p-5 rounded-2xl bg-amber-50/50 border border-amber-200/70 space-y-2">
          <div class="text-2xl">🚚</div>
          <h3 class="font-extrabold text-sm text-slate-900">Express Delivery</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Direct dispatch from Panipat warehouse with all-India express courier in 3 to 5 business days.</p>
        </div>

        <div class="p-5 rounded-2xl bg-emerald-50/50 border border-emerald-200/70 space-y-2">
          <div class="text-2xl">🔒</div>
          <h3 class="font-extrabold text-sm text-slate-900">Secure Checkout</h3>
          <p class="text-xs text-slate-600 leading-relaxed">256-bit SSL encryption protects every transaction with instant SMS &amp; email confirmation.</p>
        </div>

        <div class="p-5 rounded-2xl bg-blue-50/50 border border-blue-200/70 space-y-2">
          <div class="text-2xl">↩️</div>
          <h3 class="font-extrabold text-sm text-slate-900">7-Day Replacement*</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Doorstep replacement for any sizing or manufacturing defect with dedicated customer support.</p>
        </div>

        <div class="p-5 rounded-2xl bg-purple-50/50 border border-purple-200/70 space-y-2">
          <div class="text-2xl">💳</div>
          <h3 class="font-extrabold text-sm text-slate-900">Payment Options</h3>
          <p class="text-xs text-slate-600 leading-relaxed">UPI (Google Pay, PhonePe, Paytm), Debit/Credit Cards, Net Banking, and Cash on Delivery (COD*).</p>
        </div>
      </div>
    </div>

    <!-- 1️⃣3️⃣ FAQ ACCORDION -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-md p-6 sm:p-10 space-y-6">
      <div class="border-b border-slate-100 pb-4">
        <span class="text-[10px] font-black uppercase tracking-widest text-amber-900 bg-amber-50 border border-amber-200 px-3 py-1 rounded-full">FREQUENTLY ASKED</span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 mt-2">Questions &amp; Answers</h2>
      </div>

      <div class="space-y-3">
        {productFaqs.map((faq, index) => (
          <details class="group bg-slate-50/70 rounded-2xl border border-slate-200 p-4 sm:p-5 shadow-xs transition hover:border-amber-400">
            <summary class="flex justify-between items-center cursor-pointer font-bold text-slate-900 text-sm list-none select-none">
              <span class="flex items-center gap-2.5">
                <span class="w-6 h-6 rounded-full bg-amber-100 text-amber-900 font-extrabold text-xs flex items-center justify-center shrink-0">
                  {index + 1}
                </span>
                <span>{faq.question}</span>
              </span>
              <span class="transition-transform group-open:rotate-180 text-slate-400 text-xs shrink-0 ml-2">▼</span>
            </summary>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed mt-3 pl-8 border-t border-slate-200/70 pt-3">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </div>

    <!-- 1️⃣4️⃣ FINAL CONVERSION (“Ready to Upgrade Your Room?” [ 🛒 BUY NOW ]) -->
    <div class="bg-gradient-to-r from-amber-950 via-slate-900 to-amber-950 text-white rounded-3xl p-6 sm:p-10 shadow-2xl border border-amber-500/20 flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left">
      <div class="space-y-1.5">
        <div class="inline-flex items-center gap-2 bg-amber-500/20 text-amber-300 text-[10px] font-black px-3 py-0.5 rounded-full uppercase tracking-wider">
          <span>⚡ PANIPAT DIRECT FACTORY</span>
        </div>
        <h3 class="text-2xl sm:text-3xl font-black text-white">“Ready to Upgrade Your Room?”</h3>
        <p class="text-xs text-slate-300">{product.name} · Fast Dispatch · 7-Day Doorstep Replacement</p>
      </div>

      <div class="flex items-center gap-4 shrink-0">
        <div class="text-right hidden sm:block">
          <div class="text-3xl font-black text-amber-400">{product.currency}<span id="final-unit-price">{initialSize.price}</span></div>
          <div class="text-[10px] text-slate-400 font-medium">Free All-India Delivery</div>
        </div>
        <button
          type="button"
          onclick="document.getElementById('order-btn')?.click();"
          class="bg-amber-500 hover:bg-amber-400 active:scale-95 text-slate-950 font-black text-sm px-8 py-4 rounded-full shadow-2xl transition-all cursor-pointer whitespace-nowrap"
        >
          🛒 BUY NOW &rarr;
        </button>
      </div>
    </div>

    <!-- Recommended Related Products -->
    {relatedProducts.length > 0 && (
      <div class="space-y-6 pt-4">
        <div class="flex items-baseline justify-between border-b border-slate-200 pb-3">
          <h3 class="text-xl sm:text-2xl font-black text-slate-900">Explore More Curtains</h3>
          <a href="/products" class="text-xs font-bold text-amber-800 hover:underline">View All &rarr;</a>
        </div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
          {relatedProducts.map((rel) => (
            <a href={`/products/${rel.slug}`} class="bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-lg hover:-translate-y-1 transition p-3.5 space-y-3 group flex flex-col justify-between">
              <div class="aspect-square rounded-xl overflow-hidden bg-slate-100">
                <img
                  src={rel.images[0]}
                  alt={rel.name}
                  width="300"
                  height="300"
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition duration-500"
                />
              </div>
              <div class="space-y-1">
                <span class="text-[9px] font-bold uppercase text-amber-800 bg-amber-50 px-2 py-0.5 rounded">{rel.category || 'Curtains'}</span>
                <h4 class="font-extrabold text-xs text-slate-900 group-hover:text-amber-800 transition line-clamp-1">{rel.name}</h4>
                <div class="font-black text-sm text-slate-900">{rel.currency}{rel.price}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

  </div>

  <!-- MOBILE STICKY CTA (Bottom Bar on Mobile) -->
  <div class="sm:hidden fixed bottom-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-t border-slate-200 px-4 py-3 shadow-[0_-4px_20px_rgba(0,0,0,0.1)] flex items-center justify-between gap-3">
    <div>
      <div class="text-[10px] text-slate-500 font-semibold uppercase tracking-wider">Total Price</div>
      <div class="text-lg font-black text-slate-900 leading-none">
        {product.currency}<span id="sticky-unit-price">{initialSize.price}</span>
      </div>
    </div>
    <button
      type="button"
      onclick="document.getElementById('order-btn')?.click();"
      class="flex-1 bg-amber-800 hover:bg-amber-900 active:scale-95 text-white font-black text-sm py-3 px-6 rounded-xl shadow-md transition flex items-center justify-center gap-1.5 cursor-pointer"
    >
      <span>🛒 BUY NOW</span>
    </button>
  </div>

  <!-- Interactive JavaScript Engine -->
  <script is:inline define:vars={{ currentProductSlug: product.slug, currentProductName: product.name, currentProductId: product.id, currentProductPrice: product.price, productImages: initialImages || [], productColors: product.colors || [] }}>
    document.addEventListener('DOMContentLoaded', () => {
      let selectedColor = document.querySelector('.color-chip-btn')?.getAttribute('data-color') || '';
      let selectedSize = document.querySelector('.size-btn.active-size')?.getAttribute('data-size') || '';
      let quantity = 1;
      let baseSizePrice = parseFloat(document.querySelector('.size-btn.active-size')?.getAttribute('data-price') || document.getElementById('unit-price')?.innerText?.replace(/,/g, '') || '0');
      let baseSizeOrigPrice = parseFloat(document.querySelector('.size-btn.active-size')?.getAttribute('data-original-price') || '0');
      let unitPrice = baseSizePrice;
      let currentSlideIndex = 0;
      let currentGalleryImages = Array.isArray(productImages) ? [...productImages] : [];

      // Meta Pixel ViewContent Event
      try {
        if (typeof window.fbq === 'function') {
          window.fbq('track', 'ViewContent', {
            content_name: currentProductName,
            content_ids: [currentProductSlug],
            content_type: 'product',
            value: unitPrice || currentProductPrice,
            currency: 'INR'
          });
        }
      } catch (e) {
        console.error('Meta Pixel ViewContent error:', e);
      }

      function updateSubtotal() {
        const subtotal = unitPrice * quantity;
        const subtotalEl = document.getElementById('subtotal-price');
        const qtyDisplay = document.getElementById('qty-display');
        if (subtotalEl) subtotalEl.innerText = subtotal.toLocaleString('en-IN');
        if (qtyDisplay) qtyDisplay.innerText = quantity;
      }

      function updateQuantityButtons() {
        const minusBtn = document.getElementById('qty-minus-btn');
        const plusBtn = document.getElementById('qty-plus-btn');
        if (minusBtn) {
          if (quantity <= 1) {
            minusBtn.classList.add('opacity-40', 'cursor-not-allowed');
          } else {
            minusBtn.classList.remove('opacity-40', 'cursor-not-allowed');
          }
        }
        if (plusBtn) {
          if (quantity >= 10) {
            plusBtn.classList.add('opacity-40', 'cursor-not-allowed');
          } else {
            plusBtn.classList.remove('opacity-40', 'cursor-not-allowed');
          }
        }
      }

      function updatePricing() {
        unitPrice = baseSizePrice;
        const currentOrigPrice = baseSizeOrigPrice || 0;
        
        const unitPriceEl = document.getElementById('unit-price');
        const finalUnitPriceEl = document.getElementById('final-unit-price');
        const stickyUnitPriceEl = document.getElementById('sticky-unit-price');
        if (unitPriceEl) unitPriceEl.innerText = unitPrice.toLocaleString('en-IN');
        if (finalUnitPriceEl) finalUnitPriceEl.innerText = unitPrice.toLocaleString('en-IN');
        if (stickyUnitPriceEl) stickyUnitPriceEl.innerText = unitPrice.toLocaleString('en-IN');

        const origPriceEl = document.getElementById('original-price');
        const origWrapEl = document.getElementById('original-price-wrap');
        const discountBadgeEl = document.getElementById('discount-badge');
        const saveAmountEl = document.getElementById('save-amount');

        if (currentOrigPrice > unitPrice) {
          const savedDiff = currentOrigPrice - unitPrice;
          if (origPriceEl) origPriceEl.innerText = currentOrigPrice.toLocaleString('en-IN');
          if (origWrapEl) origWrapEl.classList.remove('hidden');
          if (saveAmountEl) saveAmountEl.innerText = savedDiff.toLocaleString('en-IN');
          if (discountBadgeEl) discountBadgeEl.classList.remove('hidden');
        } else {
          if (origWrapEl) origWrapEl.classList.add('hidden');
          if (discountBadgeEl) discountBadgeEl.classList.add('hidden');
        }

        updateSubtotal();
      }

      // Slider Logic
      const track = document.getElementById('product-slider-track');
      const counter = document.getElementById('slider-counter');

      function goToSlide(index) {
        const total = currentGalleryImages.length;
        if (total <= 0) return;
        currentSlideIndex = (index + total) % total;
        if (track) {
          track.style.transform = 'translateX(-' + (currentSlideIndex * 100) + '%)';
        }
        if (counter) {
          counter.innerText = (currentSlideIndex + 1) + ' / ' + total;
        }
        
        const dots = document.querySelectorAll('.slider-dot');
        dots.forEach((dot, idx) => {
          if (idx === currentSlideIndex) {
            dot.className = 'slider-dot transition-all duration-300 rounded-full cursor-pointer w-5 h-1.5 bg-amber-800';
          } else {
            dot.className = 'slider-dot transition-all duration-300 rounded-full cursor-pointer w-2 h-1.5 bg-slate-300 hover:bg-slate-400';
          }
        });

        const thumbs = document.querySelectorAll('.thumb-btn');
        thumbs.forEach((thumb, idx) => {
          if (idx === currentSlideIndex) {
            thumb.classList.remove('border-slate-300', 'opacity-70');
            thumb.classList.add('border-amber-800', 'ring-2', 'ring-amber-800/30', 'opacity-100');
            if (typeof thumb.scrollIntoView === 'function') {
              thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            }
          } else {
            thumb.classList.remove('border-amber-800', 'ring-2', 'ring-amber-800/30', 'opacity-100');
            thumb.classList.add('border-slate-300', 'opacity-70');
          }
        });
      }

      function attachGalleryEvents() {
        document.querySelectorAll('.thumb-btn').forEach((btn) => {
          btn.onclick = () => {
            const slideIdx = parseInt(btn.getAttribute('data-slide-index') || '0', 10);
            goToSlide(slideIdx);
          };
        });

        document.querySelectorAll('.slider-dot').forEach((dot) => {
          dot.onclick = () => {
            const slideIdx = parseInt(dot.getAttribute('data-slide-dot') || '0', 10);
            goToSlide(slideIdx);
          };
        });
      }

      function updateGalleryForColor(colorName) {
        const foundColor = (productColors || []).find((c) => c && c.name === colorName);
        if (foundColor && Array.isArray(foundColor.images) && foundColor.images.length > 0) {
          currentGalleryImages = [...foundColor.images];
          
          if (track) {
            track.innerHTML = currentGalleryImages.map((img, idx) => `
              <div class="w-full h-full flex-shrink-0 relative flex items-center justify-center bg-slate-100" style="aspect-ratio: 1 / 1; width: 100%; height: 100%;">
                <img
                  src="${img}"
                  alt="${currentProductName} ${colorName} - View ${idx + 1}"
                  width="700"
                  height="700"
                  loading="${idx === 0 ? 'eager' : 'lazy'}"
                  class="w-full h-full object-cover select-none pointer-events-none"
                />
              </div>
            `).join('');
          }

          const thumbsStrip = document.getElementById('gallery-thumbnails-strip');
          if (thumbsStrip) {
            thumbsStrip.innerHTML = currentGalleryImages.map((img, idx) => `
              <button
                type="button"
                data-slide-index="${idx}"
                data-img="${img}"
                class="thumb-btn flex-shrink-0 w-14 h-14 sm:w-20 sm:h-20 rounded-xl overflow-hidden border-2 transition shadow-sm focus:outline-none cursor-pointer ${idx === 0 ? 'border-amber-800 ring-2 ring-amber-800/30' : 'border-slate-300 hover:border-amber-600/60 opacity-70 hover:opacity-100'}"
              >
                <img src="${img}" alt="Thumbnail ${idx + 1}" width="80" height="80" class="w-full h-full object-cover pointer-events-none" />
              </button>
            `).join('');
            thumbsStrip.className = `flex gap-2.5 sm:gap-4 mt-3 sm:mt-4 overflow-x-auto pb-1 ${currentGalleryImages.length > 1 ? '' : 'hidden'}`;
          }

          const dotsContainer = document.getElementById('slider-dots');
          if (dotsContainer) {
            dotsContainer.innerHTML = currentGalleryImages.map((_, idx) => `
              <button type="button" data-slide-dot="${idx}" class="slider-dot transition-all duration-300 rounded-full cursor-pointer ${idx === 0 ? 'w-5 h-1.5 bg-amber-800' : 'w-2 h-1.5 bg-slate-300 hover:bg-slate-400'}"></button>
            `).join('');
          }

          const controlsWrap = document.getElementById('slider-controls-wrap');
          if (controlsWrap) {
            controlsWrap.className = `flex items-center justify-between mt-3 px-1 ${currentGalleryImages.length > 1 ? '' : 'hidden'}`;
          }

          const previewImg = document.getElementById('room-preview-img');
          if (previewImg && currentGalleryImages[0]) {
            previewImg.src = currentGalleryImages[0];
          }

          attachGalleryEvents();
          goToSlide(0);
        }
      }

      // Prev / Next Chevron Button Listeners
      const prevBtn = document.getElementById('slider-prev-btn');
      const nextBtn = document.getElementById('slider-next-btn');
      if (prevBtn) {
        prevBtn.addEventListener('click', () => goToSlide(currentSlideIndex - 1));
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', () => goToSlide(currentSlideIndex + 1));
      }

      // Touch Swipe Gesture Handling
      const viewport = document.getElementById('product-gallery-viewport');
      let touchStartX = 0;
      let touchEndX = 0;
      if (viewport) {
        viewport.addEventListener('touchstart', (e) => {
          touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });
        viewport.addEventListener('touchend', (e) => {
          touchEndX = e.changedTouches[0].screenX;
          const diff = touchStartX - touchEndX;
          if (Math.abs(diff) > 40) {
            if (diff > 0) {
              goToSlide(currentSlideIndex + 1);
            } else {
              goToSlide(currentSlideIndex - 1);
            }
          }
        }, { passive: true });
      }

      attachGalleryEvents();

      // Color Selection
      document.querySelectorAll('.color-chip-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.color-chip-btn').forEach((b) => {
            b.className = 'color-chip-btn flex items-center gap-2 px-3 py-1.5 rounded-xl border text-xs font-bold transition focus:outline-none cursor-pointer border-slate-200 hover:border-slate-400 bg-slate-50 text-slate-800';
          });
          btn.className = 'color-chip-btn flex items-center gap-2 px-3 py-1.5 rounded-xl border text-xs font-bold transition focus:outline-none cursor-pointer border-amber-800 ring-2 ring-amber-800/30 bg-amber-50/60 text-amber-950';
          selectedColor = btn.getAttribute('data-color') || '';
          const label = document.getElementById('selected-color-label');
          if (label) label.innerText = selectedColor;
          updateGalleryForColor(selectedColor);
        });
      });

      // Size Selection
      document.querySelectorAll('.size-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.size-btn').forEach((b) => {
            b.classList.remove('active-size');
          });
          btn.classList.add('active-size');
          selectedSize = btn.getAttribute('data-size') || '';
          baseSizePrice = parseFloat(btn.getAttribute('data-price') || '0');
          baseSizeOrigPrice = parseFloat(btn.getAttribute('data-original-price') || '0');

          updatePricing();
        });
      });

      // Quantity Handlers
      const minusBtn = document.getElementById('qty-minus-btn');
      const plusBtn = document.getElementById('qty-plus-btn');

      if (minusBtn) {
        minusBtn.addEventListener('click', () => {
          if (quantity > 1) {
            quantity -= 1;
            updateSubtotal();
            updateQuantityButtons();
          }
        });
      }

      if (plusBtn) {
        plusBtn.addEventListener('click', () => {
          if (quantity < 10) {
            quantity += 1;
            updateSubtotal();
            updateQuantityButtons();
          }
        });
      }

      // Add To Cart Handler
      const addCartBtn = document.getElementById('add-cart-btn');
      if (addCartBtn) {
        addCartBtn.addEventListener('click', () => {
          if (typeof window.animatedAddToCart === 'function') {
            const currentImg = currentGalleryImages[0] || (productImages && productImages[0]) || '';
            const finalTitle = `${currentProductName} (${selectedColor ? selectedColor + ', ' : ''}${selectedSize || 'Standard'})`;
            window.animatedAddToCart(addCartBtn, finalTitle, currentProductSlug, unitPrice, currentImg);
          }
        });
      }

      // Direct Buy Now & Instant Checkout Handler
      const orderBtn = document.getElementById('order-btn');
      if (orderBtn) {
        orderBtn.addEventListener('click', () => {
          const currentImg = currentGalleryImages[0] || (productImages && productImages[0]) || '';
          const finalTitle = `${currentProductName} (${selectedColor ? selectedColor + ', ' : ''}${selectedSize || 'Standard'})`;
          
          // Add to cart directly
          let cart = [];
          try {
            cart = JSON.parse(localStorage.getItem('teepul_cart') || '[]');
          } catch (e) {
            cart = [];
          }

          const existingIdx = cart.findIndex((item) => item.slug === currentProductSlug && item.title === finalTitle);
          if (existingIdx > -1) {
            cart[existingIdx].quantity += quantity;
          } else {
            cart.push({
              id: `${currentProductId}-${Date.now()}`,
              slug: currentProductSlug,
              title: finalTitle,
              price: unitPrice,
              image: currentImg,
              quantity: quantity
            });
          }

          localStorage.setItem('teepul_cart', JSON.stringify(cart));
          window.location.href = '/checkout';
        });
      }

      updatePricing();
      updateQuantityButtons();
    });
  </script>
</PublicLayout>
