---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { getStorefrontProducts, normalizeProductSizes } from '../../lib/products';

const { slug } = Astro.params;

const allProducts = await getStorefrontProducts();
const product = allProducts.find((p) => p.slug === slug);

if (!product) {
  return Astro.rewrite('/404');
}

const normalizedSizes = normalizeProductSizes(product.sizes, product.price, product.originalPrice);
const initialSize = normalizedSizes[0] || { name: 'Standard Size', price: product.price, originalPrice: product.originalPrice };
const relatedProducts = allProducts.filter((p) => p.id !== product.id);
---

<PublicLayout
  seo={{
    title: `${product.name} - Official Product Showcase`,
    description: product.description,
    ogImage: product.images?.[0],
    preloadLcpImage: product.images?.[0],
    productData: {
      name: product.name,
      price: product.price,
      currency: product.currency || 'INR',
      sku: product.id,
      inStock: product.inStock,
      rating: product.rating,
      reviewCount: product.reviewCount,
      image: product.images?.[0],
    },
    breadcrumbs: [
      { name: 'Home', url: '/' },
      { name: 'Products', url: '/products' },
      { name: product.name, url: `/products/${product.slug}` },
    ],
  }}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10 pb-28 sm:pb-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-6 sm:mb-8">
      <a href="/" class="hover:text-amber-800 transition">Home</a>
      <span>/</span>
      <a href="/products" class="hover:text-amber-800 transition">Products</a>
      <span>/</span>
      <span class="text-slate-800 font-bold">{product.name}</span>
    </nav>

    <!-- Main Product Card -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-xl overflow-hidden grid grid-cols-1 lg:grid-cols-2 mb-16">
      
      <!-- Gallery Column with Touch-Swipe Slider -->
      <div class="p-6 sm:p-8 bg-slate-50 flex flex-col justify-between border-b lg:border-b-0 lg:border-r border-slate-200 select-none">
        <div
          id="product-gallery-viewport"
          class="relative aspect-square rounded-2xl overflow-hidden shadow-inner bg-slate-200 group touch-pan-y cursor-grab active:cursor-grabbing"
        >
          <!-- Sliding Image Track -->
          <div
            id="product-slider-track"
            class="flex h-full w-full transition-transform duration-300 ease-out will-change-transform"
            style="transform: translateX(0%);"
          >
            {product.images.map((img, idx) => (
              <div class="w-full h-full flex-shrink-0 relative">
                <img
                  src={img}
                  alt={`${product.name} - Official View ${idx + 1}`}
                  class="w-full h-full object-cover select-none pointer-events-none"
                  loading={idx === 0 ? "eager" : "lazy"}
                  fetchpriority={idx === 0 ? "high" : "auto"}
                  decoding={idx === 0 ? "sync" : "async"}
                  width="600"
                  height="600"
                  draggable="false"
                />
              </div>
            ))}
          </div>

          <!-- Product Badges -->
          {product.badge && (
            <span class="absolute top-4 left-4 bg-slate-900/90 text-white text-xs font-black px-3.5 py-1.5 rounded-full uppercase tracking-wider shadow-md backdrop-blur-sm z-10 pointer-events-none">
              {product.badge}
            </span>
          )}
          <span class="absolute bottom-4 left-4 bg-slate-900/80 text-white text-[10px] font-bold px-3 py-1 rounded-full backdrop-blur-sm z-10 pointer-events-none hidden sm:inline-block">
            Heavyweight Thermal Fabric
          </span>

          <!-- Slide Counter Badge (Top Right) -->
          {product.images.length > 1 && (
            <span
              id="slider-counter"
              class="absolute top-4 right-4 bg-slate-900/80 text-white text-[11px] font-black px-2.5 py-1 rounded-full backdrop-blur-sm z-10 pointer-events-none shadow"
            >
              1 / {product.images.length}
            </span>
          )}

          <!-- Previous / Next Navigation Chevron Buttons -->
          {product.images.length > 1 && (
            <>
              <button
                type="button"
                id="slider-prev-btn"
                class="absolute left-2.5 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/90 hover:bg-white active:scale-90 text-slate-800 shadow-lg backdrop-blur-md flex items-center justify-center font-black text-xl transition z-20 border border-slate-200 cursor-pointer select-none"
                aria-label="Previous image"
                title="Previous Image"
              >
                ‹
              </button>
              <button
                type="button"
                id="slider-next-btn"
                class="absolute right-2.5 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/90 hover:bg-white active:scale-90 text-slate-800 shadow-lg backdrop-blur-md flex items-center justify-center font-black text-xl transition z-20 border border-slate-200 cursor-pointer select-none"
                aria-label="Next image"
                title="Next Image"
              >
                ›
              </button>

              <!-- Dot Indicators (Bottom Center) -->
              <div
                id="slider-dots"
                class="absolute bottom-3.5 left-1/2 -translate-x-1/2 flex items-center gap-1.5 z-20 bg-slate-900/50 backdrop-blur-sm px-3 py-1.5 rounded-full"
              >
                {product.images.map((_, idx) => (
                  <button
                    type="button"
                    data-slide-dot={idx}
                    class={`slider-dot transition-all duration-300 rounded-full cursor-pointer ${idx === 0 ? 'w-5 h-2 bg-white' : 'w-2 h-2 bg-white/50 hover:bg-white/80'}`}
                    aria-label={`Go to slide ${idx + 1}`}
                  ></button>
                ))}
              </div>
            </>
          )}
        </div>

        <!-- Thumbnails Strip -->
        {product.images.length > 1 && (
          <div class="flex gap-3 sm:gap-4 mt-6 overflow-x-auto pb-1">
            {product.images.map((img, idx) => (
              <button
                type="button"
                data-slide-index={idx}
                data-img={img}
                class={`thumb-btn flex-shrink-0 w-16 h-16 sm:w-20 sm:h-20 rounded-xl overflow-hidden border-2 transition shadow-sm focus:outline-none cursor-pointer ${idx === 0 ? 'border-amber-800 ring-2 ring-amber-800/30' : 'border-slate-300 hover:border-amber-600/60 opacity-70 hover:opacity-100'}`}
              >
                <img
                  src={img}
                  alt={`View ${product.name} thumbnail slide ${idx + 1}`}
                  width="80"
                  height="80"
                  loading="lazy"
                  class="w-full h-full object-cover pointer-events-none"
                />
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- Detail Info Column -->
      <div class="p-8 lg:p-12 space-y-6 flex flex-col justify-between">
        <div class="space-y-4">
          <div class="flex items-center gap-2">
            <span class="bg-amber-100 text-amber-900 font-extrabold text-xs px-3 py-1 rounded-full uppercase tracking-wider border border-amber-200">
              {product.category}
            </span>
            <span class="bg-emerald-100 text-emerald-800 font-extrabold text-xs px-3 py-1 rounded-full uppercase tracking-wider">
              In Stock & Ready to Ship
            </span>
          </div>

          <h1 class="text-3xl sm:text-4xl font-black text-slate-900 leading-tight">
            {product.name}
          </h1>

          <div class="flex items-center gap-4 text-xs font-semibold">
            <div class="flex items-center gap-1 text-amber-500 text-sm">
              <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
              <span class="text-slate-900 font-bold ml-1">{product.rating}</span>
            </div>
            <span class="text-slate-400">|</span>
            <span class="text-slate-500">{product.reviewCount} Verified Customer Reviews</span>
          </div>

          <div class="bg-amber-50/70 border border-amber-200/80 p-3.5 rounded-2xl flex items-center gap-3 text-xs sm:text-sm font-semibold text-slate-800">
            <span class="text-amber-800 font-bold text-base shrink-0">✨</span>
            <span>{product.tagline || (product.description ? product.description.split('.')[0] + '.' : 'Premium Quality Panipat Curtain')}</span>
          </div>

          <!-- Price Header -->
          <div class="pt-4 pb-2 border-y border-slate-100 flex items-baseline gap-3">
            <span class="text-3xl font-black text-slate-900">{product.currency}<span id="unit-price">{initialSize.price}</span></span>
            <span id="original-price-wrap" class={`text-base text-slate-400 line-through font-semibold ${initialSize.originalPrice && initialSize.originalPrice > initialSize.price ? '' : 'hidden'}`}>
              {product.currency}<span id="original-price">{initialSize.originalPrice || ''}</span>
            </span>
            <span
              id="discount-badge"
              class={`bg-rose-100 text-rose-700 font-bold text-xs px-2.5 py-0.5 rounded-full ml-auto ${initialSize.originalPrice && initialSize.originalPrice > initialSize.price ? '' : 'hidden'}`}
            >
              Save {initialSize.originalPrice ? Math.round(((initialSize.originalPrice - initialSize.price) / initialSize.originalPrice) * 100) : 0}% Today
            </span>
          </div>

          <!-- Color Display -->
          <div class="space-y-2">
            <div class="flex items-center gap-2 text-xs font-bold text-slate-700">
              <span class="uppercase tracking-wider">Color:</span>
              <span id="selected-color-label" class="text-amber-800 font-bold">{product.colors[0]?.name}</span>
            </div>
            <div class="flex flex-wrap gap-3">
              {product.colors.map((c, idx) => (
                <button
                  type="button"
                  data-color={c.name}
                  class={`color-chip-btn flex items-center gap-2 px-3.5 py-2 rounded-xl border text-xs font-bold transition focus:outline-none ${idx === 0 ? 'border-amber-800 ring-2 ring-amber-800/30 bg-amber-50/60 text-amber-950' : 'border-slate-200 hover:border-slate-400 bg-slate-50 text-slate-800'}`}
                >
                  <span class="w-4 h-4 rounded-full border border-slate-400 shadow-inner" style={`background-color: ${c.hex}`}></span>
                  <span>{c.name}</span>
                </button>
              ))}
            </div>
          </div>

          <!-- Size Selector -->
          <div class="space-y-2">
            <div class="flex items-center justify-between text-xs font-bold text-slate-700">
              <span class="uppercase tracking-wider">Select Size / Length</span>
              <span id="selected-size-label" class="text-amber-800 font-semibold">{initialSize.name}</span>
            </div>
            <div class="flex flex-wrap gap-2.5">
              {normalizedSizes.map((sz, idx) => (
                <button
                  type="button"
                  data-size={sz.name}
                  data-price={sz.price}
                  data-original-price={sz.originalPrice || ''}
                  class={`size-btn px-4 py-2.5 min-h-[44px] rounded-xl border-2 font-bold text-xs sm:text-sm transition focus:outline-none whitespace-nowrap cursor-pointer flex items-center gap-1.5 ${idx === 0 ? 'border-slate-900 bg-slate-900 text-white shadow-md' : 'border-slate-200 hover:border-amber-600 hover:bg-amber-50/50 text-slate-800'}`}
                >
                  <span>{sz.name}</span>
                  <span class={`size-badge text-[11px] font-black px-1.5 py-0.5 rounded-md ${idx === 0 ? 'bg-white/20 text-white' : 'bg-slate-100 text-slate-700'}`}>
                    {product.currency}{sz.price.toLocaleString('en-IN')}
                  </span>
                </button>
              ))}
            </div>
          </div>

          <!-- Quantity Selector -->
          <div class="space-y-2 pt-2">
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700">Quantity</label>
            <div class="flex items-center gap-3">
              <div class="flex items-center border-2 border-slate-200 rounded-xl overflow-hidden bg-slate-50">
                <button type="button" id="qty-minus-btn" class="w-11 h-11 min-w-[44px] min-h-[44px] flex items-center justify-center font-bold text-slate-800 hover:bg-slate-200 active:bg-slate-300 transition select-none text-base cursor-pointer" aria-label="Decrease quantity">-</button>
                <span id="qty-display" class="w-12 text-center font-extrabold text-sm text-slate-900 select-none">1</span>
                <button type="button" id="qty-plus-btn" class="w-11 h-11 min-w-[44px] min-h-[44px] flex items-center justify-center font-bold text-slate-800 hover:bg-slate-200 active:bg-slate-300 transition select-none text-base cursor-pointer" aria-label="Increase quantity">+</button>
              </div>
              <span class="text-xs text-slate-500 font-medium">Subtotal: {product.currency}<span id="subtotal-price">{product.price}</span></span>
            </div>
          </div>

          <!-- Technical Specs Card -->
          <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200 text-xs space-y-2 mt-4">
            <div class="font-bold text-slate-900 uppercase tracking-wider text-[10px]">Fabric & Specifications</div>
            <div class="grid grid-cols-2 gap-2 text-slate-600">
              <div>• <strong>Weave:</strong> Heavyweight Thermal</div>
              <div>• <strong>Material:</strong> {product.fabricSpecs.material}</div>
              <div>• <strong>Fit:</strong> {product.fabricSpecs.fit}</div>
              <div>• <strong>Care:</strong> {product.fabricSpecs.care}</div>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="pt-6 border-t border-slate-100 space-y-3">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <button
              type="button"
              id="add-cart-btn"
              class="bg-amber-100 hover:bg-amber-200 active:scale-95 text-amber-950 font-black text-xs sm:text-sm py-4 rounded-2xl border border-amber-300 shadow-sm hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>🛒 Add to Cart</span>
            </button>

            <button
              type="button"
              id="order-btn"
              class="bg-amber-800 hover:bg-amber-900 active:scale-95 text-white font-black text-xs sm:text-sm py-4 rounded-2xl shadow-lg shadow-amber-900/30 hover:shadow-amber-900/50 hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>⚡ Buy Now & Checkout</span>
            </button>
          </div>

          <button
            type="button"
            id="whatsapp-direct-btn"
            class="w-full bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-white font-black text-xs sm:text-sm py-3.5 rounded-2xl shadow-md shadow-emerald-600/20 hover:shadow-emerald-600/40 hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2 cursor-pointer"
          >
            <span>💬 Order via WhatsApp</span>
          </button>
          
          <div class="flex items-center justify-center gap-6 text-[11px] text-slate-500 font-semibold pt-1">
            <span>🔒 SSL Encrypted</span>
            <span>⚡ 7-Day Replacement</span>
            <span>🚚 Free Express Shipping</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Authentic Panipat Manufacturing Unit Trust Banner -->
    <div class="bg-gradient-to-r from-amber-950 via-slate-900 to-amber-900 text-white p-6 sm:p-8 rounded-3xl border border-amber-500/20 shadow-xl grid grid-cols-1 md:grid-cols-12 gap-6 items-center my-8">
      <div class="md:col-span-5 relative">
        <div class="rounded-2xl overflow-hidden border border-amber-400/30 shadow-lg aspect-[16/10] group">
          <img
            src="/panipat-factory-unit.jpg"
            alt="Teepul Panipat Curtain Manufacturing Unit - Ashank Ecommerce Private Limited"
            width="640"
            height="400"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
        </div>
      </div>

      <div class="md:col-span-7 space-y-3 text-left">
        <div class="inline-flex items-center gap-2 bg-amber-500/20 border border-amber-400/30 text-amber-300 text-[10px] font-black px-3 py-1 rounded-full uppercase tracking-wider">
          <span>🇮🇳 100% MADE IN PANIPAT</span>
          <span>•</span>
          <span>ASHANK ECOMMERCE PVT LTD</span>
        </div>

        <h3 class="text-xl sm:text-2xl font-black text-white leading-tight">
          Handcrafted in Our Panipat Manufacturing Unit
        </h3>

        <p class="text-xs text-slate-300 leading-relaxed font-normal">
          This curtain panel is directly woven, double-stitched, and eyelet-fitted by skilled women artisans at our Panipat factory (Sector 25, HSIIDC Industrial Area). No middlemen — 100% genuine factory direct quality.
        </p>

        <div class="grid grid-cols-3 gap-2 pt-1 text-[10px] text-slate-200 font-semibold">
          <div class="bg-white/10 px-2.5 py-1.5 rounded-lg border border-white/10 text-center">
            👩‍🏭 Women Artisans
          </div>
          <div class="bg-white/10 px-2.5 py-1.5 rounded-lg border border-white/10 text-center">
            ⚡ JUKI Machinery
          </div>
          <div class="bg-white/10 px-2.5 py-1.5 rounded-lg border border-white/10 text-center">
            ✨ QC Verified
          </div>
        </div>
      </div>
    </div>

    <!-- Full Product Description & Specifications Section -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-md p-6 sm:p-10 space-y-8 my-8">
      <div class="border-b border-slate-100 pb-4 flex items-center justify-between flex-wrap gap-4">
        <div>
          <span class="text-[10px] font-black uppercase tracking-widest text-amber-900 bg-amber-50 border border-amber-200 px-3 py-1 rounded-full">Complete Overview</span>
          <h2 class="text-2xl font-black text-slate-900 mt-1">Product Details & Features</h2>
        </div>
        <div class="flex items-center gap-3 text-xs font-bold text-slate-500">
          <span class="bg-emerald-50 text-emerald-700 px-3 py-1 rounded-lg border border-emerald-200">📦 Direct Factory Shipping</span>
          <span class="bg-amber-50 text-amber-700 px-3 py-1 rounded-lg border border-amber-200">🛡️ 100% Inspected Quality</span>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Left: Formatted Description Paragraphs & Highlights -->
        <div class="lg:col-span-8 space-y-6 text-slate-700 text-sm leading-relaxed">
          {product.description ? (
            <div class="space-y-4">
              {product.description.split('\n\n').map((paragraph) => {
                const trimmed = paragraph.trim();
                if (!trimmed) return null;
                
                // If it looks like bullet points or key features list
                if (trimmed.startsWith('✔') || trimmed.startsWith('•') || trimmed.includes('\n•') || trimmed.includes('\n✔')) {
                  const lines = trimmed.split('\n').map(l => l.trim()).filter(Boolean);
                  return (
                    <div class="bg-slate-50 p-5 rounded-2xl border border-slate-200/80 my-4 space-y-2">
                      {lines.map((line) => (
                        <div class="flex items-start gap-2.5 text-xs sm:text-sm font-medium text-slate-800">
                          <span class="text-emerald-600 font-bold shrink-0">✓</span>
                          <span>{line.replace(/^[✔•\s\-\u2714]+/, '')}</span>
                        </div>
                      ))}
                    </div>
                  );
                }
                
                return <p class="text-slate-600 text-sm sm:text-base leading-relaxed">{trimmed}</p>;
              })}
            </div>
          ) : (
            <p class="text-slate-600 text-sm leading-relaxed">
              Crafted in our Panipat manufacturing unit, this curtain panel combines heavyweight thermal fabric with precision eyelet stitching to deliver superior light blocking, thermal regulation, and seamless interior aesthetic.
            </p>
          )}

          <!-- Highlights Grid -->
          {product.features && product.features.length > 0 && (
            <div class="pt-4 space-y-3 border-t border-slate-100">
              <h3 class="font-extrabold text-xs text-slate-900 uppercase tracking-widest">Key Performance Highlights</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {product.features.map((feat) => (
                  <div class="flex items-center gap-3 bg-blue-50/60 border border-blue-100 p-3 rounded-xl text-xs font-bold text-blue-950">
                    <span class="w-6 h-6 rounded-full bg-blue-600 text-white flex items-center justify-center text-[10px] shrink-0 font-black">✓</span>
                    <span>{feat}</span>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        <!-- Right: Technical Specifications Box -->
        <div class="lg:col-span-4 space-y-4">
          <div class="bg-slate-900 text-white p-6 rounded-2xl shadow-xl space-y-4 border border-slate-800">
            <h3 class="font-extrabold text-xs text-amber-400 uppercase tracking-widest flex items-center gap-2">
              <span>🧵</span> Fabric Specifications
            </h3>
            
            <div class="space-y-3 text-xs divide-y divide-slate-800">
              <div class="pt-2 flex justify-between items-center">
                <span class="text-slate-400 font-medium">Fabric Type</span>
                <span class="font-bold text-white bg-slate-800 px-2.5 py-1 rounded-md">Heavyweight Polyester</span>
              </div>
              <div class="pt-3 flex justify-between items-center">
                <span class="text-slate-400 font-medium">Material</span>
                <span class="font-bold text-white text-right">100% Premium Polyester</span>
              </div>
              <div class="pt-3 flex justify-between items-center">
                <span class="text-slate-400 font-medium">Fitting Style</span>
                <span class="font-bold text-white text-right">{product.fabricSpecs?.fit || 'Silver Eyelet Grommets'}</span>
              </div>
              <div class="pt-3 flex justify-between items-center">
                <span class="text-slate-400 font-medium">Care</span>
                <span class="font-bold text-white text-right">{product.fabricSpecs?.care || 'Hand & Machine Wash Cold'}</span>
              </div>
              <div class="pt-3 flex justify-between items-center">
                <span class="text-slate-400 font-medium">Origin</span>
                <span class="font-black text-amber-300">Panipat, Haryana (India)</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Related Products -->
    {relatedProducts.length > 0 && (
      <div class="space-y-6">
        <h3 class="text-2xl font-black text-slate-900">Recommended Next</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {relatedProducts.map((rel) => (
            <a href={`/products/${rel.slug}`} class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition flex items-center gap-6 group">
              <img
                src={rel.images[0]}
                alt={`View related product ${rel.name}`}
                width="96"
                height="96"
                loading="lazy"
                class="w-24 h-24 rounded-xl object-cover"
              />
              <div>
                <span class="text-[10px] font-bold uppercase text-amber-900 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded">{rel.category}</span>
                <h4 class="font-bold text-base text-slate-900 group-hover:text-amber-800 transition mt-1">{rel.name}</h4>
                <p class="text-xs text-slate-500 line-clamp-1 mt-0.5">{rel.tagline}</p>
                <div class="font-black text-sm text-slate-900 mt-2">{rel.currency}{rel.price}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>

  <!-- Interactive Order Toast / Modal Overlay -->
  <div id="order-toast" class="fixed bottom-6 right-6 z-50 max-w-md bg-slate-900 text-white p-6 rounded-3xl shadow-2xl border border-slate-700 hidden transform transition-all duration-300">
    <div class="flex items-start justify-between gap-4">
      <div class="space-y-2">
        <div class="flex items-center gap-2">
          <span class="bg-emerald-500 text-white text-[10px] font-extrabold px-2.5 py-0.5 rounded-full uppercase">Ready to Checkout</span>
          <span class="text-xs text-slate-400 font-semibold">Teepul Express</span>
        </div>
        <h4 class="font-extrabold text-sm text-white">{product.name}</h4>
        <div class="text-xs text-slate-300 space-y-0.5 font-medium">
          <div>Color: <span id="toast-color" class="font-bold text-amber-400"></span></div>
          <div>Size: <span id="toast-size" class="font-bold text-amber-400"></span></div>
          <div>Quantity: <span id="toast-qty" class="font-bold text-amber-400"></span></div>
          <div>Total Price: <span id="toast-price" class="font-black text-emerald-400"></span></div>
        </div>
      </div>
      <button type="button" id="close-toast-btn" class="text-slate-400 hover:text-white font-bold text-lg">&times;</button>
    </div>
    <div class="mt-4 pt-3 border-t border-slate-800 flex gap-2">
      <a id="toast-checkout-link" href="/checkout" class="w-full bg-amber-800 hover:bg-amber-700 text-center font-bold text-xs py-3 rounded-xl transition shadow-lg">
        Proceed to Checkout &rarr;
      </a>
    </div>
  </div>

  <script is:inline define:vars={{ currentProductSlug: product.slug, currentProductName: product.name, productImages: product.images || [] }}>
    document.addEventListener('DOMContentLoaded', () => {
      let selectedColor = document.querySelector('.color-chip-btn')?.getAttribute('data-color') || '';
      let selectedSize = document.querySelector('.size-btn.bg-slate-900')?.getAttribute('data-size') || '';
      let quantity = 1;
      let unitPrice = parseFloat(document.getElementById('unit-price')?.innerText || '0');
      let currentSlideIndex = 0;
      const totalSlides = Array.isArray(productImages) ? productImages.length : 1;

      // Update subtotal price
      function updateSubtotal() {
        const subtotal = unitPrice * quantity;
        const subtotalEl = document.getElementById('subtotal-price');
        const qtyDisplay = document.getElementById('qty-display');
        if (subtotalEl) subtotalEl.innerText = subtotal.toLocaleString('en-IN');
        if (qtyDisplay) qtyDisplay.innerText = quantity;
      }

      // Smooth Sliding Gallery Logic
      const track = document.getElementById('product-slider-track');
      const counter = document.getElementById('slider-counter');
      const dots = document.querySelectorAll('.slider-dot');
      const thumbs = document.querySelectorAll('.thumb-btn');

      function goToSlide(index) {
        if (totalSlides <= 0) return;
        currentSlideIndex = (index + totalSlides) % totalSlides;
        if (track) {
          track.style.transform = 'translateX(-' + (currentSlideIndex * 100) + '%)';
        }
        if (counter) {
          counter.innerText = (currentSlideIndex + 1) + ' / ' + totalSlides;
        }
        // Sync Dots
        dots.forEach((dot, idx) => {
          if (idx === currentSlideIndex) {
            dot.className = 'slider-dot transition-all duration-300 rounded-full cursor-pointer w-5 h-2 bg-white';
          } else {
            dot.className = 'slider-dot transition-all duration-300 rounded-full cursor-pointer w-2 h-2 bg-white/50 hover:bg-white/80';
          }
        });
        // Sync Thumbnails
        thumbs.forEach((thumb, idx) => {
          if (idx === currentSlideIndex) {
            thumb.classList.remove('border-slate-300', 'opacity-70');
            thumb.classList.add('border-amber-800', 'ring-2', 'ring-amber-800/30', 'opacity-100');
            if (typeof thumb.scrollIntoView === 'function') {
              thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            }
          } else {
            thumb.classList.remove('border-amber-800', 'ring-2', 'ring-amber-800/30', 'opacity-100');
            thumb.classList.add('border-slate-300', 'opacity-70');
          }
        });
      }

      // Next / Prev Button Listeners
      document.getElementById('slider-prev-btn')?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        goToSlide(currentSlideIndex - 1);
      });

      document.getElementById('slider-next-btn')?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        goToSlide(currentSlideIndex + 1);
      });

      // Thumbnail Click Handlers
      thumbs.forEach((btn) => {
        btn.addEventListener('click', () => {
          const slideIdx = parseInt(btn.getAttribute('data-slide-index') || '0', 10);
          goToSlide(slideIdx);
        });
      });

      // Dot Click Handlers
      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const slideIdx = parseInt(dot.getAttribute('data-slide-dot') || '0', 10);
          goToSlide(slideIdx);
        });
      });

      // Touch Swipe Gesture Support (Mobile)
      const viewport = document.getElementById('product-gallery-viewport');
      if (viewport && totalSlides > 1) {
        let touchStartX = 0;
        let touchStartY = 0;
        let isSwiping = false;

        viewport.addEventListener('touchstart', (e) => {
          touchStartX = e.touches[0].clientX;
          touchStartY = e.touches[0].clientY;
          isSwiping = true;
        }, { passive: true });

        viewport.addEventListener('touchmove', (e) => {
          if (!isSwiping) return;
          const diffX = e.touches[0].clientX - touchStartX;
          const diffY = e.touches[0].clientY - touchStartY;
          if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 10) {
            if (e.cancelable) e.preventDefault();
          }
        }, { passive: false });

        viewport.addEventListener('touchend', (e) => {
          if (!isSwiping) return;
          isSwiping = false;
          const touchEndX = e.changedTouches[0].clientX;
          const diffX = touchEndX - touchStartX;
          const threshold = 35;
          if (diffX < -threshold) {
            goToSlide(currentSlideIndex + 1);
          } else if (diffX > threshold) {
            goToSlide(currentSlideIndex - 1);
          }
        }, { passive: true });

        // Desktop Mouse Drag Support
        let isMouseDown = false;
        let mouseStartX = 0;

        viewport.addEventListener('mousedown', (e) => {
          if (e.target && e.target.closest && e.target.closest('button')) return;
          isMouseDown = true;
          mouseStartX = e.clientX;
        });

        window.addEventListener('mouseup', (e) => {
          if (!isMouseDown) return;
          isMouseDown = false;
          const diffX = e.clientX - mouseStartX;
          if (diffX < -40) {
            goToSlide(currentSlideIndex + 1);
          } else if (diffX > 40) {
            goToSlide(currentSlideIndex - 1);
          }
        });
      }

      // Color Chip Click Handlers
      document.querySelectorAll('.color-chip-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          selectedColor = btn.getAttribute('data-color') || '';
          const label = document.getElementById('selected-color-label');
          if (label) label.innerText = selectedColor;

          document.querySelectorAll('.color-chip-btn').forEach((b) => {
            b.classList.remove('border-amber-800', 'ring-2', 'ring-amber-800/30', 'bg-amber-50/60', 'text-amber-950');
            b.classList.add('border-slate-200', 'bg-slate-50', 'text-slate-800');
          });
          btn.classList.remove('border-slate-200', 'bg-slate-50', 'text-slate-800');
          btn.classList.add('border-amber-800', 'ring-2', 'ring-amber-800/30', 'bg-amber-50/60', 'text-amber-950');
        });
      });

      // Size Button Click Handlers - Dynamic Size Pricing Update
      document.querySelectorAll('.size-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          selectedSize = btn.getAttribute('data-size') || '';
          const label = document.getElementById('selected-size-label');
          if (label) label.innerText = selectedSize;

          const sizePriceAttr = btn.getAttribute('data-price');
          const sizeOrigPriceAttr = btn.getAttribute('data-original-price');

          if (sizePriceAttr) {
            const newPrice = parseFloat(sizePriceAttr);
            if (!isNaN(newPrice)) {
              unitPrice = newPrice;
              const unitPriceEl = document.getElementById('unit-price');
              if (unitPriceEl) unitPriceEl.innerText = newPrice.toLocaleString('en-IN');

              const origPriceEl = document.getElementById('original-price');
              const origWrapEl = document.getElementById('original-price-wrap');
              const discountBadgeEl = document.getElementById('discount-badge');

              if (sizeOrigPriceAttr && parseFloat(sizeOrigPriceAttr) > newPrice) {
                const newOrig = parseFloat(sizeOrigPriceAttr);
                if (origPriceEl) origPriceEl.innerText = newOrig.toLocaleString('en-IN');
                if (origWrapEl) origWrapEl.classList.remove('hidden');
                if (discountBadgeEl) {
                  const savePercent = Math.round(((newOrig - newPrice) / newOrig) * 100);
                  discountBadgeEl.innerText = `Save ${savePercent}% Today`;
                  discountBadgeEl.classList.remove('hidden');
                }
              } else {
                if (origWrapEl) origWrapEl.classList.add('hidden');
                if (discountBadgeEl) discountBadgeEl.classList.add('hidden');
              }

              updateSubtotal();
            }
          }

          document.querySelectorAll('.size-btn').forEach((b) => {
            b.classList.remove('border-slate-900', 'bg-slate-900', 'text-white', 'shadow-md');
            b.classList.add('border-slate-200', 'text-slate-800');
            const priceBadge = b.querySelector('.size-badge');
            if (priceBadge) {
              priceBadge.className = 'size-badge text-[11px] font-black px-1.5 py-0.5 rounded-md bg-slate-100 text-slate-700';
            }
          });

          btn.classList.remove('border-slate-200', 'text-slate-800');
          btn.classList.add('border-slate-900', 'bg-slate-900', 'text-white', 'shadow-md');
          const activeBadge = btn.querySelector('.size-badge');
          if (activeBadge) {
            activeBadge.className = 'size-badge text-[11px] font-black px-1.5 py-0.5 rounded-md bg-white/20 text-white';
          }
        });
      });

      // Quantity Plus & Minus
      document.getElementById('qty-minus-btn')?.addEventListener('click', () => {
        if (quantity > 1) {
          quantity--;
          updateSubtotal();
        }
      });

      document.getElementById('qty-plus-btn')?.addEventListener('click', () => {
        quantity++;
        updateSubtotal();
      });

      // Add to Cart Click Handler - Opens Right Slide-over Cart Drawer
      document.getElementById('add-cart-btn')?.addEventListener('click', () => {
        if (typeof window.quickAddToCart === 'function') {
          const currentImg = (productImages && productImages[currentSlideIndex]) || productImages[0] || '';
          window.quickAddToCart(
            currentProductName,
            currentProductSlug,
            unitPrice,
            currentImg,
            selectedSize,
            selectedColor,
            quantity
          );
        }
      });

      // Order / Buy Now Click Handler
      document.getElementById('order-btn')?.addEventListener('click', () => {
        const checkoutUrl = `/checkout?product=${encodeURIComponent(currentProductSlug)}&color=${encodeURIComponent(selectedColor)}&size=${encodeURIComponent(selectedSize)}&price=${unitPrice}&qty=${quantity}`;
        window.location.href = checkoutUrl;
      });

      // WhatsApp Direct Order Handler
      document.getElementById('whatsapp-direct-btn')?.addEventListener('click', () => {
        const msg = `Hi Teepul Store! I want to order:\n\n*Product:* ${currentProductName}\n*Color:* ${selectedColor}\n*Size:* ${selectedSize}\n*Quantity:* ${quantity}\n*Price:* ₹${(unitPrice * quantity).toLocaleString('en-IN')}`;
        window.open(`https://wa.me/919876543210?text=${encodeURIComponent(msg)}`, '_blank');
      });

      // Sticky Mobile Bar Handlers
      document.getElementById('mobile-sticky-add-btn')?.addEventListener('click', () => {
        document.getElementById('add-cart-btn')?.click();
      });

      document.getElementById('mobile-sticky-buy-btn')?.addEventListener('click', () => {
        document.getElementById('order-btn')?.click();
      });

      // Update mobile sticky bar on size change
      const updateMobileStickyInfo = () => {
        const stickyPrice = document.getElementById('mobile-sticky-price');
        if (stickyPrice) stickyPrice.innerText = unitPrice.toLocaleString('en-IN');
        const stickySize = document.getElementById('mobile-sticky-size');
        if (stickySize) stickySize.innerText = selectedSize;
      };

      document.querySelectorAll('.size-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          setTimeout(updateMobileStickyInfo, 50);
        });
      });
    });
  </script>

  <!-- Sticky Mobile Action Bar (80% Mobile E-commerce Users) -->
  <div class="sm:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-xl border-t border-slate-200 p-2.5 shadow-[0_-4px_25px_rgba(0,0,0,0.12)] flex items-center justify-between gap-2.5" style="padding-bottom: max(0.625rem, env(safe-area-inset-bottom));">
    <!-- Left: Dynamic Price & Size Preview -->
    <div class="pl-1.5 leading-tight shrink-0">
      <div class="flex items-baseline gap-1">
        <span class="text-xs font-bold text-slate-500">{product.currency}</span>
        <span id="mobile-sticky-price" class="text-lg font-black text-slate-950">{initialSize.price.toLocaleString('en-IN')}</span>
      </div>
      <div class="flex items-center gap-1 text-[10px] font-bold text-slate-500">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block"></span>
        <span id="mobile-sticky-size" class="truncate max-w-[90px]">{initialSize.name}</span>
      </div>
    </div>

    <!-- Right: Action Buttons -->
    <div class="flex items-center gap-2 flex-1 justify-end">
      <button
        type="button"
        id="mobile-sticky-add-btn"
        class="bg-amber-100 hover:bg-amber-200 active:scale-95 text-amber-950 font-black text-xs py-3 px-3.5 rounded-xl transition border border-amber-300/80 shadow-sm flex items-center gap-1.5 cursor-pointer shrink-0"
        title="Add to Cart"
      >
        <span>🛒</span>
        <span>Cart</span>
      </button>

      <button
        type="button"
        id="mobile-sticky-buy-btn"
        class="bg-amber-800 hover:bg-amber-900 active:scale-95 text-white font-black text-xs py-3 px-4 rounded-xl shadow-lg shadow-amber-900/30 transition flex items-center justify-center gap-1 cursor-pointer flex-1"
        title="Buy Now Directly"
      >
        <span>⚡ Buy Now</span>
      </button>
    </div>
  </div>
</PublicLayout>
