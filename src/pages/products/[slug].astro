---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { PRODUCTS_CATALOG } from '../../lib/products';

const { slug } = Astro.params;

const product = PRODUCTS_CATALOG.find((p) => p.slug === slug);

if (!product) {
  return Astro.redirect('/products');
}

const relatedProducts = PRODUCTS_CATALOG.filter((p) => p.id !== product.id);
---

<PublicLayout
  seo={{
    title: `${product.name} - Official Product Showcase`,
    description: product.description,
    breadcrumbs: [
      { name: 'Home', url: '/' },
      { name: 'Products', url: '/products' },
      { name: product.name, url: `/products/${product.slug}` },
    ],
  }}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs font-semibold text-slate-400 mb-8">
      <a href="/" class="hover:text-blue-600 transition">Home</a>
      <span>/</span>
      <a href="/products" class="hover:text-blue-600 transition">Products</a>
      <span>/</span>
      <span class="text-slate-800 font-bold">{product.name}</span>
    </nav>

    <!-- Main Product Card -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-xl overflow-hidden grid grid-cols-1 lg:grid-cols-2 mb-16">
      
      <!-- Gallery Column -->
      <div class="p-8 bg-slate-50 flex flex-col justify-between border-b lg:border-b-0 lg:border-r border-slate-200">
        <div class="relative aspect-square rounded-2xl overflow-hidden shadow-inner bg-slate-200 group">
          <img
            id="main-product-img"
            src={product.images[0]}
            alt={product.name}
            class="w-full h-full object-cover transition-all duration-300"
          />
          {product.badge && (
            <span class="absolute top-4 left-4 bg-slate-900/90 text-white text-xs font-black px-3.5 py-1.5 rounded-full uppercase tracking-wider shadow-md backdrop-blur-sm">
              {product.badge}
            </span>
          )}
          <span class="absolute bottom-4 left-4 bg-slate-900/80 text-white text-[10px] font-bold px-3 py-1 rounded-full backdrop-blur-sm">
            {product.fabricSpecs.gsm} GSM Heavyweight Cotton
          </span>
        </div>

        <!-- Thumbnails -->
        {product.images.length > 1 && (
          <div class="flex gap-4 mt-6">
            {product.images.map((img, idx) => (
              <button
                type="button"
                data-img={img}
                class={`thumb-btn w-20 h-20 rounded-xl overflow-hidden border-2 transition shadow-sm focus:outline-none ${idx === 0 ? 'border-blue-600 ring-2 ring-blue-600/30' : 'border-slate-300 hover:border-blue-400'}`}
              >
                <img src={img} alt={`Thumbnail ${idx + 1}`} class="w-full h-full object-cover" />
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- Detail Info Column -->
      <div class="p-8 lg:p-12 space-y-6 flex flex-col justify-between">
        <div class="space-y-4">
          <div class="flex items-center gap-2">
            <span class="bg-blue-100 text-blue-800 font-extrabold text-xs px-3 py-1 rounded-full uppercase tracking-wider">
              {product.category}
            </span>
            <span class="bg-emerald-100 text-emerald-800 font-extrabold text-xs px-3 py-1 rounded-full uppercase tracking-wider">
              In Stock & Ready to Ship
            </span>
          </div>

          <h1 class="text-3xl sm:text-4xl font-black text-slate-900 leading-tight">
            {product.name}
          </h1>

          <div class="flex items-center gap-4 text-xs font-semibold">
            <div class="flex items-center gap-1 text-amber-500 text-sm">
              <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
              <span class="text-slate-900 font-bold ml-1">{product.rating}</span>
            </div>
            <span class="text-slate-400">|</span>
            <span class="text-slate-500">{product.reviewCount} Verified Customer Reviews</span>
          </div>

          <p class="text-slate-600 text-sm leading-relaxed">
            {product.description}
          </p>

          <!-- Price Header -->
          <div class="pt-4 pb-2 border-y border-slate-100 flex items-baseline gap-3">
            <span class="text-3xl font-black text-slate-900">{product.currency}<span id="unit-price">{product.price}</span></span>
            {product.originalPrice && (
              <span class="text-base text-slate-400 line-through font-semibold">{product.currency}{product.originalPrice}</span>
            )}
            <span class="bg-rose-100 text-rose-700 font-bold text-xs px-2.5 py-0.5 rounded-full ml-auto">
              Save {Math.round(((product.originalPrice! - product.price) / product.originalPrice!) * 100)}% Today
            </span>
          </div>

          <!-- Color Selector -->
          <div class="space-y-2">
            <div class="flex items-center justify-between text-xs font-bold text-slate-700">
              <span class="uppercase tracking-wider">Select Color</span>
              <span id="selected-color-label" class="text-blue-600 font-semibold">{product.colors[0].name}</span>
            </div>
            <div class="flex flex-wrap gap-3">
              {product.colors.map((c, idx) => (
                <button
                  type="button"
                  data-color={c.name}
                  class={`color-chip-btn flex items-center gap-2 px-3.5 py-2 rounded-xl border text-xs font-bold transition focus:outline-none ${idx === 0 ? 'border-blue-600 ring-2 ring-blue-600/30 bg-blue-50/60 text-blue-900' : 'border-slate-200 hover:border-slate-400 bg-slate-50 text-slate-800'}`}
                >
                  <span class="w-4 h-4 rounded-full border border-slate-400 shadow-inner" style={`background-color: ${c.hex}`}></span>
                  <span>{c.name}</span>
                </button>
              ))}
            </div>
          </div>

          <!-- Size Selector -->
          <div class="space-y-2">
            <div class="flex items-center justify-between text-xs font-bold text-slate-700">
              <span class="uppercase tracking-wider">Select Size (Oversized Fit)</span>
              <span id="selected-size-label" class="text-blue-600 font-semibold">{product.sizes[1] || product.sizes[0]}</span>
            </div>
            <div class="flex flex-wrap gap-2.5">
              {product.sizes.map((sz, idx) => (
                <button
                  type="button"
                  data-size={sz}
                  class={`size-btn w-12 h-11 rounded-xl border-2 font-black text-xs transition focus:outline-none ${idx === 1 ? 'border-slate-900 bg-slate-900 text-white shadow-md' : 'border-slate-200 hover:border-blue-500 hover:bg-blue-50 text-slate-800'}`}
                >
                  {sz}
                </button>
              ))}
            </div>
          </div>

          <!-- Quantity Selector -->
          <div class="space-y-2 pt-2">
            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700">Quantity</label>
            <div class="flex items-center gap-3">
              <div class="flex items-center border-2 border-slate-200 rounded-xl overflow-hidden bg-slate-50">
                <button type="button" id="qty-minus-btn" class="w-10 h-10 flex items-center justify-center font-bold text-slate-700 hover:bg-slate-200 transition">-</button>
                <span id="qty-display" class="w-12 text-center font-extrabold text-sm text-slate-900">1</span>
                <button type="button" id="qty-plus-btn" class="w-10 h-10 flex items-center justify-center font-bold text-slate-700 hover:bg-slate-200 transition">+</button>
              </div>
              <span class="text-xs text-slate-500 font-medium">Subtotal: {product.currency}<span id="subtotal-price">{product.price}</span></span>
            </div>
          </div>

          <!-- Technical Specs Card -->
          <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200 text-xs space-y-2 mt-4">
            <div class="font-bold text-slate-900 uppercase tracking-wider text-[10px]">Fabric & Specifications</div>
            <div class="grid grid-cols-2 gap-2 text-slate-600">
              <div>• <strong>GSM:</strong> {product.fabricSpecs.gsm} GSM</div>
              <div>• <strong>Material:</strong> {product.fabricSpecs.material}</div>
              <div>• <strong>Fit:</strong> {product.fabricSpecs.fit}</div>
              <div>• <strong>Care:</strong> {product.fabricSpecs.care}</div>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="pt-6 border-t border-slate-100 space-y-3">
          <button
            type="button"
            id="order-btn"
            class="w-full bg-blue-600 hover:bg-blue-500 text-white font-black text-sm py-4 rounded-2xl shadow-lg shadow-blue-500/30 hover:shadow-blue-500/50 hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2"
          >
            <span>🛍️ Add to Cart / Order Now</span>
          </button>
          
          <div class="flex items-center justify-center gap-6 text-[11px] text-slate-500 font-semibold pt-1">
            <span>🔒 Secure Checkout</span>
            <span>⚡ 7-Day Replacement</span>
            <span>🚚 Free Express Shipping</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Related Products -->
    {relatedProducts.length > 0 && (
      <div class="space-y-6">
        <h3 class="text-2xl font-black text-slate-900">Recommended Next</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {relatedProducts.map((rel) => (
            <a href={`/products/${rel.slug}`} class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition flex items-center gap-6 group">
              <img src={rel.images[0]} alt={rel.name} class="w-24 h-24 rounded-xl object-cover" />
              <div>
                <span class="text-[10px] font-bold uppercase text-blue-600 bg-blue-50 px-2 py-0.5 rounded">{rel.category}</span>
                <h4 class="font-bold text-base text-slate-900 group-hover:text-blue-600 transition mt-1">{rel.name}</h4>
                <p class="text-xs text-slate-500 line-clamp-1 mt-0.5">{rel.tagline}</p>
                <div class="font-black text-sm text-slate-900 mt-2">{rel.currency}{rel.price}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>

  <!-- Interactive Order Toast / Modal Overlay -->
  <div id="order-toast" class="fixed bottom-6 right-6 z-50 max-w-md bg-slate-900 text-white p-6 rounded-3xl shadow-2xl border border-slate-700 hidden transform transition-all duration-300">
    <div class="flex items-start justify-between gap-4">
      <div class="space-y-2">
        <div class="flex items-center gap-2">
          <span class="bg-emerald-500 text-white text-[10px] font-extrabold px-2.5 py-0.5 rounded-full uppercase">Item Added</span>
          <span class="text-xs text-slate-400 font-semibold">Shopping Cart</span>
        </div>
        <h4 class="font-extrabold text-sm text-white">{product.name}</h4>
        <div class="text-xs text-slate-300 space-y-0.5 font-medium">
          <div>Color: <span id="toast-color" class="font-bold text-blue-400"></span></div>
          <div>Size: <span id="toast-size" class="font-bold text-blue-400"></span></div>
          <div>Quantity: <span id="toast-qty" class="font-bold text-blue-400"></span></div>
          <div>Total Price: <span id="toast-price" class="font-black text-emerald-400"></span></div>
        </div>
      </div>
      <button type="button" id="close-toast-btn" class="text-slate-400 hover:text-white font-bold text-lg">&times;</button>
    </div>
    <div class="mt-4 pt-3 border-t border-slate-800 flex gap-2">
      <a href="/admin/login" class="w-full bg-blue-600 hover:bg-blue-500 text-center font-bold text-xs py-2.5 rounded-xl transition">
        Proceed to Checkout &rarr;
      </a>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      let selectedColor = document.querySelector('.color-chip-btn')?.getAttribute('data-color') || '';
      let selectedSize = document.querySelector('.size-btn.bg-slate-900')?.getAttribute('data-size') || 'M';
      let quantity = 1;
      const unitPrice = parseFloat(document.getElementById('unit-price')?.innerText || '0');

      // Update subtotal price
      function updateSubtotal() {
        const subtotal = unitPrice * quantity;
        const subtotalEl = document.getElementById('subtotal-price');
        const qtyDisplay = document.getElementById('qty-display');
        if (subtotalEl) subtotalEl.innerText = subtotal.toLocaleString();
        if (qtyDisplay) qtyDisplay.innerText = quantity;
      }

      // Thumbnail Click Handlers
      document.querySelectorAll('.thumb-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const imgSrc = btn.getAttribute('data-img');
          const mainImg = document.getElementById('main-product-img');
          if (mainImg && imgSrc) mainImg.src = imgSrc;

          document.querySelectorAll('.thumb-btn').forEach((b) => {
            b.classList.remove('border-blue-600', 'ring-2', 'ring-blue-600/30');
            b.classList.add('border-slate-300');
          });
          btn.classList.remove('border-slate-300');
          btn.classList.add('border-blue-600', 'ring-2', 'ring-blue-600/30');
        });
      });

      // Color Chip Click Handlers
      document.querySelectorAll('.color-chip-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          selectedColor = btn.getAttribute('data-color') || '';
          const label = document.getElementById('selected-color-label');
          if (label) label.innerText = selectedColor;

          document.querySelectorAll('.color-chip-btn').forEach((b) => {
            b.classList.remove('border-blue-600', 'ring-2', 'ring-blue-600/30', 'bg-blue-50/60', 'text-blue-900');
            b.classList.add('border-slate-200', 'bg-slate-50', 'text-slate-800');
          });
          btn.classList.remove('border-slate-200', 'bg-slate-50', 'text-slate-800');
          btn.classList.add('border-blue-600', 'ring-2', 'ring-blue-600/30', 'bg-blue-50/60', 'text-blue-900');
        });
      });

      // Size Button Click Handlers
      document.querySelectorAll('.size-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          selectedSize = btn.getAttribute('data-size') || '';
          const label = document.getElementById('selected-size-label');
          if (label) label.innerText = selectedSize;

          document.querySelectorAll('.size-btn').forEach((b) => {
            b.classList.remove('border-slate-900', 'bg-slate-900', 'text-white', 'shadow-md');
            b.classList.add('border-slate-200', 'text-slate-800');
          });
          btn.classList.remove('border-slate-200', 'text-slate-800');
          btn.classList.add('border-slate-900', 'bg-slate-900', 'text-white', 'shadow-md');
        });
      });

      // Quantity Plus & Minus
      document.getElementById('qty-minus-btn')?.addEventListener('click', () => {
        if (quantity > 1) {
          quantity--;
          updateSubtotal();
        }
      });

      document.getElementById('qty-plus-btn')?.addEventListener('click', () => {
        quantity++;
        updateSubtotal();
      });

      // Order / Add to Cart Click Handler
      document.getElementById('order-btn')?.addEventListener('click', () => {
        const toast = document.getElementById('order-toast');
        const toastColor = document.getElementById('toast-color');
        const toastSize = document.getElementById('toast-size');
        const toastQty = document.getElementById('toast-qty');
        const toastPrice = document.getElementById('toast-price');

        if (toastColor) toastColor.innerText = selectedColor;
        if (toastSize) toastSize.innerText = selectedSize;
        if (toastQty) toastQty.innerText = quantity;
        if (toastPrice) toastPrice.innerText = '₹' + (unitPrice * quantity).toLocaleString();

        if (toast) {
          toast.classList.remove('hidden');
          toast.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
      });

      // Close Toast Handler
      document.getElementById('close-toast-btn')?.addEventListener('click', () => {
        const toast = document.getElementById('order-toast');
        if (toast) toast.classList.add('hidden');
      });
    });
  </script>
</PublicLayout>
