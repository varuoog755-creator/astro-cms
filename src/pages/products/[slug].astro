      </div>
    </div>

    <!-- Authentic Customer Reviews Section -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-md p-6 sm:p-10 space-y-8 my-8">
      <div class="border-b border-slate-100 pb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-1.5 bg-amber-100 border border-amber-300 text-amber-950 text-[10px] sm:text-xs font-black px-3 py-1 rounded-full uppercase tracking-wider">
            <span>⭐</span>
            <span>VERIFIED BUYER FEEDBACK</span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-black text-slate-900 mt-2">Customer Reviews &amp; Ratings</h3>
          <p class="text-xs sm:text-sm text-slate-500 mt-1">Real reviews from verified customers across India</p>
        </div>

        <!-- Rating Summary Box -->
        <div class="bg-amber-50/80 border border-amber-200 rounded-2xl p-4 flex items-center gap-4 shrink-0">
          <div class="text-center">
            <div class="text-3xl sm:text-4xl font-black text-amber-900 leading-none">{product.rating}</div>
            <div class="flex items-center gap-0.5 text-amber-500 text-xs mt-1">
              <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
            </div>
          </div>
          <div class="border-l border-amber-200 pl-4 text-xs font-medium text-slate-700">
            <div class="font-bold text-slate-900">{product.reviewCount} Total Ratings</div>
            <div class="text-emerald-700 font-semibold flex items-center gap-1 mt-0.5">
              <span>✓</span> 100% Verified Purchases
            </div>
          </div>
        </div>
      </div>

      <!-- Reviews Cards Grid (Simple, Authentic Human Language) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
        {customerReviews.map((rev) => (
          <div class="bg-slate-50/80 border border-slate-200 rounded-2xl p-5 space-y-3 hover:border-amber-300 transition-colors">
            <div class="flex items-start justify-between gap-2">
              <div class="flex items-center gap-2.5">
                <div class="w-8 h-8 rounded-full bg-amber-800 text-white font-bold text-xs flex items-center justify-center shrink-0">
                  {rev.name.charAt(0)}
                </div>
                <div>
                  <h4 class="font-bold text-xs sm:text-sm text-slate-900 leading-tight">{rev.name}</h4>
                  <span class="text-[10px] text-slate-500 font-medium">{rev.city}</span>
