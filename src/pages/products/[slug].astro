    </div>

    <!-- Full Product Description & Specifications Section -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-md p-6 sm:p-10 space-y-8 my-8">
      <div class="border-b border-slate-100 pb-4 flex items-center justify-between flex-wrap gap-4">
        <div>
          <span class="text-[10px] font-black uppercase tracking-widest text-amber-900 bg-amber-50 border border-amber-200 px-3 py-1 rounded-full">Complete Overview</span>
          <h2 class="text-2xl font-black text-slate-900 mt-1">Product Details & Features</h2>
        </div>
        <div class="flex items-center gap-3 text-xs font-bold text-slate-500">
          <span class="bg-emerald-50 text-emerald-700 px-3 py-1 rounded-lg border border-emerald-200">📦 Direct Factory Shipping</span>
          <span class="bg-amber-50 text-amber-700 px-3 py-1 rounded-lg border border-amber-200">🛡️ 100% Inspected Quality</span>
        </div>
