---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { getStorefrontProducts, normalizeProductSizes } from '../../lib/products';

const { slug } = Astro.params;

const allProducts = await getStorefrontProducts();
const product = allProducts.find((p) => p.slug === slug);

if (!product) {
  return Astro.rewrite('/404');
}

const normalizedSizes = normalizeProductSizes(product.sizes, product.price, product.originalPrice);
const initialSize = normalizedSizes[0] || { name: 'Standard Size', price: product.price, originalPrice: product.originalPrice };
const relatedProducts = allProducts.filter((p) => p.id !== product.id);

function parseProductDetails(raw: string, defaultName: string) {
  if (!raw) {
    return {
      paragraphs: [
        'Crafted directly in our Panipat manufacturing mills, this curtain panel combines premium heavyweight fabric with precision eyelet stitching to deliver superior light control, smooth drape, and enduring interior beauty.'
      ],
      bullets: [
        'Light Filtering & Room Darkening for soothing ambiance',
        'Rust-proof metallic silver eyelet rings for effortless sliding',
        'Direct factory double-stitched hem and side borders',
        'Easy maintenance: 100% hand & gentle machine wash friendly'
      ],
      specs: [
        { label: 'Fabric Type', value: '100% Premium Polyester' },
        { label: 'Eyelet Fitting', value: 'Stainless Steel Silver Grommets' },
        { label: 'Available Sizes', value: '5ft, 6ft, 7ft & 9ft' },
        { label: 'Care Instructions', value: 'Hand & Machine Wash Cold' },
        { label: 'Manufacturing Origin', value: 'Panipat, Haryana (India)' }
      ]
    };
  }

  const lines = raw.split('\n').map(l => l.trim()).filter(Boolean);
  const specs: { label: string; value: string }[] = [];
  const bullets: string[] = [];
  const paragraphs: string[] = [];

  const skipHeaders = new Set([
    'key features', 'key features:', 'product highlights', 'product information',
    'perfect for', 'bullet points', 'product description', 'why choose this curtain?',
    'size information', 'product details', 'about this item'
  ]);

  for (const line of lines) {
    // Filter keyword stuffing lines
    const commaCount = (line.match(/,/g) || []).length;
    if (commaCount >= 3 && !line.includes('.') && line.length < 160) continue;

    // Check key: value
    const colonIdx = line.indexOf(':');
    if (colonIdx > 1 && colonIdx < 30) {
      const k = line.slice(0, colonIdx).trim();
      const v = line.slice(colonIdx + 1).trim();
      const kLower = k.toLowerCase();
      const vLower = v.toLowerCase();

      if (kLower === 'name' || kLower.includes('net quantity') || vLower.includes('shoe rack')) {
        continue;
      }

      if (['material', 'opacity', 'length', 'type', 'set', 'size', 'pattern', 'colour', 'eyelet', 'care', 'origin'].some(term => kLower.includes(term))) {
        if (v && !specs.some(s => s.label.toLowerCase() === kLower)) {
          specs.push({ label: k, value: v });
        }
        continue;
      }
    }

    // Check bullet points
    if (line.startsWith('✔') || line.startsWith('•') || line.startsWith('- ') || line.startsWith('✓')) {
      const clean = line.replace(/^[✔•\-\u2714\u2713\s]+/, '').trim();
      if (clean.length > 5 && !bullets.includes(clean)) {
        bullets.push(clean);
      }
      continue;
    }

    if (skipHeaders.has(line.toLowerCase())) continue;

    if (line.length > 25 && !paragraphs.includes(line)) {
      paragraphs.push(line);
    }
  }

  if (bullets.length === 0) {
    bullets.push(
      'Premium fabric weave ensures elegant fall and rich drape',
      'Light filtering and privacy protection for windows and doors',
      'Rust-proof metallic eyelet grommets for smooth movement',
      'Hand and gentle machine wash friendly'
    );
  }

  if (specs.length === 0) {
    specs.push(
      { label: 'Fabric Type', value: '100% Premium Polyester' },
      { label: 'Fitting Style', value: 'Silver Eyelet Rings' },
      { label: 'Care Instructions', value: 'Hand & Machine Wash Cold' },
      { label: 'Origin', value: 'Panipat, Haryana (India)' }
    );
  }

  return { paragraphs, bullets, specs };
}

const cleanedDesc = parseProductDetails(product.description, product.name);

const customerReviews = [
  {
    name: "Pooja Sharma",
    city: "Jaipur, Rajasthan",
    rating: 5,
    date: "Verified Purchase · 3 days ago",
    title: "Fabric quality is genuine and heavy",
    comment: "Parde ka fabric bohot badhiya aur heavy quality ka hai. 7 feet door size bilkul perfect fit aaya mere hall rod par. Rings smooth slide hoti hain aur stitching ekdum clean hai."
  },
  {
    name: "Rahul Verma",
    city: "New Delhi",
    rating: 5,
    date: "Verified Purchase · 1 week ago",
    title: "Exact color as shown in photo",
    comment: "Color bilkul same hai jaisa website par dikhaya gaya tha. Din me direct sunlight aur glare ko achhe se filter karta hai. Room me elegant look aa gaya hai. Value for money purchase."
  },
  {
    name: "Anjali Gupta",
    city: "Lucknow, UP",
    rating: 5,
    date: "Verified Purchase · 2 weeks ago",
    title: "Clean stitching and fast delivery",
    comment: "Panipat direct dispatch hone se 4 din me Lucknow me deliver ho gaya. Eyelet rings rust-free metallic hain aur wash ke baad bhi fabric ka fall waise ka waisa rehta hai."
  },
  {
    name: "Vikram Malhotra",
    city: "Chandigarh",
    rating: 4,
    date: "Verified Purchase · 3 weeks ago",
    title: "Good privacy and soft fall",
    comment: "Living room ke liye Pack of 2 mangwaya tha. Bahar se visibility bilkul band ho gayi hai jab parde band hote hain. Fabric soft hai aur wrinkle-free lagta hai. Highly recommended."
  }
];
---

<PublicLayout
  seo={{
    title: `${product.name} - Official Product Showcase`,
    description: product.description,
    canonicalUrl: `/products/${product.slug}`,
    ogImage: product.images?.[0],
    preloadLcpImage: product.images?.[0],
    type: 'product',
    productData: {
      name: product.name,
      price: product.price,
      currency: 'INR',
      sku: product.id,
      inStock: product.inStock,
      rating: product.rating,
      reviewCount: product.reviewCount,
      image: product.images?.[0],
      category: product.category,
    },
    breadcrumbs: [
      { name: 'Home', url: '/' },
      { name: 'Products', url: '/products' },
      { name: product.name, url: `/products/${product.slug}` },
    ],
  }}
>
  <div class="max-w-7xl mx-auto px-2 sm:px-6 lg:px-8 py-4 sm:py-10 pb-28 sm:pb-12">
    <!-- Main Product Card -->
    <div class="bg-white rounded-2xl sm:rounded-3xl border border-slate-200 shadow-xl overflow-hidden grid grid-cols-1 lg:grid-cols-2 mb-12 sm:mb-16">
      
      <!-- Gallery Column with Touch-Swipe Slider (Enlarged Unobstructed Canvas) -->
      <div class="p-2 sm:p-6 lg:p-8 bg-slate-50 flex flex-col justify-between border-b lg:border-b-0 lg:border-r border-slate-200 select-none">
        <div
          id="product-gallery-viewport"
          class="relative aspect-square w-full rounded-2xl overflow-hidden shadow-sm bg-slate-200 group touch-pan-y cursor-grab active:cursor-grabbing"
          style="aspect-ratio: 1 / 1; width: 100%; height: auto; max-width: 100%;"
        >
          <!-- Sliding Image Track -->
          <div
            id="product-slider-track"
            class="flex h-full w-full transition-transform duration-300 ease-out will-change-transform"
            style="transform: translateX(0%); aspect-ratio: 1 / 1; width: 100%; height: 100%;"
          >
            {product.images.map((img, idx) => (
              <div class="w-full h-full flex-shrink-0 relative flex items-center justify-center bg-slate-100" style="aspect-ratio: 1 / 1; width: 100%; height: 100%;">
                <img
                  src={img}
                  alt={`${product.name} - Official View ${idx + 1}`}
                  class="w-full h-full object-cover select-none pointer-events-none"
                  loading={idx === 0 ? "eager" : "lazy"}
                  fetchpriority={idx === 0 ? "high" : "auto"}
                  decoding={idx === 0 ? "sync" : "async"}
                  width="700"
                  height="700"
                  draggable="false"
                  style="aspect-ratio: 1 / 1; width: 100%; height: 100%; object-fit: cover;"
                />
              </div>
            ))}
          </div>
        </div>

        <!-- Slider Controls Strip (Positioned Below Image, Never Obscuring Product) -->
        {product.images.length > 1 && (
          <div class="flex items-center justify-between px-1 sm:px-2 pt-3 pb-1 text-xs text-slate-600 select-none">
            <!-- Left: Slide Counter (e.g. 1 / 4) -->
            <span
              id="slider-counter"
              class="bg-white border border-slate-200 text-slate-700 font-bold text-[11px] px-2.5 py-1 rounded-full shadow-sm"
            >
              1 / {product.images.length}
            </span>

            <!-- Center: Dot Indicators -->
            <div id="slider-dots" class="flex items-center gap-1.5">
              {product.images.map((_, idx) => (
                <button
                  type="button"
                  data-slide-dot={idx}
                  class={`slider-dot transition-all duration-300 rounded-full cursor-pointer ${idx === 0 ? 'w-5 h-1.5 bg-amber-800' : 'w-2 h-1.5 bg-slate-300 hover:bg-slate-400'}`}
                  aria-label={`Go to slide ${idx + 1}`}
                ></button>
              ))}
            </div>

            <!-- Right: Prev / Next Chevron Buttons -->
            <div class="flex items-center gap-1.5">
              <button
                type="button"
                id="slider-prev-btn"
                class="w-8 h-8 rounded-full bg-white hover:bg-amber-50 active:scale-90 text-slate-700 hover:text-amber-900 border border-slate-200 shadow-sm flex items-center justify-center font-bold text-sm transition cursor-pointer select-none"
                aria-label="Previous image"
                title="Previous Image"
              >
                ‹
              </button>
              <button
                type="button"
                id="slider-next-btn"
                class="w-8 h-8 rounded-full bg-white hover:bg-amber-50 active:scale-90 text-slate-700 hover:text-amber-900 border border-slate-200 shadow-sm flex items-center justify-center font-bold text-sm transition cursor-pointer select-none"
                aria-label="Next image"
                title="Next Image"
              >
                ›
              </button>
            </div>
          </div>
        )}

        <!-- Thumbnails Strip -->
        {product.images.length > 1 && (
          <div class="flex gap-2.5 sm:gap-4 mt-3 sm:mt-4 overflow-x-auto pb-1">
            {product.images.map((img, idx) => (
              <button
                type="button"
                data-slide-index={idx}
                data-img={img}
                class={`thumb-btn flex-shrink-0 w-14 h-14 sm:w-20 sm:h-20 rounded-xl overflow-hidden border-2 transition shadow-sm focus:outline-none cursor-pointer ${idx === 0 ? 'border-amber-800 ring-2 ring-amber-800/30' : 'border-slate-300 hover:border-amber-600/60 opacity-70 hover:opacity-100'}`}
              >
                <img
                  src={img}
                  alt={`View ${product.name} thumbnail slide ${idx + 1}`}
                  width="80"
                  height="80"
                  loading="lazy"
                  class="w-full h-full object-cover pointer-events-none"
                />
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- Detail Info Column -->
      <div class="p-4 sm:p-8 lg:p-12 space-y-5 sm:space-y-6 flex flex-col justify-between">
        <div class="space-y-4">
          <!-- Category, Best Seller & Stock Status Badges (Strictly 1 line on mobile) -->
          <div class="flex items-center gap-2 overflow-x-auto whitespace-nowrap scrollbar-none py-0.5">
            {product.badge && (
              <span class="bg-rose-600 text-white font-black text-[10px] sm:text-xs px-2.5 py-0.5 sm:px-3 sm:py-1 rounded-full uppercase tracking-wider shadow-sm shrink-0 whitespace-nowrap">
                🔥 {product.badge}
              </span>
            )}
            <span class="bg-amber-100 text-amber-900 font-extrabold text-[10px] sm:text-xs px-2.5 py-0.5 sm:px-3 sm:py-1 rounded-full uppercase tracking-wider border border-amber-200 shrink-0 whitespace-nowrap">
              {product.category}
            </span>
            <span class="bg-emerald-100 text-emerald-800 font-extrabold text-[10px] sm:text-xs px-2.5 py-0.5 sm:px-3 sm:py-1 rounded-full uppercase tracking-wider shrink-0 whitespace-nowrap flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 inline-block animate-pulse"></span>
              In Stock & Ready to Ship
            </span>
          </div>

          <h1 class="text-2xl sm:text-4xl font-black text-slate-900 leading-tight">
            {product.name}
          </h1>

          <!-- Star Rating & Review Count (Strictly 1 line on mobile) -->
          <div class="flex items-center gap-2 sm:gap-3 text-[11px] sm:text-xs font-semibold whitespace-nowrap overflow-hidden text-ellipsis">
            <div class="flex items-center gap-0.5 text-amber-500 text-xs sm:text-sm shrink-0">
              <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
              <span class="text-slate-900 font-bold ml-1">{product.rating}</span>
            </div>
            <span class="text-slate-300 shrink-0">|</span>
            <span class="text-slate-600 truncate">{product.reviewCount} Verified Customer Reviews</span>
          </div>

          <!-- Price Header -->
          <div class="pt-3 pb-2 border-y border-slate-100 flex items-baseline gap-3">
            <span class="text-2xl sm:text-3xl font-black text-slate-900">{product.currency}<span id="unit-price">{initialSize.price}</span></span>
            <span id="original-price-wrap" class={`text-sm sm:text-base text-slate-400 line-through font-semibold ${initialSize.originalPrice && initialSize.originalPrice > initialSize.price ? '' : 'hidden'}`}>
              {product.currency}<span id="original-price">{initialSize.originalPrice || ''}</span>
            </span>
            <span
              id="discount-badge"
              class={`bg-rose-100 text-rose-700 font-bold text-[10px] sm:text-xs px-2.5 py-0.5 rounded-full ml-auto ${initialSize.originalPrice && initialSize.originalPrice > initialSize.price ? '' : 'hidden'}`}
            >
              Save {initialSize.originalPrice ? Math.round(((initialSize.originalPrice - initialSize.price) / initialSize.originalPrice) * 100) : 0}% Today
            </span>
          </div>

          <!-- Color Display -->
          <div class="space-y-2">
            <div class="flex items-center gap-2 text-xs font-bold text-slate-700">
              <span class="uppercase tracking-wider">Color:</span>
              <span id="selected-color-label" class="text-amber-800 font-bold">{product.colors[0]?.name}</span>
            </div>
            <div class="flex flex-wrap gap-2.5 sm:gap-3">
              {product.colors.map((c, idx) => (
                <button
                  type="button"
                  data-color={c.name}
                  data-color-index={idx}
                  class={`color-chip-btn flex items-center gap-2 px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl border text-xs font-bold transition focus:outline-none ${idx === 0 ? 'border-amber-800 ring-2 ring-amber-800/30 bg-amber-50/60 text-amber-950' : 'border-slate-200 hover:border-slate-400 bg-slate-50 text-slate-800'}`}
                >
                  <span class="w-3.5 h-3.5 sm:w-4 sm:h-4 rounded-full border border-slate-400 shadow-inner" style={`background-color: ${c.hex}`}></span>
                  <span>{c.name}</span>
                </button>
              ))}
            </div>
          </div>

          <!-- Size Selector with Real-time Stock Display -->
          <div class="space-y-2">
            <div class="flex items-center justify-between text-xs font-bold text-slate-700">
              <span class="uppercase tracking-wider">Select Size / Length</span>
              <div class="flex items-center gap-2">
                <span id="selected-size-label" class="text-amber-800 font-semibold">{initialSize.name}</span>
                <span id="selected-size-stock" class={`text-[10px] px-2 py-0.5 rounded-full font-bold ${initialSize.inStock === false ? 'bg-rose-100 text-rose-800' : 'bg-emerald-100 text-emerald-800'}`}>
                  {initialSize.inStock === false ? 'Out of Stock' : (initialSize.stock && initialSize.stock <= 5 ? `Only ${initialSize.stock} Left` : '✓ In Stock')}
                </span>
              </div>
            </div>
            <div class="flex flex-wrap gap-2 sm:gap-2.5">
              {normalizedSizes.map((sz, idx) => {
                const isOutOfStock = sz.inStock === false || (typeof sz.stock === 'number' && sz.stock <= 0);
                return (
                  <button
                    type="button"
                    data-size={sz.name}
                    data-price={sz.price}
                    data-original-price={sz.originalPrice || ''}
                    data-stock={sz.stock ?? 50}
                    data-in-stock={!isOutOfStock}
                    disabled={isOutOfStock}
                    class={`size-btn px-3.5 py-2 sm:px-4 sm:py-2.5 min-h-[42px] sm:min-h-[44px] rounded-xl border-2 font-bold text-xs sm:text-sm transition focus:outline-none whitespace-nowrap flex items-center gap-1.5 cursor-pointer ${isOutOfStock ? 'disabled-size' : (idx === 0 ? 'active-size' : '')}`}
                  >
                    <span class="size-title">{sz.name}</span>
                    <span class="size-badge text-[10px] sm:text-[11px] font-black px-1.5 py-0.5 rounded-md">
                      {isOutOfStock ? 'Out of Stock' : `${product.currency}${sz.price.toLocaleString('en-IN')}`}
                    </span>
                  </button>
                );
              })}
            </div>
          </div>

          <!-- Pack Configuration (Standardized to Pack of 2 / Set of 2 Panels) -->
          <div class="space-y-2 pt-1">
            <div class="flex items-center justify-between text-xs font-bold text-slate-700">
              <span class="uppercase tracking-wider">Pack Configuration</span>
              <span id="selected-pack-label" class="text-amber-800 font-semibold">Pack of 2 (Set of 2 Curtains)</span>
            </div>
            <div class="w-full">
              <div
                class="w-full px-4 py-3 rounded-2xl border-2 border-slate-900 bg-slate-900 text-white shadow-sm flex items-center justify-between"
              >
                <div class="flex items-center gap-2.5">
                  <span class="text-lg">📦</span>
                  <div>
                    <div class="font-extrabold text-xs sm:text-sm text-white">Pack of 2 (Set of 2 Curtains)</div>
                    <div class="text-[10px] text-slate-300">Contains 2 matching curtain panels with pre-fitted silver eyelets</div>
                  </div>
                </div>
                <span class="text-[10px] font-black bg-emerald-500 text-slate-950 px-2.5 py-1 rounded-full uppercase tracking-wider">Standard Pack</span>
              </div>
            </div>
          </div>

          <!-- Quantity Selector (1 to 10 Only) -->
          <div class="space-y-2 pt-1">
            <div class="flex items-center justify-between">
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-700">Quantity</label>
              <span class="text-[10px] font-semibold text-slate-500 bg-slate-100 px-2 py-0.5 rounded">Max 10 units per order</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="flex items-center border-2 border-slate-200 rounded-xl overflow-hidden bg-slate-50">
                <button type="button" id="qty-minus-btn" class="w-11 h-11 min-w-[44px] min-h-[44px] flex items-center justify-center font-bold text-slate-800 hover:bg-slate-200 active:bg-slate-300 transition select-none text-base cursor-pointer opacity-40 cursor-not-allowed" aria-label="Decrease quantity">-</button>
                <span id="qty-display" class="w-12 text-center font-extrabold text-sm text-slate-900 select-none">1</span>
                <button type="button" id="qty-plus-btn" class="w-11 h-11 min-w-[44px] min-h-[44px] flex items-center justify-center font-bold text-slate-800 hover:bg-slate-200 active:bg-slate-300 transition select-none text-base cursor-pointer" aria-label="Increase quantity">+</button>
              </div>
              <span class="text-xs text-slate-500 font-medium">Subtotal: {product.currency}<span id="subtotal-price">{product.price}</span></span>
            </div>
          </div>

          <!-- Technical Specs Card -->
          <div class="bg-slate-50 p-4 rounded-2xl border border-slate-200 text-xs space-y-2 mt-2">
            <div class="font-bold text-slate-900 uppercase tracking-wider text-[10px]">Fabric & Specifications</div>
            <div class="grid grid-cols-2 gap-2 text-slate-600">
              <div>• <strong>Material:</strong> 100% Polyester</div>
              <div>• <strong>Fitting:</strong> Silver Eyelets</div>
              <div>• <strong>Sizes:</strong> 5ft, 6ft, 7ft, 9ft</div>
              <div>• <strong>Care:</strong> Machine Wash Cold</div>
            </div>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="pt-6 border-t border-slate-100 space-y-3">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <button
              type="button"
              id="add-cart-btn"
              class="bg-amber-100 hover:bg-amber-200 active:scale-95 text-amber-950 font-black text-xs sm:text-sm py-4 rounded-2xl border border-amber-300 shadow-sm hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>🛒 Add to Cart</span>
            </button>

            <button
              type="button"
              id="order-btn"
              class="bg-amber-800 hover:bg-amber-900 active:scale-95 text-white font-black text-xs sm:text-sm py-4 rounded-2xl shadow-lg shadow-amber-900/30 hover:shadow-amber-900/50 hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>⚡ Buy Now & Checkout</span>
            </button>
          </div>

          <button
            type="button"
            id="whatsapp-direct-btn"
            class="w-full bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-white font-black text-xs sm:text-sm py-3.5 px-4 rounded-2xl shadow-md shadow-emerald-600/20 hover:shadow-emerald-600/40 hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2 cursor-pointer"
          >
            <span class="text-base sm:text-lg">💬</span>
            <span>Order via WhatsApp (+91 98963 74239)</span>
          </button>
          
          <div class="flex items-center justify-center gap-6 text-[11px] text-slate-500 font-semibold pt-1">
            <span>🔒 SSL Encrypted</span>
            <span>⚡ 7-Day Replacement</span>
            <span>🚚 Free Express Shipping</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Authentic Panipat Manufacturing Unit Trust Banner -->
    <div class="bg-gradient-to-r from-amber-950 via-slate-900 to-amber-900 text-white p-6 sm:p-8 rounded-3xl border border-amber-500/20 shadow-xl grid grid-cols-1 md:grid-cols-12 gap-6 items-center my-8">
      <div class="md:col-span-5 relative">
        <div class="rounded-2xl overflow-hidden border border-amber-400/30 shadow-lg aspect-[16/10] group">
          <img
            src="/panipat-factory-unit.jpg"
            alt="Teepul Panipat Curtain Manufacturing Unit - Ashank Ecommerce Private Limited"
            width="640"
            height="400"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
        </div>
      </div>

      <div class="md:col-span-7 space-y-3 text-left">
        <div class="inline-flex items-center gap-2 bg-amber-500/20 border border-amber-400/30 text-amber-300 text-[10px] font-black px-3 py-1 rounded-full uppercase tracking-wider">
          <span>🇮🇳 100% MADE IN PANIPAT</span>
          <span>•</span>
          <span>ASHANK ECOMMERCE PVT LTD</span>
        </div>

        <h3 class="text-xl sm:text-2xl font-black text-white leading-tight">
          Handcrafted in Our Panipat Manufacturing Unit
        </h3>

        <p class="text-xs text-slate-300 leading-relaxed font-normal">
          This curtain panel is directly woven, double-stitched, and eyelet-fitted by skilled women artisans at our Panipat factory (Sector 25, HSIIDC Industrial Area). No middlemen — 100% genuine factory direct quality.
        </p>

        <div class="grid grid-cols-3 gap-2 pt-1 text-[10px] text-slate-200 font-semibold">
          <div class="bg-white/10 px-2.5 py-1.5 rounded-lg border border-white/10 text-center">
            👩‍🏭 Women Artisans
          </div>
          <div class="bg-white/10 px-2.5 py-1.5 rounded-lg border border-white/10 text-center">
            ⚡ JUKI Machinery
          </div>
          <div class="bg-white/10 px-2.5 py-1.5 rounded-lg border border-white/10 text-center">
            ✨ QC Verified
          </div>
        </div>
