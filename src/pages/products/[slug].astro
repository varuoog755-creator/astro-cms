      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        <!-- Left: Formatted Description Paragraphs & Highlights -->
        <div class="lg:col-span-7 space-y-6 text-slate-700 text-sm leading-relaxed">
          {cleanedDesc.paragraphs.length > 0 ? (
            <div class="space-y-4">
              {cleanedDesc.paragraphs.map((para) => (
                <p class="text-slate-600 text-sm sm:text-base leading-relaxed">{para}</p>
