              </div>
              <span class="inline-flex items-center gap-1 bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5 rounded-full shrink-0">
                <span>✓</span> Verified Buyer
              </span>
            </div>

            <div class="flex items-center gap-2 text-xs">
              <div class="flex text-amber-500 text-xs">
                {Array.from({ length: rev.rating }).map(() => <span>★</span>)}
              </div>
              <span class="text-[11px] font-bold text-slate-900">{rev.title}</span>
            </div>

            <p class="text-xs text-slate-600 leading-relaxed">
              "{rev.comment}"
            </p>

            <div class="text-[10px] text-slate-400 font-medium pt-1 border-t border-slate-200/60">
              {rev.date}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Related Products -->
    {relatedProducts.length > 0 && (
      <div class="space-y-6">
        <h3 class="text-2xl font-black text-slate-900">Recommended Next</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {relatedProducts.map((rel) => (
            <a href={`/products/${rel.slug}`} class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition flex items-center gap-6 group">
              <img
                src={rel.images[0]}
                alt={`View related product ${rel.name}`}
                width="96"
                height="96"
                loading="lazy"
                class="w-24 h-24 rounded-xl object-cover"
              />
              <div>
                <span class="text-[10px] font-bold uppercase text-amber-900 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded">{rel.category}</span>
                <h4 class="font-bold text-base text-slate-900 group-hover:text-amber-800 transition mt-1">{rel.name}</h4>
                <p class="text-xs text-slate-500 line-clamp-1 mt-0.5">{rel.tagline}</p>
                <div class="font-black text-sm text-slate-900 mt-2">{rel.currency}{rel.price}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>

  <!-- Interactive Order Toast / Modal Overlay -->
  <div id="order-toast" class="fixed bottom-6 right-6 z-50 max-w-md bg-slate-900 text-white p-6 rounded-3xl shadow-2xl border border-slate-700 hidden transform transition-all duration-300">
    <div class="flex items-start justify-between gap-4">
      <div class="space-y-2">
        <div class="flex items-center gap-2">
          <span class="bg-emerald-500 text-white text-[10px] font-extrabold px-2.5 py-0.5 rounded-full uppercase">Ready to Checkout</span>
          <span class="text-xs text-slate-400 font-semibold">Teepul Express</span>
        </div>
        <h4 class="font-extrabold text-sm text-white">{product.name}</h4>
        <div class="text-xs text-slate-300 space-y-0.5 font-medium">
          <div>Color: <span id="toast-color" class="font-bold text-amber-400"></span></div>
          <div>Size: <span id="toast-size" class="font-bold text-amber-400"></span></div>
          <div>Quantity: <span id="toast-qty" class="font-bold text-amber-400"></span></div>
          <div>Total Price: <span id="toast-price" class="font-black text-emerald-400"></span></div>
        </div>
      </div>
      <button type="button" id="close-toast-btn" class="text-slate-400 hover:text-white font-bold text-lg">&times;</button>
    </div>
    <div class="mt-4 pt-3 border-t border-slate-800 flex gap-2">
      <a id="toast-checkout-link" href="/checkout" class="w-full bg-amber-800 hover:bg-amber-700 text-center font-bold text-xs py-3 rounded-xl transition shadow-lg">
        Proceed to Checkout &rarr;
      </a>
    </div>
  </div>

  <script is:inline define:vars={{ currentProductSlug: product.slug, currentProductName: product.name, productImages: product.images || [] }}>
    document.addEventListener('DOMContentLoaded', () => {
      let selectedColor = document.querySelector('.color-chip-btn')?.getAttribute('data-color') || '';
      let selectedSize = document.querySelector('.size-btn.bg-slate-900')?.getAttribute('data-size') || '';
      let selectedPack = 'Pack of 1';
      let packMultiplier = 1;
      let quantity = 1;
      let baseSizePrice = parseFloat(document.querySelector('.size-btn.bg-slate-900')?.getAttribute('data-price') || document.getElementById('unit-price')?.innerText || '0');
      let baseSizeOrigPrice = parseFloat(document.querySelector('.size-btn.bg-slate-900')?.getAttribute('data-original-price') || '0');
      let unitPrice = baseSizePrice * packMultiplier;
      let currentSlideIndex = 0;
      const totalSlides = Array.isArray(productImages) ? productImages.length : 1;

      // Update subtotal price
      function updateSubtotal() {
        const subtotal = unitPrice * quantity;
        const subtotalEl = document.getElementById('subtotal-price');
        const qtyDisplay = document.getElementById('qty-display');
        if (subtotalEl) subtotalEl.innerText = subtotal.toLocaleString('en-IN');
        if (qtyDisplay) qtyDisplay.innerText = quantity;
      }

      function updateQuantityButtons() {
        const minusBtn = document.getElementById('qty-minus-btn');
        const plusBtn = document.getElementById('qty-plus-btn');
        if (minusBtn) {
          if (quantity <= 1) {
            minusBtn.classList.add('opacity-40', 'cursor-not-allowed');
          } else {
            minusBtn.classList.remove('opacity-40', 'cursor-not-allowed');
          }
        }
        if (plusBtn) {
          if (quantity >= 10) {
            plusBtn.classList.add('opacity-40', 'cursor-not-allowed');
          } else {
            plusBtn.classList.remove('opacity-40', 'cursor-not-allowed');
          }
        }
      }

      function updatePricing() {
        unitPrice = baseSizePrice * packMultiplier;
        const currentOrigPrice = baseSizeOrigPrice ? (baseSizeOrigPrice * packMultiplier) : 0;
        
        const unitPriceEl = document.getElementById('unit-price');
        if (unitPriceEl) unitPriceEl.innerText = unitPrice.toLocaleString('en-IN');

        const origPriceEl = document.getElementById('original-price');
        const origWrapEl = document.getElementById('original-price-wrap');
        const discountBadgeEl = document.getElementById('discount-badge');

        if (currentOrigPrice > unitPrice) {
          if (origPriceEl) origPriceEl.innerText = currentOrigPrice.toLocaleString('en-IN');
          if (origWrapEl) origWrapEl.classList.remove('hidden');
          if (discountBadgeEl) {
            const savePercent = Math.round(((currentOrigPrice - unitPrice) / currentOrigPrice) * 100);
            discountBadgeEl.innerText = `Save ${savePercent}% Today`;
            discountBadgeEl.classList.remove('hidden');
          }
        } else {
          if (origWrapEl) origWrapEl.classList.add('hidden');
          if (discountBadgeEl) discountBadgeEl.classList.add('hidden');
        }

        updateSubtotal();
        updateMobileStickyInfo();
      }

      // Smooth Sliding Gallery Logic
      const track = document.getElementById('product-slider-track');
      const counter = document.getElementById('slider-counter');
      const dots = document.querySelectorAll('.slider-dot');
      const thumbs = document.querySelectorAll('.thumb-btn');

      function goToSlide(index) {
        if (totalSlides <= 0) return;
        currentSlideIndex = (index + totalSlides) % totalSlides;
        if (track) {
          track.style.transform = 'translateX(-' + (currentSlideIndex * 100) + '%)';
        }
        if (counter) {
          counter.innerText = (currentSlideIndex + 1) + ' / ' + totalSlides;
        }
        // Sync Dots
        dots.forEach((dot, idx) => {
          if (idx === currentSlideIndex) {
            dot.className = 'slider-dot transition-all duration-300 rounded-full cursor-pointer w-5 h-2 bg-white';
          } else {
            dot.className = 'slider-dot transition-all duration-300 rounded-full cursor-pointer w-2 h-2 bg-white/50 hover:bg-white/80';
          }
        });
        // Sync Thumbnails
        thumbs.forEach((thumb, idx) => {
          if (idx === currentSlideIndex) {
            thumb.classList.remove('border-slate-300', 'opacity-70');
            thumb.classList.add('border-amber-800', 'ring-2', 'ring-amber-800/30', 'opacity-100');
            if (typeof thumb.scrollIntoView === 'function') {
              thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            }
          } else {
            thumb.classList.remove('border-amber-800', 'ring-2', 'ring-amber-800/30', 'opacity-100');
            thumb.classList.add('border-slate-300', 'opacity-70');
          }
        });
      }

      // Next / Prev Button Listeners
      document.getElementById('slider-prev-btn')?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        goToSlide(currentSlideIndex - 1);
      });

      document.getElementById('slider-next-btn')?.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        goToSlide(currentSlideIndex + 1);
      });

      // Thumbnail Click Handlers
      thumbs.forEach((btn) => {
        btn.addEventListener('click', () => {
          const slideIdx = parseInt(btn.getAttribute('data-slide-index') || '0', 10);
          goToSlide(slideIdx);
        });
      });

      // Dot Click Handlers
      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const slideIdx = parseInt(dot.getAttribute('data-slide-dot') || '0', 10);
          goToSlide(slideIdx);
        });
      });

      // Touch Swipe Gesture Support (Mobile)
      const viewport = document.getElementById('product-gallery-viewport');
      if (viewport && totalSlides > 1) {
        let touchStartX = 0;
        let touchStartY = 0;
        let isSwiping = false;

        viewport.addEventListener('touchstart', (e) => {
          touchStartX = e.touches[0].clientX;
          touchStartY = e.touches[0].clientY;
          isSwiping = true;
        }, { passive: true });

        viewport.addEventListener('touchmove', (e) => {
          if (!isSwiping) return;
          const diffX = e.touches[0].clientX - touchStartX;
          const diffY = e.touches[0].clientY - touchStartY;
          if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 10) {
            if (e.cancelable) e.preventDefault();
          }
        }, { passive: false });

        viewport.addEventListener('touchend', (e) => {
          if (!isSwiping) return;
          isSwiping = false;
          const touchEndX = e.changedTouches[0].clientX;
          const diffX = touchEndX - touchStartX;
          const threshold = 35;
          if (diffX < -threshold) {
            goToSlide(currentSlideIndex + 1);
          } else if (diffX > threshold) {
            goToSlide(currentSlideIndex - 1);
          }
        }, { passive: true });

        // Desktop Mouse Drag Support
        let isMouseDown = false;
        let mouseStartX = 0;

        viewport.addEventListener('mousedown', (e) => {
          if (e.target && e.target.closest && e.target.closest('button')) return;
          isMouseDown = true;
          mouseStartX = e.clientX;
        });

        window.addEventListener('mouseup', (e) => {
          if (!isMouseDown) return;
          isMouseDown = false;
          const diffX = e.clientX - mouseStartX;
          if (diffX < -40) {
            goToSlide(currentSlideIndex + 1);
          } else if (diffX > 40) {
            goToSlide(currentSlideIndex - 1);
          }
        });
      }

      // Color Chip Click Handlers
      document.querySelectorAll('.color-chip-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          selectedColor = btn.getAttribute('data-color') || '';
          const label = document.getElementById('selected-color-label');
          if (label) label.innerText = selectedColor;

          document.querySelectorAll('.color-chip-btn').forEach((b) => {
            b.classList.remove('border-amber-800', 'ring-2', 'ring-amber-800/30', 'bg-amber-50/60', 'text-amber-950');
            b.classList.add('border-slate-200', 'bg-slate-50', 'text-slate-800');
          });
          btn.classList.remove('border-slate-200', 'bg-slate-50', 'text-slate-800');
          btn.classList.add('border-amber-800', 'ring-2', 'ring-amber-800/30', 'bg-amber-50/60', 'text-amber-950');
        });
      });

      // Size Button Click Handlers - Dynamic Size Pricing Update
      document.querySelectorAll('.size-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          selectedSize = btn.getAttribute('data-size') || '';
          const label = document.getElementById('selected-size-label');
          if (label) label.innerText = selectedSize;

          const sizePriceAttr = btn.getAttribute('data-price');
          const sizeOrigPriceAttr = btn.getAttribute('data-original-price');

          if (sizePriceAttr) {
            const newPrice = parseFloat(sizePriceAttr);
            if (!isNaN(newPrice)) {
              baseSizePrice = newPrice;
              baseSizeOrigPrice = sizeOrigPriceAttr ? parseFloat(sizeOrigPriceAttr) : 0;
              updatePricing();
            }
          }

          document.querySelectorAll('.size-btn').forEach((b) => {
            b.classList.remove('border-slate-900', 'bg-slate-900', 'text-white', 'shadow-md');
            b.classList.add('border-slate-200', 'text-slate-800');
            const priceBadge = b.querySelector('.size-badge');
            if (priceBadge) {
              priceBadge.className = 'size-badge text-[10px] sm:text-[11px] font-black px-1.5 py-0.5 rounded-md bg-slate-100 text-slate-700';
            }
          });

          btn.classList.remove('border-slate-200', 'text-slate-800');
          btn.classList.add('border-slate-900', 'bg-slate-900', 'text-white', 'shadow-md');
          const activeBadge = btn.querySelector('.size-badge');
          if (activeBadge) {
            activeBadge.className = 'size-badge text-[10px] sm:text-[11px] font-black px-1.5 py-0.5 rounded-md bg-white/20 text-white';
          }
        });
      });

      // Pack Button Handlers (Pack of 1 & Pack of 2 Only)
      document.querySelectorAll('.pack-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          selectedPack = btn.getAttribute('data-pack') || 'Pack of 1';
          packMultiplier = parseInt(btn.getAttribute('data-pack-multiplier') || '1', 10);
          const packLabel = btn.getAttribute('data-pack-label') || selectedPack;

          const labelEl = document.getElementById('selected-pack-label');
          if (labelEl) labelEl.innerText = packLabel;

          document.querySelectorAll('.pack-btn').forEach((b) => {
            b.classList.remove('border-slate-900', 'bg-slate-900', 'text-white', 'shadow-sm');
            b.classList.add('border-slate-200', 'text-slate-800');
            const badge = b.querySelector('.pack-badge');
            if (badge) {
              if (b.getAttribute('data-pack') === 'Pack of 2') {
                badge.className = 'pack-badge text-[10px] font-bold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded border border-emerald-200';
              } else {
                badge.className = 'pack-badge text-[10px] font-medium bg-slate-100 text-slate-700 px-1.5 py-0.5 rounded';
              }
            }
          });

          btn.classList.remove('border-slate-200', 'text-slate-800');
          btn.classList.add('border-slate-900', 'bg-slate-900', 'text-white', 'shadow-sm');
          const activeBadge = btn.querySelector('.pack-badge');
          if (activeBadge) {
            activeBadge.className = 'pack-badge text-[10px] font-medium bg-white/20 text-white px-1.5 py-0.5 rounded';
          }

          updatePricing();
        });
      });

      // Quantity Plus & Minus (Strict 1 to 10 Limit)
      document.getElementById('qty-minus-btn')?.addEventListener('click', () => {
        if (quantity > 1) {
          quantity--;
          updateQuantityButtons();
          updateSubtotal();
          updateMobileStickyInfo();
        }
      });

      document.getElementById('qty-plus-btn')?.addEventListener('click', () => {
        if (quantity < 10) {
          quantity++;
          updateQuantityButtons();
          updateSubtotal();
          updateMobileStickyInfo();
        }
      });

      // Add to Cart Click Handler - Opens Right Slide-over Cart Drawer
      document.getElementById('add-cart-btn')?.addEventListener('click', () => {
        if (typeof window.quickAddToCart === 'function') {
          const currentImg = (productImages && productImages[currentSlideIndex]) || productImages[0] || '';
          const variationLabel = `${selectedSize} (${selectedPack})`;
          window.quickAddToCart(
            currentProductName,
            currentProductSlug,
            unitPrice,
            currentImg,
            variationLabel,
            selectedColor,
            quantity
          );
        }
      });

      // Order / Buy Now Click Handler
      document.getElementById('order-btn')?.addEventListener('click', () => {
        const variationLabel = `${selectedSize} (${selectedPack})`;
        const checkoutUrl = `/checkout?product=${encodeURIComponent(currentProductSlug)}&color=${encodeURIComponent(selectedColor)}&size=${encodeURIComponent(variationLabel)}&price=${unitPrice}&qty=${quantity}`;
        window.location.href = checkoutUrl;
      });

      // WhatsApp Direct Order Handler
      document.getElementById('whatsapp-direct-btn')?.addEventListener('click', () => {
        const msg = `Hi Teepul Store! I want to order:\n\n*Product:* ${currentProductName}\n*Color:* ${selectedColor}\n*Size:* ${selectedSize}\n*Pack:* ${selectedPack}\n*Quantity:* ${quantity}\n*Price:* ₹${(unitPrice * quantity).toLocaleString('en-IN')}`;
        window.open(`https://wa.me/919896374239?text=${encodeURIComponent(msg)}`, '_blank');
      });

      // Sticky Mobile Bar Handlers
      document.getElementById('mobile-sticky-add-btn')?.addEventListener('click', () => {
        document.getElementById('add-cart-btn')?.click();
      });

      document.getElementById('mobile-sticky-buy-btn')?.addEventListener('click', () => {
        document.getElementById('order-btn')?.click();
      });

      // Update mobile sticky bar
      function updateMobileStickyInfo() {
        const stickyPrice = document.getElementById('mobile-sticky-price');
        if (stickyPrice) stickyPrice.innerText = (unitPrice * quantity).toLocaleString('en-IN');
        const stickySize = document.getElementById('mobile-sticky-size');
        if (stickySize) stickySize.innerText = `${selectedSize} · ${selectedPack}`;
      }

      updateQuantityButtons();
      updateMobileStickyInfo();
    });
  </script>

  <!-- Sticky Mobile Action Bar (80% Mobile E-commerce Users) -->
  <div class="sm:hidden fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-xl border-t border-slate-200 p-2.5 shadow-[0_-4px_25px_rgba(0,0,0,0.12)] flex items-center justify-between gap-2.5" style="padding-bottom: max(0.625rem, env(safe-area-inset-bottom));">
    <!-- Left: Dynamic Price & Size Preview -->
    <div class="pl-1.5 leading-tight shrink-0">
      <div class="flex items-baseline gap-1">
        <span class="text-xs font-bold text-slate-500">{product.currency}</span>
        <span id="mobile-sticky-price" class="text-lg font-black text-slate-950">{initialSize.price.toLocaleString('en-IN')}</span>
      </div>
      <div class="flex items-center gap-1 text-[10px] font-bold text-slate-500">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block"></span>
        <span id="mobile-sticky-size" class="truncate max-w-[90px]">{initialSize.name}</span>
      </div>
    </div>

    <!-- Right: Action Buttons -->
    <div class="flex items-center gap-2 flex-1 justify-end">
      <button
        type="button"
        id="mobile-sticky-add-btn"
        class="bg-amber-100 hover:bg-amber-200 active:scale-95 text-amber-950 font-black text-xs py-3 px-3.5 rounded-xl transition border border-amber-300/80 shadow-sm flex items-center gap-1.5 cursor-pointer shrink-0"
        title="Add to Cart"
      >
        <span>🛒</span>
        <span>Cart</span>
      </button>

      <button
        type="button"
        id="mobile-sticky-buy-btn"
        class="bg-amber-800 hover:bg-amber-900 active:scale-95 text-white font-black text-xs py-3 px-4 rounded-xl shadow-lg shadow-amber-900/30 transition flex items-center justify-center gap-1 cursor-pointer flex-1"
        title="Buy Now Directly"
      >
        <span>⚡ Buy Now</span>
      </button>
    </div>
  </div>
</PublicLayout>
