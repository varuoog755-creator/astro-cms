          ) : (
            <p class="text-slate-600 text-sm leading-relaxed">
              Crafted in our Panipat manufacturing unit, this curtain panel combines heavyweight fabric with precision eyelet stitching to deliver superior light regulation and seamless interior aesthetic.
            </p>
          )}

          <!-- Key Performance Highlights -->
          {cleanedDesc.bullets.length > 0 && (
            <div class="pt-4 space-y-3 border-t border-slate-100">
              <h3 class="font-extrabold text-xs text-slate-900 uppercase tracking-widest">Key Features & Benefits</h3>
