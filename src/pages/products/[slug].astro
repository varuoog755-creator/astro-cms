---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { getStorefrontProducts, normalizeProductSizes } from '../../lib/products';

const { slug } = Astro.params;

const allProducts = await getStorefrontProducts();
const product = allProducts.find((p) => p.slug === slug);

if (!product) {
  return Astro.rewrite('/404');
}

const normalizedSizes = normalizeProductSizes(product.sizes, product.price, product.originalPrice);
const initialSize = normalizedSizes[0] || { name: 'Standard Size', price: product.price, originalPrice: product.originalPrice };
const initialImages = (product.colors && product.colors[0] && Array.isArray(product.colors[0].images) && product.colors[0].images.length > 0)
  ? product.colors[0].images
  : product.images;
const relatedProducts = allProducts.filter((p) => p.id !== product.id).slice(0, 4);

function parseProductDetails(raw: string, defaultName: string) {
  if (!raw) {
    return {
      paragraphs: [
        'Crafted directly in our Panipat manufacturing mills, this curtain panel combines premium 150 GSM fabric with precision eyelet stitching to deliver superior light control, smooth drape, and enduring interior beauty.'
      ],
      bullets: [
        '85%+ Sunlight & Glare Blocking for cooling ambiance',
        'Rust-proof metallic silver eyelet rings for effortless sliding',
        'Direct factory double-stitched hem and side borders',
        'Easy maintenance: 100% hand & gentle machine wash friendly'
      ],
      specs: [
        { label: 'Fabric Type', value: '100% Premium Polyester (150 GSM)' },
        { label: 'Eyelet Fitting', value: 'Stainless Steel Silver Grommets' },
        { label: 'Available Sizes', value: '5ft, 6ft, 7ft & 9ft' },
        { label: 'Care Instructions', value: 'Hand & Machine Wash Cold' },
        { label: 'Manufacturing Origin', value: 'Panipat, Haryana (India)' }
      ]
    };
  }

  const lines = raw.split('\n').map(l => l.trim()).filter(Boolean);
  const specs: { label: string; value: string }[] = [];
  const bullets: string[] = [];
  const paragraphs: string[] = [];

  const skipHeaders = new Set([
    'key features', 'key features:', 'product highlights', 'product information',
    'perfect for', 'bullet points', 'product description', 'why choose this curtain?',
    'size information', 'product details', 'about this item'
  ]);

  for (const line of lines) {
    const commaCount = (line.match(/,/g) || []).length;
    if (commaCount >= 3 && !line.includes('.') && line.length < 160) continue;

    const colonIdx = line.indexOf(':');
    if (colonIdx > 1 && colonIdx < 30) {
      const k = line.slice(0, colonIdx).trim();
      const v = line.slice(colonIdx + 1).trim();
      const kLower = k.toLowerCase();
      const vLower = v.toLowerCase();

      if (kLower === 'name' || kLower.includes('net quantity') || vLower.includes('shoe rack')) {
        continue;
      }

      if (['material', 'opacity', 'length', 'type', 'set', 'size', 'pattern', 'colour', 'eyelet', 'care', 'origin'].some(term => kLower.includes(term))) {
        if (v && !specs.some(s => s.label.toLowerCase() === kLower)) {
          specs.push({ label: k, value: v });
        }
        continue;
      }
    }

    if (line.startsWith('✔') || line.startsWith('•') || line.startsWith('- ') || line.startsWith('✓')) {
      const clean = line.replace(/^[✔•\-\u2714\u2713\s]+/, '').trim();
      if (clean.length > 5 && !bullets.includes(clean)) {
        bullets.push(clean);
      }
      continue;
    }

    if (skipHeaders.has(line.toLowerCase())) continue;

    if (line.length > 25 && !paragraphs.includes(line)) {
      paragraphs.push(line);
    }
  }

  if (bullets.length === 0) {
    bullets.push(
      'Premium 150 GSM fabric weave ensures elegant fall and rich drape',
      '85%+ room darkening and privacy protection for windows and doors',
      'Rust-proof metallic eyelet grommets for smooth movement',
      'Hand and gentle machine wash friendly'
    );
  }

  if (specs.length === 0) {
    specs.push(
      { label: 'Fabric Type', value: '100% Premium Polyester (150 GSM)' },
      { label: 'Fitting Style', value: 'Stainless Steel Silver Eyelets' },
      { label: 'Care Instructions', value: 'Hand & Machine Wash Cold' },
      { label: 'Origin', value: 'Panipat, Haryana (India)' }
    );
  }

  return { paragraphs, bullets, specs };
}

const cleanedDesc = parseProductDetails(product.description, product.name);

const customerReviews = [
  {
    name: "Pooja Sharma",
    city: "Jaipur, Rajasthan",
    rating: 5,
    date: "Verified Purchase · 3 days ago",
    title: "Fabric quality is genuine and heavy",
    comment: "Parde ka fabric bohot badhiya aur heavy quality ka hai. 7 feet door size bilkul perfect fit aaya mere hall rod par. Rings smooth slide hoti hain aur stitching ekdum clean hai."
  },
  {
    name: "Rahul Verma",
    city: "New Delhi",
    rating: 5,
    date: "Verified Purchase · 1 week ago",
    title: "Exact color as shown in photo",
    comment: "Color bilkul same hai jaisa website par dikhaya gaya tha. Din me direct sunlight aur glare ko achhe se filter karta hai. Room me elegant look aa gaya hai. Value for money purchase."
  },
  {
    name: "Anjali Gupta",
    city: "Lucknow, UP",
    rating: 5,
    date: "Verified Purchase · 2 weeks ago",
    title: "Clean stitching and fast delivery",
    comment: "Panipat direct dispatch hone se 4 din me Lucknow me deliver ho gaya. Eyelet rings rust-free metallic hain aur wash ke baad bhi fabric ka fall waise ka waisa rehta hai."
  },
  {
    name: "Vikram Malhotra",
    city: "Chandigarh",
    rating: 5,
    date: "Verified Purchase · 3 weeks ago",
    title: "Good privacy and soft fall",
    comment: "Living room ke liye Pack of 2 mangwaya tha. Bahar se visibility bilkul band ho gayi hai jab parde band hote hain. Fabric soft hai aur wrinkle-free lagta hai. Highly recommended."
  }
];

const productUgcVideos = [
  {
    src: '/ugc/product-ugc-1.mp4',
    title: 'Fabric Quality & Sunlight Test',
    tag: '⚡ 85%+ Blackout Test',
  },
  {
    src: '/ugc/product-ugc-2.mp4',
    title: 'Stainless Rings & Precision Weave',
    tag: '✨ Anti-Rust Eyelets',
  },
  {
    src: '/ugc/product-ugc-3.mp4',
    title: 'Customer Living Room Setup',
    tag: '🏡 Real Home Setup',
  },
];

const productFaqs = [
  {
    question: "Which size should I order for standard Indian doors and windows?",
    answer: "For standard windows, order 5 Feet (152 cm) or 6 Feet (183 cm). For standard room doors, order 7 Feet (213 cm). For high-ceiling doors or balcony entrances, order 9 Feet (274 cm). All panels come pre-fitted with eyelet rings."
  },
  {
    question: "What fabric material and GSM is this curtain?",
    answer: "This curtain is crafted with 100% virgin polyester 150 GSM fabric engineered at our Panipat weaving mills. It is pre-shrunk, fade-resistant, and machine-wash friendly."
  },
  {
    question: "Are the eyelet rings rust-proof during washing?",
    answer: "Yes, every ring is crafted from premium stainless alloy with a protective silver coating that will not rust or stain the drapery during hand or machine washing."
  },
  {
    question: "How many curtains are included in 1 order?",
    answer: "Every order is a Pack of 2 (Set of 2 full curtain panels) with pre-fitted grommets, ready to hang right out of the box."
  },
  {
    question: "What is the return and replacement policy?",
    answer: "We offer a 7-day doorstep replacement and return policy across India. If you need a different size or color, our Panipat support team will assist you immediately."
  }
];
---

<PublicLayout
  hideMobileNav={true}
  seo={{
    title: `${product.name} - Official Product Showcase`,
    description: product.description,
    canonicalUrl: `/products/${product.slug}`,
    ogImage: initialImages?.[0] || product.images?.[0],
    preloadLcpImage: initialImages?.[0] || product.images?.[0],
    type: 'product',
    productData: {
      name: product.name,
      price: product.price,
      currency: 'INR',
      sku: product.id,
      inStock: product.inStock,
      rating: product.rating,
      reviewCount: product.reviewCount,
      image: initialImages?.[0] || product.images?.[0],
      category: product.category,
    },
    breadcrumbs: [
      { name: 'Home', url: '/' },
      { name: 'Products', url: '/products' },
      { name: product.name, url: `/products/${product.slug}` },
    ],
  }}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 space-y-10 sm:space-y-14">
    
    <!-- Top Breadcrumb -->
    <nav class="flex text-xs font-semibold text-slate-500 gap-2 items-center" aria-label="Breadcrumb">
      <a href="/" class="hover:text-amber-800 transition">Home</a>
      <span>/</span>
      <a href="/products" class="hover:text-amber-800 transition">Shop</a>
      <span>/</span>
      <span class="text-slate-900 truncate max-w-[200px] sm:max-w-md">{product.name}</span>
    </nav>

    <!-- 1 TO 7: MAIN PRODUCT BUY BOX (Images -> Name -> Rating -> Price -> Size -> Quantity -> Buy Now) -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-md overflow-hidden grid grid-cols-1 lg:grid-cols-12 gap-0">
      
      <!-- 1. PRODUCT IMAGES (Interactive Gallery) -->
      <div class="lg:col-span-6 p-4 sm:p-6 lg:p-8 bg-slate-50/50 border-b lg:border-b-0 lg:border-r border-slate-200/80 flex flex-col justify-between">
        
        <!-- Main Image Viewport -->
        <div id="product-gallery-viewport" class="relative w-full aspect-square rounded-2xl sm:rounded-3xl overflow-hidden bg-white border border-slate-200 shadow-inner group select-none">
          
          <div
            id="product-slider-track"
            class="flex w-full h-full transition-transform duration-300 ease-out"
            style="transform: translateX(0%);"
          >
            {initialImages.map((img, idx) => (
              <div class="w-full h-full flex-shrink-0 relative flex items-center justify-center bg-slate-100" style="aspect-ratio: 1 / 1; width: 100%; height: 100%;">
                <img
                  src={img}
                  alt={`${product.name} - View ${idx + 1}`}
                  width="700"
                  height="700"
                  loading={idx === 0 ? "eager" : "lazy"}
                  fetchpriority={idx === 0 ? "high" : "auto"}
                  decoding="async"
                  class="w-full h-full object-cover select-none pointer-events-none"
                />
              </div>
            ))}
          </div>

          <!-- Top Floating Badges -->
          <div class="absolute top-3 left-3 z-20 flex flex-col gap-1.5 pointer-events-none">
            {product.badge && (
              <span class="bg-rose-600 text-white font-black text-[10px] sm:text-xs px-2.5 py-1 rounded-full uppercase tracking-wider shadow">
                🔥 {product.badge}
              </span>
            )}
            <span class="bg-slate-900/90 backdrop-blur-md text-white font-bold text-[10px] sm:text-xs px-2.5 py-1 rounded-full uppercase tracking-wider shadow">
              Pack of 2 Panels
            </span>
          </div>

          <!-- Slide Counter Badge -->
          <div class="absolute bottom-3 right-3 z-20 bg-black/70 backdrop-blur-md text-white text-[11px] font-black px-2.5 py-1 rounded-full shadow pointer-events-none">
            <span id="slider-counter">1 / {initialImages.length}</span>
          </div>
        </div>

        <!-- Slider Controls & Dots Bar -->
        <div id="slider-controls-wrap" class={`flex items-center justify-between mt-3 px-1 ${initialImages.length > 1 ? '' : 'hidden'}`}>
          <div id="slider-dots" class="flex items-center gap-1.5">
            {initialImages.map((_, idx) => (
              <button
                type="button"
                data-slide-dot={idx}
                class={`slider-dot transition-all duration-300 rounded-full cursor-pointer ${idx === 0 ? 'w-5 h-1.5 bg-amber-800' : 'w-2 h-1.5 bg-slate-300 hover:bg-slate-400'}`}
                aria-label={`Go to slide ${idx + 1}`}
              ></button>
            ))}
          </div>

          <div class="flex items-center gap-1.5">
            <button
              type="button"
              id="slider-prev-btn"
              class="w-8 h-8 rounded-full bg-white hover:bg-amber-50 active:scale-90 text-slate-700 hover:text-amber-900 border border-slate-200 shadow-sm flex items-center justify-center font-bold text-sm transition cursor-pointer select-none"
              aria-label="Previous image"
            >
              ‹
            </button>
            <button
              type="button"
              id="slider-next-btn"
              class="w-8 h-8 rounded-full bg-white hover:bg-amber-50 active:scale-90 text-slate-700 hover:text-amber-900 border border-slate-200 shadow-sm flex items-center justify-center font-bold text-sm transition cursor-pointer select-none"
              aria-label="Next image"
            >
              ›
            </button>
          </div>
        </div>

        <!-- Thumbnails Strip -->
        <div id="gallery-thumbnails-strip" class={`flex gap-2.5 sm:gap-4 mt-3 sm:mt-4 overflow-x-auto pb-1 ${initialImages.length > 1 ? '' : 'hidden'}`}>
          {initialImages.map((img, idx) => (
            <button
              type="button"
              data-slide-index={idx}
              data-img={img}
              class={`thumb-btn flex-shrink-0 w-14 h-14 sm:w-20 sm:h-20 rounded-xl overflow-hidden border-2 transition shadow-sm focus:outline-none cursor-pointer ${idx === 0 ? 'border-amber-800 ring-2 ring-amber-800/30' : 'border-slate-300 hover:border-amber-600/60 opacity-70 hover:opacity-100'}`}
            >
              <img
                src={img}
                alt={`View ${product.name} thumbnail ${idx + 1}`}
                width="80"
                height="80"
                loading="lazy"
                class="w-full h-full object-cover pointer-events-none"
              />
            </button>
          ))}
        </div>
      </div>

      <!-- 2 TO 7: DETAIL INFO COLUMN -->
      <div class="lg:col-span-6 p-5 sm:p-8 lg:p-10 space-y-5 flex flex-col justify-between">
        <div class="space-y-4">
          
          <!-- Category & Status -->
          <div class="flex items-center gap-2 overflow-x-auto whitespace-nowrap scrollbar-none">
            <span class="bg-amber-100 text-amber-900 font-extrabold text-[10px] sm:text-xs px-2.5 py-0.5 rounded-full uppercase tracking-wider border border-amber-200">
              {product.category}
            </span>
            <span class="bg-emerald-100 text-emerald-800 font-extrabold text-[10px] sm:text-xs px-2.5 py-0.5 rounded-full uppercase tracking-wider flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-600 inline-block animate-pulse"></span>
              In Stock &amp; Ready to Ship
            </span>
          </div>

          <!-- 2. PRODUCT NAME -->
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 leading-tight">
            {product.name}
          </h1>

          <!-- 3. ⭐ RATING -->
          <div class="flex items-center gap-2 sm:gap-3 text-xs font-semibold">
            <div class="flex items-center gap-0.5 text-amber-500 text-sm">
              <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
              <span class="text-slate-900 font-black ml-1">{product.rating}</span>
            </div>
            <span class="text-slate-300">|</span>
            <span class="text-slate-600 font-medium">{product.reviewCount} Verified Customer Reviews</span>
          </div>

          <!-- 4. PRICE -->
          <div class="pt-3 pb-2 border-y border-slate-100 flex items-baseline gap-3">
            <span class="text-3xl sm:text-4xl font-black text-slate-900">{product.currency}<span id="unit-price">{initialSize.price}</span></span>
            <span id="original-price-wrap" class={`text-base sm:text-lg text-slate-400 line-through font-semibold ${initialSize.originalPrice && initialSize.originalPrice > initialSize.price ? '' : 'hidden'}`}>
              {product.currency}<span id="original-price">{initialSize.originalPrice || ''}</span>
            </span>
            <span
              id="discount-badge"
              class={`bg-rose-100 text-rose-700 font-bold text-xs px-2.5 py-0.5 rounded-full ml-auto ${initialSize.originalPrice && initialSize.originalPrice > initialSize.price ? '' : 'hidden'}`}
            >
              Save {initialSize.originalPrice ? Math.round(((initialSize.originalPrice - initialSize.price) / initialSize.originalPrice) * 100) : 0}% Today
            </span>
          </div>

          <!-- Color Variations -->
          {product.colors && product.colors.length > 0 && (
            <div class="space-y-2">
              <div class="flex items-center gap-2 text-xs font-bold text-slate-700">
                <span class="uppercase tracking-wider">Color:</span>
                <span id="selected-color-label" class="text-amber-800 font-bold">{product.colors[0]?.name}</span>
              </div>
              <div class="flex flex-wrap gap-2.5">
                {product.colors.map((c, idx) => (
                  <button
                    type="button"
                    data-color={c.name}
                    data-color-index={idx}
                    class={`color-chip-btn flex items-center gap-2 px-3 py-1.5 rounded-xl border text-xs font-bold transition focus:outline-none cursor-pointer ${idx === 0 ? 'border-amber-800 ring-2 ring-amber-800/30 bg-amber-50/60 text-amber-950' : 'border-slate-200 hover:border-slate-400 bg-slate-50 text-slate-800'}`}
                  >
                    <span class="w-3.5 h-3.5 rounded-full border border-slate-400 shadow-inner" style={`background-color: ${c.hex}`}></span>
                    <span>{c.name}</span>
                  </button>
                ))}
              </div>
            </div>
          )}

          <!-- 5. SIZE SELECTOR -->
          <div class="space-y-2">
            <div class="flex items-center justify-between text-xs font-bold text-slate-700">
              <span class="uppercase tracking-wider">Select Size / Length</span>
              <div class="flex items-center gap-2">
                <span id="selected-size-label" class="text-amber-800 font-semibold">{initialSize.name}</span>
                <span id="selected-size-stock" class="text-[10px] px-2 py-0.5 rounded-full font-bold bg-emerald-100 text-emerald-800">
                  ✓ In Stock
                </span>
              </div>
            </div>
            <div class="flex flex-wrap gap-2 sm:gap-2.5">
              {normalizedSizes.map((sz, idx) => (
                <button
                  type="button"
                  data-size={sz.name}
                  data-price={sz.price}
                  data-original-price={sz.originalPrice || ''}
                  data-stock={sz.stock ?? 50}
                  data-in-stock={true}
                  class={`size-btn px-3.5 py-2 sm:px-4 sm:py-2.5 min-h-[42px] rounded-xl border-2 font-bold text-xs sm:text-sm transition focus:outline-none whitespace-nowrap flex items-center gap-1.5 cursor-pointer ${idx === 0 ? 'active-size' : ''}`}
                >
                  <span class="size-title">{sz.name}</span>
                  <span class="size-badge text-[10px] sm:text-[11px] font-black px-1.5 py-0.5 rounded-md">
                    {product.currency}{sz.price.toLocaleString('en-IN')}
                  </span>
                </button>
              ))}
            </div>
          </div>

          <!-- Pack Info Box -->
          <div class="p-3 bg-amber-50/70 border border-amber-200 rounded-2xl flex items-center justify-between text-xs">
            <div class="flex items-center gap-2 font-bold text-amber-950">
              <span>📦</span>
              <span>Pack of 2 = 2 Full Matched Panels Included</span>
            </div>
            <span class="text-[10px] font-black uppercase text-amber-800 bg-amber-100 px-2 py-0.5 rounded">
              Ready to Hang
            </span>
          </div>

          <!-- 6. QUANTITY SELECTOR -->
          <div class="space-y-2 pt-1">
            <div class="flex items-center justify-between">
              <label class="block text-xs font-bold uppercase tracking-wider text-slate-700">Quantity (Sets)</label>
              <span class="text-[10px] font-semibold text-slate-500 bg-slate-100 px-2 py-0.5 rounded">Max 10 sets per order</span>
            </div>
            <div class="flex items-center gap-3">
              <div class="flex items-center border-2 border-slate-200 rounded-xl overflow-hidden bg-slate-50">
                <button type="button" id="qty-minus-btn" class="w-11 h-11 min-w-[44px] min-h-[44px] flex items-center justify-center font-bold text-slate-800 hover:bg-slate-200 active:bg-slate-300 transition text-base cursor-pointer opacity-40 cursor-not-allowed" aria-label="Decrease quantity">-</button>
                <span id="qty-display" class="w-12 text-center font-extrabold text-sm text-slate-900 select-none">1</span>
                <button type="button" id="qty-plus-btn" class="w-11 h-11 min-w-[44px] min-h-[44px] flex items-center justify-center font-bold text-slate-800 hover:bg-slate-200 active:bg-slate-300 transition text-base cursor-pointer" aria-label="Increase quantity">+</button>
              </div>
              <span class="text-xs text-slate-500 font-medium">Subtotal: {product.currency}<span id="subtotal-price">{product.price}</span></span>
            </div>
          </div>
        </div>

        <!-- 7. BUY NOW ACTION BUTTONS -->
        <div class="pt-6 border-t border-slate-100 space-y-3">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <button
              type="button"
              id="add-cart-btn"
              class="bg-slate-100 hover:bg-slate-200 active:scale-95 text-slate-900 font-bold text-xs sm:text-sm py-4 rounded-xl border border-slate-200 shadow-xs hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>🛒 Add to Cart</span>
            </button>

            <button
              type="button"
              id="order-btn"
              class="bg-slate-900 hover:bg-slate-800 active:scale-95 text-white font-black text-xs sm:text-sm py-4 rounded-xl shadow-lg hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>⚡ Buy Now &amp; Checkout</span>
            </button>
          </div>

          <div class="flex items-center justify-center gap-6 text-[11px] text-slate-500 font-semibold pt-1">
            <span>🔒 SSL Encrypted</span>
            <span>⚡ 7-Day Replacement</span>
            <span>🚚 Free Express Shipping</span>
          </div>
        </div>

      </div>
    </div>

    <!-- 8. KEY BENEFITS -->
    <div class="bg-white rounded-3xl border border-slate-200 shadow-md p-6 sm:p-10 space-y-6">
      <div class="border-b border-slate-100 pb-4">
        <span class="text-[10px] font-black uppercase tracking-widest text-amber-900 bg-amber-50 border border-amber-200 px-3 py-1 rounded-full">CORE ADVANTAGES</span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 mt-2">Key Benefits of Teepul Curtains</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <div class="p-5 rounded-2xl bg-amber-50/50 border border-amber-200/70 space-y-2">
          <div class="text-2xl">☀️</div>
          <h3 class="font-extrabold text-sm text-slate-900">85%+ Room Darkening</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Blocks direct sun glare and keeps indoor temperatures pleasantly cool during hot afternoons.</p>
        </div>

        <div class="p-5 rounded-2xl bg-emerald-50/50 border border-emerald-200/70 space-y-2">
          <div class="text-2xl">🛡️</div>
          <h3 class="font-extrabold text-sm text-slate-900">100% Privacy Protection</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Dense 150 GSM weave ensures complete privacy with zero outdoor visibility even with lights on.</p>
        </div>

        <div class="p-5 rounded-2xl bg-blue-50/50 border border-blue-200/70 space-y-2">
          <div class="text-2xl">🧺</div>
          <h3 class="font-extrabold text-sm text-slate-900">Machine Wash Safe</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Pre-shrunk fabric and colorfast dyeing guarantee zero shrinkage and zero color bleeding in cold wash.</p>
        </div>

        <div class="p-5 rounded-2xl bg-purple-50/50 border border-purple-200/70 space-y-2">
