---
import PublicLayout from '../../layouts/PublicLayout.astro';
import BlockRenderer from '../../components/editor/BlockRenderer.astro';
import prisma from '../../lib/db';

const { slug } = Astro.params;

// Check redirect table first
const redirectRecord = await prisma.redirect.findUnique({
  where: { sourceUrl: `/blog/${slug}` },
});

if (redirectRecord) {
  // Update hit count asynchronously
  await prisma.redirect.update({
    where: { id: redirectRecord.id },
    data: { hitCount: { increment: 1 } },
  }).catch(() => {});

  return Astro.redirect(redirectRecord.targetUrl, redirectRecord.statusCode);
}

const post = await prisma.post.findUnique({
  where: { slug },
  include: {
    author: true,
    categories: { include: { category: true } },
    tags: { include: { tag: true } },
    comments: {
      where: { status: 'approved' },
      orderBy: { createdAt: 'desc' },
    },
  },
});

if (!post || post.status === 'trash') {
  return Astro.redirect('/404');
}

// Increment post views count
await prisma.post.update({
  where: { id: post.id },
  data: { viewsCount: { increment: 1 } },
}).catch(() => {});
---

<PublicLayout
  seo={{
    title: post.title,
    description: post.excerpt || undefined,
    type: 'article',
    publishedTime: post.publishedAt?.toISOString(),
    authorName: post.author.displayName,
    breadcrumbs: [
      { name: 'Home', url: '/' },
      { name: 'Blog', url: '/blog' },
      { name: post.title, url: `/blog/${post.slug}` },
    ],
  }}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Post Header -->
    <header class="mb-10 text-center space-y-4">
      <div class="flex items-center justify-center gap-2">
        {post.categories.map((c) => (
          <a href={`/category/${c.category.slug}`} class="bg-blue-100 text-blue-800 font-bold px-3 py-1 rounded-full text-xs hover:bg-blue-200 transition">
            {c.category.name}
          </a>
        ))}
      </div>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-gray-900 leading-tight tracking-tight">
        {post.title}
      </h1>

      <div class="flex items-center justify-center gap-4 text-xs text-gray-500 font-medium">
        <span class="text-gray-900 font-semibold">By {post.author.displayName}</span>
        <span>·</span>
        <span>{new Date(post.publishedAt || post.createdAt).toLocaleDateString()}</span>
      </div>
    </header>

    <!-- Block Content -->
    <div class="bg-white p-8 md:p-12 rounded-3xl border border-gray-200 shadow-sm mb-12">
      <BlockRenderer content={post.content} />
    </div>

    <!-- Tags -->
    {post.tags.length > 0 && (
      <div class="flex items-center gap-2 mb-12">
        <span class="text-xs font-bold uppercase text-gray-400">Tags:</span>
        {post.tags.map((t) => (
          <a href={`/tag/${t.tag.slug}`} class="bg-gray-100 hover:bg-gray-200 text-gray-700 text-xs font-medium px-2.5 py-1 rounded-md transition">
            #{t.tag.name}
          </a>
        ))}
      </div>
    )}

    <!-- Author Box -->
    <div class="bg-slate-900 text-white p-6 rounded-2xl mb-16 flex items-center gap-4">
      <div class="w-12 h-12 bg-blue-600 rounded-full flex items-center justify-center font-bold text-lg">
        {post.author.displayName[0]}
      </div>
      <div>
        <div class="font-bold text-base">{post.author.displayName}</div>
        <p class="text-xs text-slate-300 mt-0.5">{post.author.bio || 'Author at Astro CMS.'}</p>
      </div>
    </div>

    <!-- Comments Section -->
    <section class="space-y-8">
      <h3 class="text-2xl font-bold text-gray-900">Comments ({post.comments.length})</h3>

      <!-- Approved Comments List -->
      <div class="space-y-4">
        {post.comments.map((comment) => (
          <div class="bg-white p-6 rounded-2xl border border-gray-200 shadow-sm space-y-2">
            <div class="flex items-center justify-between text-xs text-gray-500">
              <span class="font-bold text-gray-900">{comment.authorName}</span>
              <span>{new Date(comment.createdAt).toLocaleDateString()}</span>
            </div>
            <p class="text-sm text-gray-700 leading-relaxed">{comment.content}</p>
          </div>
        ))}
      </div>

      <!-- Add Comment Form -->
      <div class="bg-white p-8 rounded-2xl border border-gray-200 shadow-sm space-y-4">
        <h4 class="font-bold text-lg text-gray-900">Leave a Reply</h4>

        <form action="/api/comments" method="POST" class="space-y-4">
          <input type="hidden" name="postId" value={post.id} />
          
          <!-- Honeypot anti-spam input (hidden from real users) -->
          <input type="text" name="website" tabIndex={-1} autoComplete="off" class="hidden" />

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-gray-700 mb-1">Name</label>
              <input type="text" name="authorName" required class="w-full text-xs border border-gray-300 rounded-lg px-3 py-2" />
            </div>

            <div>
              <label class="block text-xs font-semibold text-gray-700 mb-1">Email</label>
              <input type="email" name="authorEmail" required class="w-full text-xs border border-gray-300 rounded-lg px-3 py-2" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-gray-700 mb-1">Comment</label>
            <textarea name="content" rows="4" required class="w-full text-xs border border-gray-300 rounded-lg p-3"></textarea>
          </div>

          <button type="submit" class="bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs px-6 py-3 rounded-xl shadow transition">
            Submit Comment
          </button>
        </form>
      </div>
    </section>
  </article>
</PublicLayout>
