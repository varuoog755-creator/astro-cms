---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { getStorefrontBlogs } from '../../lib/blogs';

const posts = await getStorefrontBlogs();
---

<PublicLayout
  seo={{
    title: `Teepul Home Decor Blog - Product Guides & Interior Design Tips (${posts.length})`,
    description: 'Explore expert buying guides, 3D interactive specs, and interior styling advice for all 19 Teepul luxury door curtains, window drapes, and ambient lighting items.',
    canonicalUrl: '/blog',
  }}
>
  <div class="relative bg-gradient-to-b from-[#f7f4ef] via-[#faf8f4] to-[#f4efe6] text-slate-900 overflow-hidden py-14 px-4 sm:px-6 lg:px-8 border-b border-amber-900/10 mb-8">
    <div class="max-w-7xl mx-auto text-center space-y-3">
      <span class="inline-flex items-center gap-2 bg-amber-900/10 border border-amber-900/20 text-amber-900 text-xs font-black px-4 py-1.5 rounded-full uppercase tracking-wider">
        <span>📚 Teepul SEO & GEO Decor Guides</span>
      </span>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-950 tracking-tight">
        Product Buying Guides & <span class="bg-gradient-to-r from-amber-800 via-amber-700 to-amber-900 bg-clip-text text-transparent">Interior Design Journal</span>
      </h1>
      <p class="max-w-2xl mx-auto text-slate-700 text-xs sm:text-sm font-medium">
        Deep technical specs, premium polyester fabric guides, color matching advice, and 3D visual previews for every Teepul product.
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <div class="flex items-center justify-between mb-8 pb-4 border-b border-slate-200">
      <h2 class="text-xl font-extrabold text-slate-900">All Product Guides ({posts.length})</h2>
      <span class="text-xs text-amber-800 font-bold uppercase tracking-wider bg-amber-50 px-3 py-1 rounded-full border border-amber-200">
        AI Overview & Google Search Optimized
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {posts.map((post) => (
        <article class="bg-white rounded-3xl border border-slate-200 shadow-sm p-6 flex flex-col justify-between hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group">
          <div class="space-y-4">
            <div class="flex items-center gap-2">
              {post.categories.map((c) => (
                <span class="bg-amber-50 text-amber-900 font-bold px-2.5 py-0.5 rounded-full text-[10px] uppercase tracking-wider border border-amber-200">
                  {c.category.name}
                </span>
              ))}
            </div>
            
            <h2 class="font-extrabold text-base text-slate-900 group-hover:text-amber-800 transition leading-snug">
              <a href={`/blog/${post.slug}`}>
                {post.title}
              </a>
            </h2>
            
            <p class="text-xs text-slate-500 line-clamp-3 leading-relaxed font-medium">{post.excerpt}</p>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
            <span class="text-slate-800 font-bold">By {post.author.displayName}</span>
            <a href={`/blog/${post.slug}`} class="text-amber-800 font-bold hover:underline flex items-center gap-1">
              <span>Read Guide</span>
              <span>&rarr;</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</PublicLayout>
