---
import PublicLayout from '../../layouts/PublicLayout.astro';
import prisma from '../../lib/db';

let posts: any[] = [];
try {
  posts = await prisma.post.findMany({
    where: { status: 'published' },
    orderBy: { publishedAt: 'desc' },
    include: { author: true, categories: { include: { category: true } } },
  });
} catch (error) {
  console.error('Failed to fetch blog posts:', error);
}
---

<PublicLayout seo={{ title: 'Blog Archive' }}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl font-extrabold text-gray-900 mb-8">All Blog Posts</h1>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {posts.map((post) => (
        <article class="bg-white rounded-2xl border border-gray-200 shadow-sm p-6 flex flex-col justify-between hover:shadow-md transition">
          <div class="space-y-3">
            <div class="flex items-center gap-2">
              {post.categories.map((c) => (
                <span class="bg-blue-50 text-blue-700 font-bold px-2 py-0.5 rounded text-[10px]">
                  {c.category.name}
                </span>
              ))}
            </div>
            <h2 class="font-bold text-lg text-gray-900 leading-snug">
              <a href={`/blog/${post.slug}`} class="hover:text-blue-600 transition">
                {post.title}
              </a>
            </h2>
            <p class="text-xs text-gray-600 line-clamp-3">{post.excerpt}</p>
          </div>

          <div class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between text-xs text-gray-500">
            <span>By {post.author.displayName}</span>
            <span>{new Date(post.publishedAt || post.createdAt).toLocaleDateString()}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</PublicLayout>
