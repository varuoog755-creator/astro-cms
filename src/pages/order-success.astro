---
import Layout from '../layouts/Layout.astro';

const { searchParams } = Astro.url;
const orderNumber = searchParams.get('order') || 'ORD-98241';
---

<Layout title="Order Confirmed &mdash; Teepul Streetwear" description="Thank you for your order! Your 240 GSM heavyweight streetwear drop is being prepared.">
  <section style="padding: 5rem 0; text-align: center;">
    <div class="container" style="max-width: 600px;">
      <div style="width: 80px; height: 80px; background: #34c759; color: #fff; font-size: 2.5rem; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
        ✓
      </div>

      <span style="background: #e5f9e7; color: #1e7e34; font-size: 0.82rem; font-weight: 800; padding: 4px 12px; border-radius: 20px;">
        ORDER CONFIRMED &bull; CASH ON DELIVERY
      </span>

      <h1 style="font-size: 2.8rem; font-weight: 900; margin: 1rem 0 0.5rem; font-family: 'Outfit', sans-serif;">
        Thank You for Your Order!
      </h1>

      <p style="color: #636366; font-size: 1.1rem; line-height: 1.6; margin-bottom: 2rem;">
        Order <strong style="color: #000;">#{orderNumber}</strong> has been successfully placed. Our warehouse is preparing your 240 GSM heavyweight apparel drop for dispatch within 24 hours.
      </p>

      <div style="background: #fafafa; border: 1px solid #e5e5ea; padding: 2rem; border-radius: 12px; text-align: left; margin-bottom: 2.5rem;">
        <h3 style="margin: 0 0 1rem; font-size: 1.1rem; font-weight: 800;">Order Status & Tracking</h3>
        <div style="font-size: 0.9rem; color: #3a3a3c; display: flex; flex-direction: column; gap: 0.6rem;">
          <div>📦 <strong>Order Number:</strong> #{orderNumber}</div>
          <div>🚚 <strong>Estimated Delivery:</strong> 2 to 4 Business Days</div>
          <div>💵 <strong>Payment Status:</strong> Cash on Delivery (COD)</div>
          <div>📱 <strong>SMS & WhatsApp Updates:</strong> Sent to your mobile number</div>
        </div>
      </div>

      <div style="display: flex; gap: 1rem; justify-content: center;">
        <a href="/products" style="background: #000; color: #fff; padding: 0.85rem 2rem; border-radius: 8px; font-weight: 800; text-decoration: none;">
          Continue Shopping &rarr;
        </a>
        <a href="/" style="background: #f2f2f7; color: #000; padding: 0.85rem 2rem; border-radius: 8px; font-weight: 800; text-decoration: none;">
          Go to Home
        </a>
      </div>
    </div>
  </section>
</Layout>
