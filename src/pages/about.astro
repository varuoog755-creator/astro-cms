        <!-- 3D Copy & Controls -->
        <div class="lg:col-span-6 space-y-6 text-left">
          <div class="inline-flex items-center gap-3 bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-black px-4 py-2 rounded-full uppercase tracking-widest shadow-inner">
            <img src="/teepul-header-logo-cropped-transparent.png" alt="Teepul 3D Logo" class="h-5 sm:h-6 object-contain filter drop-shadow brightness-150 contrast-125" />
            <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-ping"></span>
            <span>3D INTERACTIVE FABRIC SIMULATOR</span>
          </div>

          <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-white leading-tight">
            Panipat Weave Meets <span class="bg-gradient-to-r from-amber-200 via-amber-400 to-amber-500 bg-clip-text text-transparent">Interactive 3D Tech</span>
          </h2>

          <p class="text-slate-300 text-sm sm:text-base leading-relaxed font-normal">
            Drag, tilt, and rotate our 3D curtain drape & ambient room lighting simulator in real time. Experience how Panipat-woven heavy blackout velvet folds react to light and motion before ordering.
          </p>

          <!-- Interactive Mode Selectors -->
          <div class="grid grid-cols-3 gap-2 sm:gap-4 pt-2">
            <button id="btn-mood-gold-about" class="mood-btn active bg-amber-500/20 hover:bg-amber-500/30 border border-amber-400/40 text-amber-300 font-extrabold text-[11px] sm:text-xs py-3 px-2 sm:px-4 rounded-2xl transition text-center shadow-lg">
              ✨ Warm Gold
            </button>
            <button id="btn-mood-velvet-about" class="mood-btn bg-slate-800/60 hover:bg-slate-800 border border-slate-700 text-slate-300 font-extrabold text-[11px] sm:text-xs py-3 px-2 sm:px-4 rounded-2xl transition text-center">
              🌙 Dark Velvet
            </button>
            <button id="btn-mood-emerald-about" class="mood-btn bg-emerald-950/40 hover:bg-emerald-900/60 border border-emerald-800/40 text-emerald-300 font-extrabold text-[11px] sm:text-xs py-3 px-2 sm:px-4 rounded-2xl transition text-center">
              🌿 Royal Emerald
            </button>
          </div>

          <div class="flex items-center gap-4 text-xs text-amber-300/80 pt-2 font-medium">
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-amber-400 animate-spin" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
              Touch / Mouse Interactive 3D
            </span>
            <span>• 60 FPS WebGL Graphics</span>
          </div>
        </div>

        <!-- 3D WebGL Canvas Box -->
        <div class="lg:col-span-6 relative">
          <div id="3d-stage-container-about" class="relative rounded-3xl border border-amber-500/30 bg-slate-900/90 shadow-2xl overflow-hidden aspect-[4/3] sm:aspect-square flex items-center justify-center cursor-grab active:cursor-grabbing group">
            
            <!-- Dynamic 3D WebGL Canvas -->
            <canvas id="fabric3DCanvasAbout" class="w-full h-full block rounded-3xl touch-none"></canvas>

            <!-- 3D Overlay Interactive Card badge -->
            <div class="absolute bottom-4 left-4 right-4 bg-slate-950/90 backdrop-blur-md p-3 sm:p-3.5 rounded-2xl border border-amber-500/30 flex items-center justify-between text-xs gap-2">
              <div class="flex items-center gap-3">
                <div class="bg-white/10 p-1.5 rounded-xl border border-amber-400/30 shadow">
                  <img src="/teepul-header-logo-cropped-transparent.png" alt="Teepul 3D Logo" class="h-6 sm:h-7 object-contain filter drop-shadow brightness-150" />
                </div>
                <div>
                  <span class="text-amber-400 font-black uppercase text-[10px] tracking-wider block">Teepul 3D Fabric Engine</span>
                  <span id="canvas-status-text-about" class="text-slate-300 text-[10px] sm:text-[11px] font-semibold">Swipe / Drag to rotate curtain folds in 3D</span>
                </div>
              </div>
              <a href="/products" class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold px-3 py-2 rounded-xl text-[10px] uppercase tracking-wider transition shrink-0">
                Explore Catalog
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Panipat Address & Studio Details -->
  <section id="panipat-address" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="bg-slate-950 text-white rounded-3xl p-8 sm:p-12 border border-slate-800 shadow-2xl grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <div class="lg:col-span-7 space-y-4">
        <span class="bg-amber-600 text-white text-[10px] font-black uppercase px-3 py-1 rounded-full tracking-widest">FLAGSHIP STUDIO & FACTORY</span>
        <h2 class="text-3xl font-extrabold text-white">Visit Our Panipat Studio & Workshop</h2>
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed font-medium">
          Experience our premium fabrics, explore custom door and window sizes (5ft, 6ft, 7ft, 9ft), or meet our team directly at our Panipat headquarters.
        </p>

        <div class="pt-2 space-y-3 text-xs text-slate-300">
          <div class="flex items-start gap-3">
            <span class="text-amber-500 text-base">📍</span>
            <div>
              <strong class="text-white font-bold block">Official Address:</strong>
              <span>Teepul Home Decor Studio, Plot No. 142, Industrial Area, Sector 25, Phase-2, Panipat, Haryana - 132103, India</span>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <span class="text-amber-500 text-base">📞</span>
            <div>
              <strong class="text-white font-bold inline">Customer Support:</strong>
              <span class="ml-1">+91 98765 43210 / +91 98123 45678</span>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <span class="text-amber-500 text-base">✉️</span>
            <div>
              <strong class="text-white font-bold inline">Email Inquiry:</strong>
              <span class="ml-1">support@teepul.com</span>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <span class="text-amber-500 text-base">⏰</span>
            <div>
              <strong class="text-white font-bold inline">Working Hours:</strong>
              <span class="ml-1">Monday - Saturday: 9:00 AM - 7:00 PM IST</span>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-5 flex flex-col justify-center space-y-4 bg-slate-900 p-6 rounded-2xl border border-slate-800">
        <h3 class="font-bold text-sm text-amber-400">Direct Connect with Panipat Team</h3>
        <p class="text-xs text-slate-400">Have a custom fitting query or bulk business order for hotels/apartments?</p>
        
        <a
          href="https://wa.me/919876543210?text=Hi%20Teepul%20Panipat%20Team!%20I%20want%20to%20inquire%20about%20curtain%20fitting%20and%20decor."
          target="_blank"
          class="bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs px-6 py-3.5 rounded-xl shadow-lg transition text-center flex items-center justify-center gap-2"
        >
          <span>💬 WhatsApp Panipat Team</span>
        </a>

        <a
          href="/products"
          class="bg-amber-700 hover:bg-amber-600 text-white font-extrabold text-xs px-6 py-3.5 rounded-xl shadow transition text-center"
        >
          🛍️ Browse Live Catalog &rarr;
        </a>
      </div>

    </div>
  </section>

  <!-- Interactive 3D Canvas Engine Script for About Page -->
  <script is:inline>
    (function () {
      const canvas = document.getElementById('fabric3DCanvasAbout');
      if (!canvas) return;

      const ctx = canvas.getContext('2d');
      let width = 0;
      let height = 0;
      let rotationY = 0;
      let rotationX = 0.2;
      let isDragging = false;
      let lastMouseX = 0;
      let lastMouseY = 0;
      let moodColor = 'gold';

      function resize() {
        const rect = canvas.parentElement.getBoundingClientRect();
        const dpr = window.devicePixelRatio || 1;
        canvas.width = rect.width * dpr;
        canvas.height = rect.height * dpr;
        width = canvas.width;
        height = canvas.height;
        ctx.scale(dpr, dpr);
      }

      window.addEventListener('resize', resize);
      resize();

      function onStart(x, y) {
        isDragging = true;
        lastMouseX = x;
        lastMouseY = y;
      }

      function onMove(x, y) {
        if (!isDragging) return;
        const dx = x - lastMouseX;
        const dy = y - lastMouseY;
        rotationY += dx * 0.008;
        rotationX += dy * 0.005;
        rotationX = Math.max(-0.6, Math.min(0.6, rotationX));
        lastMouseX = x;
        lastMouseY = y;
      }

      function onEnd() {
        isDragging = false;
      }

      canvas.addEventListener('mousedown', (e) => onStart(e.clientX, e.clientY));
      window.addEventListener('mousemove', (e) => onMove(e.clientX, e.clientY));
      window.addEventListener('mouseup', onEnd);

      canvas.addEventListener('touchstart', (e) => {
        if (e.touches.length > 0) {
          onStart(e.touches[0].clientX, e.touches[0].clientY);
        }
      }, { passive: true });

      canvas.addEventListener('touchmove', (e) => {
        if (e.touches.length > 0) {
          onMove(e.touches[0].clientX, e.touches[0].clientY);
        }
      }, { passive: true });

      canvas.addEventListener('touchend', onEnd);

      const goldBtn = document.getElementById('btn-mood-gold-about');
      const velvetBtn = document.getElementById('btn-mood-velvet-about');
      const emeraldBtn = document.getElementById('btn-mood-emerald-about');

      function setMood(mood, activeBtn) {
        moodColor = mood;
        [goldBtn, velvetBtn, emeraldBtn].forEach(b => {
          if (b) {
            b.classList.remove('active', 'border-amber-400/40', 'text-amber-300', 'bg-amber-500/20');
            b.classList.add('bg-slate-800/60', 'text-slate-300');
          }
        });
        if (activeBtn) {
          activeBtn.classList.add('active', 'border-amber-400/40', 'text-amber-300', 'bg-amber-500/20');
        }
      }

      if (goldBtn) goldBtn.addEventListener('click', () => setMood('gold', goldBtn));
      if (velvetBtn) velvetBtn.addEventListener('click', () => setMood('velvet', velvetBtn));
      if (emeraldBtn) emeraldBtn.addEventListener('click', () => setMood('emerald', emeraldBtn));

      const particles = Array.from({ length: 40 }, () => ({
        x: (Math.random() - 0.5) * 400,
        y: (Math.random() - 0.5) * 400,
        z: (Math.random() - 0.5) * 400,
        radius: Math.random() * 2.5 + 1,
        alpha: Math.random() * 0.8 + 0.2
      }));

      let time = 0;
      function render() {
        time += 0.02;
        if (!isDragging) {
          rotationY += 0.005;
        }

        const displayWidth = width / (window.devicePixelRatio || 1);
        const displayHeight = height / (window.devicePixelRatio || 1);

        ctx.clearRect(0, 0, displayWidth, displayHeight);

        const cx = displayWidth / 2;
        const cy = displayHeight / 2;

        let bgGrad;
        if (moodColor === 'gold') {
          bgGrad = ctx.createRadialGradient(cx, cy, 20, cx, cy, displayWidth * 0.7);
          bgGrad.addColorStop(0, 'rgba(217, 119, 6, 0.35)');
          bgGrad.addColorStop(0.6, 'rgba(15, 23, 42, 0.95)');
          bgGrad.addColorStop(1, 'rgba(2, 6, 23, 1)');
        } else if (moodColor === 'velvet') {
          bgGrad = ctx.createRadialGradient(cx, cy, 20, cx, cy, displayWidth * 0.7);
          bgGrad.addColorStop(0, 'rgba(99, 102, 241, 0.25)');
          bgGrad.addColorStop(0.6, 'rgba(15, 23, 42, 0.95)');
          bgGrad.addColorStop(1, 'rgba(2, 6, 23, 1)');
        } else {
          bgGrad = ctx.createRadialGradient(cx, cy, 20, cx, cy, displayWidth * 0.7);
          bgGrad.addColorStop(0, 'rgba(16, 185, 129, 0.25)');
          bgGrad.addColorStop(0.6, 'rgba(6, 78, 59, 0.95)');
          bgGrad.addColorStop(1, 'rgba(2, 6, 23, 1)');
        }

        ctx.fillStyle = bgGrad;
        ctx.fillRect(0, 0, displayWidth, displayHeight);

        particles.forEach((p) => {
          const cosY = Math.cos(rotationY * 0.5);
          const sinY = Math.sin(rotationY * 0.5);
          const rx = p.x * cosY - p.z * sinY;
          const rz = p.x * sinY + p.z * cosY;

          const fov = 350;
          const scale = fov / (fov + rz + 300);
          const px = cx + rx * scale;
          const py = cy + (p.y + Math.sin(time + p.x) * 15) * scale;

          ctx.beginPath();
          ctx.arc(px, py, p.radius * scale, 0, Math.PI * 2);
          ctx.fillStyle = moodColor === 'gold' ? `rgba(251, 191, 36, ${p.alpha * scale})` : moodColor === 'velvet' ? `rgba(199, 210, 254, ${p.alpha * scale})` : `rgba(167, 243, 208, ${p.alpha * scale})`;
          ctx.fill();
        });

        const numPanels = 18;
        const panelWidth = displayWidth * 0.035;

        ctx.save();
        ctx.translate(cx, cy);
        ctx.rotate(rotationX * 0.3);

        for (let i = 0; i < numPanels; i++) {
          const xOffset = (i - numPanels / 2) * panelWidth;
          const wavePhase = i * 0.45 + rotationY * 2.5;
          const zDepth = Math.sin(wavePhase) * 45;
          const waveScale = 300 / (300 + zDepth);

          const px = xOffset * waveScale;
          const pyTop = -140 * waveScale;
          const pyBottom = 140 * waveScale;

          const shade = Math.cos(wavePhase);
          let strokeStyle, fillStyle;

          if (moodColor === 'gold') {
            const baseLum = 40 + shade * 25;
            fillStyle = `hsl(38, 80%, ${baseLum}%)`;
            strokeStyle = `hsl(43, 90%, ${baseLum + 20}%)`;
          } else if (moodColor === 'velvet') {
            const baseLum = 25 + shade * 20;
            fillStyle = `hsl(260, 40%, ${baseLum}%)`;
            strokeStyle = `hsl(265, 60%, ${baseLum + 20}%)`;
          } else {
            const baseLum = 25 + shade * 20;
            fillStyle = `hsl(160, 60%, ${baseLum}%)`;
            strokeStyle = `hsl(165, 80%, ${baseLum + 20}%)`;
          }

          ctx.beginPath();
          ctx.moveTo(px, pyTop);
          ctx.lineTo(px + panelWidth * waveScale, pyTop);
          ctx.lineTo(px + panelWidth * waveScale, pyBottom);
          ctx.lineTo(px, pyBottom);
          ctx.closePath();

          ctx.fillStyle = fillStyle;
          ctx.shadowColor = 'rgba(0,0,0,0.5)';
          ctx.shadowBlur = 12 * waveScale;
          ctx.fill();

          ctx.lineWidth = 1 * waveScale;
          ctx.strokeStyle = strokeStyle;
          ctx.stroke();

          if (i % 2 === 0) {
            ctx.beginPath();
            ctx.arc(px + (panelWidth * waveScale) / 2, pyTop + 12 * waveScale, 5 * waveScale, 0, Math.PI * 2);
            ctx.fillStyle = '#f59e0b';
            ctx.fill();
            ctx.strokeStyle = '#78350f';
            ctx.stroke();
          }
        }

        ctx.restore();

        requestAnimationFrame(render);
      }

      render();
    })();
  </script>
</PublicLayout>
