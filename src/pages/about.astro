---
import PublicLayout from '../layouts/PublicLayout.astro';
---

<PublicLayout seo={{ title: 'About Teepul - Luxury Home Drapery & Ambient Decor' }}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center space-y-4 mb-16">
      <span class="bg-amber-900/10 text-amber-900 font-black text-xs px-4 py-1.5 rounded-full uppercase tracking-wider">
        THE TEEPUL STORY
      </span>
      <h1 class="text-4xl sm:text-5xl font-black text-slate-950">Architectural Home Elegance</h1>
      <p class="max-w-2xl mx-auto text-slate-600 text-sm sm:text-base leading-relaxed font-medium">
        Teepul delivers 350 GSM thermal blackout door curtains, French sheer window drapes, and dimmable frosted glass lighting across India.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm space-y-3">
        <div class="text-3xl">✨</div>
        <h3 class="font-extrabold text-slate-900 text-lg">Premium Materials</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Crafted from 350 GSM micro-velvet and heavyweight linen blends with stainless steel brass grommets.
        </p>
      </div>

      <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm space-y-3">
        <div class="text-3xl">🌙</div>
        <h3 class="font-extrabold text-slate-900 text-lg">100% Thermal Blackout</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Blocks 99% light and insulates rooms against heat, cold, and external noise.
        </p>
      </div>

      <div class="bg-white p-8 rounded-3xl border border-slate-200 shadow-sm space-y-3">
        <div class="text-3xl">🚀</div>
        <h3 class="font-extrabold text-slate-900 text-lg">Pan-India Express</h3>
        <p class="text-xs text-slate-500 leading-relaxed">
          Fast doorstep delivery with Razorpay, Paytm, Cash on Delivery, and direct WhatsApp support.
        </p>
      </div>
    </div>
  </div>
</PublicLayout>
