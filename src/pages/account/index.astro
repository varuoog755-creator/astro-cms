---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { getSession } from '../../lib/auth/session';
import prisma from '../../lib/db';

const sessionToken = Astro.cookies.get('cms_session_token')?.value;
const session = sessionToken ? await getSession(sessionToken) : null;

if (!session) {
  return Astro.redirect('/login');
}

// Fetch complete user profile from DB
let dbUser: any = null;
try {
  dbUser = await prisma.user.findUnique({
    where: { id: session.userId },
  });
} catch (e) {
  console.error('Failed to fetch user:', e);
}

// Fetch customer orders
let customerOrders: any[] = [];
try {
  customerOrders = await prisma.order.findMany({
    where: {
      customerEmail: session.email,
    },
    include: {
      items: true,
    },
    orderBy: {
      createdAt: 'desc',
    },
  });
} catch (error) {
  console.error('Failed to fetch customer orders:', error);
}

const userProfile = {
  displayName: dbUser?.displayName || session.displayName || session.username,
  email: session.email,
  phone: dbUser?.phone || '',
  address: dbUser?.address || '',
  city: dbUser?.city || '',
  state: dbUser?.state || '',
  pincode: dbUser?.pincode || '',
  role: session.role,
};
---

<PublicLayout
  seo={{
    title: `Customer Account - ${userProfile.displayName}`,
    description: 'Manage your profile details, shipping address, and track your orders.',
    robots: 'noindex, nofollow',
    canonicalUrl: '/account',
  }}
>
  <div class="bg-[#faf9f6] min-h-screen py-10 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">

      <!-- Header Greeting Banner -->
      <div class="bg-gradient-to-r from-amber-900 via-amber-800 to-amber-950 text-white rounded-3xl p-6 sm:p-10 shadow-xl border border-amber-800/30 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 relative overflow-hidden">
        <div class="space-y-2 z-10">
          <div class="inline-flex items-center gap-2 bg-amber-500/20 border border-amber-400/30 text-amber-200 text-xs font-black px-3.5 py-1 rounded-full uppercase tracking-wider">
            <span>✨ Customer Portal</span>
          </div>
          <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight">
            Welcome back, {userProfile.displayName}! 👋
          </h1>
          <p class="text-xs sm:text-sm text-amber-200/90 font-medium">
            Member Email: <span class="font-mono underline">{userProfile.email}</span>
          </p>
        </div>

        <div class="flex items-center gap-3 z-10">
          <a
            href="/products"
            class="bg-white text-slate-900 hover:bg-amber-100 font-extrabold text-xs px-5 py-3 rounded-2xl shadow transition flex items-center gap-1.5"
          >
            <span>🛍️ Browse Store</span>
          </a>
          
          <button
            type="button"
            id="account-logout-btn"
            class="bg-red-600 hover:bg-red-700 text-white font-extrabold text-xs px-5 py-3 rounded-2xl shadow transition flex items-center gap-1.5"
          >
            <span>🚪 Logout</span>
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

        <!-- Left Column: Editable Profile & Address Form -->
        <div class="lg:col-span-5 space-y-6">
          <div class="bg-white rounded-3xl p-6 sm:p-7 border border-slate-200 shadow-sm space-y-5">
            <div class="border-b border-slate-100 pb-3 flex items-center justify-between">
              <h2 class="text-base font-extrabold text-slate-900 flex items-center gap-2">
                <span>👤</span> My Profile & Address Details
              </h2>
              <span class="text-[10px] bg-amber-100 text-amber-900 font-black px-2.5 py-0.5 rounded-full uppercase">
                EDITABLE
              </span>
            </div>

            <form id="profile-form" class="space-y-4">
              <div id="profile-alert" class="hidden p-3 rounded-xl text-xs font-bold text-center"></div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Full Name *</label>
                <input
                  type="text"
                  name="displayName"
                  value={userProfile.displayName}
                  required
                  placeholder="e.g. Rahul Sharma"
                  class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-amber-500 font-medium"
                />
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Phone Number (For Delivery SMS)</label>
                <input
                  type="tel"
                  name="phone"
                  value={userProfile.phone}
                  placeholder="e.g. 9896374239"
                  class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-4 py-2.5 focus:outline-none focus:ring-2 focus:ring-amber-500 font-medium"
                />
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Delivery Address</label>
                <textarea
                  name="address"
                  rows="2"
                  placeholder="House/Flat No., Street, Landmark"
                  class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl p-3 focus:outline-none focus:ring-2 focus:ring-amber-500 font-medium"
                >{userProfile.address}</textarea>
              </div>

              <div class="grid grid-cols-3 gap-2.5">
                <div>
                  <label class="block text-[11px] font-bold text-slate-700 mb-1">Pincode</label>
                  <input
                    type="text"
                    name="pincode"
                    value={userProfile.pincode}
                    placeholder="110001"
                    class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 font-mono"
                  />
                </div>
                <div>
                  <label class="block text-[11px] font-bold text-slate-700 mb-1">City</label>
                  <input
                    type="text"
                    name="city"
                    value={userProfile.city}
                    placeholder="Delhi"
                    class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-3 py-2"
                  />
                </div>
                <div>
                  <label class="block text-[11px] font-bold text-slate-700 mb-1">State</label>
                  <input
                    type="text"
                    name="state"
                    value={userProfile.state}
                    placeholder="Delhi"
                    class="w-full text-xs bg-slate-50 border border-slate-300 rounded-xl px-3 py-2"
                  />
                </div>
              </div>

              <div class="pt-2">
                <button
                  type="submit"
                  id="save-profile-btn"
                  class="w-full bg-amber-800 hover:bg-amber-900 text-white font-extrabold text-xs py-3 rounded-2xl shadow transition flex items-center justify-center gap-2"
                >
                  <span>💾 Save Profile Details</span>
                </button>
              </div>
            </form>
          </div>

          <div class="bg-amber-50/70 border border-amber-200 p-5 rounded-3xl text-xs space-y-2">
            <h3 class="font-extrabold text-amber-900 flex items-center gap-1.5">
              <span>🛡️</span> Customer Service & Order Support
            </h3>
            <p class="text-amber-800/90 leading-relaxed text-[11px]">
              Need help with curtain measurements, order changes or tracking details? Connect directly with Teepul support team on WhatsApp.
            </p>
            <a
              href="https://wa.me/919896374239?text=Hi%20Teepul!%20I%20have%20a%20question%20about%20my%20order."
              target="_blank"
              class="inline-flex items-center gap-1.5 font-bold text-emerald-700 hover:underline pt-1"
            >
              <span>💬 Open WhatsApp Support &rarr;</span>
            </a>
          </div>
        </div>

        <!-- Right Column: Order History & Live Order Tracking -->
        <div class="lg:col-span-7 space-y-6">
          <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-6">
            <div class="flex items-center justify-between border-b border-slate-100 pb-4">
              <div>
                <h2 class="text-lg font-extrabold text-slate-900 flex items-center gap-2">
                  <span>📦</span> Order History & Live Tracking ({customerOrders.length})
                </h2>
                <p class="text-xs text-slate-500 mt-0.5">Track your door curtain & decor shipments</p>
              </div>

              <a href="/products" class="text-xs font-bold text-amber-800 hover:underline">
                + Shop Catalog
              </a>
            </div>

            {customerOrders.length === 0 ? (
              <div class="text-center py-12 space-y-4 bg-slate-50 rounded-2xl border border-slate-100">
                <div class="text-4xl">🛍️</div>
                <h3 class="text-base font-bold text-slate-800">No Orders Found</h3>
                <p class="text-xs text-slate-500 max-w-sm mx-auto">
                  Explore our luxury door curtains, French sheer drapery, and ambient lighting catalog!
                </p>
                <a
                  href="/products"
                  class="inline-block bg-amber-800 hover:bg-amber-900 text-white font-extrabold text-xs px-6 py-3 rounded-full shadow transition"
                >
                  Explore Collection &rarr;
                </a>
              </div>
            ) : (
              <div class="space-y-6">
                {customerOrders.map((order) => (
                  <div class="bg-slate-50/80 rounded-2xl p-5 border border-slate-200 space-y-4">
                    
                    <!-- Order Header Info -->
                    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200/60 pb-3 text-xs">
                      <div>
                        <span class="font-extrabold text-slate-900 text-sm">Order #{order.orderNumber}</span>
                        <span class="text-slate-400 ml-2 font-medium">
                          {new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
                        </span>
                      </div>

                      <div class="flex items-center gap-2">
                        <span class="bg-blue-100 text-blue-800 text-[10px] font-black px-2.5 py-0.5 rounded-full uppercase">
                          {order.paymentMethod}
                        </span>
                        <span class={`text-[10px] font-black px-2.5 py-0.5 rounded-full uppercase ${
                          order.orderStatus === 'DELIVERED'
                            ? 'bg-emerald-100 text-emerald-800'
                            : order.orderStatus === 'SHIPPED'
                            ? 'bg-amber-100 text-amber-800'
                            : 'bg-blue-100 text-blue-800'
                        }`}>
                          {order.orderStatus}
                        </span>
                      </div>
                    </div>

                    <!-- Tracking Box -->
                    <div class="bg-white p-4 rounded-xl border border-amber-200/80 space-y-2">
                      <div class="flex items-center justify-between text-xs">
                        <span class="font-extrabold text-amber-900 flex items-center gap-1.5">
                          <span>🚚</span> Package Tracking Details
                        </span>
                        <span class="text-[10px] font-bold text-slate-500">
                          Partner: {order.courierPartner || 'Delhivery Express'}
                        </span>
                      </div>

                      <div class="flex flex-wrap items-center justify-between gap-2 text-xs pt-1">
                        <div>
                          <span class="text-slate-400 block text-[10px]">AWB / Tracking Number</span>
                          <span class="font-mono font-bold text-slate-800">
                            {order.trackingNumber || `DEL-${order.orderNumber.replace('ORD-', '')}-IN`}
                          </span>
                        </div>

                        <a
                          href={order.trackingUrl || `https://www.delhivery.com/track/package/${order.trackingNumber || 'DEL123456789'}`}
                          target="_blank"
                          class="bg-amber-800 hover:bg-amber-900 text-white font-extrabold text-[11px] px-4 py-2 rounded-xl shadow transition flex items-center gap-1"
                        >
                          <span>🚚 Track Package Live &rarr;</span>
                        </a>
                      </div>
                    </div>

                    <!-- Order Items -->
                    <div class="space-y-2">
                      {order.items.map((item: any) => (
                        <div class="flex items-center justify-between text-xs bg-white p-3 rounded-xl border border-slate-200/70">
                          <div>
                            <span class="font-bold text-slate-900 block">{item.productTitle}</span>
                            <span class="text-slate-500 text-[11px]">Qty: {item.quantity} | Size: {item.size || 'Standard'} | Color: {item.color || 'Default'}</span>
                          </div>
                          <span class="font-bold text-slate-900">₹{item.totalPrice?.toLocaleString('en-IN')}</span>
                        </div>
                      ))}
                    </div>

                    <!-- Shipping Address Preview -->
                    <div class="text-[11px] text-slate-500 border-t border-slate-200/60 pt-2 flex items-center justify-between">
                      <span><strong>Shipping Address:</strong> {order.shippingAddress}, {order.pincode}</span>
                      <span class="font-extrabold text-slate-900 text-xs">Total: ₹{order.totalAmount?.toLocaleString('en-IN')}</span>
                    </div>

                  </div>
                ))}
              </div>
            )}
          </div>
        </div>

      </div>

    </div>
  </div>

  <script is:inline>
    // Profile Edit Submit Handler
    const profileForm = document.getElementById('profile-form');
    const profileAlert = document.getElementById('profile-alert');
    const saveBtn = document.getElementById('save-profile-btn');

    profileForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      saveBtn.disabled = true;
      saveBtn.innerHTML = '⌛ Saving Details...';
      profileAlert.className = 'hidden';

      const formData = new FormData(profileForm);
      const data = Object.fromEntries(formData.entries());

      try {
        const res = await fetch('/api/account/update-profile', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const result = await res.json();

        if (result.success) {
          profileAlert.className = 'p-3 rounded-xl text-xs font-bold text-center bg-emerald-100 text-emerald-800 border border-emerald-300';
          profileAlert.innerText = '✨ Profile & address saved successfully!';
        } else {
          profileAlert.className = 'p-3 rounded-xl text-xs font-bold text-center bg-red-100 text-red-800 border border-red-300';
          profileAlert.innerText = 'Error: ' + (result.error || 'Failed to update profile');
        }
      } catch (err) {
        profileAlert.className = 'p-3 rounded-xl text-xs font-bold text-center bg-red-100 text-red-800 border border-red-300';
        profileAlert.innerText = 'Unexpected error occurred.';
      } finally {
        saveBtn.disabled = false;
        saveBtn.innerHTML = '💾 Save Profile Details';
      }
    });

    // Logout Handler
    const handleLogout = async () => {
      try {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.location.href = '/login';
      } catch (err) {
        window.location.href = '/login';
      }
    };

    document.getElementById('account-logout-btn')?.addEventListener('click', handleLogout);
  </script>
</PublicLayout>
